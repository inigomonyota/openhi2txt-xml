<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- atetris by Atari, 1988 -->
<!-- hiscore.dat: @:maincpu,program,979,90,30,52 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <!-- Updated size for the full 144-byte table -->
      <size>144</size>
    </check>

    <!-- Block 1: Scores for Ranks 1 through 16 (16 * 6 = 96 bytes) -->
    <loop count="16">
      <elt size="6" type="text" id="SCORE"/>
    </loop>

    <!-- Block 2: Names for Ranks 1 through 16 (16 * 3 = 48 bytes) -->
    <loop count="16">
      <elt size="3" type="text" id="NAME"/>
    </loop>
  </structure>

  <output>
    <table id="HIGH SCORES">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="trim_zeros;comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-15 into 1ST-16TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/><case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/><case src="5" dst="6TH"/><case src="6" dst="7TH"/><case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/><case src="9" dst="10TH"/><case src="10" dst="11TH"/><case src="11" dst="12TH"/>
    <case src="12" dst="13TH"/><case src="13" dst="14TH"/><case src="14" dst="15TH"/><case src="15" dst="16TH"/>
  </format>

  <!-- Removes leading zeros from ASCII score strings -->
  <format id="trim_zeros">
    <trim direction="left">0</trim>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>