<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 79 bytes = 10 entries x 8 bytes, skip-last-bytes=1
    per entry (8 bytes):
      [0:3]  score, 3-byte little-endian BCD (base16)
      [3:6]  name, 3-byte ASCII
      [6]    character index
      [7]    0x00 pad (missing in final entry -> skip-last-bytes=1)
    score displayed with leading zero (7 digits)
  //-->

  <structure file=".hi">
    <check>
      <size>79</size>
    </check>
    <loop count="10" skip-last-bytes="1">
      <elt size="3" type="int"  id="SCORE" base="16" endianness="little_endian"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="CHARACTER"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="score"><pad direction="left" max="6">0</pad></format>

</hi2txt>