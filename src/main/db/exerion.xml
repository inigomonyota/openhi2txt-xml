<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <structure file=".hi">
    <check>
      <size>240</size>
    </check>

    <!-- scores: 5 x 2 bytes, packed BCD -->
    <loop count="5">
      <elt size="2" type="int" id="SCORE" base="16" table-index="loop_index"/>
    </loop>

    <!-- 0xC8 is names; we've read 10 bytes so far -->
    <elt size="190" type="raw" id="_SKIP"/>

    <!-- names: 5 x (3 chars + 5 zero padding) -->
    <loop count="5">
      <elt size="3" type="text" id="NAME" charset="exerion" table-index="loop_index"/>
      <elt size="5" type="raw"  id="_NPAD"/>
    </loop>
  </structure>

  <output>
    <table id="EXERION">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE" format="*100"/>
      <column id="NAME"  src="NAME"  format="trimr"/>
    </table>
  </output>

  <charset id="exerion">
    <char src="0x5b" dst="."/>  <!-- '[' -> '.' -->
    <char src="0x5f" dst=":"/>  <!-- '_' -> ':' -->
  </charset>

</hi2txt>
