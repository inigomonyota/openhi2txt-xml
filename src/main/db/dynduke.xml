<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Dynamic Duke">
  <!--
    hiscore.dat: @:maincpu,program,1346,77,50,2a
    10 entries x 12 bytes = 119 bytes (last entry missing null terminator)
    Score: 4 bytes little-endian int
    RD:    1 byte, stored as (displayed value - 1)
    Pad:   3 bytes unknown
    Name:  3 bytes ASCII + 1 byte null
  //-->

  <structure file="hi">
    <check>
      <size>119</size>
    </check>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" endianness="little_endian"/>
      <elt size="1" type="int"  id="RD"/>
      <elt size="3" type="raw"  id="PAD"/>
      <elt size="3" type="text" id="NAME" ascii-offset="0"/>
      <elt size="1" type="raw"  id="NULL"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="rank"/>
      <column id="SCORE"/>
      <column id="RD"    format="+1"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="rank">
    <case src="0" dst="1:"/>
    <case src="1" dst="2:"/>
    <case src="2" dst="3:"/>
    <case src="3" dst="4:"/>
    <case src="4" dst="5:"/>
    <case src="5" dst="6:"/>
    <case src="6" dst="7:"/>
    <case src="7" dst="8:"/>
    <case src="8" dst="9:"/>
    <case src="9" dst="10:"/>
  </format>
  <format id="+1"><add>1</add></format>

</hi2txt>