<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    riot - Riot (NMK, 1992)
    .hi via hiscore.dat plugin: @:maincpu,program,101d3c,f0,64,18 (240 bytes).
    "COMMANDO WAR HISTORY 1992" book = 24 entries x 10 bytes.
    Record: [DATE 2 game-counter][KILL COUNT 2B big-endian int][NAME 6 indexed, char=byte+0x41]
      The displayed DATE (1992.mm.dd) and STATUS line (MISSION COMPLESED / LOST TO Nth BOSS /
      DEAD IN ... BATTLE) are derived by game code from the two counter bytes, not stored as
      literal fields, so only the stored columns KILL COUNT + NAME are decoded here.
      NAME is a rank-valued index repeated 6x (0x01->BBBBBB ... 0x18->YYYYYY).
  //-->

  <structure file=".hi">
    <check>
      <definition>0:101d3c:f0:64:18</definition>
      <size>240</size>
    </check>
    <loop count="24">
      <elt size="2" type="raw"  id="DATE"/>
      <elt size="2" type="int"  id="KILL COUNT" endianness="big_endian"/>
      <elt size="6" type="text" id="NAME" ascii-offset="65"/>
    </loop>
  </structure>

  <output>
    <table id="COMMANDO WAR HISTORY 1992">
      <column id="RANK" src="index" format="+1"/>
      <column id="KILL COUNT"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>
