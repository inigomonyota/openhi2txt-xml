<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 73 bytes -->
    <check><size>73</size></check>
    
    <!-- 5 Records * 16 Bytes = 80 Bytes -->
    <!-- The dump ends 7 bytes early during the 5th record's padding! -->
    <loop count="5" skip-last-bytes="7">
      
      <!-- 3-byte Big Endian BCD Score -->
      <elt size="3" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      
      <!-- 4-byte Name, padded with a space on the left -->
      <elt size="4" type="text" id="NAME" charset="bjourney_char"/>
      
      <!-- 1-byte Credits used -->
      <elt size="1" type="int"  id="CREDITS" base="16"/>
      
      <!-- 1-byte Internal Stage ID -->
      <elt size="1" type="int"  id="STAGE"/>
      
      <!-- 7 bytes of unused padding -->
      <elt size="7" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="TODAY'S BEST 5">
      <column id="RANK"    src="index"   format="ordinal"/>
      <column id="NAME"    src="NAME"    format="trim_space"/>
      <column id="SCORE"   src="SCORE"   format="PadL60"/>
        <!-- Game seems to have an internal array for stages, mapping largely unknown
	 	  <column id="STAGE"   src="STAGE"   format="stage_map"/> -->
      <column id="CREDITS" src="CREDITS" format="PadL20"/>
    </table>
  </output>

  <!-- Translates the visual row index to 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>
  
  <!-- Cleans the leading space from the 4-byte name field -->
  <format id="trim_space">
    <trim direction="left"> </trim>
  </format>

  <!-- Translates the internal absolute room ID back to the Stage X-Y display -->
  <format id="stage_map">
    <case src="1" dst="1-2"/>
    <case src="2" dst="1-1"/>
    <case src="3" dst="1-2"/>
    <case src="4" dst="1-3"/>
    <case src="5" dst="2-1"/>
    <case src="6" dst="2-2"/>
    <case src="7" dst="2-3"/>
    <case src="8" dst="3-1"/>
    <case src="9" dst="3-2"/>
    <case src="10" dst="3-3"/>
  </format>

  <!-- Custom charset -->
  <charset id="bjourney_char">
    <char src="0x3A" dst="¥"/>
    <char src="0x3B" dst="#"/>
    <char src="0x3C" dst="[H]"/>
    <char src="0x3F" dst="*"/>
  </charset>
</hi2txt>