<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- ordyne by Namco, 1988 -->
<!-- hiscore.dat: @:maincpu,program,100712,28,00,03 | @:maincpu,program,40925c,4,00,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>44</size>
    </check>

    <!-- 5 records, 8 bytes each: 4 (Score) + 3 (Name) + 1 (Round) -->
    <loop count="5">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <!-- Name uses offset -143 (0xD0 - 143 = 65/'A') -->
      <elt size="3" type="text" id="NAME"  ascii-offset="-143"/>
      <elt size="1" type="int"  id="ROUND" format="round_fix"/>
    </loop>

    <!-- Global Top Score (matches hiscore.dat 4-byte range) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>
    <elt size="1" type="raw" id="UNUSED"/>
  </structure>

  <output>
    <table id="TOP 5">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
      <column id="ROUND" src="ROUND"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <!-- Handles Namco's mixed round encoding (raw vs offset) -->
  <format id="round_fix">
    <case src="208" operator="&gt;=" format="-208"/>
    <case src="208" operator="&lt;"  format="*1" default="yes"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>