<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  polepos - Pole Position (Namco, 1982)
  Native nvram saving: nvram/polepos/nvram (2048 bytes)
  300 records x 6 bytes = 1800 bytes + 248 bytes config/tail
  Record: 2B score (LE int, x10 for display) + 2B unused + 2B name (base-32 packed)
  Names use base-32 LE packing (space=0, A=1..Z=26) which hi2txt cannot decode.
  Screen shows top 6 as PRIZE WINNERS, sorted by score descending.
//-->
<hi2txt>

  <structure file="nvram">
    <check>
      <size>2048</size>
    </check>
    <loop count="300">
      <elt size="2" type="int" id="SCORE" endianness="little_endian"/>
      <elt size="2" type="raw" id="PAD"/>
      <elt size="2" type="raw" id="NAMEPACKED"/>
    </loop>
    <elt size="248" type="raw" id="TAIL"/>
  </structure>

  <output>
    <table id="PRIZE WINNERS" sort="SCORE" sort-order="desc" lines-max="6">
      <column id="NO." src="index" format="+1"/>
      <column id="SCORE" format="*10"/>
    </table>
  </output>

</hi2txt>