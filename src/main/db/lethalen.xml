<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- lethalen by Konami, 1992 -->
<!-- hiscore.dat: @:maincpu,program,3390,50,41,00 | @:maincpu,program,33de,1,70,70 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>81</size>
    </check>

    <!-- 10 records, 8 bytes each -->
    <!-- Record: 3(Name) + 3(Score) + 1(Accuracy) + 1(Class) -->
    <loop count="10">
      <elt size="3" type="text" id="NAME"/>
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="int"  id="ACCURACY" base="16"/>
      <elt size="1" type="int"  id="CLASS"/>
    </loop>
  </structure>

  <output>
    <table id="BEST COPS">
      <column id="RANK"     src="index"    format="ordinal"/>
      <column id="NAME"     src="NAME"/>
      <column id="SCORE"    src="SCORE"    format="comma_score"/>
      <column id="ACCURACY" src="ACCURACY" format="accuracy_suffix"/>
      <column id="CLASS"    src="CLASS"    format="class_map"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- Translates Class IDs to Rank Names -->
  <format id="class_map">
    <case src="0" dst="PATROLMAN"/>
    <case src="1" dst="DETECTIVE"/>
    <case src="2" dst="SERGEANT"/>
    <case src="3" dst="LIEUTENANT"/>
    <case src="4" dst="CAPTAIN"/>
    <case src="5" dst="COMMANDER"/>
  </format>

  <!-- Adds % symbol to accuracy -->
  <format id="accuracy_suffix">
    <suffix>%</suffix>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>