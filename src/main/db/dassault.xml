<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  dassault - Desert Assault / Thunder Zone (Data East, 1991)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,3f803c,1e,19,10
  30 bytes = 5 entries x 6B
  Record (6B): 3B name (charset A=0x00) + 1B stage + 2B score (BCD)
  Stage: 7=END (game cleared). Other values may need +1 offset.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>30</size>
    </check>
    <loop count="5">
      <elt size="3" type="text" id="NAME" charset="az"/>
      <elt size="1" type="int" id="STAGE"/>
      <elt size="2" type="int" id="SCORE" base="16"/>
    </loop>
  </structure>

  <output>
    <table id="BEST 5 PLAYERS">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME"/>
      <column id="SCORE" format="comma_score"/>
      <column id="STAGE" format="stagemap"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" operator="=" dst="NO.1"/>
    <case src="1" operator="=" dst="NO.2"/>
    <case src="2" operator="=" dst="NO.3"/>
    <case src="3" operator="=" dst="NO.4"/>
    <case src="4" operator="=" dst="NO.5"/>
  </format>

  <format id="stagemap">
    <case src="0" operator="=" dst="1"/>
    <case src="1" operator="=" dst="1"/>
    <case src="2" operator="=" dst="2"/>
    <case src="3" operator="=" dst="3"/>
    <case src="4" operator="=" dst="4"/>
    <case src="5" operator="=" dst="4"/>
    <case src="6" operator="=" dst="5"/>
    <case src="7" operator="=" dst="END"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="az">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
    <char src="0x1B" dst="."/>
  </charset>

</hi2txt>
