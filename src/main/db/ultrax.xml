<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- ultrax by Banpresto, 1995 -->
<!-- hiscore.dat: @:maincpu,program,1ac8e,28,40,04 | @:maincpu,program,e23c,3,40,0f -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>43</size>
    </check>

    <!-- 5 records, 8 bytes each -->
    <loop count="5">
      <!-- Score is 4-byte Little Endian Integer -->
      <elt size="4" type="int"  id="SCORE"  endianness="little_endian"/>
      <!-- Name is 3 bytes (0x0C = M, 0x13 = T, 0x18 = Y) -->
      <elt size="3" type="text" id="NAME"   charset="ultrax_chars"/>
      <!-- Faction ID is 1 byte -->
      <elt size="1" type="int"  id="FACTION_ID"/>
    </loop>

    <!-- Global High Score (Final 3 bytes of the 43-byte file) -->
    <elt size="3" type="int" id="HI-SCORE" endianness="little_endian"/>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="comma_score" display="extra"/-->

    <table id="BEST 5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="PadL70;comma_score"/>
	  <column id="NAME" src="NAME"/>
      <column id="EDF FACTION" src="FACTION_ID" format="faction_map"/>
    </table>
  </output>

  <!-- Translates 0-4 into 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/>
  </format>

  <!-- Verified Faction and Ship Mapping -->
  <format id="faction_map">
    <case src="0" dst="SSP (JET-VTOL)"/>
    <case src="1" dst="TDF (ULTRA-HAWK)"/>
    <case src="2" dst="MAT (MAT-ARROW)"/>
    <case src="3" dst="TAC (TAC-SPACE)"/>
    <case src="4" dst="ZAT (CONDOR-1)"/>
    <case src="5" dst="MAC (MACKY-3)"/>
    <case src="6" dst="UGM (SILVER-GULL)"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Alphanumeric Charset (A=0, B=1...) -->
  <charset id="ultrax_chars">
    <char src="0x00" dst="A"/><char src="0x01" dst="B"/><char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/><char src="0x04" dst="E"/><char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/><char src="0x07" dst="H"/><char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/><char src="0x0A" dst="K"/><char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/><char src="0x0D" dst="N"/><char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/><char src="0x10" dst="Q"/><char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/><char src="0x13" dst="T"/><char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/><char src="0x16" dst="W"/><char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/><char src="0x19" dst="Z"/>
  </charset>
</hi2txt>