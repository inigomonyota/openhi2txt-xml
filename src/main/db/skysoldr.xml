<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Sky Soldiers">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,204100,c0,00,0c
                  @:maincpu,program,40030,4,00,00</definition>
      <size>196</size>
    </check>
    <loop count="12">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="2" type="raw"  id="PAD1"/>
      <elt size="2" type="raw"  id="PAD2"/>
      <elt size="1" type="raw"  id="PAD3"/>
      <elt size="1" type="text" id="CHAR1"/>
      <elt size="1" type="text" id="CHAR2"/>
      <elt size="1" type="text" id="CHAR3"/>
      <elt size="1" type="raw"  id="PAD4"/>
      <elt size="1" type="text" id="CHAR4"/>
      <elt size="1" type="raw"  id="PAD5"/>
      <elt size="1" type="int"  id="RANK_RAW"/>
    </loop>
    <elt size="4" type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table sort="SCORE" sort-order="desc">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="*1000"/>
      <column id="NAME"  format="name"/>
    </table>
    <field id="TOP SCORE" format="*10"/>
  </output>

  <format id="name">
    <concat>
      <column id="CHAR2"/>
      <column id="CHAR3"/>
      <column id="CHAR4"/>
    </concat>
  </format>
</hi2txt>
