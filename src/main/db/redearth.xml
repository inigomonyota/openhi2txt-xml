<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Red Earth">
  <!--
    Red Earth / Warzard (redearth) - Capcom CPS-3, 1996. SH-2, BIG-ENDIAN.
    The RANKING board (5 entries) is NOT in the 128-byte eeprom (that only holds
    dip/config); it lives in :maincpu program-space work RAM. Found by loading
    the save state and searching main RAM: table base 0x02067932, 5 records of
    0x10 (16) bytes = 0x50 (80) bytes total, cleanly zero-bounded.

    Record layout (16 bytes, big-endian), verified against the RANKING screen:
      +0x00  EXP   : 2 bytes packed BCD, big-endian (80 00 = 8000). Decoded with
                     base="16" (same as jojoban; the deployed tool reads packed
                     2-digit-per-byte BCD via base 16, not decoding-profile="bcd").
      +0x02  LV    : 1 byte, 0-based character level (stored 3 => shown LV4).
      +0x03  WINS  : 1 byte, win count (raw).
      +0x04  pad   : 2 bytes (00 + character-id).
      +0x06  pad   : 1 byte (00).
      +0x07  C1    : 1 byte, name char 1 as letter index A=0 (ascii-offset 65).
      +0x08  pad   : 1 byte (00).
      +0x09  C2    : 1 byte, name char 2.
      +0x0A  pad   : 1 byte (00).
      +0x0B  C3    : 1 byte, name char 3.
      +0x0C  pad   : 4 bytes (00).

    Verified against the RANKING screenshot (factory defaults):
      1 DNA  B-HEART 8000 LV4 3WINS   2 YAN 4000 LV3 2WINS
      3 ARI  3000 LV3 2WINS           4 NOT 2000 LV2 1WIN
      5 FRK  1000 LV2 1WIN
    "B-HEART" is the champion title shown only on the 1st-place row.
    Authored by Pipmick @ CoinOPS.
  //-->

  <structure file=".hi">
    <check>
      <size>80</size>
    </check>
    <loop count="5">
      <elt size="2" type="int"  id="EXP"  base="16" table-index="loop_index"/>
      <elt size="1" type="int"  id="LV"   table-index="loop_index"/>
      <elt size="1" type="int"  id="WINS" table-index="loop_index"/>
      <elt size="2" type="raw"  id="PAD1" table-index="loop_index"/>
      <elt size="1" type="raw"  id="PAD2" table-index="loop_index"/>
      <elt size="1" type="text" id="C1"   ascii-offset="65" table-index="loop_index"/>
      <elt size="1" type="raw"  id="PAD3" table-index="loop_index"/>
      <elt size="1" type="text" id="C2"   ascii-offset="65" table-index="loop_index"/>
      <elt size="1" type="raw"  id="PAD4" table-index="loop_index"/>
      <elt size="1" type="text" id="C3"   ascii-offset="65" table-index="loop_index"/>
      <elt size="4" type="raw"  id="PAD5" table-index="loop_index"/>
    </loop>
  </structure>

  <output>
    <table id="HIGH SCORES">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="C1"    format="namecat"/>
      <column id="TITLE" src="index" format="bheart"/>
      <column id="EXP"   src="EXP"/>
      <column id="LV"    src="LV"     format="+1"/>
      <column id="WINS"  src="WINS"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="namecat" input-as-subcolumns-input="yes">
    <concat>
      <column src="C1"/><column src="C2"/><column src="C3"/>
    </concat>
  </format>

  <format id="bheart">
    <replace src="0" dst="B-HEART"/>
    <replace src="1" dst=""/>
    <replace src="2" dst=""/>
    <replace src="3" dst=""/>
    <replace src="4" dst=""/>
  </format>
</hi2txt>
