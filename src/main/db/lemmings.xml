<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- lemmings by Data East USA, 1991 -->
<!-- hiscore.dat: @:maincpu,program,10a402,50,44,01 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>80</size>
    </check>

    <!-- 10 records, 8 bytes each -->
    <loop count="10">
      <!-- Bytes 0-2: Initials (3 bytes ASCII) -->
      <elt size="3" type="text" id="NAME"/>
      <!-- Bytes 3-4: Padding -->
      <elt size="2" type="raw"  id="PAD1"/>
      <!-- Byte 5: Saved Lemmings (Standard Hex Integer) -->
      <elt size="1" type="int"  id="SAVED"/>
      <!-- Byte 6: Padding -->
      <elt size="1" type="raw"  id="PAD2"/>
      <!-- Byte 7: Level (Standard Hex Integer) -->
      <elt size="1" type="int"  id="LEVEL"/>
    </loop>
  </structure>

  <output>
    <table id="LEMMINGS LOVERS">
      <column id="RANK"     src="index" format="ordinal"/>
      <column id="INITIALS" src="NAME"/>
      <column id="SAVED"    src="SAVED" format="comma_score"/>
      <column id="LEVEL"    src="LEVEL"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>