<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  cop01 - Cop 01 (Nichibutsu, 1985)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,c46d,28,00,01
  40 bytes = 5 entries x 8B
  Record (8B): 4B score (BCD) + 3B name (ASCII, 0x03=period) + 1B zone
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>40</size>
    </check>
    <loop count="5">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME" charset="chars"/>
      <elt size="1" type="int" id="ZONE"/>
    </loop>
  </structure>

  <output>
    <table id="BEST 5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE" format="comma_score"/>
      <column id="NAME"/>
      <column id="ZONE"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
    <case src="3" operator="=" dst="4TH"/>
    <case src="4" operator="=" dst="5TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="chars">
    <char src="0x03" dst="."/>
    <char src="0x41" dst="A"/>
    <char src="0x42" dst="B"/>
    <char src="0x43" dst="C"/>
    <char src="0x44" dst="D"/>
    <char src="0x45" dst="E"/>
    <char src="0x46" dst="F"/>
    <char src="0x47" dst="G"/>
    <char src="0x48" dst="H"/>
    <char src="0x49" dst="I"/>
    <char src="0x4A" dst="J"/>
    <char src="0x4B" dst="K"/>
    <char src="0x4C" dst="L"/>
    <char src="0x4D" dst="M"/>
    <char src="0x4E" dst="N"/>
    <char src="0x4F" dst="O"/>
    <char src="0x50" dst="P"/>
    <char src="0x51" dst="Q"/>
    <char src="0x52" dst="R"/>
    <char src="0x53" dst="S"/>
    <char src="0x54" dst="T"/>
    <char src="0x55" dst="U"/>
    <char src="0x56" dst="V"/>
    <char src="0x57" dst="W"/>
    <char src="0x58" dst="X"/>
    <char src="0x59" dst="Y"/>
    <char src="0x5A" dst="Z"/>
  </charset>

</hi2txt>
