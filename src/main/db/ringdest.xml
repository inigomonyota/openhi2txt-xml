<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>144</size></check>
    
    <!-- Skip the 44 bytes of pointers -->
    <elt size="44" type="raw" id="POINTERS"/>
    
    <!-- 11 records * 8 bytes = 88 bytes -->
    <!-- No complex table-indexing needed! Just read them sequentially. -->
    <loop count="11">
      <elt size="4" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      <elt size="3" type="text" id="NAME" />
      <elt size="1" type="text" id="CHAR" charset="ringdest_char"/>
    </loop>
    
    <!-- 12 bytes trail -->
    <elt size="12" type="raw" id="TRAIL"/>
  </structure>
  
  <output>
    <!-- sort="SCORE" automatically orders them highest to lowest -->
    <table id="HIGH SCORES" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="rank_format"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME" src="NAME"/>
      <column id="CHARACTER" src="CHAR"/>
    </table>
  </output>

  <!-- Maps the newly sorted indices to proper rank strings -->
  <format id="rank_format">
    <case src="0" dst="CHAMP"/>
    <case src="1" dst="1"/>
    <case src="2" dst="2"/>
    <case src="3" dst="3"/>
    <case src="4" dst="4"/>
    <case src="5" dst="5"/>
    <case src="6" dst="6"/>
    <case src="7" dst="7"/>
    <case src="8" dst="8"/>
    <case src="9" dst="9"/>
    <case src="10" dst="10"/>
  </format>
  
  <charset id="ringdest_char">
    <char src="0x00" dst="BIFF"/>
    <char src="0x01" dst="GUNLOC"/>
    <char src="0x02" dst="ONI"/>
    <char src="0x03" dst="TIM"/>
    <char src="0x04" dst="STINGRAY"/>
    <char src="0x05" dst="HAGGAR"/>
    <char src="0x06" dst="ALEXANDER"/>
    <char src="0x07" dst="RASTA MON"/>
    <char src="0x08" dst="JUMBO"/>
    <char src="0x0d" dst="VICTOR"/>
    <char src="0xFF" dst="UNKNOWN" default="yes"/>
  </charset>
</hi2txt>