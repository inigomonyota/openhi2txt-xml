<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- loffire by Sega, 1989 -->
<!-- hiscore.dat: @:mainpcb:maincpu,program,a3800,18f,01,49 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>399</size>
    </check>

    <!-- 50 records, 8 bytes each: 4 (Score BCD) + 3 (Name) + 1 (Pad) -->
    <!-- skip-last-bytes="1" handles the file ending after the 50th name (399 bytes) -->
    <loop count="50" skip-last-bytes="1">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Explicit Ordinal Formatter for 1ST to 50TH -->
  <format id="ordinal">
    <!-- 1st - 3rd (Indices 0-2) -->
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>

    <!-- 11th - 13th (Indices 10-12) -->
    <case src="10" dst="11TH"/>
    <case src="11" dst="12TH"/>
    <case src="12" dst="13TH"/>

    <!-- 21st - 23rd (Indices 20-22) -->
    <case src="20" dst="21ST"/>
    <case src="21" dst="22ND"/>
    <case src="22" dst="23RD"/>

    <!-- 31st - 33rd (Indices 30-32) -->
    <case src="30" dst="31ST"/>
    <case src="31" dst="32ND"/>
    <case src="32" dst="33RD"/>

    <!-- 41st - 43rd (Indices 40-42) -->
    <case src="40" dst="41ST"/>
    <case src="41" dst="42ND"/>
    <case src="42" dst="43RD"/>

    <!-- Default for all other numbers (appends TH to Rank+1) -->
    <case src="0" operator="&gt;=" format="+1;SuffixTH" default="yes"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>