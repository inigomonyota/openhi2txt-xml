<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with:
	  mame 0.219 and related hiscore.dat
	  mame 0.148 and related hiscore.dat
	history:
	  2020-04-15 fix score for endianness
    source: HiToText, GreatStone
  //-->
  
  <structure file=".hi">
    <check>
      <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure versus the provided file //-->
      <definition>0:8082:3:00:00
                  0:c5be:1:25:25
                  0:c5de:1:25:25
                  0:c5fe:1:05:05
                  0:c61e:1:00:00
                  0:c63e:1:00:00
                  0:c65e:1:00:00</definition>
      <!-- optional: if defined, it allows to select the good structure versus the provided file
                     useful if multiple structures are defined but hiscore.dat not provided //-->
      <size>9</size>
    </check>
    <loop count="1">
      <elt size="3" type="raw" id="SCORE"/>
      <elt size="6" type="text" id="HI-SCORE" charset="alpine_cs"/>
    </loop>
  </structure>
  
  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="HI-SCORE"/>
    </table>
  </output>
  
  <format id="+1"><add>1</add></format>
  <charset id="alpine_cs">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
    <char src="0x25" dst=""/>
    <char src="0x28" dst=":"/>
  </charset>
</hi2txt>
