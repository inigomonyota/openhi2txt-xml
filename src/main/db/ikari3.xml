<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- ikari3 by SNK, 1989 -->
<!-- hiscore.dat: @:maincpu,program,4007e,58,00,1d -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>88</size>
    </check>

    <!-- The first 8 bytes seem to be a separate 'Global Top' or sentinel record -->
    <elt size="4" type="int" id="TOP_SCORE_RAW" base="16"/>
    <elt size="4" type="raw" id="TOP_NAME_RAW"/>

    <!-- 10 records, 8 bytes each -->
    <!-- Record: 4(Score BCD) + 3(Name) + 1(Pad) -->
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <!-- SNK Internal Map: 0x00=A, 0x12=S, 0x0D=N, 0x0A=K, 0x19=Z -->
      <elt size="3" type="text" id="NAME"  ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="BEST"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>