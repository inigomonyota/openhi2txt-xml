<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  uccopsar - Undercover Cops Alpha Renewal Version (Irem Corporation, 1992)
  M92 hardware, V33 CPU.
  hiscore.dat: @:maincpu,program,e3e78,49,30,01
  73 bytes total

  Layout:
    5 entries × 16 bytes each = 80 bytes, but last entry truncated to 9 bytes
    (4 × 16 + 9 = 73 bytes total; skip-last-bytes=7 on the loop)

  9-byte data record (with 7 trailing 0xFF padding bytes for entries 1-4):
    [0-3] Score (4B LE packed BCD, stored / 10 for display)
    [4-6] Name (3B ASCII)
    [7]   City Sweeper ID (1B int)
    [8]   Coins (1B int)
    [9-15] 7 × 0xFF padding (entries 1-4 only)

  City Sweepers:
    1 = CLAUDE
    2 = BUBBA
    3 = FLAME

  Score is stored as score/10 in 4-byte LE BCD, so the file value 59630
  displays as 596300 (with leading zeros padded to 8 digits and a "$" prefix
  matching the in-game display).
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>73</size>
    </check>

    <!-- 5 entries × 16B; last entry truncated by 7 padding bytes -->
    <loop count="5" skip-last-bytes="7">
      <elt size="4" type="int" id="SCORE" base="16" endianness="little_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="NAME" table-index="loop_index"/>
      <elt size="1" type="int" id="SWEEPER_ID" table-index="loop_index"/>
      <elt size="1" type="int" id="COINS" table-index="loop_index"/>
      <elt size="7" type="raw" id="EPAD"/>
    </loop>
  </structure>

  <output>
    <table id="BEST SWEEPERS">
      <column id="RANK" src="index" format="rank_pad"/>
      <column id="BOUNTY" src="SCORE" format="bounty_x10;comma_score;dollar_prefix"/>
      <column id="NAME"/>
      <column id="CITY SWEEPER" src="SWEEPER_ID" format="sweeper_name"/>
      <column id="COINS" format="pad2"/>
    </table>
  </output>

  <!-- Rank: 0-4 -> 01-05 -->
  <format id="rank_pad">
    <add>1</add>
    <pad direction="left" max="2">0</pad>
  </format>

  <!-- 2-digit zero pad (used by COINS) -->
  <format id="pad2">
    <pad direction="left" max="2">0</pad>
  </format>

  <!-- Bounty: undo the score/10 storage by multiplying by 10 -->
  <format id="bounty_x10">
    <multiply>10</multiply>
  </format>

  <!-- Add $ prefix (chained after comma_score at column level) -->
  <format id="dollar_prefix">
    <prefix>$</prefix>
  </format>

  <!-- City Sweeper ID -> name -->
  <format id="sweeper_name">
    <case src="1" operator="=" dst="CLAUDE"/>
    <case src="2" operator="=" dst="BUBBA"/>
    <case src="3" operator="=" dst="FLAME"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>