<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    Sega Model 1: Virtua Fighter (vf) - NVRAM-based table decode for hi2txt.

    hiscore.dat reference:
      @:maincpu,program,40f800,b3,09,4d

    File to read (MAME):
      nvram\vf\nvram   (64 KiB)

    Notes:
      - This XML assumes the hiscore block is mapped into backup RAM and is stored in the nvram file.
      - TIME is assumed to be a 16-bit tick counter at 32 ticks/second (same tick rate as Virtua Racing).
      - The previous vf.xml was formatting TIME as two separate bytes; this version forces the TIME format to operate
        on the full 16-bit value (see input-as-subcolumns-input="yes"), matching how vr.xml does it.
  //-->

  <structure file="nvram">
    <!-- Skip to 0xF800 (0x40F800 - 0x400000) -->
    <elt size="63488" type="raw" id="_SKIP_TO_TABLE"/>

    <!-- 18 ranking lines -->
    <loop count="18">
      <elt size="3" type="text" id="NAME" table-index="loop_index"/>
      <!-- 16-bit ticks (little-endian on Model 1) -->
      <elt size="2" type="int"  id="TIME" byte-swap="2" table-index="loop_index"/>
      <elt size="1" type="text" id="CHARACTER" charset="vf_chars" table-index="loop_index"/>
    </loop>

    <!-- Remaining bytes in the hiscore.dat block (0xB3 - 18*6 = 0x47) -->
    <elt size="71" type="raw" id="_TRAIL"/>

    <!-- Consume the rest of the 64 KiB nvram so the structure matches file size exactly -->
    <elt size="1869" type="raw" id="_REST"/>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME"/>
      <column id="TIME" format="vf_time_fmt"/>
      <column id="CHARACTER"/>
    </table>
  </output>

  <!-- TIME: 32 ticks/sec -> S''CC (seconds and centiseconds) -->
  <format id="vf_time_fmt" input-as-subcolumns-input="yes">
    <concat>
      <column format="vf_sec"/>
      <txt>''</txt>
      <column format="vf_cs"/>
    </concat>
  </format>

  <format id="vf_sec">
    <divide_trunc>32</divide_trunc>
  </format>

  <format id="vf_cs">
    <remainder>32</remainder>
    <multiply>100</multiply>
    <divide_trunc>32</divide_trunc>
    <pad direction="left" max="2">0</pad>
  </format>

  <charset id="vf_chars">
    <!-- Best-effort mapping (adjust if you see different character codes in your nvram). -->
    <char src="0x00" dst="LAU" default="1"/>
    <char src="0x01" dst="AKI"/>
    <char src="0x02" dst="JAC"/>
    <char src="0x03" dst="SAR"/>
    <char src="0x04" dst="PAI"/>
    <char src="0x05" dst="WOL"/>
    <char src="0x06" dst="JEF"/>
    <char src="0x07" dst="KAG"/>
    <char src="0x08" dst="DUR"/>
  </charset>
</hi2txt>
