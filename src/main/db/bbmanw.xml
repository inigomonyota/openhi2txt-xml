<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>106</size></check>
    <elt size="1" type="raw" id="SKIP_HEADER"/>
    <loop count="5">
      <elt size="1" type="int"  id="WORLDNUM"/>
      <elt size="1" type="int"  id="STAGENUM"/>
      <elt size="3" type="int"  id="SCORE" base="16" endianness="little_endian"/>
      <elt size="6" type="text" id="NAME" charset="bbmanw_char"/>
    </loop>
    <elt size="50" type="raw" id="TRAIL"/>
  </structure>

  <output>
    <table id="BEST 5 RANKING">
      <column id="RANK"          src="index" format="+1"/>
      <column id="SCORE"         src="SCORE" format="*10;PadL70"/>
      <column id="STAGE"             format="stage_fmt"/>
      <column id="NAME"          src="NAME"  format="TrimR "/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="stage_fmt">
    <concat>
      <column src="WORLDNUM" format="+1"/>
      <txt>-</txt>
      <column src="STAGENUM" format="+1"/>
    </concat>
  </format>

  <charset id="bbmanw_char">
    <char src="0x63" dst="&black-heart;"/>
  </charset>
</hi2txt>