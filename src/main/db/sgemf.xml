<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Super Gem Fighter Mini Mix">
  <!--
    sgemf (Super Gem Fighter Mini Mix / Pocket Fighter, CPS-2, 68000 big-endian).
    No nvram scoreboard; scores live in volatile work RAM and the MAME hiscore
    plugin restores them on boot. hiscore.dat (shared by sgemf/sgemfa/sgemfd/sgemfh):
      @:maincpu,program,fff23a,2 ,00,02   -> .hi bytes 0x00-0x01
      @:maincpu,program,fff23c,ae,00,00   -> .hi bytes 0x02-0xAF
    fff23a + 2 = fff23c, so the two blocks are contiguous in RAM; the captured
    .hi (hiscore/sgemf.hi) is one 176-byte blob = 11 records of 16 bytes:
      SCORE RANKING : 5 records (0x00-0x4F)
      (empty record : 0x50-0x5F, unused slot)
      VS RANKING    : 5 records (0x60-0xAF)

    Record (16 bytes):
      +0  SCORE  4 bytes packed BCD, big-endian (00 01 00 00 = 10000). Decoded
                 with base="16" (this build reads 2 BCD digits/byte; same as
                 jojoban/shadfrce). Shown only on SCORE RANKING.
      +4  NAME   3 bytes, indexed initials: byte = letter index, A=0..Z=25
                 (0x11 0x18 0x14 = R,Y,U = "RYU").
      +7  MARK   1 byte, constant 0x2d on written rows (ignored).
      +8  AVATAR 1 byte, fighter index. 0-11 mapped to names via format favatar
                 (0=Ryu,1=Ken,2=Chun-Li,3=Sakura,4=Morrigan,5=Lei-Lei,6=Felicia,
                 7=Tessa,8=Ibuki,9=Zangief,10=Dan,11=Akuma). Secret fighters Dan(10)
                 and Akuma(11) confirmed by live byte-injection into chart RAM +
                 attract snapshot (the rank-1 BEST PLAYER board draws the fighter
                 name in green below the initials). Indices 12+ render a face-down
                 blank card with no name (Devilot has no ranking-avatar portrait), so
                 they pass through raw.
      +9  (2 bytes pad)
      +11 WINS   1 byte, VS match wins (00 on SCORE rows). Shown only on VS RANKING.
      +12 (4 bytes pad)

    Proven byte-for-byte against hiscore/sgemf.hi and the attract screenshots:
      SCORE RANKING  1 RYU 20000 / 2 KEN 10000 / 3 CHN 5000 / 4 SKR 4000 / 5 ZAN 2000
      VS RANKING     1 MOR 6 / 2 FEL 5 / 3 LEI 4 / 4 IBK 3 / 5 TBS 2
    Authored by Pipmick @ CoinOPS.
  //-->

  <structure file=".hi">
    <check>
      <size>176</size>
    </check>

    <!-- SCORE RANKING: 5 records -->
    <loop count="5">
      <elt size="4" type="int"  id="S_SCORE"  base="16"      table-index="loop_index"/>
      <elt size="3" type="text" id="S_NAME"   charset="csAZ" table-index="loop_index"/>
      <elt size="1" type="raw"  id="S_MARK"                  table-index="loop_index"/>
      <elt size="1" type="int"  id="S_AVATAR"                table-index="loop_index"/>
      <elt size="3" type="raw"  id="S_PAD"                   table-index="loop_index"/>
      <elt size="4" type="raw"  id="S_PAD2"                  table-index="loop_index"/>
    </loop>

    <!-- unused slot between the two tables -->
    <elt size="16" type="raw" id="_GAP"/>

    <!-- VS RANKING: 5 records -->
    <loop count="5">
      <elt size="4" type="raw"  id="V_SCORE"                 table-index="loop_index"/>
      <elt size="3" type="text" id="V_NAME"   charset="csAZ" table-index="loop_index"/>
      <elt size="1" type="raw"  id="V_MARK"                  table-index="loop_index"/>
      <elt size="1" type="int"  id="V_AVATAR"                table-index="loop_index"/>
      <elt size="2" type="raw"  id="V_PAD"                   table-index="loop_index"/>
      <elt size="1" type="int"  id="V_WINS"                  table-index="loop_index"/>
      <elt size="4" type="raw"  id="V_PAD2"                  table-index="loop_index"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING">
      <column id="RANK"    src="index"    format="ordinal"/>
      <column id="SCORE"   src="S_SCORE"/>
      <column id="NAME"    src="S_NAME"/>
      <column id="FIGHTER" src="S_AVATAR" format="favatar"/>
    </table>
    <table id="VS RANKING">
      <column id="RANK"    src="index"    format="ordinal"/>
      <column id="WINS"    src="V_WINS"/>
      <column id="NAME"    src="V_NAME"/>
      <column id="FIGHTER" src="V_AVATAR" format="favatar"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <!-- Fighter avatar index -> name. Indices 0-9 confirmed from the .hi + attract
       snapshots; 10=Dan and 11=Akuma confirmed by live byte-injection into chart RAM
       (rank-1 BEST PLAYER board draws the fighter name in green). Indices 12+ render
       a blank face-down card with no name (Devilot has no ranking avatar), so unknown
       values pass through as their raw number. -->
  <format id="favatar">
    <case src="0" dst="RYU"/>
    <case src="1" dst="KEN"/>
    <case src="2" dst="CHUN-LI"/>
    <case src="3" dst="SAKURA"/>
    <case src="4" dst="MORRIGAN"/>
    <case src="5" dst="LEI-LEI"/>
    <case src="6" dst="FELICIA"/>
    <case src="7" dst="TESSA"/>
    <case src="8" dst="IBUKI"/>
    <case src="9" dst="ZANGIEF"/>
    <case src="10" dst="DAN"/>
    <case src="11" dst="AKUMA"/>
    <case src="-1" default="true" format="idnum"/>
  </format>
  <format id="idnum"><add>0</add></format>

  <charset id="csAZ">
    <char src="0x00" dst="A"/><char src="0x01" dst="B"/><char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/><char src="0x04" dst="E"/><char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/><char src="0x07" dst="H"/><char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/><char src="0x0a" dst="K"/><char src="0x0b" dst="L"/>
    <char src="0x0c" dst="M"/><char src="0x0d" dst="N"/><char src="0x0e" dst="O"/>
    <char src="0x0f" dst="P"/><char src="0x10" dst="Q"/><char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/><char src="0x13" dst="T"/><char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/><char src="0x16" dst="W"/><char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/><char src="0x19" dst="Z"/>
  </charset>
</hi2txt>
