<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<hi2txt>

  <!--
    kov2 - Knights of Valour 2 (IGS PGM)
    Reads the MAME sram file (nvram/kov2/sram), 131072 bytes.

    PGM 68000: sram is word-swapped, so structure uses byte-swap 2.
    Two contiguous 10-entry tables of 30-byte (0x1E) records from 0x3B86:
      EXP RANKING   @ 0x3B86
      SCORE RANKING @ 0x3CB2 (immediately after)
    Record:
      [0:4]   NAME  4 ASCII chars
      [4:22]  per-entry character data (18 bytes)
      [22:26] SCORE 4-byte big-endian BINARY (00 03 0D 40 gives 200000)
      [26:30] padding
  -->

  <structure file="sram" byte-swap="2">
    <check>
      <size>131072</size>
    </check>

    <!-- skip to EXP RANKING at 0x3B86 (15238 bytes) -->
    <elt size="15238" type="raw" id="PRE"/>
    <!-- EXP RANKING -->
    <loop count="10">
      <elt size="4"  type="text" id="EXP_NAME"/>
      <elt size="18" type="raw"  id="EXP_MID"/>
      <elt size="4"  type="int"  id="EXP_SCORE"/>
      <elt size="4"  type="raw"  id="EXP_PAD"/>
    </loop>
    <!-- SCORE RANKING -->
    <loop count="10">
      <elt size="4"  type="text" id="SC_NAME"/>
      <elt size="18" type="raw"  id="SC_MID"/>
      <elt size="4"  type="int"  id="SC_SCORE"/>
      <elt size="4"  type="raw"  id="SC_PAD"/>
    </loop>
  </structure>

  <output>
    <table id="EXP RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="EXP_NAME"/>
      <column id="SCORE" src="EXP_SCORE"/>
    </table>
    <table id="SCORE RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="SC_NAME"/>
      <column id="SCORE" src="SC_SCORE"/>
    </table>
  </output>

</hi2txt>
