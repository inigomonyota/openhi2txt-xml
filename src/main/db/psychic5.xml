<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- psychic5 by Jaleco, 1987 -->
<!-- hiscore.dat: @:maincpu,program,fd00,31,00,01 | @:maincpu,program,fc84,3,00,53 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>52</size>
    </check>

    <!-- 7 records, 7 bytes each: 3(Score BCD) + 3(Name) + 1(Scene) -->
    <loop count="7">
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="jaleco_psychic"/>
      <elt size="1" type="int"  id="SCENE"/>
    </loop>

    <!-- Global Top Score (Final 3 bytes of the 52-byte file) -->
    <elt size="3" type="int" id="HI-SCORE" base="16"/>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="*100;comma_score" display="extra"/-->

    <table id="BEST 7 PLAYERS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="*100;comma_score"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCENE" src="SCENE"/>
    </table>
  </output>

  <!-- Translates 0-6 into 1ST-7TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Mapping Jaleco specific characters from your hex dump -->
  <charset id="jaleco_psychic">
    <char src="0x5E" dst="❤"/> <!-- Heart -->
    <char src="0x5C" dst="✦"/> <!-- Star/Cross symbol -->
    <char src="0x7F" dst="♂"/> <!-- Male symbol -->
    <char src="0x7D" dst="♀"/> <!-- Female symbol -->
    <char src="0x7B" dst="."/> <!-- Period variant 1 -->
    <char src="0x2E" dst="."/> <!-- Period variant 2 -->
  </charset>
</hi2txt>