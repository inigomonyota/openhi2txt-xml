<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <!-- sharrier (.hi) – Space Harrier
       Observed sharrier.hi size: 994 bytes

       Rank 1:
         0x0000 SCORE (4 bytes packed BCD)
         0x0004 SCORE duplicate (ignored)
         0x0008 NAME  (4 bytes ASCII, padded)

       Rank 2..10 (9 records, 10 bytes each):
         PFX   (2 bytes, ignored)
         SCORE (4 bytes packed BCD)
         NAME  (4 bytes ASCII, padded)
  -->

  <structure file=".hi">
    <check>
      <size>994</size>
    </check>

    <!-- Rank 1 goes into table row 0 -->
    <elt size="4" type="int"  id="SCORE" base="16" table-index="0"/>
    <elt size="4" type="raw"  id="_SCORE_DUP"/>
    <elt size="4" type="text" id="NAME"  table-index="0"/>

    <!-- Rank 2..10 go into table rows 1..9 -->
    <loop count="9" start="1" step="1">
      <elt size="2" type="raw"  id="_PFX"/>
      <elt size="4" type="int"  id="SCORE" base="16" table-index="loop_index"/>
      <elt size="4" type="text" id="NAME"  table-index="loop_index"/>
    </loop>
  </structure>

  <output>
    <table line-ignore="SCORE:0">
      <column id="RANK"  src="index" format="+1" />
      <column id="SCORE"/>
      <column id="NAME"  format="trim"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="trim"><trim direction="right"> </trim></format>

</hi2txt>
