<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>100</size></check>
    
    <!-- TABLE 1: 3 LIVES -->
    <loop count="10">
      <elt size="3" type="int"  id="SCORE_3" endianness="big_endian"/>
      <elt size="2" type="text" id="NAME_3"  decoding-profile="base-40" charset="indytemp_char"/>
    </loop>

    <!-- TABLE 2: 7 LIVES -->
    <loop count="10">
      <elt size="3" type="int"  id="SCORE_7" endianness="big_endian"/>
      <elt size="2" type="text" id="NAME_7"  decoding-profile="base-40" charset="indytemp_char"/>
    </loop>
  </structure>

  <output>
    <table id="3 LIVES">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME_3"/>
      <!-- Call our custom math-based comma formatter -->
      <column id="SCORE" src="SCORE_3" format="comma_score"/>
    </table>

    <table id="7 LIVES">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME_7"/>
      <!-- Call our custom math-based comma formatter -->
      <column id="SCORE" src="SCORE_7" format="comma_score"/>
    </table>
  </output>

  <!-- Translates the visual row index to 1. - 10. -->
  <format id="ordinal">
    <case src="0" dst="1."/>
    <case src="1" dst="2."/>
    <case src="2" dst="3."/>
    <case src="3" dst="4."/>
    <case src="4" dst="5."/>
    <case src="5" dst="6."/>
    <case src="6" dst="7."/>
    <case src="7" dst="8."/>
    <case src="8" dst="9."/>
    <case src="9" dst="10."/>
  </format>

  <!-- ==========================================
       MANUAL COMMA FORMATTING LOGIC 
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000 -->
    <case src="1000000" operator="&gt;=" format="two_commas"/>
    <!-- If score is >= 1,000 -->
    <case src="1000"    operator="&gt;=" format="one_comma"/>
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"    operator="&lt;"  format="*1" default="yes"/>
  </format>

  <!-- Formats like: 112,300 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Formats like: 1,112,300 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Resolves the Base-40 blank space -->
  <charset id="indytemp_char">
    <char src="0x40" dst=" "/>
  </charset>
</hi2txt>