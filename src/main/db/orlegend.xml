<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    orlegend - Oriental Legend / Xi You Shi E Zhuan (IGS, 1997, PGM)
    .hi via hiscore.dat plugin: @:maincpu,program,811946,d4,49,b0 (212 bytes).
    RANKING = 9 entries x 24 bytes. The last record's trailing 4-byte field is
      truncated at EOF (file 212 = 9*24 - 4; the 0xb0 end gate is the low byte of
      the 9th score 0x36b0=14000), which hi2txt tolerates.
    Record: [NAME 4 ASCII "IGS."][MISC 12 game-state][SCORE 4B big-endian int][TRAIL 4]
  //-->

  <structure file=".hi">
    <check>
      <definition>0:811946:d4:49:b0</definition>
      <size>212</size>
    </check>
    <loop count="9">
      <elt size="4"  type="text" id="NAME"/>
      <elt size="12" type="raw"  id="MISC"/>
      <elt size="4"  type="int"  id="SCORE" endianness="big_endian"/>
      <elt size="4"  type="raw"  id="TRAIL"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>
