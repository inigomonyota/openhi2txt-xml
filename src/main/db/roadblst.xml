<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    roadblst - Road Blasters (Atari, 1987)
    eeprom: 512 bytes, 10 high score entries at offset 0x3C
    Record: 15 bytes = 5B prefix + 2B score (BE) + 2B name (base-40) + 6B suffix
  //-->
  
  <structure file="eeprom">
    <check>
      <size>512</size>
    </check>
    <elt size="60" type="raw" id="HEADER"/>
    <loop count="10">
      <elt size="5" type="raw" id="PREFIX"/>
      <elt size="2" type="int" id="SCORE"/>
      <elt size="2" type="text" id="NAME" decoding-profile="base-40" charset="roadblst"/>
      <elt size="6" type="raw" id="SUFFIX"/>
    </loop>
    <elt size="302" type="raw" id="TAIL"/>
  </structure>
  
  <output>
    <table sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <charset id="roadblst">
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>
