<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Burning Force">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,100171,bb,00,48
                  @:maincpu,program,100175,1,08,08</definition>
      <size>188</size>
    </check>
    <elt size="4" type="raw" id="PAD0"/>
    <elt size="1" type="int" id="TOP_D1"/>
    <elt size="1" type="raw" id="TOP_P1"/>
    <elt size="1" type="int" id="TOP_D2"/>
    <elt size="1" type="raw" id="TOP_P2"/>
    <elt size="1" type="int" id="TOP_D3"/>
    <elt size="1" type="raw" id="TOP_P3"/>
    <elt size="1" type="int" id="TOP_D4"/>
    <elt size="1" type="raw" id="TOP_P4"/>
    <elt size="4" type="raw" id="PAD1"/>
    <loop count="8" skip-last-bytes="5">
      <elt size="1" type="int"  id="D1"/>
      <elt size="1" type="raw"  id="P1"/>
      <elt size="1" type="int"  id="D2"/>
      <elt size="1" type="raw"  id="P2"/>
      <elt size="1" type="int"  id="D3"/>
      <elt size="1" type="raw"  id="P3"/>
      <elt size="1" type="int"  id="D4"/>
      <elt size="1" type="raw"  id="P4"/>
      <elt size="1" type="int"  id="AREA"/>
      <elt size="1" type="raw"  id="P5"/>
      <elt size="1" type="int"  id="STAGE"/>
      <elt size="1" type="raw"  id="P6"/>
      <elt size="1" type="text" id="CHAR1"/>
      <elt size="1" type="raw"  id="P7"/>
      <elt size="1" type="text" id="CHAR2"/>
      <elt size="1" type="raw"  id="P8"/>
      <elt size="1" type="text" id="CHAR3"/>
      <elt size="5" type="raw"  id="P9"/>
    </loop>
    <elt size="1" type="raw" id="SENTINEL"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="NAME"  format="name"/>
      <column id="AREA"/>
      <column id="STAGE"/>
    </table>
    <field id="TOP SCORE" format="top_score"/>
  </output>

  <format id="score">
    <concat>
      <column id="D1"/>
      <column id="D2"/>
      <column id="D3"/>
      <column id="D4"/>
      <txt>0</txt>
    </concat>
  </format>

  <format id="top_score">
    <concat>
      <column id="TOP_D1"/>
      <column id="TOP_D2"/>
      <column id="TOP_D3"/>
      <column id="TOP_D4"/>
      <txt>0</txt>
    </concat>
  </format>

  <format id="name">
    <concat>
      <column id="CHAR1"/>
      <column id="CHAR2"/>
      <column id="CHAR3"/>
    </concat>
  </format>
</hi2txt>
