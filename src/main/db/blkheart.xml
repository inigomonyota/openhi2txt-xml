<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  blkheart: Black Heart

  hiscore file: hiscore/blkheart.hi (4 bytes)
  Single packed-BCD score (8 nibbles). Example bytes: 00 05 05 00 -> 50500.
-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>4</size>
    </check>
    <elt size="4" type="int" id="SCORE" base="16" table-index="0"/>
  </structure>

  <output>
    <table>
      <column id="HI" src="SCORE"/>
    </table>
  </output>

</hi2txt>
