<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    batsuguna (Batsugun)
    hiscore.dat regions: 10109e/04 + 101166/50 + 1011b6/20 + 1010de/30 = 164 bytes
      first 116 bytes hold the visible score data;
      the final 48-byte region (1010de/30) is captured as UNUSED and not displayed.
      source: HiToText
  //-->

  <structure file=".hi">
    <check>
      <size>164</size>
    </check>
    <elt size="4" type="int" id="TOP SCORE" base="16"/>
    <loop count="8">
      <elt size="4" type="int"  id="SCORE" base="16"/>
    </loop>
    <loop count="8">
      <elt size="6" type="text" id="NAME" byte-skip="odd" charset="batsugun" ascii-offset="24"/>
    </loop>
    <loop count="8">
      <elt size="2" type="int" id="STAGE"/>
    </loop>
    <loop count="8">
      <elt size="2" type="int" id="CHARACTER" base="16"/>
    </loop>
    <elt size="48" type="raw" id="UNUSED"/>
  </structure>

  <output>
    <table id="TOP PLAYERS!">
      <column id="RANK" src="index" format="rank"/>
      <column id="CHARACTER" format="character"/>
      <column id="NAME"/>
      <column id="STAGE" format="stage"/>
      <column id="SCORE"/>
    </table>
    <field id="TOP SCORE" display="debug"/>
  </output>

  <format id="rank">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
  </format>
  <format id="character">
    <case src="0" dst="JEENO" default="yes"/>
    <case src="1" dst="BELTIANA"/>
    <case src="2" dst="ICEMAN"/>
  </format>
  <format id="stage">
    <case src="0" dst="-"/>
  </format>

  <charset id="batsugun">
    <char src="0x15" dst="-"/>
    <char src="0x16" dst="."/>
  </charset>
</hi2txt>
