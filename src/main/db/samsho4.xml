<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Samurai Shodown IV">

  <structure file="saveram" byte-swap="2">
    <check><size>65536</size></check>
    <elt size="1055" type="raw" id="_PREFIX"/>

    <loop count="18" skip-last-bytes="1">
      <elt size="3" type="int" id="TIME" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="int" id="CONTINUES" base="16"/>
      <elt size="1" type="raw" id="_PAD"/>
    </loop>

    <loop count="3">
      <elt size="2" type="raw" id="_VS_CHARACTER"/>
      <elt size="2" type="int" id="VS_WINS" endianness="big_endian"/>
    </loop>

    <elt size="64326" type="raw" id="_SUFFIX"/>
  </structure>

  <output>
    <table id="LIGHTNING FAST SWORD MASTER" line-ignore="RANK:14" lines-max="17">
      <column id="CHARACTER" src="index" format="fighter"/>
      <column id="NAME"/>
      <column id="TIME" format="clear_time"/>
      <column id="CONTINUES"/>
      <column id="RANK" src="index" format="+1" display="debug"/>
    </table>

    <!-- VS character/avatar (_VS_CHARACTER byte) is an UNVERIFIED stored-index
         lookup; kept as non-displayed raw for later identification. -->
    <table id="PEERLESS COMPLETE VICTORY" lines-max="3">
      <column id="WINS" src="VS_WINS"/>
      <column id="RANK" src="index" format="+1" display="debug"/>
    </table>
  </output>

  <format id="fighter">
    <case src="0" dst="HAOHMARU"/>
    <case src="1" dst="NAKORURU"/>
    <case src="2" dst="RIMURURU"/>
    <case src="3" dst="HANZO"/>
    <case src="4" dst="GALFORD"/>
    <case src="5" dst="KIYOSHIRO"/>
    <case src="6" dst="UKYO"/>
    <case src="7" dst="GENJURO"/>
    <case src="8" dst="BASARA"/>
    <case src="9" dst="SHIZAMARU"/>
    <case src="10" dst="GAIRA"/>
    <case src="11" dst="SHIRO TOKISADA AMAKUSA"/>
    <case src="12" dst="JUBEI"/>
    <case src="13" dst="ZANKURO MINAZUKI"/>
    <case src="14" dst="CHARLOTTE"/>
    <case src="15" dst="TAM TAM"/>
    <case src="16" dst="KAZUKI"/>
    <case src="17" dst="SOGETSU KAZAMA"/>
  </format>

  <format id="clear_time" input-as-subcolumns-input="yes">
    <concat>
      <column format="d10000;PadL20"/>
      <txt>'</txt>
      <column format="%10000;d100;PadL20"/>
      <txt>''</txt>
      <column format="%100;PadL20"/>
    </concat>
  </format>
</hi2txt>
