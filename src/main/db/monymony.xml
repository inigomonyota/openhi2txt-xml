<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hi2txt>
<hi2txt label="Money Money">
  <structure file=".hi">
    <check><size>75</size></check>
    <loop count="8">
      <elt id="NAME" type="text" size="3" ascii-offset="55" charset="CS_MONYMONY"/>
      <elt id="PAD"  type="raw"  size="3"/>
    </loop>
    <loop count="8">
      <elt id="SCORE" type="int" size="3" base="16"/>
    </loop>
    <elt id="TOP_SCORE" type="int" size="3" base="16"/>
  </structure>

  <charset id="CS_MONYMONY">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
  </charset>

  <format id="RANK_FMT">
    <case src="0" dst="TOP"/>
    <case src="1" dst="2"/>
    <case src="2" dst="3"/>
    <case src="3" dst="4"/>
    <case src="4" dst="5"/>
    <case src="5" dst="6"/>
    <case src="6" dst="7"/>
    <case src="7" dst="8"/>
  </format>

  <output>
    <field id="HIGH SCORE" src="TOP_SCORE" display="extra"/>
    <table id="TODAYS HIGH SCORES" lines-max="8">
      <column id="RANK"  src="index" format="RANK_FMT"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"/>
    </table>
  </output>
</hi2txt>
