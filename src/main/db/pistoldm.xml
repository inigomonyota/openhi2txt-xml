<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Pistol Daimyo no Bouken">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,01f7,23,05,33
                  @:maincpu,program,015c,4,05,00</definition>
      <size>39</size>
    </check>
    <loop count="5">
      <elt size="3" type="int" id="SCORE" base="16"/>
      <elt size="4" type="raw" id="EMPTY"/>
    </loop>
    <elt size="3" type="int" id="TOP SCORE" base="16"/>
    <elt size="1" type="raw" id="EMPTY2"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
    </table>
    <field id="TOP SCORE" display="extra"/>
  </output>
</hi2txt>
