<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  hi2txt description for The Astyanax (astyanax)

  Column names match the default high score table (astyanax.xml):
      GREAT WARRIORS : RANK | SCORE | STAGE | NAME

  This is for a 174-byte hiscore dump. The published HiToText definition is
  for a 167-byte dump: its range starts 7 bytes later, which truncates the
  first score AND flips the byte parity, so it uses byte-skip="odd" where
  this one needs byte-skip="even". The two are not interchangeable.

  SCORE is one decimal digit per byte, not packed bcd:
      00 00 01 02 00 00 00 00   ->  120000
  byte-skip="even" keeps the digit bytes, nibble-skip="odd" drops each
  always-zero high nibble to leave packed bcd, base="16" converts it.

  5 entries of 32 raw bytes:
      [0x00-0x0F]  SCORE      8 digits, one per byte, even offsets
      [0x10-0x11]  STAGE      1 ascii digit
      [0x12-0x17]  NAME       3 ascii chars
      [0x18-0x1F]  RANK TEXT  the NEXT entry's rank label ("2ND", "3RD", ...)

  Trailing 14 bytes: 8 unknown, then the top score as plain ascii "120000".
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>174</size>
    </check>

    <loop count="5">
      <elt size="16" type="int"  id="SCORE" base="16" byte-skip="even" nibble-skip="odd"/>
      <elt size="2"  type="text" id="STAGE"           byte-skip="even"/>
      <elt size="6"  type="text" id="NAME"            byte-skip="even"/>
      <elt size="8"  type="raw"  id="RANK TEXT"/>
    </loop>

    <elt size="8" type="raw"  id="UNKNOWN"/>
    <elt size="6" type="text" id="TOP SCORE"/>
  </structure>

  <output>
    <table id="GREAT WARRIORS - TOP 5">
      <column id="RANK"  src="index" format="rank"/>
      <column id="SCORE" src="SCORE"/>
      <column id="STAGE" src="STAGE"/>
      <column id="NAME"  src="NAME"/>
    </table>

    <field id="TOP SCORE" display="extra"/>
  </output>

  <format id="rank">
    <add>1</add>
    <case src="1" dst="1ST"/>
    <case src="2" dst="2ND"/>
    <case src="3" dst="3RD"/>
    <case src="4" dst="4TH"/>
    <case src="5" dst="5TH"/>
  </format>

</hi2txt>
