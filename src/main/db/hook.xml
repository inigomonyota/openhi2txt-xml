<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  hook - Hook (Irem, 1992)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,ea6ad,f0,00,4f
  240 bytes = 15 entries x 16B (5 characters x 3 each)
  Record (16B): 6B score digits (unpacked BCD, LE digit order: d0-d5) +
                3B pad(00) + 3B name (ASCII) + 4B pad(FF)
  Score = d5 d4 d3 d2 d1 d0 (reversed for display)
  Characters: PETER PAN (1-3), RUFIO (4-6), ACE (7-9), POCKETS (10-12), THUDBUTT (13-15)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>240</size>
    </check>
    <!-- PETER PAN: 3 x 16B -->
    <loop count="3">
      <elt size="1" type="int" id="PD0"/>
      <elt size="1" type="int" id="PD1"/>
      <elt size="1" type="int" id="PD2"/>
      <elt size="1" type="int" id="PD3"/>
      <elt size="1" type="int" id="PD4"/>
      <elt size="1" type="int" id="PD5"/>
      <elt size="3" type="raw" id="PPAD"/>
      <elt size="3" type="text" id="PNAME"/>
      <elt size="4" type="raw" id="PTAIL"/>
    </loop>
    <!-- RUFIO: 3 x 16B -->
    <loop count="3">
      <elt size="1" type="int" id="RD0"/>
      <elt size="1" type="int" id="RD1"/>
      <elt size="1" type="int" id="RD2"/>
      <elt size="1" type="int" id="RD3"/>
      <elt size="1" type="int" id="RD4"/>
      <elt size="1" type="int" id="RD5"/>
      <elt size="3" type="raw" id="RPAD"/>
      <elt size="3" type="text" id="RNAME"/>
      <elt size="4" type="raw" id="RTAIL"/>
    </loop>
    <!-- ACE: 3 x 16B -->
    <loop count="3">
      <elt size="1" type="int" id="AD0"/>
      <elt size="1" type="int" id="AD1"/>
      <elt size="1" type="int" id="AD2"/>
      <elt size="1" type="int" id="AD3"/>
      <elt size="1" type="int" id="AD4"/>
      <elt size="1" type="int" id="AD5"/>
      <elt size="3" type="raw" id="APAD"/>
      <elt size="3" type="text" id="ANAME"/>
      <elt size="4" type="raw" id="ATAIL"/>
    </loop>
    <!-- POCKETS: 3 x 16B -->
    <loop count="3">
      <elt size="1" type="int" id="KD0"/>
      <elt size="1" type="int" id="KD1"/>
      <elt size="1" type="int" id="KD2"/>
      <elt size="1" type="int" id="KD3"/>
      <elt size="1" type="int" id="KD4"/>
      <elt size="1" type="int" id="KD5"/>
      <elt size="3" type="raw" id="KPAD"/>
      <elt size="3" type="text" id="KNAME"/>
      <elt size="4" type="raw" id="KTAIL"/>
    </loop>
    <!-- THUDBUTT: 3 x 16B -->
    <loop count="3">
      <elt size="1" type="int" id="TD0"/>
      <elt size="1" type="int" id="TD1"/>
      <elt size="1" type="int" id="TD2"/>
      <elt size="1" type="int" id="TD3"/>
      <elt size="1" type="int" id="TD4"/>
      <elt size="1" type="int" id="TD5"/>
      <elt size="3" type="raw" id="TPAD"/>
      <elt size="3" type="text" id="TNAME"/>
      <elt size="4" type="raw" id="TTAIL"/>
    </loop>
  </structure>

  <output>
    <table id="BEST 3 PLAYERS - PETER PAN">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="PNAME"/>
      <column id="SCORE" src="PD5" format="score_peter"/>
    </table>
    <table id="BEST 3 PLAYERS - RUFIO">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="RNAME"/>
      <column id="SCORE" src="RD5" format="score_rufio"/>
    </table>
    <table id="BEST 3 PLAYERS - ACE">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="ANAME"/>
      <column id="SCORE" src="AD5" format="score_ace"/>
    </table>
    <table id="BEST 3 PLAYERS - POCKETS">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="KNAME"/>
      <column id="SCORE" src="KD5" format="score_pockets"/>
    </table>
    <table id="BEST 3 PLAYERS - THUDBUTT">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="TNAME"/>
      <column id="SCORE" src="TD5" format="score_thudbutt"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
  </format>

  <format id="score_peter" input-as-subcolumns-input="yes">
    <concat>
      <column src="PD5"/>
      <column src="PD4"/>
      <column src="PD3"/>
      <column src="PD2"/>
      <column src="PD1"/>
      <column src="PD0"/>
    </concat>
  </format>

  <format id="score_rufio" input-as-subcolumns-input="yes">
    <concat>
      <column src="RD5"/>
      <column src="RD4"/>
      <column src="RD3"/>
      <column src="RD2"/>
      <column src="RD1"/>
      <column src="RD0"/>
    </concat>
  </format>

  <format id="score_ace" input-as-subcolumns-input="yes">
    <concat>
      <column src="AD5"/>
      <column src="AD4"/>
      <column src="AD3"/>
      <column src="AD2"/>
      <column src="AD1"/>
      <column src="AD0"/>
    </concat>
  </format>

  <format id="score_pockets" input-as-subcolumns-input="yes">
    <concat>
      <column src="KD5"/>
      <column src="KD4"/>
      <column src="KD3"/>
      <column src="KD2"/>
      <column src="KD1"/>
      <column src="KD0"/>
    </concat>
  </format>

  <format id="score_thudbutt" input-as-subcolumns-input="yes">
    <concat>
      <column src="TD5"/>
      <column src="TD4"/>
      <column src="TD3"/>
      <column src="TD2"/>
      <column src="TD1"/>
      <column src="TD0"/>
    </concat>
  </format>

</hi2txt>
