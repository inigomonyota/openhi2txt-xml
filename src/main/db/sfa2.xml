<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  sfa2 - Street Fighter Alpha 2 (Capcom, 1996)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat: @:maincpu,program,ffdf6a,b0,00,00 (extended from ad)
  176 bytes = 11 entries x 16 bytes
  Score Ranking: 6 entries (game shows 5, stores 6)
  VS Ranking: 5 entries
  Record: 4B score (BCD) + 3B name (A=0) + 9B metadata
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>176</size>
    </check>
    <!-- Score Ranking: 6 entries x 16 bytes -->
    <loop count="6">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="SNAME" charset="sfa2"/>
      <elt size="1" type="raw" id="SPAD1"/>
      <elt size="1" type="int" id="SCHAR"/>
      <elt size="7" type="raw" id="SPAD2"/>
    </loop>
    <!-- VS Ranking: 5 entries x 16 bytes -->
    <loop count="5">
      <elt size="4" type="int" id="VPTS" base="16"/>
      <elt size="3" type="text" id="VNAME" charset="sfa2"/>
      <elt size="1" type="raw" id="VPAD1"/>
      <elt size="1" type="int" id="VCHAR"/>
      <elt size="3" type="raw" id="VPAD2"/>
      <elt size="1" type="int" id="WINS"/>
      <elt size="3" type="raw" id="VPAD3"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING" sort="SCORE" sort-order="desc" lines-max="5">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="SNAME"/>
      <column id="SCORE"/>
      <column id="CHARACTER" src="SCHAR" format="charname"/>
    </table>
    <table id="VS RANKING" sort="VPTS" sort-order="desc" lines-max="5">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="VNAME"/>
      <column id="WINS"/>
      <column id="PTS" src="VPTS"/>
      <column id="CHARACTER" src="VCHAR" format="charname"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="charname">
    <case src="1" operator="&lt;" dst="RYU"/>
    <case src="2" operator="&lt;" dst="KEN"/>
    <case src="3" operator="&lt;" dst="AKUMA"/>
    <case src="4" operator="&lt;" dst="CHARLIE"/>
    <case src="5" operator="&lt;" dst="CHUN-LI"/>
    <case src="6" operator="&lt;" dst="ADON"/>
    <case src="7" operator="&lt;" dst="SODOM"/>
    <case src="8" operator="&lt;" dst="GUY"/>
    <case src="9" operator="&lt;" dst="BIRDIE"/>
    <case src="10" operator="&lt;" dst="ROSE"/>
    <case src="11" operator="&lt;" dst="M.BISON"/>
    <case src="12" operator="&lt;" dst="SAGAT"/>
    <case src="13" operator="&lt;" dst="DAN"/>
    <case src="14" operator="&lt;" dst="SAKURA"/>
    <case src="15" operator="&lt;" dst="ROLENTO"/>
    <case src="16" operator="&lt;" dst="DHALSIM"/>
    <case src="17" operator="&lt;" dst="ZANGIEF"/>
    <case src="18" operator="&lt;" dst="GEN"/>
    <case src="19" operator="&lt;" dst="EVIL RYU"/>
    <case src="20" operator="&lt;" dst="SHIN AKUMA"/>
  </format>

  <charset id="sfa2">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
  </charset>

</hi2txt>