<?xml version="1.0" encoding="UTF-8"?>
<hi2txt>
<!-- Sengoku 2 (Neo Geo, saveram). 68000 => byte-swap="2".
     RANKING table @ raw 0x325, 10 records x 8 bytes:
       [0:3] SCORE 3-byte packed BCD  (score precedes name here; cf. sengoku, name-first)
       [3:6] NAME  3 ASCII chars (spaces significant, e.g. " X ")
       [6:8] 20 00 (trailing name-pad space + 00); not displayed
     NOTE: file is authoritative - rank 7 NAME=NEO SCORE=21800 (bytes 02 18 00, verified raw
     and swapped); the reference XML shows 27800 (a 1->7 transcription typo). File wins. -->
<structure file="saveram" byte-swap="2">
  <check>
    <size>65536</size>
  </check>
  <elt size="805" type="raw" id="HEADER"/>
  <loop count="10">
    <elt size="3" type="int"  id="SCORE" base="16"/>
    <elt size="3" type="text" id="NAME"/>
    <elt size="2" type="raw"  id="PAD"/>
  </loop>
</structure>

<format id="rank">
  <case src="0" dst="1ST"/>
  <case src="1" dst="2ND"/>
  <case src="2" dst="3RD"/>
  <case src="3" dst="4TH"/>
  <case src="4" dst="5TH"/>
  <case src="5" dst="6TH"/>
  <case src="6" dst="7TH"/>
  <case src="7" dst="8TH"/>
  <case src="8" dst="9TH"/>
  <case src="9" dst="10TH"/>
</format>

<output>
  <table id="RANKING">
    <column id="RANK"  src="index" format="rank"/>
    <column id="NAME"/>
    <column id="SCORE"/>
  </table>
</output>
</hi2txt>
