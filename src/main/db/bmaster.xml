<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 128 bytes = 8 entries x 16 bytes
    per entry (16 bytes):
      [0:2]  score, 2-byte LE int (* 100 = display score)
      [2:6]  00 00 00 00 pad
      [6:9]  name, 3-byte ASCII (spaces = blank entry)
      [9]    0x20 pad
      [10]   player: 0x00 = P1 (purple), 0x01 = P2 (teal)
      [11:16] FF FF 00 00 00 for valid entries, 00s for extras
    entries 7-8 are extra default slots; lines-max=6 hides them
  //-->

  <structure file=".hi">
    <check>
      <size>128</size>
    </check>
    <loop count="8">
      <elt size="2" type="int"  id="SCORE" endianness="little_endian"/>
      <elt size="4" type="raw"  id="PAD1"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="1" type="int"  id="PLAYER"/>
      <elt size="5" type="raw"  id="PAD3"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING" lines-max="6">
      <column id="RANK"   src="index" format="NO.+1"/>
      <column id="SCORE"  format="*100"/>
      <column id="NAME"   format="TrimR "/>
      <column id="PLAYER" format="character"/>
    </table>
  </output>

  <format id="NO.+1"><add>1</add><prefix>NO. </prefix></format>
  <format id="character">
    <case src="0" dst="ROY"/>
    <case src="1" dst="ARNOLD"/>
  </format>

</hi2txt>