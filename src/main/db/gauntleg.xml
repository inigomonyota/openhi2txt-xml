<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    gauntleg  (Gauntlet Legends, Atari Games 1998, "vegas" hardware, MIPS R5000).

    Gauntlet Legends does NOT keep its high-score table in the battery nvram.
    The two nvram files are a tiny M48T37 timekeeper (RTC clock + a ~0x90-byte
    config block, the rest 0xff) and an all-0xff ioasic block - neither holds
    the chart. The real RECORDS table persists on the CHD hard disk and is
    mirrored into MIPS work RAM while the game runs. This definition therefore
    decodes a 960-byte .hi lifted from the live work-RAM table (captured from a
    MAME save state, the same technique used for starglad), verified against the
    in-game RECORDS screen (snap 0000).

    The RECORDS screen shows FOUR scrolls, one per playable class, in this
    stored order: WIZARDS, VALKYRIES, WARRIORS, ARCHERS. Each scroll holds 10
    entries (the on-screen rank number is only painted on some rows; entries are
    stored and ranked top-to-bottom, so RANK here is the stored position 1..10).

    RECORD = 24 bytes, every field 32-bit LITTLE-endian:
      +0  LEVEL        u32  character level reached (1..99)
      +4  SCORE        u32  internal ranking score (NOT shown on the scroll)
      +8  COMPLETIONS  u32  times the player has fully completed the game. On
                           screen this is the skull avatar on the right of the
                           row: 0 = none (no skull), 1 = a lone skull (beaten
                           once, no number), 2 = skull "x2", 3 = skull "x3" ...
                           (up to x8 observed). Exposed as its own COMPLETED GAME
                           column.
      +12 NAME         3 bytes ASCII initials + 1 nul. An un-entered initial is
                           an underscore 0x5f (e.g. "BO_" shows as "BO"); the
                           charset maps 0x5f to blank.
      +16 P            4 bytes, a 3-ASCII-digit code + nul (e.g. "666","420",
                           "___" for empty) - not shown on the scroll, kept as a
                           debug column.
      +20 Q            4 bytes u32, small bookkeeping value - not shown, debug.

    Decodes the captured table byte-perfect: e.g. WIZARDS 1 JLG Level76 skull x2,
    3 KEN Level59 (no skull); ARCHERS 1 BO Level99 skull x8, 5 SJC Level99 lone
    skull. Authored by the HI2TXT project (gauntleg support).

    NOTE the COMPLETED GAME marker uses "}" which is the star glyph in the
    CoinOPS hiscore font; swap it for a dedicated skull glyph if one is added.
  //-->

  <structure file=".hi">
    <check>
      <size>960</size>
    </check>
    <loop count="10">
      <elt size="4" type="int"  id="W_LEVEL" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="W_SCORE" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="W_COMP"  endianness="little_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="W_NAME"  charset="csgl" table-index="loop_index"/>
      <elt size="1" type="raw"  id="W_NUL"/>
      <elt size="4" type="raw"  id="W_P"/>
      <elt size="4" type="raw"  id="W_Q"/>
    </loop>
    <loop count="10">
      <elt size="4" type="int"  id="V_LEVEL" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="V_SCORE" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="V_COMP"  endianness="little_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="V_NAME"  charset="csgl" table-index="loop_index"/>
      <elt size="1" type="raw"  id="V_NUL"/>
      <elt size="4" type="raw"  id="V_P"/>
      <elt size="4" type="raw"  id="V_Q"/>
    </loop>
    <loop count="10">
      <elt size="4" type="int"  id="R_LEVEL" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="R_SCORE" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="R_COMP"  endianness="little_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="R_NAME"  charset="csgl" table-index="loop_index"/>
      <elt size="1" type="raw"  id="R_NUL"/>
      <elt size="4" type="raw"  id="R_P"/>
      <elt size="4" type="raw"  id="R_Q"/>
    </loop>
    <loop count="10">
      <elt size="4" type="int"  id="A_LEVEL" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="A_SCORE" endianness="little_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="A_COMP"  endianness="little_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="A_NAME"  charset="csgl" table-index="loop_index"/>
      <elt size="1" type="raw"  id="A_NUL"/>
      <elt size="4" type="raw"  id="A_P"/>
      <elt size="4" type="raw"  id="A_Q"/>
    </loop>
  </structure>

  <output>
    <table id="WIZARDS">
      <column id="RANK"          src="index" format="rank"/>
      <column id="NAME"          src="W_NAME"/>
      <column id="LEVEL"         src="W_LEVEL"/>
      <column id="COMPLETED GAME" src="W_COMP" format="completed"/>
      <column id="SCORE"         src="W_SCORE" display="debug"/>
      <column id="P"             src="W_P" format="0x" display="debug"/>
      <column id="Q"             src="W_Q" format="0x" display="debug"/>
    </table>
    <table id="VALKYRIES">
      <column id="RANK"          src="index" format="rank"/>
      <column id="NAME"          src="V_NAME"/>
      <column id="LEVEL"         src="V_LEVEL"/>
      <column id="COMPLETED GAME" src="V_COMP" format="completed"/>
      <column id="SCORE"         src="V_SCORE" display="debug"/>
      <column id="P"             src="V_P" format="0x" display="debug"/>
      <column id="Q"             src="V_Q" format="0x" display="debug"/>
    </table>
    <table id="WARRIORS">
      <column id="RANK"          src="index" format="rank"/>
      <column id="NAME"          src="R_NAME"/>
      <column id="LEVEL"         src="R_LEVEL"/>
      <column id="COMPLETED GAME" src="R_COMP" format="completed"/>
      <column id="SCORE"         src="R_SCORE" display="debug"/>
      <column id="P"             src="R_P" format="0x" display="debug"/>
      <column id="Q"             src="R_Q" format="0x" display="debug"/>
    </table>
    <table id="ARCHERS">
      <column id="RANK"          src="index" format="rank"/>
      <column id="NAME"          src="A_NAME"/>
      <column id="LEVEL"         src="A_LEVEL"/>
      <column id="COMPLETED GAME" src="A_COMP" format="completed"/>
      <column id="SCORE"         src="A_SCORE" display="debug"/>
      <column id="P"             src="A_P" format="0x" display="debug"/>
      <column id="Q"             src="A_Q" format="0x" display="debug"/>
    </table>
  </output>

  <format id="rank">
    <case src="0" dst="1"/>
    <case src="1" dst="2"/>
    <case src="2" dst="3"/>
    <case src="3" dst="4"/>
    <case src="4" dst="5"/>
    <case src="5" dst="6"/>
    <case src="6" dst="7"/>
    <case src="7" dst="8"/>
    <case src="8" dst="9"/>
    <case src="9" dst="10"/>
  </format>

  <format id="completed">
    <case src="0" dst=""/>
    <case src="1" dst="}"/>
    <case src="2" dst="}x2"/>
    <case src="3" dst="}x3"/>
    <case src="4" dst="}x4"/>
    <case src="5" dst="}x5"/>
    <case src="6" dst="}x6"/>
    <case src="7" dst="}x7"/>
    <case src="8" dst="}x8"/>
    <case src="9" dst="}x9"/>
    <case src="10" dst="}x10"/>
  </format>

  <charset id="csgl">
    <char src="0x5f" dst=""/>
  </charset>
</hi2txt>
