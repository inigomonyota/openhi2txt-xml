<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>156</size></check>
    
    <elt size="3" type="raw" id="TOP_SCORE"/>
    
    <loop count="10" skip-last-bytes="7">
      <elt size="3" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      
      <!-- CHANGED TO "odd" so we keep 1C 1E 08 and throw away 00 00 00 -->
      <elt size="6" type="text" id="NAME" byte-skip="odd" charset="mechatt_char"/>
      
      <elt size="7" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="BEST PLAYERS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME" format="add_dashes"/>
      <column id="SCORE" src="SCORE" format="*10"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>
  
  <format id="add_dashes">
    <suffix>----</suffix>
  </format>

  <charset id="mechatt_char">
    <char src="0x00" dst="A"/>
    <char src="0x02" dst="B"/>
    <char src="0x04" dst="C"/>
    <char src="0x06" dst="D"/>
    <char src="0x08" dst="E"/>
    <char src="0x0A" dst="F"/>
    <char src="0x0C" dst="G"/>
    <char src="0x0E" dst="H"/>
    <char src="0x10" dst="I"/>
    <char src="0x12" dst="J"/>
    <char src="0x14" dst="K"/>
    <char src="0x16" dst="L"/>
    <char src="0x18" dst="M"/>
    <char src="0x1A" dst="N"/>
    <char src="0x1C" dst="O"/>
    <char src="0x1E" dst="P"/>
    <char src="0x20" dst="Q"/>
    <char src="0x22" dst="R"/>
    <char src="0x24" dst="S"/>
    <char src="0x26" dst="T"/>
    <char src="0x28" dst="U"/>
    <char src="0x2A" dst="V"/>
    <char src="0x2C" dst="W"/>
    <char src="0x2E" dst="X"/>
    <char src="0x30" dst="Y"/>
    <char src="0x32" dst="Z"/>
    <char src="0xFF" dst="?" default="yes"/>
  </charset>
</hi2txt>