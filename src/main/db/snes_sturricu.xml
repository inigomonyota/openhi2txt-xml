<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Super Turrican">
  <!--
    SNES / Super Turrican (softlist: sturricu, "Super Turrican (USA)"). Launch:
    mame64.exe snes sturricu.

    This game has no native persistent high-score table (no nvram/battery). It only
    keeps the CURRENT run's score, shown on the GAME OVER (and ending "FINAL SCORE")
    screen. To capture it, a hiscore.dat entry snapshots the live score from 5A22
    work RAM so the MAME hiscore plugin writes it to hiscore/snes_sturricu.hi on exit:

        snes,sturricu:
        @delay=2
        @:maincpu,program,7e0581,06,00,00

    The score is stored as 6 UNPACKED decimal digits, one digit per byte (values
    0x00-0x09), most-significant digit first, at WRAM 0x7e0581 (default 000000, all
    zero at boot - so the 00,00 check matches; a shadow copy sits at 0x7f000d and an
    ASCII "SCORE 004200" display buffer at 0x7e2448). The plugin .hi is therefore
    exactly 6 bytes = the six digit bytes.

    This definition reads that 6-byte .hi: the digit bytes are rendered directly as
    text via a 0x00-0x09 -> '0'-'9' charset, giving e.g. "004200".
  //-->
  <structure file=".hi">
    <check>
      <size>6</size>
    </check>
    <elt size="6" type="text" charset="digit" id="SCORE"/>
  </structure>

  <output>
    <table id="SCORE FROM LAST PLAY">
      <column id="SCORE" src="SCORE"/>
    </table>
  </output>

  <charset id="digit">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
  </charset>
</hi2txt>
