<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- gtmrusa by Kaneko, 1994 -->
<!-- hiscore.dat: @:maincpu,program,1035fa,19e,59,80 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>414</size>
    </check>

    <!-- The file contains several blocks representing different stages/courses. -->
    <!-- Each record is 4 bytes: 2 (Time BCD) + 1 (Pad) + 1 (Car ID) -->
    <!-- We extract 100 records to cover the 415-byte file (100 * 4 = 400 bytes) -->
    <loop count="100">
      <elt size="2" type="int" id="TIME" base="16"/>
      <elt size="1" type="raw" id="PAD"/>
      <elt size="1" type="int" id="CAR"/>
    </loop>
  </structure>

  <output>
    <!-- We filter out the 'marker' bytes (where Time is 0) using line-ignore -->
    <table id="TOP TIMES" line-ignore="TIME:0">
      <column id="RANK"  src="unsorted_index" format="rank_reset"/>
      <column id="TIME"  src="TIME"           format="time_format"/>
      <column id="CAR"   src="CAR"            format="car_map"/>
    </table>
  </output>

  <!-- Resets the rank display for every block of 8 entries -->
  <format id="rank_reset">
    <remainder>8</remainder>
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
  </format>

  <!-- Standard Ordinal Format -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- Transforms BCD 5910 into 59'10'' -->
  <format id="time_format" input-as-subcolumns-input="yes">
    <concat>
      <column format="d100"/>
      <txt>'</txt>
      <column format="%100;PadL20"/>
      <txt>''</txt>
    </concat>
  </format>

  <format id="car_map">
    <case src="8" dst="FERRARI 250 GTO"/>
    <case src="7" dst="MERCEDES BENZ 300SLR"/>
    <case src="6" dst="MERCEDES BENZ 55KL"/>
    <case src="5" dst="BUGATTI T59"/>
    <case src="4" dst="ALFA ROMEO 8C 2300"/>
    <case src="3" dst="ALFA ROMEO GIULIETTA SZ"/>
    <case src="2" dst="JAGUAR D-TYPE"/>
    <case src="1" dst="PORSCHE 550RS"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>