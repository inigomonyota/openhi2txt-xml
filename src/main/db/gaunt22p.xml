<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    gaunt22p - Gauntlet II (2 Players, rev 2) (Atari, 1986)
    .hi file format (via hiscore.dat plugin)
    Same RAM layout as gauntlet/gaunt2p: 2B level + 4x(10x(3B score + 2B name))
    Names use base-40 packing with ascii-offset 64
    Add gaunt22p to hiscore.dat under gaunt2p entry to generate .hi files
  //-->
  
  <structure file=".hi">
    <check>
      <definition>0:904010:2:00:07
                  0:904DE8:C8:00:50</definition>
      <size>202</size>
    </check>
    <elt size="2" type="int" id="LAST LEVEL PLAYED"/>
    <loop count="10">
      <elt size="3" type="int" id="WARRIORS SCORE"/>
      <elt size="2" type="text" id="WARRIORS NAME" decoding-profile="base-40" charset="gaunt22p"/>
    </loop>
    <loop count="10">
      <elt size="3" type="int" id="VALKYRIES SCORE"/>
      <elt size="2" type="text" id="VALKYRIES NAME" decoding-profile="base-40" charset="gaunt22p"/>
    </loop>
    <loop count="10">
      <elt size="3" type="int" id="WIZARDS SCORE"/>
      <elt size="2" type="text" id="WIZARDS NAME" decoding-profile="base-40" charset="gaunt22p"/>
    </loop>
    <loop count="10">
      <elt size="3" type="int" id="ELVES SCORE"/>
      <elt size="2" type="text" id="ELVES NAME" decoding-profile="base-40" charset="gaunt22p"/>
    </loop>
  </structure>
  
  <output>
    <table id="WARRIORS">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="WARRIORS SCORE"/>
      <column id="NAME" src="WARRIORS NAME"/>
    </table>
    <table id="VALKYRIES">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="VALKYRIES SCORE"/>
      <column id="NAME" src="VALKYRIES NAME"/>
    </table>
    <table id="WIZARDS">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="WIZARDS SCORE"/>
      <column id="NAME" src="WIZARDS NAME"/>
    </table>
    <table id="ELVES">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="ELVES SCORE"/>
      <column id="NAME" src="ELVES NAME"/>
    </table>
    <field id="LAST LEVEL PLAYED" display="extra"/>
  </output>

  <charset id="gaunt22p">
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>
