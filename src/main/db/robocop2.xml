<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="RoboCop 2">
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 83 bytes total
      [0:40]   10 name entries x 4 bytes: 3 ASCII chars + null
      [40:80]  10 score entries x 4 bytes: 3-byte BCD big-endian (base16) + null
      [80:83]  3-byte top score BCD (truncated, no null)
    name charset: standard ASCII stored; game displays via 7-segment font
                  (e.g. '!' renders as '1', '9' as '9', etc.)
  //-->

  <structure file=".hi">
    <check>
      <size>83</size>
    </check>
    <loop count="10">
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="NAME_NULL"/>
    </loop>
    <loop count="10">
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="raw"  id="SCORE_NULL"/>
    </loop>
    <elt size="3" type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table id="THE BEST LAW ENFORCERS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"/>
      <column id="SCORE"/>
    </table>
    <field id="TOP SCORE" display="extra"/>
  </output>

  <format id="ordinal">
    <case src="0" dst="1"/>
    <case src="1" dst="2"/>
    <case src="2" dst="3"/>
    <case src="3" dst="4"/>
    <case src="4" dst="5"/>
    <case src="5" dst="6"/>
    <case src="6" dst="7"/>
    <case src="7" dst="8"/>
    <case src="8" dst="9"/>
    <case src="9" dst="10"/>
  </format>

</hi2txt>