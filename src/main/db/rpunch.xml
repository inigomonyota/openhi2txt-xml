<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Ring Punch">
  <!--
    hiscore.dat (updated):
      @:maincpu,program,ffe01,73,00,17
      @:maincpu,program,ffe74,5,80,00
    Together: 120 bytes = 10 x 12 bytes (complete entries)
    Entry: 3-byte BCD score (stored/100, display *100) + 1-byte stage
           + 3-byte tile name + 5-byte pad (80 80 80 80 00)
    Charset: A=0x0a (ascii-offset=55)
      Special: 0x24='.', 0x80=space, 0x28=unknown
  //-->

  <structure file=".hi">
    <check>
      <size>120</size>
    </check>
    <loop count="10">
      <elt size="3" type="int"  id="SCORE" base="16" table-index="loop_index"/>
      <elt size="1" type="int"  id="STAGE" table-index="loop_index"/>
      <elt size="3" type="text" id="NAME"  charset="CS_RPUNCH" ascii-offset="55" table-index="loop_index"/>
      <elt size="5" type="raw"  id="PAD"   table-index="loop_index"/>
    </loop>
  </structure>

  <structure file=".hi">
    <check>
      <size>115</size>
    </check>
    <loop count="9">
      <elt size="3" type="int"  id="SCORE" base="16" table-index="loop_index"/>
      <elt size="1" type="int"  id="STAGE" table-index="loop_index"/>
      <elt size="3" type="text" id="NAME"  charset="CS_RPUNCH" ascii-offset="55" table-index="loop_index"/>
      <elt size="5" type="raw"  id="PAD"   table-index="loop_index"/>
    </loop>
    <elt size="3" type="int"  id="SCORE" base="16" table-index="9"/>
    <elt size="1" type="int"  id="STAGE" table-index="9"/>
    <elt size="3" type="text" id="NAME"  charset="CS_RPUNCH" ascii-offset="55" table-index="9"/>
  </structure>

  <output>
    <table id="SCORE RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="*100"/>
      <column id="STAGE"/>
      <column id="NAME"  format="TrimR "/>
    </table>
  </output>

  <format id="+1">
    <case src="0" dst="1:"/>
    <case src="1" dst="2:"/>
    <case src="2" dst="3:"/>
    <case src="3" dst="4:"/>
    <case src="4" dst="5:"/>
    <case src="5" dst="6:"/>
    <case src="6" dst="7:"/>
    <case src="7" dst="8:"/>
    <case src="8" dst="9:"/>
    <case src="9" dst="10:"/>
  </format>
  <format id="*100"><multiply>100</multiply></format>

  <charset id="CS_RPUNCH">
    <char src="0x24" dst="."/>
    <char src="0x80" dst=" "/>
  </charset>

</hi2txt>