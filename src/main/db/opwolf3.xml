<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<hi2txt label="Introduce Rankers">
  <!--
    NVRAM file: mk48t08
    Total size: 8192 bytes

    High-score table:
      Offset:      0x003f
      Entries:     5
      Record size: 18 bytes

    Record layout:
      +0x00  3 bytes  packed-decimal score
      +0x03  3 bytes  initials
      +0x06  2 bytes  unknown
      +0x08  1 byte   internal scene value
      +0x09  9 bytes  unknown

    Internal scene values:
      0x00 = Scene 1
      0x02 = Scene 2
      0x03 = Scene 3
      0x05 = Scene 4
      0x06 = Scene 5
  //-->

  <structure file="mk48t08">
    <check>
      <size>8192</size>
    </check>

    <!-- Skip to the table at 0x003f. -->
    <elt size="63" type="raw" id="HEADER"/>

    <loop count="5">
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME" charset="rankers"/>
      <elt size="2" type="raw"  id="UNKNOWN1"/>
      <elt size="1" type="int"  id="SCENE"/>
      <elt size="9" type="raw"  id="UNKNOWN2"/>
    </loop>

    <!-- Remaining bytes after offset 0x0099. -->
    <elt size="8039" type="raw" id="REMAINDER"/>
  </structure>

  <output>
    <table id="RANKERS">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="NAME"/>
      <column id="SCORE" src="SCORE"/>
      <column id="SCENE" src="SCENE" format="scene"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <format id="scene">
    <case src="0" dst="1"/>
    <case src="2" dst="2"/>
    <case src="3" dst="3"/>
    <case src="5" dst="4"/>
    <case src="6" dst="5"/>
    <case src="0" dst="" default="yes"/>
  </format>

  <charset id="rankers">
    <char src="0xa5" dst="."/>
  </charset>
</hi2txt>