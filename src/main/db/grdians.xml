<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 75 bytes = 5 entries x 16 bytes, skip-last-bytes=5
    per entry (16 bytes):
      [0:3]  score, 3-byte big-endian integer
      [3:7]  name, 4-byte ASCII, null/space padded (TrimR)
      [7]    1 byte raw (zero)
      [8]    character index, 1-byte integer
      [9]    1 byte raw (zero)
      [10]   stage reached, 1-byte integer
      [11:16] 5 bytes raw (zeros)
    score displayed as 7 digits (PadL70), stage as 2 digits (PadL20)
  //-->

  <structure file=".hi">
    <check>
      <size>75</size>
    </check>
    <loop count="5" skip-last-bytes="5">
      <elt size="3"  type="int"  id="SCORE"/>
      <elt size="4"  type="text" id="NAME"/>
      <elt size="1"  type="raw"  id="PAD1"/>
      <elt size="1"  type="int"  id="CHARACTER"/>
      <elt size="1"  type="raw"  id="PAD2"/>
      <elt size="1"  type="int"  id="STAGE"/>
      <elt size="5"  type="raw"  id="PAD3"/>
    </loop>
  </structure>

  <output>
    <table id="TODAYS HI-SCORE">
      <column id="RANK"      src="index" format="ordinal"/>
      <column id="SCORE"     format="PadL70"/>
      <column id="STAGE"     format="PadL20"/>
      <column id="NAME"      format="TrimR "/>
     <!-- <column id="CHARACTER" format="character"/> -->
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <format id="character">
    <case src="0" dst="0"/>
    <case src="1" dst="1"/>
    <case src="2" dst="2"/>
    <case src="3" dst="3"/>
  </format>

</hi2txt>