<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Ryujin">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,403e3c,63,54,01
                  @:maincpu,program,403f20,4,00,00</definition>
      <size>103</size>
    </check>
    <loop count="10" skip-last-bytes="1">
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD"/>
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="int"  id="STAGE"/>
      <elt size="1" type="raw"  id="SHIP"/>
    </loop>
    <elt size="4" type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="STAGE"/>
    </table>
    <field id="TOP SCORE"/>
  </output>
</hi2txt>
