<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Thunder Dragon 2">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,1ff101,6b,18,00</definition>
      <size>107</size>
    </check>
    <loop count="9" skip-last-bytes="1">
      <elt size="1" type="text" id="CHAR1" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="1" type="text" id="CHAR2" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="1" type="text" id="CHAR3" ascii-offset="65"/>
      <elt size="2" type="raw"  id="PAD3"/>
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="raw"  id="PAD4"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"  format="name"/>
    </table>
  </output>

  <format id="name">
    <concat>
      <column id="CHAR1"/>
      <column id="CHAR2"/>
      <column id="CHAR3"/>
    </concat>
  </format>
</hi2txt>
