<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Virtua Cop">
  <!--
    Sega Model 2, file=backup1, NO byte-swap, little-endian.
    (The 128B ioboard_eeprom is settings only.)
    RANKING @ 0x208 (after a "sega" block header @0x200), 10 x 16B:
      [SCORE:4 int LE][CHAR1:4 LE idx][CHAR2:4 LE idx][CHAR3:4 LE idx].
    Each name char is a 4-byte LE index, A=0 (I=8,T=19,A=0 -> "ITA").
    NAME read via byte-skip="1000" (keep the low index byte of each 4-byte field)
    + ascii-offset="65".
  //-->

  <structure file="backup1">
    <check>
      <size>16384</size>
    </check>
    <elt size="520" type="raw" id="HEADER"/>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" endianness="little_endian"/>
      <elt size="12" type="text" id="NAME"  byte-skip="1000" ascii-offset="65"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
</hi2txt>
