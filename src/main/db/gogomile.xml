<?xml version="1.0"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="go go! mile smile">
    <!--
      tested with mame 0.277 and related hiscore.dat
      source: Danz83
    //-->

    <structure file=".hi">
        <check>
          <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure versus the provided file //-->
          <definition>@:maincpu,program,40660d,161,01,14
                      @:maincpu,program,4066cf,1,05,05</definition>
          <!-- optional: if defined, it allows to select the good structure versus the provided file
                         useful if multiple structures are defined but hiscore.dat not provided //-->
          <size>354</size>
        </check>
        <loop count="5">
            <elt id="singles_score" size="3" type="int"/>
            <elt id="skip_score" size="1" type="raw"/>
        </loop>
        <loop count="5">
            <elt id="singles_stage" size="1" type="int"/>
            <elt id="skip_stage" size="1" type="raw"/>
        </loop>
        <loop count="5">
            <elt id="singles_name" size="6" type="text" byte-skip="even" charset="gogo_alpha"/>
            <elt id="skip_name_pad" size="2" type="raw"/>
        </loop>
        <elt id="skip_singles_dup" size="40" type="raw"/>

        <elt id="gap" size="56" type="raw"/>

        <loop count="5">
            <elt id="doubles_score" size="3" type="int"/>
            <elt id="skip_dscore" size="1" type="raw"/>
        </loop>
        <loop count="5">
            <elt id="doubles_stage" size="1" type="int"/>
            <elt id="skip_dstage" size="1" type="raw"/>
        </loop>
        <loop count="5">
            <elt id="doubles_name_p1" size="6" type="text" byte-skip="even" charset="gogo_alpha"/>
            <elt id="skip_doubles_p1_pad" size="2" type="raw"/>
        </loop>
        <elt id="skip_doubles_p1_dup" size="40" type="raw"/>
        
        <loop count="5">
            <elt id="doubles_name_p2" size="6" type="text" byte-skip="even" charset="gogo_alpha"/>
            <elt id="skip_doubles_p2_pad" size="2" type="raw"/>
        </loop>
        <elt id="skip_doubles_p2_dup" size="38" type="raw"/>
    </structure>

    <output>
        <table id="SINGLES">
            <column id="RANK" src="index" format="+1"/>
            <column id="SCORE" src="singles_score"/>
            <column id="STAGE" src="singles_stage"/>
            <column id="NAME" src="singles_name"/>
        </table>
        
        <table id="DOUBLES">
            <column id="RANK" src="index" format="+1"/>
            <column id="SCORE" src="doubles_score"/>
            <column id="STAGE" src="doubles_stage"/>
            <column id="NAME P1" src="doubles_name_p1"/>
            <column id="NAME P2" src="doubles_name_p2"/>
        </table>
    </output>

    <format id="+1">
        <add>1</add>
    </format>

    <charset id="gogo_alpha">
        <char src="00" dst=" "/>
        <char src="01" dst="A"/>
        <char src="02" dst="B"/>
        <char src="03" dst="C"/>
        <char src="04" dst="D"/>
        <char src="05" dst="E"/>
