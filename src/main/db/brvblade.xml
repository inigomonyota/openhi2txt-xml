<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <!--
    brvblade - Brave Blade (Raizing / Eighting, 2000)
    Reads the MAME EEPROM file (nvram/brvblade/at28c16), 2080 bytes.

    RANKING table: 10 records x 12 bytes, starting at offset 0x00C8.
    Record layout:
      [0:4]  SCORE  uint32 little-endian  (displayed zero-padded to 8 digits)
      [4:7]  NAME   3 ASCII chars
      [7]    null terminator
      [8]    index/char byte (cycles 0-4, not displayed)
      [9]    STAGE code: 0-6 -> ST1-ST7, 7 -> ALL
      [10:12] padding (00 00)
    RANK is positional (1ST..10TH).
    charset "stage" is defined at the bottom (after <output>).
  -->

  <structure file="at28c16">
    <check>
      <size>2080</size>
    </check>

    <!-- skip to first record at 0x00C8 (200 bytes) -->
    <elt size="200" type="raw" id="PRE"/>

    <loop count="10">
      <elt size="4" type="int"  endianness="little_endian" id="SCORE"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="NUL"/>
      <elt size="1" type="raw"  id="IDX"/>
      <elt size="1" type="text" charset="stage" id="STAGE"/>
      <elt size="2" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <!-- score displayed zero-padded to 8 digits (no commas; the game pads) -->
  <format id="score8">
    <pad direction="left" max="8">0</pad>
  </format>

  <!-- positional rank -> ordinal string -->
  <format id="rank">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="rank"/>
      <column id="NAME"  src="NAME"/>
      <column id="STAGE" src="STAGE"/>
      <column id="SCORE" src="SCORE" format="score8"/>
    </table>
  </output>

  <!-- charset placed after <output>, before </hi2txt> -->
  <charset id="stage">
    <char src="0x00" dst="ST1"/>
    <char src="0x01" dst="ST2"/>
    <char src="0x02" dst="ST3"/>
    <char src="0x03" dst="ST4"/>
    <char src="0x04" dst="ST5"/>
    <char src="0x05" dst="ST6"/>
    <char src="0x06" dst="ST7"/>
    <char src="0x07" dst="ALL"/>
  </charset>

</hi2txt>
