<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- macross2 by Banpresto, 1993 -->
<!-- hiscore.dat: 1ffa00,80 | 1ffb00,80 | 1ffc00,80 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>5504</size>
    </check>

    <!-- BEGINNER COURSE (8 records, 16 bytes each) -->
    <loop count="8">
      <elt size="4" type="int"  id="B_SCORE" base="16"/>
      <!-- byte-skip="odd" removes the 0x01 attribute bytes at positions 1, 3, 5... -->
      <elt size="12" type="text" id="B_NAME"  byte-skip="odd" charset="nmk_macross"/>
    </loop>

    <!-- MEDIUM COURSE (8 records, 16 bytes each) -->
    <loop count="8">
      <elt size="4" type="int"  id="M_SCORE" base="16"/>
      <elt size="12" type="text" id="M_NAME"  byte-skip="odd" charset="nmk_macross"/>
    </loop>

    <!-- EXPERT COURSE (8 records, 16 bytes each) -->
    <loop count="8">
      <elt size="4" type="int"  id="E_SCORE" base="16"/>
      <elt size="12" type="text" id="E_NAME"  byte-skip="odd" charset="nmk_macross"/>
    </loop>
  </structure>

  <output>
    <table id="BEGINNER COURSE">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="SCORE" src="B_SCORE" format="comma_score"/>
      <column id="NAME"  src="B_NAME"  format="trim_right"/>
    </table>

    <table id="MEDIUM COURSE">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="SCORE" src="M_SCORE" format="comma_score"/>
      <column id="NAME"  src="M_NAME"  format="trim_right"/>
    </table>

    <table id="EXPERT COURSE">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="SCORE" src="E_SCORE" format="comma_score"/>
      <column id="NAME"  src="E_NAME"  format="trim_right"/>
    </table>
  </output>

  <!-- Translates 0-7 into 1-8 -->
  <format id="ordinal">
    <case src="0" dst="1"/><case src="1" dst="2"/><case src="2" dst="3"/>
    <case src="3" dst="4"/><case src="4" dst="5"/><case src="5" dst="6"/>
    <case src="6" dst="7"/><case src="7" dst="8"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Banpresto/NMK Internal Alphanumeric Charset -->
  <charset id="nmk_macross">
    <char src="0x04" dst="A"/><char src="0x08" dst="B"/><char src="0x0C" dst="C"/>
    <char src="0x10" dst="D"/><char src="0x14" dst="E"/><char src="0x18" dst="F"/>
    <char src="0x1C" dst="G"/><char src="0x20" dst="H"/><char src="0x24" dst="I"/>
    <char src="0x28" dst="J"/><char src="0x2C" dst="K"/><char src="0x30" dst="L"/>
    <char src="0x34" dst="M"/><char src="0x38" dst="N"/><char src="0x3C" dst="O"/>
    <char src="0x40" dst="P"/><char src="0x44" dst="Q"/><char src="0x48" dst="R"/>
    <char src="0x4C" dst="S"/><char src="0x50" dst="T"/><char src="0x54" dst="U"/>
    <char src="0x58" dst="V"/><char src="0x5C" dst="W"/><char src="0x60" dst="X"/>
    <char src="0x64" dst="Y"/><char src="0x68" dst="Z"/>
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>