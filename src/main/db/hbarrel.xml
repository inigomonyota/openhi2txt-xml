<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- hbarrel by Data East Corporation, 1987 -->
<!-- hiscore.dat: @:maincpu,program,ffbe78,58,00,26 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>88</size>
    </check>

    <!-- Block 1: Scores (10 records x 4 bytes = 40 bytes) -->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>

    <!-- Block 2: Middle Padding (9 bytes) -->
    <!-- Offsets 40-48. This fixes the 1-byte shift in the names. -->
    <elt size="9" type="raw" id="GAP"/>

    <!-- Block 3: Names (10 records) -->
    <!-- 9 records are 4 bytes (3 chars + 1 null), last record is 3 bytes -->
    <loop count="10" skip-last-bytes="1">
      <elt size="3" type="text" id="NAME" charset="de_hbarrel"/>
      <elt size="1" type="raw"  id="N_PAD"/>
    </loop>
  </structure>

  <output>
    <table id="BEST PLAYERS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Full Character Set for Data East -->
  <charset id="de_hbarrel">
    <char src="0x21" dst="!"/><char src="0x26" dst="&amp;"/><char src="0x2A" dst="*"/>
    <char src="0x20" dst=" "/><char src="0x2C" dst=","/><char src="0x2E" dst="."/>
    <!-- Mapping standard uppercase A-Z -->
    <char src="0x41" dst="A"/><char src="0x42" dst="B"/><char src="0x43" dst="C"/>
    <char src="0x44" dst="D"/><char src="0x45" dst="E"/><char src="0x46" dst="F"/>
    <char src="0x47" dst="G"/><char src="0x48" dst="H"/><char src="0x49" dst="I"/>
    <char src="0x4A" dst="J"/><char src="0x4B" dst="K"/><char src="0x4C" dst="L"/>
    <char src="0x4D" dst="M"/><char src="0x4E" dst="N"/><char src="0x4F" dst="O"/>
    <char src="0x50" dst="P"/><char src="0x51" dst="Q"/><char src="0x52" dst="R"/>
    <char src="0x53" dst="S"/><char src="0x54" dst="T"/><char src="0x55" dst="U"/>
    <char src="0x56" dst="V"/><char src="0x57" dst="W"/><char src="0x58" dst="X"/>
    <char src="0x59" dst="Y"/><char src="0x5A" dst="Z"/>
  </charset>
</hi2txt>