<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Varth: Operation Thunderstorm">
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 10 entries x 8 bytes + 4-byte trailer = 84 bytes total
    per entry (8 bytes):
      [0:4]  score, 4-byte BCD big-endian (base16)
      [4:7]  name, 3 ASCII chars
      [7]    stage reached (1-30, displayed as S01-S30)
    trailer [80:84]: top score BCD or checksum (raw)
  //-->

  <structure file=".hi">
    <check>
      <size>84</size>
    </check>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="int"  id="STAGE"/>
    </loop>
    <elt size="4" type="raw" id="TOP SCORE"/>
  </structure>

  <output>
    <table id="RANKING BEST 10">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="STAGE" format="pad2;prefixS"/>
    </table>
    <field id="TOP SCORE" format="hexadecimal_string" display="debug"/>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <format id="pad2">
    <pad direction="left" max="2">0</pad>
  </format>

  <format id="prefixS">
    <prefix>S</prefix>
  </format>

</hi2txt>