<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  pbobble4 - Puzzle Bobble 4 (Taito, 1997)
  Taito F3 hardware, 68EC020 CPU (big-endian).
  hiscore.dat:
    @:maincpu,program,40e85a,116,00,00
    @:maincpu,program,40e8ba,1,41,41
  279 bytes = 278B range1 + 1B range2

  Same 22B record layout as pbobble2, with the "flag" field repurposed
  as a 2-byte character ID.

  Layout:
    [0-109]   VS CPU table:  5 × 22B records
    [110-219] Puzzle table:  5 × 22B records
    [220-277] Pointer/metadata (58B)
    [278]     Range 2 trigger (1B)

  22-byte record:
    [0-3]   Score    (4B big-endian int)
    [4-6]   Name     (3B ASCII)
    [7]     Pad      (1B null)
    [8-15]  Metadata (8B: character input codes + zeros)
    [16-17] Round    (2B big-endian int)
    [18-19] Internal rank (2B big-endian)
    [20-21] Character ID (2B big-endian)

  Character IDs:
    0=BUB / BOB  1=ALKANET  2=MARINO  3=KUROL  4=TAMTAM
    5=CLEON  6=G  7=BRAMB  8=DEVELON  9=GIGANT
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>279</size>
    </check>

    <!-- VS CPU MODE: 5 x 22B records (offsets 0-109) -->
    <loop count="5">
      <elt size="4" type="int" id="VS_SCORE" endianness="big_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="VS_NAME" table-index="loop_index"/>
      <elt size="1" type="raw" id="VS_NPAD"/>
      <elt size="8" type="raw" id="VS_META"/>
      <elt size="2" type="int" id="VS_ROUND" endianness="big_endian" table-index="loop_index"/>
      <elt size="2" type="raw" id="VS_IRANK"/>
      <elt size="2" type="int" id="VS_CHAR" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- PUZZLE MODE: 5 x 22B records (offsets 110-219) -->
    <loop count="5">
      <elt size="4" type="int" id="PZ_SCORE" endianness="big_endian" table-index="loop_index"/>
      <elt size="3" type="text" id="PZ_NAME" table-index="loop_index"/>
      <elt size="1" type="raw" id="PZ_NPAD"/>
      <elt size="8" type="raw" id="PZ_META"/>
      <elt size="2" type="int" id="PZ_ROUND" endianness="big_endian" table-index="loop_index"/>
      <elt size="2" type="raw" id="PZ_IRANK"/>
      <elt size="2" type="int" id="PZ_CHAR" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- Pointer/metadata block (58 bytes) -->
    <elt size="58" type="raw" id="PTRS"/>

    <!-- Range 2: trigger (1 byte) -->
    <elt size="1" type="raw" id="RANGE2"/>
  </structure>

  <output>
    <table id="RANKING - PUZZLE MODE" sort="SCORE" sort-order="desc" sort-format="sort_num">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="ROUND" src="PZ_ROUND"/>
      <column id="CHARACTER" src="PZ_CHAR" format="char_name"/>
      <column id="SCORE" src="PZ_SCORE" format="comma_score"/>
      <column id="NAME" src="PZ_NAME"/>
    </table>

    <table id="RANKING - VS CPU MODE" sort="SCORE" sort-order="desc" sort-format="sort_num">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="ROUND" src="VS_ROUND"/>
      <column id="CHARACTER" src="VS_CHAR" format="char_name"/>
      <column id="SCORE" src="VS_SCORE" format="comma_score"/>
      <column id="NAME" src="VS_NAME"/>
    </table>
  </output>

  <!-- Ordinal rank (0-4 -> 1ST-5TH) -->
  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
    <case src="3" operator="=" dst="4TH"/>
    <case src="4" operator="=" dst="5TH"/>
  </format>

  <!-- Character ID (0-9) -> character name -->
  <format id="char_name">
    <case src="0" operator="=" dst="BUB / BOB"/>
    <case src="1" operator="=" dst="ALKANET"/>
    <case src="2" operator="=" dst="MARINO"/>
    <case src="3" operator="=" dst="KUROL"/>
    <case src="4" operator="=" dst="TAMTAM"/>
    <case src="5" operator="=" dst="CLEON"/>
    <case src="6" operator="=" dst="G"/>
    <case src="7" operator="=" dst="BRAMB"/>
    <case src="8" operator="=" dst="DEVELON"/>
    <case src="9" operator="=" dst="GIGANT"/>
  </format>

  <!-- Pass-through for numeric sort (bypasses any string formatting) -->
  <format id="sort_num"><multiply>1</multiply></format>

<!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>
