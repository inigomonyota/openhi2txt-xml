<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 164 bytes -->
    <check><size>164</size></check>
    
    <!-- 4-byte standalone Top Score -->
    <elt size="4" type="raw" id="SKIP_TOP_SCORE"/>
    
    <!-- ARRAY 1: 20 Scores (4 bytes each) -->
    <loop count="20">
      <!-- 4-byte Big-Endian BCD Score -->
      <elt size="4" type="int" id="SCORE" base="16" endianness="big_endian"/>
    </loop>
    
    <!-- ARRAY 2: 20 Names (4 bytes each) -->
    <loop count="20">
      <!-- 3-character ASCII Name -->
      <elt size="3" type="text" id="NAME"/>
      <!-- 1 byte padding (usually 0x00) -->
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <!-- The arcade draws two columns, but hi2txt will cleanly output one list from 1 to 20 -->
    <table id="BEST PLAYERS">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"/>
    </table>
  </output>

  <!-- Translates the visual row index to 1-20 -->
  <format id="+1">
    <add>1</add>
  </format>
</hi2txt>