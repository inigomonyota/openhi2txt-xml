<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    maxforce (Maximum Force, Mesa Logic / Atari Games, 1994 - Cojag hardware).
    Cojag CPUs are BIG-ENDIAN, so every 32-bit field is big-endian and the significant
    character byte is the LAST byte of each 4-byte name cell (bytes +03/+07/+0B).
    Two boards are captured, both with the SAME 0x18-byte record layout:
      +00 name cell 1 (3 pad bytes + code: 0x00='A'..0x19='Z', 0xFF=space)
      +04 name cell 2
      +08 name cell 3
      +0C score  (big-endian int, e.g. 0x0001CA02 = 117250)
      +10 leaderboard position (1-based; 0xFFFFFFFF on the unranked bottom row)
      +14 always 0
    Live locations in :mainram/share:
      HIGH SCORE  chart : 0xA588, 10 records = 240 bytes
      TOURNAMENT  chart : 0xA688,  5 records = 120 bytes (Single Player - Single Credit)
    The MAME hiscore plugin concatenates both regions plus a 1-byte sentinel (0xA59B row):
      240 + 120 + 1 = 361 bytes total.
    NOTE: unlike area51, maxforce encodes initials ZERO-BASED (A=0x00, not 0x0A).
    Authored by the HI2TXT project (maxforce support). Big-endian, zero-based names.
  //-->

  <structure file=".hi">
    <check>
      <size>361</size>
    </check>

    <!-- HIGH SCORE chart: 10 records -->
    <loop count="10">
      <elt size="3" type="raw"  id="PAD1"   table-index="loop_index"/>
      <elt size="1" type="text" id="INIT1"  charset="csMF" table-index="loop_index"/>
      <elt size="3" type="raw"  id="PAD2"   table-index="loop_index"/>
      <elt size="1" type="text" id="INIT2"  charset="csMF" table-index="loop_index"/>
      <elt size="3" type="raw"  id="PAD3"   table-index="loop_index"/>
      <elt size="1" type="text" id="INIT3"  charset="csMF" table-index="loop_index"/>
      <elt size="4" type="int"  id="SCORE"  endianness="big_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="POS"    endianness="big_endian" table-index="loop_index"/>
      <elt size="4" type="raw"  id="ZERO"   table-index="loop_index"/>
    </loop>

    <!-- TOURNAMENT chart (Single Player - Single Credit): 5 records -->
    <loop count="5">
      <elt size="3" type="raw"  id="TPAD1"  table-index="loop_index"/>
      <elt size="1" type="text" id="TINIT1" charset="csMF" table-index="loop_index"/>
      <elt size="3" type="raw"  id="TPAD2"  table-index="loop_index"/>
      <elt size="1" type="text" id="TINIT2" charset="csMF" table-index="loop_index"/>
      <elt size="3" type="raw"  id="TPAD3"  table-index="loop_index"/>
      <elt size="1" type="text" id="TINIT3" charset="csMF" table-index="loop_index"/>
      <elt size="4" type="int"  id="TSCORE" endianness="big_endian" table-index="loop_index"/>
      <elt size="4" type="int"  id="TPOS"   endianness="big_endian" table-index="loop_index"/>
      <elt size="4" type="raw"  id="TZERO"  table-index="loop_index"/>
    </loop>

    <elt size="1" type="raw" id="SENTINEL"/>
  </structure>

  <output>
    <table id="HIGH SCORE" sort="SCORE" sort-order="desc">
      <column id="POS."   src="index" format="+1"/>
      <column id="NAME"   format="fname"/>
      <column id="SCORE"  src="SCORE"/>
      <column id="INIT1"   display="debug"/>
      <column id="INIT2"   display="debug"/>
      <column id="INIT3"   display="debug"/>
      <column id="POS"   format="0x" display="debug"/>
      <column id="PAD1"  format="0x" display="debug"/>
      <column id="PAD2"  format="0x" display="debug"/>
      <column id="PAD3"  format="0x" display="debug"/>
      <column id="ZERO"  format="0x" display="debug"/>
    </table>

    <table id="TOURNAMENT" sort="TSCORE" sort-order="desc">
      <column id="POS."   src="index" format="+1"/>
      <column id="NAME"   format="tfname"/>
      <column id="SCORE"  src="TSCORE"/>
      <column id="TINIT1"  display="debug"/>
      <column id="TINIT2"  display="debug"/>
      <column id="TINIT3"  display="debug"/>
      <column id="TPOS"   format="0x" display="debug"/>
      <column id="TPAD1"  format="0x" display="debug"/>
      <column id="TPAD2"  format="0x" display="debug"/>
      <column id="TPAD3"  format="0x" display="debug"/>
      <column id="TZERO"  format="0x" display="debug"/>
    </table>

    <field id="SENTINEL" format="0x" display="debug"/>
  </output>

  <!-- POS. = 1-based row index -->
  <format id="+1"><add>1</add></format>

  <!-- NAME = the three initials joined, outer padding trimmed -->
  <format id="fname">
    <concat><column id="INIT1"/><column id="INIT2"/><column id="INIT3"/></concat>
    <trim direction="both"> </trim>
  </format>
  <!-- TOURNAMENT names are blank; keep the joined spaces (do NOT trim to empty) so
       openhi2txt still recognises these rows as belonging to this table. openhi2txt
       decides table membership by whether the first data column (NAME) has content,
       and an empty NAME would make it drop the whole TOURNAMENT board. -->
  <format id="tfname">
    <concat><column id="TINIT1"/><column id="TINIT2"/><column id="TINIT3"/></concat>
  </format>

  <charset id="csMF">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0a" dst="K"/>
    <char src="0x0b" dst="L"/>
    <char src="0x0c" dst="M"/>
    <char src="0x0d" dst="N"/>
    <char src="0x0e" dst="O"/>
    <char src="0x0f" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
    <char src="0xff" dst=" "/>
  </charset>
</hi2txt>
