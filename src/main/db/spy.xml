<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 84 bytes -->
    <check><size>84</size></check>
    
    <!-- The arcade monitor only displays the Top 8 records -->
    <loop count="8">
      <!-- Name uses a simple offset of +48. We attach the charset just to protect against blank spaces! -->
      <elt size="3" type="text" id="NAME" ascii-offset="48" charset="spy_char"/>
      <elt size="1" type="raw"  id="PAD"/>
      <elt size="4" type="int"  id="SCORE" base="16" endianness="big_endian"/>
    </loop>
    
    <!-- The remaining 20 bytes hold the unused 9th/10th records and the standalone Top Score -->
    <elt size="20" type="raw" id="TRAIL"/>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"/>
    </table>
  </output>

  <!-- Translates the visual row index to 1-8 -->
  <format id="+1">
    <add>1</add>
  </format>

  <!-- Safely intercepts 0x00 so it prints a blank space instead of a "0" -->
  <charset id="spy_char">
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>