<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="World Heroes">
  <!--
    Neo Geo saveram, byte-swap=2 ("BACKUP RAM OK !" confirmed).
    ("WORLD HEROES" signature @0x2a0 is just a label.)
    RANKING @0x320, 10 x 8B: [SCORE:4 BCD][NAME:3 ASCII incl space][pad:1].
    SCORE 4-byte BCD -> int, shown 7-digit zero-padded (PadL70). NAME kept as-is (e.g. "LD ").
  //-->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>
    <elt size="800" type="raw" id="HEADER"/>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE" format="PadL70"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
</hi2txt>
