<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <!--
    MAME hiscore.dat:
      bubbletr:
      @:maincpu,program,106970,278,01,01

    .hi size = 0x278 = 632 bytes

    Layout confirmed from the supplied save data:
      0x000-0x13F : SINGLE PLAYER TOP 10, 10 records x 32 bytes
      0x140-0x277 : DOUBLE PLAYER TOP 10
                    10 records x 32 bytes, with the final record's
                    trailing 8 unused bytes not present in the .hi file.

    Record layout (32 bytes):
      +0x00  2 bytes SCORE, packed BCD, BIG-ENDIAN (high byte first)
                         e.g. bytes 01 74 -> "0174" -> 174
      +0x02 18 bytes NAME, 9 characters stored as 16-bit tile codes
                         (use low byte; colour is encoded in bit 7)
      +0x14  2 bytes unknown
      +0x16  2 bytes SCENE, BIG-ENDIAN integer (bytes 00 03 -> 3)
      +0x18  8 bytes unknown
  -->

  <structure file=".hi">
    <check>
<size>632</size>
    </check>

    <!-- SINGLE PLAYER TOP 10 -->
    <loop count="10">
      <elt size="2"  type="int"  id="P1_SCORE" endianness="big_endian" base="16"/>
      <elt size="18" type="text" id="P1_NAME" byte-skip="odd" charset="bubbletr_name"/>
      <elt size="2"  type="raw"  id="_P1_UNKNOWN1"/>
      <elt size="2"  type="int"  id="P1_SCENE" endianness="big_endian"/>
      <elt size="8"  type="raw"  id="_P1_UNKNOWN2"/>
    </loop>

    <!-- DOUBLE PLAYER TOP 10 -->
    <loop count="10" skip-last-bytes="8">
      <elt size="2"  type="int"  id="P2_SCORE" endianness="big_endian" base="16"/>
      <elt size="18" type="text" id="P2_NAME" byte-skip="odd" charset="bubbletr_name"/>
      <elt size="2"  type="raw"  id="_P2_UNKNOWN1"/>
      <elt size="2"  type="int"  id="P2_SCENE" endianness="big_endian"/>
      <elt size="8"  type="raw"  id="_P2_UNKNOWN2"/>
    </loop>
  </structure>

  <output>
    <table id="SINGLE PLAYER TOP 10">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="P1_SCORE"/>
      <column id="NAME" src="P1_NAME"/>
      <column id="SCE." src="P1_SCENE"/>
    </table>

    <table id="DOUBLE PLAYER TOP 10">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="P2_SCORE"/>
      <column id="NAME" src="P2_NAME"/>
      <column id="SCE." src="P2_SCENE"/>
    </table>
  </output>

  <!--
    Character tiles:
      cyan player 1 letters = ASCII in the low byte
      red  player 2 letters = ASCII + 0x80 in the low byte
      high byte is 0x01 and is discarded by byte-skip="odd"
  -->
  <charset id="bubbletr_name">
    <char src="0x00" dst=""/>
    <char src="0x20" dst=" "/>
    <char src="0x26" dst="&amp;"/>

    <char src="0x41" dst="A"/><char src="0x42" dst="B"/><char src="0x43" dst="C"/>
