<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- sokyugrt by Sega / Raizing, 1996 -->
<!-- hiscore.dat: @:maincpu,program,608dc30,a0,82,00 | @:maincpu,program,60bda38,4,00,c0 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>164</size>
    </check>

    <!-- 10 records, 16 bytes each -->
    <loop count="10">
      <!-- Byte 0: Ship Type (81, 82, 83) -->
      <elt size="1" type="int" id="SHIP_RAW"/>
      <!-- Byte 1: Stage (00-04) -->
      <elt size="1" type="int" id="STAGE_RAW"/>
      <elt size="2" type="raw" id="ATTR1"/>
      <!-- Bytes 4-7: Score (Hex Integer) -->
      <elt size="4" type="int" id="SCORE"/>
      <elt size="2" type="raw" id="ATTR2"/>
      <!-- Bytes 10-12: Name (3 chars) -->
      <elt size="3" type="text" id="NAME" charset="raizing"/>
      <!-- Bytes 13-15: Padding -->
      <elt size="3" type="raw" id="RECORD_PAD"/>
    </loop>

    <!-- Global Top Score -->
    <elt size="4" type="int" id="HI-SCORE"/>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="comma_score" display="always"/-->

    <table id="RANKING">
      <column id="RANK"  src="index"     format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"     format="comma_score"/>
      <column id="STAGE" src="STAGE_RAW" format="stage_map"/>
	  <column id="SHIP"  src="SHIP_RAW"  format="ship_map"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- Ship Type Mapping -->
  <format id="ship_map">
    <case src="129" dst="EI-DOU"/>
    <case src="130" dst="ALLRANGE"/>
    <case src="131" dst="MU-SOU"/>
  </format>

  <!-- Stage Mapping -->
  <format id="stage_map">
    <add>1</add>
    <prefix>1-</prefix>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="raizing">
    <char src="0x3A" dst="·"/>
    <char src="0x40" dst=" "/>
  </charset>
</hi2txt>