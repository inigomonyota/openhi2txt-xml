    <!-- PORT TOWN II: FASTEST LAP, inserted into shared LAP arrays at course index 12 -->
    <loop count="1" start="12">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- RED CANYON II: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="RCII_META"/>
      <elt size="1" type="int" id="RCII_SEC"/>
      <elt size="1" type="int" id="RCII_HUND"/>
    </loop>
    <!-- RED CANYON II: FASTEST LAP, inserted into shared LAP arrays at course index 13 -->
    <loop count="1" start="13">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- FIRE FIELD: TOP 10 completion times -->
    <loop count="10">
