      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <elt size="2" type="raw" id="CHECKSUM_1"/>
    <!-- MUTE CITY II: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="MCII_META"/>
      <elt size="1" type="int" id="MCII_SEC"/>
      <elt size="1" type="int" id="MCII_HUND"/>
    </loop>
    <!-- MUTE CITY II: FASTEST LAP, inserted into shared LAP arrays at course index 5 -->
    <loop count="1" start="5">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- PORT TOWN I: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="PTI_META"/>
      <elt size="1" type="int" id="PTI_SEC"/>
      <elt size="1" type="int" id="PTI_HUND"/>
    </loop>
    <!-- PORT TOWN I: FASTEST LAP, inserted into shared LAP arrays at course index 6 -->
    <loop count="1" start="6">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- RED CANYON I: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="RCI_META"/>
      <elt size="1" type="int" id="RCI_SEC"/>
      <elt size="1" type="int" id="RCI_HUND"/>
    </loop>
    <!-- RED CANYON I: FASTEST LAP, inserted into shared LAP arrays at course index 7 -->
    <loop count="1" start="7">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- WHITE LAND I: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="WLI_META"/>
      <elt size="1" type="int" id="WLI_SEC"/>
      <elt size="1" type="int" id="WLI_HUND"/>
    </loop>
    <!-- WHITE LAND I: FASTEST LAP, inserted into shared LAP arrays at course index 8 -->
    <loop count="1" start="8">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- WHITE LAND II: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="WLII_META"/>
      <elt size="1" type="int" id="WLII_SEC"/>
      <elt size="1" type="int" id="WLII_HUND"/>
    </loop>
    <!-- WHITE LAND II: FASTEST LAP, inserted into shared LAP arrays at course index 9 -->
    <loop count="1" start="9">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
