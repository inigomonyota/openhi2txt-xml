    </loop>
    <elt size="2" type="raw" id="CHECKSUM_3"/>
    <elt size="1" type="raw" id="MASTER_CLASS"/>
    <elt size="5" type="raw" id="FOOTER"/>
    <elt size="1536" type="raw" id="UNUSED"/>
  </structure>

  <output>
    <!-- FIRST TABLE: one fastest lap for each of the 15 courses -->
    <table id="FASTEST LAP TIMES"><column id="COURSE" src="index" format="course_name"/><column id="TIME" format="lap_time"/><column id="VEHICLE" src="LAP_META" format="vehicle"/><column id="MODE" src="LAP_META" format="mode"/>
    </table>

    <!-- FOLLOWED BY TOP 10 COMPLETION TIMES FOR EACH COURSE -->
    <table id="MUTE CITY I - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_MCI"/><column id="VEHICLE" src="MCI_META" format="vehicle"/><column id="MODE" src="MCI_META" format="mode"/>
    </table>
    <table id="BIG BLUE - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_BB"/><column id="VEHICLE" src="BB_META" format="vehicle"/><column id="MODE" src="BB_META" format="mode"/>
    </table>
    <table id="SAND OCEAN - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_SO"/><column id="VEHICLE" src="SO_META" format="vehicle"/><column id="MODE" src="SO_META" format="mode"/>
    </table>
    <table id="DEATH WIND I - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_DWI"/><column id="VEHICLE" src="DWI_META" format="vehicle"/><column id="MODE" src="DWI_META" format="mode"/>
    </table>
    <table id="SILENCE - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_SIL"/><column id="VEHICLE" src="SIL_META" format="vehicle"/><column id="MODE" src="SIL_META" format="mode"/>
    </table>
    <table id="MUTE CITY II - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_MCII"/><column id="VEHICLE" src="MCII_META" format="vehicle"/><column id="MODE" src="MCII_META" format="mode"/>
    </table>
    <table id="PORT TOWN I - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_PTI"/><column id="VEHICLE" src="PTI_META" format="vehicle"/><column id="MODE" src="PTI_META" format="mode"/>
    </table>
    <table id="RED CANYON I - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_RCI"/><column id="VEHICLE" src="RCI_META" format="vehicle"/><column id="MODE" src="RCI_META" format="mode"/>
    </table>
    <table id="WHITE LAND I - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_WLI"/><column id="VEHICLE" src="WLI_META" format="vehicle"/><column id="MODE" src="WLI_META" format="mode"/>
    </table>
    <table id="WHITE LAND II - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_WLII"/><column id="VEHICLE" src="WLII_META" format="vehicle"/><column id="MODE" src="WLII_META" format="mode"/>
    </table>
    <table id="MUTE CITY III - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_MCIII"/><column id="VEHICLE" src="MCIII_META" format="vehicle"/><column id="MODE" src="MCIII_META" format="mode"/>
    </table>
    <table id="DEATH WIND II - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_DWII"/><column id="VEHICLE" src="DWII_META" format="vehicle"/><column id="MODE" src="DWII_META" format="mode"/>
    </table>
    <table id="PORT TOWN II - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_PTII"/><column id="VEHICLE" src="PTII_META" format="vehicle"/><column id="MODE" src="PTII_META" format="mode"/>
    </table>
    <table id="RED CANYON II - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_RCII"/><column id="VEHICLE" src="RCII_META" format="vehicle"/><column id="MODE" src="RCII_META" format="mode"/>
    </table>
    <table id="FIRE FIELD - TOP 10 COMPLETION TIMES"><column id="RANK" src="index" format="rank10"/><column id="TIME" format="time_FF"/><column id="VEHICLE" src="FF_META" format="vehicle"/><column id="MODE" src="FF_META" format="mode"/>
    </table>
  </output>

  <format id="rank10">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <format id="course_name">
    <case src="0" dst="MUTE CITY I"/>
    <case src="1" dst="BIG BLUE"/>
    <case src="2" dst="SAND OCEAN"/>
    <case src="3" dst="DEATH WIND I"/>
    <case src="4" dst="SILENCE"/>
    <case src="5" dst="MUTE CITY II"/>
    <case src="6" dst="PORT TOWN I"/>
    <case src="7" dst="RED CANYON I"/>
    <case src="8" dst="WHITE LAND I"/>
    <case src="9" dst="WHITE LAND II"/>
    <case src="10" dst="MUTE CITY III"/>
    <case src="11" dst="DEATH WIND II"/>
    <case src="12" dst="PORT TOWN II"/>
    <case src="13" dst="RED CANYON II"/>
    <case src="14" dst="FIRE FIELD"/>
  </format>

  <format id="minute"><remainder>16</remainder></format>

  <format id="vehicle">
    <divide_trunc>16</divide_trunc>
    <case src="0" dst=""/>
    <case src="8" dst="BLUE FALCON"/>
    <case src="9" dst="WILD GOOSE"/>
    <case src="10" dst="GOLDEN FOX"/>
    <case src="11" dst="FIRE STINGRAY"/>
    <case src="12" dst="BLUE FALCON"/>
    <case src="13" dst="WILD GOOSE"/>
    <case src="14" dst="GOLDEN FOX"/>
    <case src="15" dst="FIRE STINGRAY"/>
  </format>

  <format id="mode">
    <divide_trunc>16</divide_trunc>
    <case src="0" dst=""/>
    <case src="8" dst="GRAND PRIX"/>
    <case src="9" dst="GRAND PRIX"/>
    <case src="10" dst="GRAND PRIX"/>
    <case src="11" dst="GRAND PRIX"/>
    <case src="12" dst="PRACTICE"/>
    <case src="13" dst="PRACTICE"/>
    <case src="14" dst="PRACTICE"/>
    <case src="15" dst="PRACTICE"/>
  </format>

  <format id="div16"><divide_trunc>16</divide_trunc></format>
  <format id="mod16"><remainder>16</remainder></format>

  <!-- Decode one packed-BCD byte, e.g. 0x59 -> 59 and 0x21 -> 21. -->
  <format id="bcd_byte" input-as-subcolumns-input="true">
    <concat><column format="div16"/><column format="mod16"/></concat>
  </format>

  <format id="lap_time">
    <concat>
      <column src="LAP_META" format="minute"/>
      <txt>'</txt>
      <column src="LAP_SEC" format="bcd_byte"/>
      <txt>''</txt>
      <column src="LAP_HUND" format="bcd_byte"/>
    </concat>
  </format>
  <format id="time_MCI">
    <concat>
      <column src="MCI_META" format="minute"/>
      <txt>'</txt>
      <column src="MCI_SEC" format="bcd_byte"/>
      <txt>''</txt>
      <column src="MCI_HUND" format="bcd_byte"/>
    </concat>
  </format>
  <format id="time_BB">
