      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- DEATH WIND II: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="DWII_META"/>
      <elt size="1" type="int" id="DWII_SEC"/>
      <elt size="1" type="int" id="DWII_HUND"/>
    </loop>
    <!-- DEATH WIND II: FASTEST LAP, inserted into shared LAP arrays at course index 11 -->
    <loop count="1" start="11">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
