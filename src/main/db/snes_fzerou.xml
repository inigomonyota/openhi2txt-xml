<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="F-Zero (USA) - SNES">
  <!--
    Output order:
      1) FASTEST LAP TIMES: all 15 courses, one row each
      2) 15 course tables, each containing ONLY its TOP 10 completion times

    SRAM record format (3 bytes):
      byte 0 high nibble = vehicle/mode
      byte 0 low nibble  = minutes
      byte 1 = packed-BCD seconds
      byte 2 = packed-BCD hundredths

    Vehicle/mode high nibble:
      8 Blue Falcon / Grand Prix
      9 Wild Goose / Grand Prix
      A Golden Fox / Grand Prix
      B Fire Stingray / Grand Prix
      C Blue Falcon / Practice
      D Wild Goose / Practice
      E Golden Fox / Practice
      F Fire Stingray / Practice
      0 unset / ignored

    Default/unset time = 09 59 99 = 9'59''99.
  -->

  <structure file=".hi">
    <check><size>2048</size></check>
    <elt size="5" type="raw" id="HEADER"/>
    <!-- MUTE CITY I: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="MCI_META"/>
      <elt size="1" type="int" id="MCI_SEC"/>
      <elt size="1" type="int" id="MCI_HUND"/>
    </loop>
    <!-- MUTE CITY I: FASTEST LAP, inserted into shared LAP arrays at course index 0 -->
    <loop count="1" start="0">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- BIG BLUE: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="BB_META"/>
      <elt size="1" type="int" id="BB_SEC"/>
      <elt size="1" type="int" id="BB_HUND"/>
    </loop>
    <!-- BIG BLUE: FASTEST LAP, inserted into shared LAP arrays at course index 1 -->
    <loop count="1" start="1">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- SAND OCEAN: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="SO_META"/>
      <elt size="1" type="int" id="SO_SEC"/>
      <elt size="1" type="int" id="SO_HUND"/>
    </loop>
    <!-- SAND OCEAN: FASTEST LAP, inserted into shared LAP arrays at course index 2 -->
    <loop count="1" start="2">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- DEATH WIND I: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="DWI_META"/>
      <elt size="1" type="int" id="DWI_SEC"/>
      <elt size="1" type="int" id="DWI_HUND"/>
    </loop>
    <!-- DEATH WIND I: FASTEST LAP, inserted into shared LAP arrays at course index 3 -->
    <loop count="1" start="3">
      <elt size="1" type="int" id="LAP_META" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_SEC" table-index="loop_index"/>
      <elt size="1" type="int" id="LAP_HUND" table-index="loop_index"/>
    </loop>
    <!-- SILENCE: TOP 10 completion times -->
    <loop count="10">
      <elt size="1" type="int" id="SIL_META"/>
      <elt size="1" type="int" id="SIL_SEC"/>
      <elt size="1" type="int" id="SIL_HUND"/>
    </loop>
    <!-- SILENCE: FASTEST LAP, inserted into shared LAP arrays at course index 4 -->
