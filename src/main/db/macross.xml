<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check>
      <definition>0:9102:a0:32:00</definition>
      <size>160</size>
    </check>
    <loop count="10">
      <elt size="2" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="raw"  id="PAD0"/>
      <elt size="1" type="int"  id="STAGE" base="16"/>
      <elt size="2" type="raw"  id="PAD1"/>
      <elt size="8" type="text" id="NAME"/>
      <elt size="2" type="raw"  id="PAD2"/>
    </loop>
  </structure>

  <output>
    <table id="TODAY'S BEST SCORE">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="STAGE" src="STAGE"/>
      <column id="NAME"  src="NAME" format="trim_space"/>
    </table>
  </output>

  <format id="+1">
    <add>1</add>
  </format>

  <format id="trim_space">
    <trim direction="both"> </trim>
  </format>
</hi2txt>
