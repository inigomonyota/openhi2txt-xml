<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Fighter &amp; Attacker">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,1faa8,f2,00,03
                  @:maincpu,program,1122,4,0,0</definition>
      <size>246</size>
    </check>
    <elt size="6"   type="raw" id="PAD0"/>
    <loop count="10">
      <elt size="2" type="int"  id="STAGE"/>
      <elt size="4" type="text" id="NAME"/>
      <elt size="2" type="int"  id="PLANE"/>
      <elt size="4" type="int"  id="SCORE" base="16"/>
    </loop>
    <elt size="116" type="raw" id="EMPTY"/>
    <elt size="4"   type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="STAGE"/>
    </table>
    <field id="TOP SCORE"/>
  </output>
</hi2txt>
