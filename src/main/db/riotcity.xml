<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file="nvram" byte-swap="2">
    <!-- Skip to the exact memory address 0x0E00 (3584 bytes) where the table lives -->
    <elt size="3584" type="raw" id="SKIP"/>
    
    <!-- 8 records * 8 bytes each = 64 bytes -->
    <loop count="8">
      <elt size="4" type="int"  id="SCORE" endianness="big_endian"/>
      <elt size="3" type="text" id="NAME"/>
      <!-- We read this 1 byte to keep the memory aligned, but ignore it -->
      <elt size="1" type="raw"  id="UNKNOWN"/>
    </loop>
  </structure>
  
  <output>
    <table id="HIGH SCORES">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME" src="NAME"/>
    </table>
  </output>

  <format id="+1">
    <add>1</add>
  </format>
</hi2txt>