<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  sengekis - Sengeki Striker (Warashi Inc., 1997)
  sengekisj (Japanese clone)
  Sega Saturn-based ST-V hardware, SH-2 CPU.

  hiscore.dat:
    @:maincpu,program,60b1f24,78,53,00
    @:maincpu,program,800004,338,0e,00
  944 bytes total = 120B TODAY range + 824B nvram range

  NOTE: The original hiscore.dat range for TODAY (60b1de8,78) was pointing
  to the WRONG address and captured only zeros. Corrected address found
  via debugger search: TODAY's table lives at 0x060B1F24 in maincpu
  program memory. The TOP 100 table lives in backup RAM mapped at
  0x00800000 (830 bytes of meaningful data, 4 leading null bytes skipped).

  Both memory regions use clean big-endian byte ordering - no byte
  swapping needed, unlike when reading the raw NVRAM file which was
  stored in DCBA order.

  Layout in captured .hi file:
    [0-39]    TODAY: 10 x 4B names (3B ASCII + 1B null)
    [40-79]   TODAY: 10 x 4B BE int scores
    [80-99]   TODAY: 10 x 2B BE stage main (stored as main - 1)
    [100-119] TODAY: 10 x 2B BE stage sub (stored as sub - 1)
    (range 2 starts here at file offset 120)
    [120-123] NVRAM magic: 0E 98 83 01
    [124-139] NVRAM game id: "SENGEKI STRIKER "
    [140-143] NVRAM flags: 01 00 04 D8
    [144-543] NVRAM: 100 x 4B TOP 100 names
    [544-943] NVRAM: 100 x 4B TOP 100 scores (BE int)

  Known limitations:
  - No per-entry STAGE info exists for the TOP 100 anywhere in memory.
    Confirmed via exhaustive nvram search. Warashi's engine hardcodes
    the "1-1" display for TOP 100 entries. The STAGE column is omitted
    from the TOP 100 output.
  - Sengekis nvram saves unreliably per the original hiscore.dat author.
    Names may occasionally be corrupted on save while scores save OK.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>946</size>
    </check>

    <!-- 1 byte leading pad (for hiscore.dat stable start trigger) -->
    <elt size="1" type="raw" id="LEAD_PAD"/>

    <!-- ====== TODAY'S EXCELLENT PLAYERS (120 bytes) ====== -->

    <!-- 10 x 4B names (3B ASCII + 1B null) -->
    <loop count="10">
      <elt size="3" type="text" id="TD_NAME" table-index="loop_index"/>
      <elt size="1" type="raw" id="TD_NPAD"/>
    </loop>

    <!-- 10 x 4B BE int scores -->
    <loop count="10">
      <elt size="4" type="int" id="TD_SCORE" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- 10 x 2B BE stage main (stored as main - 1) -->
    <loop count="10">
      <elt size="2" type="int" id="TD_MAIN" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- 10 x 2B BE stage sub (stored as sub - 1) -->
    <loop count="10">
      <elt size="2" type="int" id="TD_SUB" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- ====== NVRAM header (24 bytes) ====== -->
    <elt size="24" type="raw" id="NVRAM_HEADER"/>

    <!-- ====== RANKING RECORD TOP 100 ====== -->

    <!-- 100 x 4B names (3B ASCII + 1B null) -->
    <loop count="100">
      <elt size="3" type="text" id="TP_NAME" table-index="loop_index"/>
      <elt size="1" type="raw" id="TP_NPAD"/>
    </loop>

    <!-- 100 x 4B BE int scores -->
    <loop count="100">
      <elt size="4" type="int" id="TP_SCORE" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- 1 byte trailing pad (for hiscore.dat stable end trigger) -->
    <elt size="1" type="raw" id="TAIL_PAD"/>
  </structure>

  <output>
    <table id="TODAY'S EXCELLENT PLAYERS">
      <column id="RANK" src="index" format="ordinal_10"/>
      <column id="NAME" src="TD_NAME"/>
      <column id="SCORE" src="TD_SCORE" format="comma_score"/>
      <column id="STAGE" src="TD_MAIN" format="stage_fmt"/>
    </table>

    <table id="RANKING RECORD TOP 100">
      <column id="RANK" src="index" format="ordinal_100"/>
      <column id="NAME" src="TP_NAME"/>
      <column id="SCORE" src="TP_SCORE" format="comma_score"/>
    </table>
  </output>

  <!-- Ordinal rank for 10 entries -->
  <format id="ordinal_10">
    <add>1</add>
    <case src="1"  operator="=" dst="1ST"/>
    <case src="2"  operator="=" dst="2ND"/>
    <case src="3"  operator="=" dst="3RD"/>
    <case src="4"  operator="=" dst="4TH"/>
    <case src="5"  operator="=" dst="5TH"/>
    <case src="6"  operator="=" dst="6TH"/>
    <case src="7"  operator="=" dst="7TH"/>
    <case src="8"  operator="=" dst="8TH"/>
    <case src="9"  operator="=" dst="9TH"/>
    <case src="10" operator="=" dst="10TH"/>
  </format>

