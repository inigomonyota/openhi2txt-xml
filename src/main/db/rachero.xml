<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Racing Hero">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:mainpcb:maincpu,program,ff89be,51,10,01
                  @:mainpcb:maincpu,program,ff89ae,4,10,00</definition>
      <size>85</size>
    </check>
    <loop count="7" skip-last-bytes="3">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="1" type="int"  id="COURSE"/>
      <elt size="3" type="raw"  id="PAD2"/>
    </loop>
    <elt size="4" type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table>
      <column id="RANK"   src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="COURSE"/>
    </table>
    <field id="TOP SCORE" display="extra"/>
  </output>
</hi2txt>
