<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Explosive Breaker">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,10c01a,63,00,4e</definition>
      <size>99</size>
    </check>
    <loop count="10" skip-last-bytes="1">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="int"  id="ROUND_NUM"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD2"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="ROUND" format="round"/>
    </table>
  </output>

  <format id="round">
    <concat>
      <txt>R</txt>
      <column id="ROUND_NUM"/>
    </concat>
  </format>
</hi2txt>
