<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Garyo Retsuden">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,135f,28,00,00
                  @:maincpu,program,138b,1e,13,1c</definition>
      <size>70</size>
    </check>
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>
    <loop count="10">
      <elt size="3" type="text" id="NAME" charset="garyoret" ascii-offset="64"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <charset id="garyoret">
    <char src="0x1d" dst="."/>
    <char src="0x1e" dst="-"/>
    <char src="0x1f" dst=" "/>
  </charset>
</hi2txt>
