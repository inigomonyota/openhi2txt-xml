<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="POW - Prisoners of War">
  <!--
    hiscore.dat: three blocks (84 bytes total)
      @:maincpu,program,43e8e,4  -> bytes 0-3:  top score duplicate (skip)
      @:maincpu,program,41910,2  -> bytes 4-5:  start of entry 1 (contiguous with block 3)
      @:maincpu,program,41912,4e -> bytes 6-83: rest of entries (blocks 2+3 = 80 bytes = 10 entries)
    Entry: 4-byte BCD score + 3-byte tile name (A=0x00, ascii-offset=65) + 1-byte pad
  //-->

  <structure file="hi">
    <check>
      <size>84</size>
    </check>
    <elt size="4" type="raw" id="TOP_SCORE"/>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>