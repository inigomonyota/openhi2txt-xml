<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Formation Z">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,430,138,00,0f
                  @:maincpu,program,600,14,00,40</definition>
      <size>332</size>
    </check>
    <loop count="10" skip-last-bytes="8">
      <elt size="8" type="raw"  id="PAD1"/>
      <elt size="6" type="text" id="SCORE" charset="formatz_num"/>
      <elt size="2" type="raw"  id="PAD2"/>
      <elt size="8" type="text" id="NAME"  charset="formatz_txt" ascii-offset="54"/>
      <elt size="8" type="raw"  id="PAD3"/>
    </loop>
    <elt size="20" type="raw" id="SCORES_BACKUP"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="TrimL0"/>
      <column id="NAME"/>
    </table>
  </output>

  <charset id="formatz_num">
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
    <char src="0x0a" dst="0"/>
  </charset>

  <charset id="formatz_txt">
    <char src="0x00" dst=" "/>
    <char src="0x25" dst="."/>
  </charset>
</hi2txt>
