<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- luckywld by Namco, 1992 -->
<!-- hiscore.dat: @:maincpu,program,100b00,a0,00,02 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>160</size>
    </check>

    <!-- 10 records, 16 bytes each -->
    <loop count="10">
      <elt size="1" type="raw"  id="PAD_1"/>
      <elt size="1" type="int"  id="RANK_ID"/>
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <!-- Split the 8-byte name into two 4-byte halves to insert the & -->
      <elt size="4" type="text" id="P1_NAME"/>
      <elt size="4" type="text" id="P2_NAME"/>
      <elt size="1" type="int"  id="CONTINUES"/>
      <elt size="1" type="raw"  id="PAD_2"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK"      src="index"     format="ordinal"/>
      <column id="SCORE"     src="SCORE"     format="*10;comma_score"/>
      <!-- New combined name column -->
      <column id="NAME"      format="join_names"/>
      <column id="CONTINUES" src="CONTINUES"/>
    </table>
  </output>

  <!-- Joins P1 and P2 with an ampersand, cleaning up spaces -->
  <format id="join_names">
    <concat>
      <column id="P1_NAME" format="trim_right"/>
      <!-- Only adds the '&' if P2_NAME contains actual characters -->
      <column id="P2_NAME" format="ampersand_prefix"/>
    </concat>
  </format>

  <!-- Adds the '&' prefix only if the input is not empty/spaces -->
  <format id="ampersand_prefix">
    <trim direction="both"> </trim>
    <prefix empty="">&amp;</prefix>
  </format>

  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/><case src="3" dst="4TH"/><case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/><case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/><case src="9" dst="10TH"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>