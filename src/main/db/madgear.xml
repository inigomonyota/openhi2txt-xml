<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="madgear">
  <!--
    Mad Gear / Led Storm (Capcom, 1988)
    madgear, madgearj, ledstorm

    .hi file: 156 bytes (0x9C)

    Chunk 1 (0x78 = 120 bytes):
      0x00-0x13 : 10 x 2-byte BE rank pointers (20 bytes)
      0x14-0x63 : 10 x 8-byte score records (80 bytes)
      0x64-0x77 : tail data (20 bytes)

    Score record (8 bytes) at 0x14:
      [PAD:1] [SCORE:3] [NAME:3] [STAGE:1]
      SCORE is packed BCD stored in 3 bytes and decoded via base="16" (hi2txt style).
  //-->

  <structure file=".hi">
    <check>
      <definition>0:ff8890:78:00:00
                  0:ffcb76:23:02:00
                  0:ff87c9:1:d2:d2</definition>
      <definition>@:maincpu,program,ff8890,78,00,00
                  @:maincpu,program,ffcb76,23,02,00
                  @:maincpu,program,ff87c9,1,d2,d2</definition>
      <size>156</size>
    </check>

    <loop count="10">
      <elt size="2" type="raw" id="POINTER"/>
    </loop>

    <loop count="10">
      <elt size="1" type="raw"  id="PAD"/>
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="int"  id="STAGE"/>
    </loop>

    <elt size="20" type="raw" id="TAIL1"/>
    <elt size="35" type="raw" id="VEHICLES"/>
    <elt size="1"  type="raw" id="FLAG"/>
  </structure>

  <output>
    <table sort="SCORE" sort-order="desc" lines-max="10" line-ignore="SCORE:0">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <!-- Show the STAGE value but label the column ROUND -->
      <column id="ROUND" src="STAGE"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
</hi2txt>
