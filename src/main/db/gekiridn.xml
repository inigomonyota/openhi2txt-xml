<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Gekirindan">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,408e72,7a,00,01
                  @:maincpu,program,408e4c,4,00,00</definition>
      <size>126</size>
    </check>
    <loop count="8" skip-last-bytes="6">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="2" type="int"  id="STAGE"/>
      <elt size="6" type="raw"  id="PAD2"/>
    </loop>
    <elt size="4" type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="*10"/>
      <column id="NAME"/>
      <column id="STAGE"/>
    </table>
    <field id="TOP SCORE" format="*10"/>
  </output>
</hi2txt>
