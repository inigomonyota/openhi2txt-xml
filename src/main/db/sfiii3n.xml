<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Street Fighter III 3rd Strike: Fight for the Future">

  <!--
    MAME hiscore.dat:
      @:maincpu,program,2016e4c,18d,1c,04

    .hi size = 0x18D = 397 bytes.

    The block contains four 5-entry tables.  Each full record is 20 bytes:
      +00..02 NAME       custom 3-byte charset
      +03     padding
      +04..05 CHARACTER  16-bit big-endian
      +06..07 padding
      +08..11 SCORE      32-bit big-endian
      +12     GRADE
      +13     secondary grade/status byte
      +14     padding
      +15     WINS
      +16..19 bookkeeping/padding

    MAME deliberately saves only the first 17 bytes of the final record,
    hence 397 bytes rather than 400.
  -->

  <structure file=".hi">
    <check>
      <size>397</size>
    </check>

    <!-- 0x000-0x063: RANKING SCORE -->
    <loop count="5">
      <elt size="3" type="text" id="S_NAME" charset="sfiii_name"/>
      <elt size="1" type="raw" id="_S_PAD1"/>
      <elt size="2" type="int" id="S_CHARACTER" endianness="big_endian"/>
      <elt size="2" type="raw" id="_S_PAD2"/>
      <elt size="4" type="int" id="S_SCORE" endianness="big_endian"/>
      <elt size="1" type="int" id="S_GRADE"/>
      <elt size="1" type="raw" id="_S_AUXGRADE"/>
      <elt size="1" type="raw" id="_S_PAD3"/>
      <elt size="1" type="int" id="S_WINS"/>
      <elt size="4" type="raw" id="_S_TAIL"/>
    </loop>

    <!-- 0x064-0x0C7: RANKING WINS -->
    <loop count="5">
      <elt size="3" type="text" id="W_NAME" charset="sfiii_name"/>
      <elt size="1" type="raw" id="_W_PAD1"/>
      <elt size="2" type="int" id="W_CHARACTER" endianness="big_endian"/>
      <elt size="2" type="raw" id="_W_PAD2"/>
      <elt size="4" type="int" id="W_SCORE" endianness="big_endian"/>
      <elt size="1" type="int" id="W_GRADE"/>
      <elt size="1" type="raw" id="_W_AUXGRADE"/>
      <elt size="1" type="raw" id="_W_PAD3"/>
      <elt size="1" type="int" id="W_WINS"/>
      <elt size="4" type="raw" id="_W_TAIL"/>
    </loop>

    <!-- 0x0C8-0x12B: TOP GRADE (CPU FINAL) -->
    <loop count="5">
      <elt size="3" type="text" id="C_NAME" charset="sfiii_name"/>
      <elt size="1" type="raw" id="_C_PAD1"/>
      <elt size="2" type="int" id="C_CHARACTER" endianness="big_endian"/>
      <elt size="2" type="raw" id="_C_PAD2"/>
      <elt size="4" type="int" id="C_SCORE" endianness="big_endian"/>
      <elt size="1" type="int" id="C_GRADE"/>
      <elt size="1" type="raw" id="_C_AUXGRADE"/>
      <elt size="1" type="raw" id="_C_PAD3"/>
      <elt size="1" type="int" id="C_WINS"/>
      <elt size="4" type="raw" id="_C_TAIL"/>
    </loop>

    <!-- 0x12C-0x17B: first four TOP GRADE (V.S.) records -->
    <loop count="4">
      <elt size="3" type="text" id="V_NAME" charset="sfiii_name"/>
      <elt size="1" type="raw" id="_V_PAD1"/>
      <elt size="2" type="int" id="V_CHARACTER" endianness="big_endian"/>
      <elt size="2" type="raw" id="_V_PAD2"/>
      <elt size="4" type="int" id="V_SCORE" endianness="big_endian"/>
      <elt size="1" type="int" id="V_GRADE"/>
      <elt size="1" type="raw" id="_V_AUXGRADE"/>
      <elt size="1" type="raw" id="_V_PAD3"/>
      <elt size="1" type="int" id="V_WINS"/>
      <elt size="4" type="raw" id="_V_TAIL"/>
    </loop>

    <!-- Final V.S. record: only bytes +00..+16 are present in the .hi -->
    <elt size="3" type="text" id="V_NAME" table-index="4" charset="sfiii_name"/>
    <elt size="1" type="raw" id="_V5_PAD1"/>
    <elt size="2" type="int" id="V_CHARACTER" table-index="4" endianness="big_endian"/>
    <elt size="2" type="raw" id="_V5_PAD2"/>
    <elt size="4" type="int" id="V_SCORE" table-index="4" endianness="big_endian"/>
    <elt size="1" type="int" id="V_GRADE" table-index="4"/>
    <elt size="1" type="raw" id="_V5_AUXGRADE"/>
    <elt size="1" type="raw" id="_V5_PAD3"/>
    <elt size="1" type="int" id="V_WINS" table-index="4"/>
    <elt size="1" type="raw" id="_V5_INDEX"/>
  </structure>

  <output>
    <table id="RANKING SCORE" lines-max="5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="S_NAME"/>
      <column id="CHARACTER" src="S_CHARACTER" format="character"/>
      <column id="SCORE" src="S_SCORE"/>
      <column id="GRADE" src="S_GRADE" format="grade"/>
    </table>

    <table id="RANKING WINS" lines-max="5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="W_NAME"/>
      <column id="CHARACTER" src="W_CHARACTER" format="character"/>
      <column id="WINS" src="W_WINS"/>
      <column id="GRADE" src="W_GRADE" format="grade"/>
    </table>

    <table id="TOP GRADE (CPU FINAL)" lines-max="5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="C_NAME"/>
      <column id="CHARACTER" src="C_CHARACTER" format="character"/>
      <column id="SCORE" src="C_SCORE"/>
      <column id="GRADE" src="C_GRADE" format="grade"/>
    </table>

    <table id="TOP GRADE (V.S.)" lines-max="5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="V_NAME"/>
      <column id="CHARACTER" src="V_CHARACTER" format="character"/>
      <column id="WINS" src="V_WINS"/>
      <column id="GRADE" src="V_GRADE" format="grade"/>
    </table>
  </output>

  <!-- CPS-3 SFIII 3rd Strike character/avatar IDs -->
  <format id="character">
    <case src="0" dst="GILL"/>
    <case src="1" dst="ALEX"/>
    <case src="2" dst="RYU"/>
    <case src="3" dst="YUN"/>
    <case src="4" dst="DUDLEY"/>
    <case src="5" dst="NECRO"/>
    <case src="6" dst="HUGO"/>
    <case src="7" dst="IBUKI"/>
    <case src="8" dst="ELENA"/>
    <case src="9" dst="ORO"/>
    <case src="10" dst="YANG"/>
    <case src="11" dst="KEN"/>
    <case src="12" dst="SEAN"/>
    <case src="13" dst="URIEN"/>
    <case src="14" dst="AKUMA"/>
    <case src="15" dst="SHIN AKUMA"/>
    <case src="16" dst="CHUN-LI"/>
    <case src="17" dst="MAKOTO"/>
    <case src="18" dst="Q"/>
    <case src="19" dst="TWELVE"/>
    <case src="20" dst="REMY"/>
  </format>

  <!-- Grade byte: sequential from G through MSF. -->
  <format id="grade">
    <case src="0" dst="G"/>
    <case src="1" dst="G+"/>
    <case src="2" dst="G++"/>
    <case src="3" dst="F"/>
    <case src="4" dst="F+"/>
    <case src="5" dst="F++"/>
    <case src="6" dst="E"/>
    <case src="7" dst="E+"/>
    <case src="8" dst="E++"/>
    <case src="9" dst="D"/>
    <case src="10" dst="D+"/>
    <case src="11" dst="D++"/>
    <case src="12" dst="C"/>
    <case src="13" dst="C+"/>
    <case src="14" dst="C++"/>
    <case src="15" dst="B"/>
    <case src="16" dst="B+"/>
    <case src="17" dst="B++"/>
    <case src="18" dst="A"/>
    <case src="19" dst="A+"/>
    <case src="20" dst="A++"/>
    <case src="21" dst="S"/>
    <case src="22" dst="S+"/>
    <case src="23" dst="S++"/>
    <case src="24" dst="SS"/>
    <case src="25" dst="SS+"/>
    <case src="26" dst="SS++"/>
    <case src="27" dst="XS"/>
    <case src="28" dst="XS+"/>
    <case src="29" dst="XS++"/>
    <case src="30" dst="XS+++"/>
    <case src="31" dst="MSF"/>
  </format>

  <format id="ordinal">
    <case src="0" dst="1st"/>
    <case src="1" dst="2nd"/>
    <case src="2" dst="3rd"/>
    <case src="3" dst="4th"/>
    <case src="4" dst="5th"/>
  </format>

  <!-- Initial-entry charset: 0-9 then A-Z -->
  <charset id="sfiii_name">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
    <char src="0x0A" dst="A"/>
    <char src="0x0B" dst="B"/>
    <char src="0x0C" dst="C"/>
    <char src="0x0D" dst="D"/>
    <char src="0x0E" dst="E"/>
    <char src="0x0F" dst="F"/>
    <char src="0x10" dst="G"/>
    <char src="0x11" dst="H"/>
    <char src="0x12" dst="I"/>
    <char src="0x13" dst="J"/>
    <char src="0x14" dst="K"/>
    <char src="0x15" dst="L"/>
    <char src="0x16" dst="M"/>
    <char src="0x17" dst="N"/>
    <char src="0x18" dst="O"/>
    <char src="0x19" dst="P"/>
    <char src="0x1A" dst="Q"/>
    <char src="0x1B" dst="R"/>
    <char src="0x1C" dst="S"/>
    <char src="0x1D" dst="T"/>
    <char src="0x1E" dst="U"/>
    <char src="0x1F" dst="V"/>
    <char src="0x20" dst="W"/>
    <char src="0x21" dst="X"/>
    <char src="0x22" dst="Y"/>
    <char src="0x23" dst="Z"/>
  </charset>

</hi2txt>
