<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- macrossp by Banpresto, 1996 -->
<!-- hiscore.dat: @:maincpu,program,f16ddc,5e,00,14 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>94</size>
    </check>

    <!-- BLOCK 1: Scores (7 records x 4 bytes = 28 bytes) -->
    <loop count="7">
      <elt size="4" type="int" id="SCORE"/>
    </loop>

    <!-- Gap of 4 bytes before names start at offset 32 -->
    <elt size="4" type="raw" id="GAP"/>

    <!-- BLOCK 2: Names (7 records x 8 bytes = 56 bytes) -->
    <!-- byte-skip="odd" removes the leading nulls in the 00 XX 00 XX pattern -->
    <loop count="7">
      <elt size="8" type="text" id="NAME" byte-skip="odd" charset="macrossp_chars"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <!-- format adds the required < > brackets and trims trailing spaces -->
      <column id="NAME"  src="NAME"  format="trim_right;bracket_name"/>
      <!-- PadL70 ensures the 7-digit look (0300000) -->
      <column id="SCORE" src="SCORE" format="PadL70;comma_score"/>
    </table>
  </output>

  <!-- Wraps the name in brackets -->
  <format id="bracket_name">
    <prefix>&lt;</prefix>
    <suffix>&gt;</suffix>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- NMK/Banpresto Character Mapping (A=1) -->
  <charset id="macrossp_chars">
    <char src="0x01" dst="A"/><char src="0x02" dst="B"/><char src="0x03" dst="C"/>
    <char src="0x04" dst="D"/><char src="0x05" dst="E"/><char src="0x06" dst="F"/>
    <char src="0x07" dst="G"/><char src="0x08" dst="H"/><char src="0x09" dst="I"/>
    <char src="0x0A" dst="J"/><char src="0x0B" dst="K"/><char src="0x0C" dst="L"/>
    <char src="0x0D" dst="M"/><char src="0x0E" dst="N"/><char src="0x0F" dst="O"/>
    <char src="0x10" dst="P"/><char src="0x11" dst="Q"/><char src="0x12" dst="R"/>
    <char src="0x13" dst="S"/><char src="0x14" dst="T"/><char src="0x15" dst="U"/>
    <char src="0x16" dst="V"/><char src="0x17" dst="W"/><char src="0x18" dst="X"/>
    <char src="0x19" dst="Y"/><char src="0x1A" dst="Z"/>
    <char src="0x1C" dst="·"/> <!-- Middle Dot / Period -->
    <char src="0x00" dst=" "/> <!-- Space -->
  </charset>
</hi2txt>