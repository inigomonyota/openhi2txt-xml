<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check>
      <!-- Size of mercs.hi produced by MAME hiscore plugin for Mercs -->
      <size>160</size>
    </check>

    <!-- 10 entries, 16 bytes each:
         0-1  : unused/flags
         2-7  : score as 6 decimal digits, one digit per byte (not packed BCD)
         8-15 : NAME as plain ASCII, padded with spaces -->
    <loop count="10">
      <elt size="2" type="raw"  id="RAW0"/>
      <elt size="1" type="int"  id="D1"/>
      <elt size="1" type="int"  id="D2"/>
      <elt size="1" type="int"  id="D3"/>
      <elt size="1" type="int"  id="D4"/>
      <elt size="1" type="int"  id="D5"/>
      <elt size="1" type="int"  id="D6"/>
      <elt size="8" type="text" id="NAME"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="NAME"/>
    </table>
  </output>

  <!-- SCORE = D1*100000 + D2*10000 + D3*1000 + D4*100 + D5*10 + D6 -->
  <format id="score">
    <sum>
      <column id="D1" format="*100000"/>
      <column id="D2" format="*10000"/>
      <column id="D3" format="*1000"/>
      <column id="D4" format="*100"/>
      <column id="D5" format="*10"/>
      <column id="D6"/>
    </sum>
  </format>
</hi2txt>
