<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- salmndr2 by Konami, 1996 -->
<!-- hiscore.dat: @:maincpu,program,c02033,140,00,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>320</size>
    </check>

    <!-- 20 records, 16 bytes each -->
    <loop count="20">
      <!-- Byte 0-2: Score (Hex integer / 100) -->
      <elt size="3" type="int"  id="SCORE_RAW"/>
      <!-- Byte 3-5: Name (3 characters) -->
      <elt size="3" type="text" id="NAME" charset="konami_s2"/>
      <!-- Byte 6-15: Padding -->
      <elt size="10" type="raw" id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE_RAW" format="*100;comma_score"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/><case src="3" dst="4TH"/><case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/><case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/><case src="9" dst="10TH"/>
    <case src="10" dst="11TH"/><case src="11" dst="12TH"/><case src="12" dst="13TH"/><case src="14" dst="15TH"/>
    <case src="13" dst="14TH"/><case src="15" dst="16TH"/><case src="16" dst="17TH"/><case src="17" dst="18TH"/>
    <case src="18" dst="19TH"/><case src="19" dst="20TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="konami_s2">
    <char src="0x03" dst="A"/><char src="0x04" dst="B"/><char src="0x05" dst="C"/>
    <char src="0x06" dst="D"/><char src="0x07" dst="E"/><char src="0x08" dst="F"/>
    <char src="0x09" dst="G"/><char src="0x0A" dst="H"/><char src="0x0B" dst="I"/>
    <char src="0x0C" dst="J"/><char src="0x0D" dst="K"/><char src="0x0E" dst="L"/>
    <char src="0x0F" dst="M"/><char src="0x10" dst="N"/><char src="0x11" dst="O"/>
    <char src="0x12" dst="P"/><char src="0x13" dst="Q"/><char src="0x14" dst="R"/>
    <char src="0x15" dst="S"/><char src="0x16" dst="T"/><char src="0x17" dst="U"/>
    <char src="0x18" dst="V"/><char src="0x19" dst="W"/><char src="0x1A" dst="X"/>
    <char src="0x1B" dst="Y"/><char src="0x1C" dst="Z"/>
    <!-- Special symbols from your hex dump -->
    <char src="0x27" dst="?"/>
    <char src="0x28" dst="!"/>
    <char src="0x29" dst="+"/>
    <char src="0x2A" dst="-"/>
    <char src="0x2B" dst="/"/>
    <char src="0x2E" dst="·"/>
  </charset>
</hi2txt>