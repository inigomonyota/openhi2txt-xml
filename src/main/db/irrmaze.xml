<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<hi2txt>

  <!--
    irrmaze - The Irritating Maze / Ultra Denryu Iraira Bou (SNK/Success, Neo Geo)
    Reads the MAME saveram file (nvram/irrmaze/saveram), 65536 bytes.

    Neo Geo 68000: saveram is word-swapped, so structure uses byte-swap 2.
    Three single-entry ranking records of 6 bytes from 0x0644 (post-swap):
      [0:3] NAME  3 ASCII chars (three dashes = blank default)
      [3]   0xFF terminator
      [4:6] TIME  2 bytes; 0 = no record (shown as a blank time marker)
    Order: NOVICE, EXPERT, PROFESSIONAL.

    NOTE: all default TIME values are 0 (blank). The format of a real non-zero
    completion time is unverified (no played sample); non-zero values pass
    through as a raw number pending a sample.
  -->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>

    <!-- skip to first record at 0x0644 (1604 bytes) -->
    <elt size="1604" type="raw" id="PRE"/>
    <elt size="3" type="text" id="NOV_NAME"/>
    <elt size="1" type="raw"  id="NOV_TERM"/>
    <elt size="2" type="int"  id="NOV_TIME"/>
    <elt size="3" type="text" id="EXP_NAME"/>
    <elt size="1" type="raw"  id="EXP_TERM"/>
    <elt size="2" type="int"  id="EXP_TIME"/>
    <elt size="3" type="text" id="PRO_NAME"/>
    <elt size="1" type="raw"  id="PRO_TERM"/>
    <elt size="2" type="int"  id="PRO_TIME"/>
  </structure>

  <!-- time 0 maps to the blank record marker -->
  <format id="time">
    <case src="0" dst="-&apos;--&quot;--"/>
  </format>

  <output>
    <table id="RANKING - NOVICE">
      <column id="NAME" src="NOV_NAME"/>
      <column id="TIME" src="NOV_TIME" format="time"/>
    </table>
    <table id="RANKING - EXPERT">
      <column id="NAME" src="EXP_NAME"/>
      <column id="TIME" src="EXP_TIME" format="time"/>
    </table>
    <table id="RANKING - PROFESSIONAL">
      <column id="NAME" src="PRO_NAME"/>
      <column id="TIME" src="PRO_TIME" format="time"/>
    </table>
  </output>

</hi2txt>
