<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!-- calibr50 (Caliber 50, Seta 1988). Reads the native nvram (4096 bytes).
     The game APPENDS an end-of-game completion record (armed force + dog-tag name)
     into a list of 32-byte slots starting at 0x00. Each slot:
       +0x00  armed force (16-bit LE): 0=US ARMY 1=US NAVY 2=US AIR FORCE 3=US MARINE CORPS
       +0x02  name, up to 7 chars, one 16-bit word per char (byte-swap="2" per char)
       +0x10  14 bytes padding (zero)
       +0x1e  valid marker (16-bit LE): 0x00ff on a written slot, 0 on an empty slot
     The game is a 100-entry circular buffer: it fills slots 0..99, then wraps
     (counter at 0x0e00 resets to 0 and overwrites the oldest). Confirmed by trace:
     cmpi.w #$63 (=99) at PC 0x1cf2. Loop reads all 100; empties hidden via line-ignore.
     Verified: slot0 = US NAVY / ZZZZTER ; slot1 = US MARINE CORPS / (skull)!(block)HTER.

     charset cs_az maps the name-entry glyphs. A=0x00..Z=0x19, plus the "odd" glyphs
     seen on dog tags:  0x25 '!'   0x26 skull   0x29 solid block.
     More glyphs to be added as further captures identify them. -->
<hi2txt>
  <structure file="nvram">
    <check>
      <size>4096</size>
    </check>
    <loop count="100">
      <elt id="FORCE"  size="2"  type="int"  endianness="little_endian"/>
      <elt id="NAME"   size="14" type="text" src-unit-size="16" byte-swap="2" charset="cs_az"/>
      <elt id="PAD"    size="14" type="raw"/>
      <elt id="MARKER" size="2"  type="int"  endianness="little_endian"/>
    </loop>
  </structure>

  <output>
    <table id="CONGRATULATIONS! GAME COMPLETED BY:" line-ignore="MARKER:0">
      <column id=" "      src="FORCE"  format="force"/>
      <column id="  "     src="NAME"/>
      <column id="MARKER" src="MARKER" display="debug"/>
    </table>
  </output>

  <format id="force">
    <case src="0" dst="US ARMY"/>
    <case src="1" dst="US NAVY"/>
    <case src="2" dst="US AIR FORCE"/>
    <case src="3" dst="US MARINE CORPS"/>
  </format>

  <charset id="cs_az">
    <char src="0x00" dst="A"/><char src="0x01" dst="B"/><char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/><char src="0x04" dst="E"/><char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/><char src="0x07" dst="H"/><char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/><char src="0x0a" dst="K"/><char src="0x0b" dst="L"/>
    <char src="0x0c" dst="M"/><char src="0x0d" dst="N"/><char src="0x0e" dst="O"/>
    <char src="0x0f" dst="P"/><char src="0x10" dst="Q"/><char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/><char src="0x13" dst="T"/><char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/><char src="0x16" dst="W"/><char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/><char src="0x19" dst="Z"/>
    <char src="0x1a" dst="1"/><char src="0x1b" dst="2"/><char src="0x1c" dst="3"/>
    <char src="0x1d" dst="4"/><char src="0x1e" dst="5"/><char src="0x1f" dst="6"/>
    <char src="0x20" dst="7"/><char src="0x21" dst="8"/><char src="0x22" dst="9"/>
    <char src="0x23" dst="0"/>
    <char src="0x24" dst=","/>   <!-- small punctuation; you've read it as . and , -->
    <char src="0x25" dst="!"/>
    <char src="0x26" dst="☺"/>   <!-- smiley, confirmed -->
    <char src="0x27" dst=" "/>   <!-- space, confirmed -->
    <char src="0x29" dst="■"/>   <!-- earlier dog tag showed a solid block here, not a space -->
  </charset>
</hi2txt>
