<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hi2txt>
<hi2txt label="Sky Fox">
  <structure file=".hi">
    <check><size>51</size></check>
    <loop count="5">
      <elt id="SCORE" type="int" size="2" base="16"/>
    </loop>
    <loop count="5">
      <elt id="NAME" type="text" size="8" ascii-offset="64" charset="CS_SKYFOX"/>
    </loop>
    <elt id="TRAILER" type="raw" size="1"/>
  </structure>

  <charset id="CS_SKYFOX">
    <char src="0x00" dst=" "/>
  </charset>

  <format id="RANK_FMT">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <format id="*100"><multiply>100</multiply></format>

  <output>
    <table id="RANKING TABLE" lines-max="5">
      <column id="RANK"  src="index" format="RANK_FMT"/>
      <column id="SCORE" src="SCORE" format="*100"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>
</hi2txt>
