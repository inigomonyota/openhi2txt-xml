<?xml version="1.0" encoding="UTF-8"?>
<hi2txt>
<!-- SDI - Strategic Defense Initiative (Sega System 16, nvram). 68000 => byte-swap="2".
     SDI MOST VALUABLE COMMANDERS table @ raw 0x3800, 94 records x 8 bytes:
       [0:4] SCORE 4-byte packed BCD
       [4:7] NAME  3 ASCII chars (spaces are significant)
       [7]   flag byte (0x80 on rank 1 = highlight; 0x20 otherwise); not displayed
     RANK uses full English ordinals (1ST..94TH).
     NOTE: names are output as the raw 3 chars incl. spaces (file-authoritative). The reference
     XML trims leading/all-space names inconsistently (e.g. row 6 keeps "  K" but row 12 shows
     "S" for the same "space space letter" pattern, and empty rows blank out "   "); those
     whitespace-only differences on ranks 12+ are reference quirks, not decode errors. -->
<structure file="nvram" byte-swap="2">
  <check>
    <size>16384</size>
  </check>
  <elt size="14336" type="raw" id="HEADER"/>
  <loop count="94">
    <elt size="4" type="int"  id="SCORE" base="16"/>
    <elt size="3" type="text" id="NAME"/>
    <elt size="1" type="raw"  id="FLAG"/>
  </loop>
</structure>

<format id="rank">
  <case src="0" dst="1ST"/>
  <case src="1" dst="2ND"/>
  <case src="2" dst="3RD"/>
  <case src="3" dst="4TH"/>
  <case src="4" dst="5TH"/>
  <case src="5" dst="6TH"/>
