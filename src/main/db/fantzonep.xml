<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Fantasy Zone (set 2, unprotected)">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,fffc00,38,00,95
                  @:maincpu,program,ffc22c,4,00,00</definition>
      <size>60</size>
    </check>
    <loop count="7">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="int"  id="ROUND"/>
      <elt size="3" type="text" id="NAME"  charset="fantzonep" ascii-offset="-64"/>
    </loop>
    <elt size="4" type="int" id="TOP SCORE" base="16"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="ROUND"/>
    </table>
    <field id="TOP SCORE"/>
  </output>

  <charset id="fantzonep">
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>
