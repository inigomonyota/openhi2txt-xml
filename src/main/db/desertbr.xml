<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Desert Breaker">
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 17 bytes
      [0]     unknown flag/counter byte (0x15 on init)
      [1:5]   top score, 4-byte big-endian integer
      [5:17]  3 redundant copies of top score (ignored)
  //-->

  <structure file=".hi">
    <check>
      <size>17</size>
    </check>
    <elt size="1"  type="raw" id="HEADER"/>
    <elt size="4"  type="int" id="TOP SCORE"/>
    <elt size="12" type="raw" id="REDUNDANT"/>
  </structure>

  <output>
    <table>
      <column id="TOP SCORE"/>
    </table>
  </output>

</hi2txt>