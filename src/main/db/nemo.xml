<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- nemo by Capcom, 1990 -->
<!-- hiscore.dat: fff004,28 | fff054,14 | fff07c,04 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>64</size>
    </check>

    <!-- Block 1: 5 records, 8 bytes each (40 bytes total) -->
    <!-- Records achieved in chronoligical order; we use sort="SCORE" -->
    <loop count="5">
      <!-- Score is 4-byte BCD (e.g., 00 07 87 00 = 78,700) -->
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <!-- Name is 4 bytes ASCII -->
      <elt size="4" type="text" id="NAME"/>
    </loop>

    <!-- Block 2: NMK/Capcom system gap (20 bytes) -->
    <elt size="20" type="raw" id="GAP"/>

    <!-- Block 3: Global Top Score (Last 4 bytes) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="comma_score" display="extra"/-->

    <table id="RANKING BEST 5" sort="SCORE" sort-order="desc">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"  format="trim_right"/>
    </table>
  </output>

  <!-- Translates 0-4 into 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>