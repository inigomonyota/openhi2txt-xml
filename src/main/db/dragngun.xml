<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- dragngun: Dragongun by Data East Corporation, 1992 -->
<!-- hiscore.dat: @:maincpu,program,11f384,140,20,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>320</size>
    </check>

    <!-- 20 records, 16 bytes each -->
    <loop count="20">
      <!-- 4-byte Little Endian Integer -->
      <elt size="4" type="int"  id="SCORE" endianness="little_endian"/>
      <!-- 4-byte Text string (Data East 4-char name support) -->
      <elt size="4" type="text" id="NAME"  charset="de_names"/>
      <!-- 4-byte Little Endian Integer -->
      <elt size="4" type="int"  id="STAGE" endianness="little_endian"/>
      <!-- 4-byte Little Endian Integer -->
      <elt size="4" type="int"  id="CONTINUES" endianness="little_endian"/>
    </loop>
  </structure>

  <output>
    <table id="BEST PLAYERS">
      <column id="RANK"       src="index"     format="ordinal"/>
      <column id="SCORE"      src="SCORE"     format="comma_score"/>
      <column id="STAGE"      src="STAGE"/>
      <column id="NAME"       src="NAME"/>
      <column id="CONTINUES"  src="CONTINUES"/>
    </table>
  </output>

  <!-- Translates 0-19 into 1ST-20TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/><case src="3" dst="4TH"/><case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/><case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/><case src="9" dst="10TH"/>
    <case src="10" dst="11TH"/><case src="11" dst="12TH"/><case src="12" dst="13TH"/><case src="13" dst="14TH"/><case src="14" dst="15TH"/>
    <case src="15" dst="16TH"/><case src="16" dst="17TH"/><case src="17" dst="18TH"/><case src="18" dst="19TH"/><case src="19" dst="20TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="de_names">
    <char src="0x00" dst=""/> <!-- Removes null terminators from the string -->
  </charset>

</hi2txt>