<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- scross by Sega, 1992 -->
<!-- hiscore.dat: @:mainpcb:maincpu,program,701fb0,3f,53,03 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>63</size>
    </check>

    <!-- 8 records, 8 bytes each -->
    <!-- skip-last-bytes="1" handles the 63-byte file truncation -->
    <loop count="8" skip-last-bytes="1">
      <elt size="4" type="text" id="NAME"/>
      <elt size="1" type="int"  id="TICKS"/>
      <!-- Removed base="16" to allow standard hex-to-decimal conversion (0x1E -> 30) -->
      <elt size="1" type="int"  id="SECONDS"/>
      <elt size="1" type="int"  id="MINUTES"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="COURSE RECORD">
      <column id="NO."   src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"  format="trim_right"/>
      <column id="TIME"  format="stadium_time"/>
    </table>
  </output>

  <!-- Translates 0-7 into 1ST-8TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- Formats Time as M'SS''CC -->
  <format id="stadium_time" input-as-subcolumns-input="yes">
    <concat>
      <column id="MINUTES"/>
      <txt>'</txt>
      <column id="SECONDS" format="PadL20"/>
      <txt>''</txt>
      <column id="TICKS"   format="ticks_to_cs"/>
    </concat>
  </format>

  <!-- Converts 1/30th ticks to 1/100th centiseconds with rounding -->
  <format id="ticks_to_cs">
    <multiply>100</multiply>
    <add>15</add>
    <divide_trunc>30</divide_trunc>
    <pad direction="left" max="2">0</pad>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>