    <case src="0x28" dst="28"/>
    <case src="0x29" dst="29"/>
    <case src="0x30" dst="0"/>
    <case src="0x31" dst="1"/>
    <case src="0x32" dst="2"/>
    <case src="0x33" dst="3"/>
    <case src="0x34" dst="4"/>
    <case src="0x35" dst="5"/>
    <case src="0x36" dst="6"/>
    <case src="0x37" dst="7"/>
    <case src="0x38" dst="8"/>
    <case src="0x39" dst="9"/>
    <case src="0x40" dst="40"/>
    <case src="0x41" dst="41"/>
    <case src="0x42" dst="42"/>
    <case src="0x43" dst="43"/>
    <case src="0x44" dst="44"/>
    <case src="0x45" dst="45"/>
    <case src="0x46" dst="46"/>
    <case src="0x47" dst="47"/>
    <case src="0x48" dst="48"/>
