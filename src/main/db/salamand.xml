<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check>
      <size>104</size>
    </check>

    <!-- 10 entries x 10 bytes + 4 bytes TOP SCORE = 104 bytes
         Per entry (10 bytes):
           0-3 : score as 4 BCD-like bytes (needs special handling for 0x30-0x39 used as 0-9 padding)
           4-9 : name as 3 big-endian 16-bit codes: 00 xx 00 yy 00 zz
    -->
    <loop count="10">
      <elt size="1" type="int" id="S0" base="16"/>
      <elt size="1" type="int" id="S1" base="16"/>
      <elt size="1" type="int" id="S2" base="16"/>
      <elt size="1" type="int" id="S3" base="16"/>
      <elt size="6" type="text" id="NAME" byte-skip="odd" charset="salamand"/>
    </loop>

    <elt size="1" type="int" id="TOP0" base="16"/>
    <elt size="1" type="int" id="TOP1" base="16"/>
    <elt size="1" type="int" id="TOP2" base="16"/>
    <elt size="1" type="int" id="TOP3" base="16"/>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="NAME"/>
    </table>
    <field id="TOP SCORE" format="top_score" display="extra"/>
  </output>

  <!-- SCORE = bcd(S0)*1,000,000 + bcd(S1)*10,000 + bcd(S2)*100 + bcd(S3) -->
  <format id="score">
    <sum>
      <column id="S0" format="bcd_byte;*1000000"/>
      <column id="S1" format="bcd_byte;*10000"/>
      <column id="S2" format="bcd_byte;*100"/>
      <column id="S3" format="bcd_byte"/>
    </sum>
  </format>

  <format id="top_score">
    <sum>
      <field id="TOP0" format="bcd_byte;*1000000"/>
      <field id="TOP1" format="bcd_byte;*10000"/>
      <field id="TOP2" format="bcd_byte;*100"/>
      <field id="TOP3" format="bcd_byte"/>
    </sum>
  </format>

  <!-- Decode one score byte:
       - normal packed BCD for 0x00..0x99
       - but salamand uses 0x30..0x39 as 0..9 (padding as ASCII '0'..'9')
  -->
  <format id="bcd_byte">
    <case src="0x00" dst="0"/>
    <case src="0x01" dst="1"/>
    <case src="0x02" dst="2"/>
    <case src="0x03" dst="3"/>
    <case src="0x04" dst="4"/>
    <case src="0x05" dst="5"/>
    <case src="0x06" dst="6"/>
    <case src="0x07" dst="7"/>
    <case src="0x08" dst="8"/>
    <case src="0x09" dst="9"/>
    <case src="0x10" dst="10"/>
    <case src="0x11" dst="11"/>
    <case src="0x12" dst="12"/>
    <case src="0x13" dst="13"/>
    <case src="0x14" dst="14"/>
    <case src="0x15" dst="15"/>
    <case src="0x16" dst="16"/>
    <case src="0x17" dst="17"/>
    <case src="0x18" dst="18"/>
    <case src="0x19" dst="19"/>
    <case src="0x20" dst="20"/>
    <case src="0x21" dst="21"/>
