<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 55 bytes = 5 entries x 10 bytes + 5-byte trailer
    per entry (10 bytes):
      [0]    0x00 pad
      [1:4]  score, 3-byte BCD (base16)
      [4]    0x00 pad
      [5]    stage (0-based: value+1 = stage shown; 7 = "ALL")
      [6]    0x03 name length constant
      [7:10] name, 3-byte ASCII
    trailer [50:54]: top score, same 3-byte BCD format at [1:4]
    note: screenshot rank 1 shows "44700" but data confirms 444700 (leftmost digit cut off)
    stage ALL = player completed all stages (value 7 exceeds max stage count)
  //-->

  <structure file=".hi">
    <check>
      <size>55</size>
    </check>

    <loop count="5">
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="1" type="int"  id="STAGE"/>
      <elt size="1" type="raw"  id="NAMELEN"/>
      <elt size="3" type="text" id="NAME"/>
    </loop>

    <!-- trailer: top score -->
    <elt size="1" type="raw" id="T_PAD1"/>
    <elt size="3" type="int" id="TOP SCORE" base="16"/>
    <elt size="1" type="raw" id="T_PAD2"/>

  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE"/>
      <column id="STAGE" format="stage"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <format id="stage">
    <case src="1" dst="2"/>
    <case src="2" dst="3"/>
    <case src="3" dst="4"/>
    <case src="4" dst="5"/>
    <case src="5" dst="6"/>
    <case src="6" dst="7"/>
    <case src="7" dst="ALL"/>
  </format>

</hi2txt>