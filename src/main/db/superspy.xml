<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="The Super Spy">
  <!--
    Neo Geo saveram, byte-swap=2 ("BACKUP RAM OK !" confirmed).
    RANKING BEST 5 @ 0x320, 5 x 8B: [SCORE:4 BCD][NAME:3 A=1][LEVEL:1].
    NAME A=1 (ascii-offset=64): SNK = 13 0e 0b (S=19,N=14,K=11).
    SCORE 4-byte BCD (00 03 00 00 = 30000). RANK suffix "·".
  //-->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>
    <elt size="800" type="raw" id="HEADER"/>
    <loop count="5">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  ascii-offset="64"/>
      <elt size="1" type="int"  id="LEVEL"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING BEST 5">
      <column id="RANK"  src="index" format="+1;dot"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="LEVEL"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="dot"><suffix>·</suffix></format>
</hi2txt>
