<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 80 bytes = 10 entries x 8 bytes (exact fit)
    per entry (8 bytes):
      [0:4]  score, 4-byte BCD big-endian (base16)
      [4:7]  name, 3 ASCII chars; 0x3B stored as '.' on screen
      [7]    character index (bitmask): 1=Jenny, 2=Bucky, 4=Dead-Eye, 8=Blinky
  //-->

  <structure file=".hi">
    <check>
      <size>80</size>
    </check>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="bucky"/>
      <elt size="1" type="int"  id="CHARACTER"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"      src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="CHARACTER" format="character"/>
    </table>
  </output>

  <format id="character">
    <case src="1" dst="BLINKY"/>
    <case src="2" dst="BUCKY"/>
    <case src="4" dst="DEAD-EYE"/>
    <case src="8" dst="JENNY"/>
  </format>

  <charset id="bucky">
    <char src="0x3B" dst="."/>
  </charset>

</hi2txt>