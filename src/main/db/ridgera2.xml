<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Ridge Racer 2">
  <!-- [Ridge Racer 2 (Namco System 22, sequel to ridgerac; same board + eeprom
       scheme). The 8192-byte eeprom stores per-course BEST records at file 0x600:
       4 records x 6 bytes = [best-lap][best-total], each a 3-byte packed-BCD time
       whose 6 hex digits read straight as the decimal M SS MMM shown on screen
       (M'SS"MMM). Identical layout to ridgerac - proven there via a played-race
       eeprom diff. The factory eeprom here decodes to COURSE1 1'25"765/2'43"765,
       COURSE2 1'04"765/3'26"765, COURSE3 1'32"765/4'47"765, COURSE4 1'25"765/
       4'26"765 (courses 1-3 match ridgerac's defaults). The attract-mode TODAY'S
       RANKING (names MKM/OAI/... + times) is ROM-resident, NOT persisted in eeprom,
       so it is not decodable here - same as ridgerac. No hiscore.dat exists for any
       System 22 game. base="16" = packed 2-digit-per-byte BCD. //-->
  <structure file="eeprom">
    <check><size>8192</size></check>
    <elt type="raw" size="1536" id="_PREFIX"/>
    <loop count="4">
      <elt size="3" type="int" id="BESTLAP" base="16"/>
      <elt size="3" type="int" id="TOTAL"   base="16"/>
    </loop>
    <elt type="raw" size="6632" id="_REST"/>
  </structure>
  <output>
    <table id="COURSE RECORDS">
      <column id="COURSE"    src="index"   format="course"/>
      <column id="BEST LAP"  src="BESTLAP" format="gtime"/>
      <column id="BEST TIME" src="TOTAL"   format="gtime"/>
    </table>
  </output>
  <format id="course">
    <case src="0" dst="COURSE 1"/>
    <case src="1" dst="COURSE 2"/>
    <case src="2" dst="COURSE 3"/>
    <case src="3" dst="COURSE 4"/>
  </format>
  <format id="t_min"><divide_trunc>100000</divide_trunc></format>
  <format id="t_sec"><divide_trunc>1000</divide_trunc><remainder>100</remainder><pad direction="left" max="2">0</pad></format>
  <format id="t_ms"><remainder>1000</remainder><pad direction="left" max="3">0</pad></format>
  <format id="gtime" input-as-subcolumns-input="yes">
    <concat><column format="t_min"/><txt>'</txt><column format="t_sec"/><txt>"</txt><column format="t_ms"/></concat>
  </format>
</hi2txt>
