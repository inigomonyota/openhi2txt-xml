<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- mhavoc by Atari, 1983 -->
<!-- hiscore.dat: @:alpha,program,184,46,0b,00 | @:alpha,program,95,1,02,02 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>71</size>
    </check>

    <!-- BLOCK 1: NAMES (10 records x 3 bytes = 30 bytes) -->
    <!-- Atari internal encoding: 0x0B = A, 0x0C = B... handled by ascii-offset -->
    <loop count="10">
      <elt size="3" type="text" id="NAME" ascii-offset="54" charset="atari_havoc" table-index="loop_index"/>
    </loop>

    <!-- BLOCK 2: SCORES (10 records x 4 bytes = 40 bytes) -->
    <!-- Stored as Little Endian BCD. e.g., 32 45 09 00 = 94,532 -->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" endianness="little_endian" base="16" table-index="loop_index"/>
    </loop>

    <!-- Final byte from the second hiscore.dat range -->
    <elt size="1" type="raw" id="SENTINEL"/>
  </structure>

  <output>
    <table id="HIGH SCORES">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1-10 -->
  <format id="ordinal">
    <case src="0" dst="1"/><case src="1" dst="2"/><case src="2" dst="3"/>
    <case src="3" dst="4"/><case src="4" dst="5"/><case src="5" dst="6"/>
    <case src="6" dst="7"/><case src="7" dst="8"/><case src="8" dst="9"/>
    <case src="9" dst="10"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Charset for Atari's custom character placement -->
  <charset id="atari_havoc">
    <char src="0x0A" dst=" "/> <!-- Maps the 0x0A value to a space -->
  </charset>
</hi2txt>