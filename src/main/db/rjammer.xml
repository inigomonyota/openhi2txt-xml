<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Roller Jammer">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,a4fa,1e,a8,55</definition>
      <size>30</size>
    </check>
    <loop count="5">
      <elt size="3" type="int"  id="SCORE" endianness="little_endian"/>
      <elt size="3" type="text" id="NAME"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>
</hi2txt>
