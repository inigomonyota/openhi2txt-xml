<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  poundfor - Pound for Pound (Irem Corporation, 1990)
  hiscore.dat:
    @:maincpu,program,e2502,28,10,00
    @:maincpu,program,e252a,28,35,00
    @:maincpu,program,e2552,28,42,00
    @:maincpu,program,e257a,28,00,00
    @:maincpu,program,e25a2,28,11,00
    @:maincpu,program,e25ca,28,59,00
    @:maincpu,program,e25f2,28,68,00
    @:maincpu,program,e261a,28,70,00
    @:maincpu,program,e2642,28,57,00
    @:maincpu,program,e266a,28,41,00
  400 bytes total = 10 ranges x 40 bytes each

  Each 40-byte entry:
    [0-3]   4B BCD LE score. Actual score = decoded x 10.
            Example: "10 72 10 35" -> reverse -> "35 10 72 10"
            -> BCD 35107210 -> x 10 = 351,072,100 (FUJIYAMA)
    [4-19]  16B ASCII name, space-padded (0x20)
    [20-39] 20B boxing stats / unused data (not displayed in ranking)

  Names may contain leading spaces (e.g. "  JAMES", " T O M M Y")
  which reflects how the player typed them during score entry.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>400</size>
    </check>

    <loop count="10">
      <!-- 4B BCD LE score; actual value = decoded x 10 -->
      <elt size="4" type="int" id="SCORE" base="16" endianness="little_endian" table-index="loop_index"/>

      <!-- 16B ASCII name, space-padded -->
      <elt size="16" type="text" id="NAME" table-index="loop_index"/>

      <!-- 20B boxing stats / unused trailing data -->
      <elt size="20" type="raw" id="EXTRA"/>
    </loop>
  </structure>

  <output>
    <table id="ALL TIME RANKING">
      <column id="RANK" src="index" format="+1"/>
      <column id="FIGHT MONEY" src="SCORE" format="score_x10;comma_score;dollar_prefix"/>
      <column id="NAME" src="NAME"/>
    </table>
  </output>

  <!-- Score is stored as actual/10, so multiply by 10 for display -->
  <format id="score_x10"><multiply>10</multiply></format>

  <!-- Prefix score with $ symbol for FIGHT MONEY display -->
  <format id="dollar_prefix"><prefix>$</prefix></format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>
