<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  dangseed - Dangerous Seed (Namco, 1989)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,053f,a0,01,01
    @:maincpu,program,0527,4,00,00
  164 bytes = 160B main (20 x 8B) + 4B top score
  Record (8B): 3B name (charset A=0x01, .=0x2E) + 1B pad + 3B score (BCD x10) + 1B stage
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>164</size>
    </check>
    <loop count="20">
      <elt size="3" type="text" id="NAME" charset="az"/>
      <elt size="1" type="raw" id="PAD"/>
      <elt size="3" type="int" id="SCORE" base="16"/>
      <elt size="1" type="int" id="STAGE"/>
    </loop>
    <!-- Top score (4B) -->
    <elt size="4" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="TOP 20 CHART">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="INITIALS" src="NAME"/>
      <column id="SCORE" format="score_x10"/>
      <column id="STAGE" format="stage_fmt"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" operator="=" dst="NO. 1"/>
    <case src="1" operator="=" dst="NO. 2"/>
    <case src="2" operator="=" dst="NO. 3"/>
    <case src="3" operator="=" dst="NO. 4"/>
    <case src="4" operator="=" dst="NO. 5"/>
    <case src="5" operator="=" dst="NO. 6"/>
    <case src="6" operator="=" dst="NO. 7"/>
    <case src="7" operator="=" dst="NO. 8"/>
    <case src="8" operator="=" dst="NO. 9"/>
    <case src="9" operator="=" dst="NO. 10"/>
    <case src="10" operator="=" dst="NO. 11"/>
    <case src="11" operator="=" dst="NO. 12"/>
    <case src="12" operator="=" dst="NO. 13"/>
    <case src="13" operator="=" dst="NO. 14"/>
    <case src="14" operator="=" dst="NO. 15"/>
    <case src="15" operator="=" dst="NO. 16"/>
    <case src="16" operator="=" dst="NO. 17"/>
    <case src="17" operator="=" dst="NO. 18"/>
    <case src="18" operator="=" dst="NO. 19"/>
    <case src="19" operator="=" dst="NO. 20"/>
  </format>

  <format id="score_x10"><multiply>10</multiply><case src="0" operator="&gt;=" format="comma_score"/></format>

  <!-- Stage format: N -> N-T -->
  <format id="stage_fmt" input-as-subcolumns-input="yes">
    <concat>
      <column/>
      <txt>-T</txt>
    </concat>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="az">
    <char src="0x01" dst="A"/>
    <char src="0x02" dst="B"/>
    <char src="0x03" dst="C"/>
    <char src="0x04" dst="D"/>
    <char src="0x05" dst="E"/>
    <char src="0x06" dst="F"/>
    <char src="0x07" dst="G"/>
    <char src="0x08" dst="H"/>
    <char src="0x09" dst="I"/>
    <char src="0x0A" dst="J"/>
    <char src="0x0B" dst="K"/>
    <char src="0x0C" dst="L"/>
    <char src="0x0D" dst="M"/>
    <char src="0x0E" dst="N"/>
    <char src="0x0F" dst="O"/>
    <char src="0x10" dst="P"/>
    <char src="0x11" dst="Q"/>
    <char src="0x12" dst="R"/>
    <char src="0x13" dst="S"/>
    <char src="0x14" dst="T"/>
    <char src="0x15" dst="U"/>
    <char src="0x16" dst="V"/>
    <char src="0x17" dst="W"/>
    <char src="0x18" dst="X"/>
    <char src="0x19" dst="Y"/>
    <char src="0x1A" dst="Z"/>
    <char src="0x23" dst="(a)"/>
    <char src="0x2E" dst="."/>
  </charset>

</hi2txt>
