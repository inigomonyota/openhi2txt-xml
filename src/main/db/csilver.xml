<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    csilver: Captain Silver (Data East)

    hiscore/csilver.hi is 64 bytes:
      1 byte header
      10 records:
        - 3 bytes SCORE (packed BCD; base=16 decoding) => prints as 6 digits
        - 3 bytes NAME  (ASCII)
      3 byte trailer (top name repeated)
  //-->

  <structure file=".hi">
    <check>
      <size>64</size>
    </check>

    <elt size="1" type="raw" id="HEADER"/>

    <loop count="10">
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
    </loop>

    <elt size="3" type="raw" id="TRAILER"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="PadL60"/>
      <column id="NAME"/>
    </table>
  </output>
</hi2txt>
