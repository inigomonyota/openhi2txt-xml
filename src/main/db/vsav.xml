<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  vsav - Vampire Savior: The Lord of Vampire (Capcom, 1997)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,fff426,b0,00,00
  176 bytes = 6 SCORE entries x 16B + 5 VS entries x 16B
  Record (16B): 4B score BCD + 3B name (A=0) + 1B pad + 1B char_id +
                1B meta + 2B pad + 1B wins + 1B mode + 2B pad
  Mode: 0=NORMAL, 1=TURBO
  SCORE RANKING: entries 1-6 (display 5, entry 6 is overflow)
  VS RANKING: entries 7-11 (display 5, entry 11 truncated - missing 3B trailing pad)
  Character IDs confirmed: 01=DEMITRI 05=MORRIGAN 06=ANAKARIS 0C=Q-BEE 0E=LILITH
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>176</size>
    </check>
    <!-- SCORE RANKING: 6 entries x 16B (5 displayed + 1 overflow) -->
    <loop count="6">
      <elt size="4" type="int" id="SSCORE" base="16"/>
      <elt size="3" type="text" id="SNAME" charset="az"/>
      <elt size="1" type="raw" id="SPAD"/>
      <elt size="1" type="int" id="SCHAR"/>
      <elt size="3" type="raw" id="SMETA"/>
      <elt size="1" type="raw" id="SWINS"/>
      <elt size="1" type="int" id="SMODE"/>
      <elt size="2" type="raw" id="SMETA2"/>
    </loop>
    <!-- VS RANKING: 5 entries x 16B -->
    <loop count="5">
      <elt size="4" type="raw" id="VPAD1"/>
      <elt size="3" type="text" id="VNAME" charset="az"/>
      <elt size="1" type="raw" id="VPAD2"/>
      <elt size="1" type="int" id="VCHAR"/>
      <elt size="3" type="raw" id="VMETA"/>
      <elt size="1" type="int" id="VWINS"/>
      <elt size="1" type="int" id="VMODE"/>
      <elt size="2" type="raw" id="VMETA2"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING" sort="SSCORE" sort-order="desc" lines-max="5">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="SNAME"/>
      <column id="SCORE" src="SSCORE"/>
      <column id="MODE" src="SMODE" format="mode"/>
      <column id="CHARACTER" src="SCHAR" format="charname"/>
    </table>
    <table id="VS RANKING" sort="VWINS" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="VNAME"/>
      <column id="WINS" src="VWINS"/>
      <column id="MODE" src="VMODE" format="mode"/>
      <column id="CHARACTER" src="VCHAR" format="charname"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="mode">
    <case src="0" operator="=" dst="NORMAL"/>
    <case src="1" operator="=" dst="TURBO"/>
  </format>

  <format id="charname">
    <case src="1" operator="=" dst="DEMITRI"/>
    <case src="2" operator="=" dst="GALLON"/>
    <case src="3" operator="=" dst="VICTOR"/>
    <case src="4" operator="=" dst="ZABEL"/>
    <case src="5" operator="=" dst="MORRIGAN"/>
    <case src="6" operator="=" dst="ANAKARIS"/>
    <case src="7" operator="=" dst="BISHAMON"/>
    <case src="8" operator="=" dst="AULBATH"/>
    <case src="9" operator="=" dst="SASQUATCH"/>
    <case src="10" operator="=" dst="FELICIA"/>
    <case src="11" operator="=" dst="LEI-LEI"/>
    <case src="12" operator="=" dst="Q-BEE"/>
    <case src="13" operator="=" dst="JEDAH"/>
    <case src="14" operator="=" dst="LILITH"/>
    <case src="15" operator="=" dst="B.B.HOOD"/>
  </format>

  <charset id="az">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
    <char src="0x2D" dst="."/>
  </charset>

</hi2txt>