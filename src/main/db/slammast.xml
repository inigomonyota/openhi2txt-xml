<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>176</size></check>
    <!-- 22 records * 8 bytes = 176 -->
    <!-- record: score[4] (packed BCD), name[3] ASCII, char[1] id -->
    <!-- SINGLE MATCH (11) -->
    <loop count="11">
      <elt size="4" type="int"  id="SCORE_SINGLE" base="16" endianness="big_endian"/>
      <elt size="3" type="text" id="NAME_SINGLE"/>
      <elt size="1" type="text" id="CHAR_SINGLE" charset="slammast_char"/>
    </loop>
    <!-- TEAM BATTLE ROYAL (11) -->
    <loop count="11">
      <elt size="4" type="int"  id="SCORE_TEAM" base="16" endianness="big_endian"/>
      <elt size="3" type="text" id="NAME_TEAM"/>
      <elt size="1" type="text" id="CHAR_TEAM" charset="slammast_char"/>
    </loop>
  </structure>
  <output>
    <table id="SINGLE MATCH">
      <column id="RANK" src="index" format="rank_label"/>
      <column id="SCORE" src="SCORE_SINGLE"/>
      <column id="NAME" src="NAME_SINGLE"/>
      <column id="CHARACTER" src="CHAR_SINGLE"/>
    </table>
    <table id="TEAM BATTLE ROYAL">
      <column id="RANK" src="index" format="rank_label"/>
      <column id="SCORE" src="SCORE_TEAM"/>
      <column id="NAME" src="NAME_TEAM"/>
      <column id="CHARACTER" src="CHAR_TEAM"/>
    </table>
  </output>
  <format id="rank_label">
    <case src="0" dst="CHAMP"/>
    <case src="1" dst="1"/>
    <case src="2" dst="2"/>
    <case src="3" dst="3"/>
    <case src="4" dst="4"/>
    <case src="5" dst="5"/>
    <case src="6" dst="6"/>
    <case src="7" dst="7"/>
    <case src="8" dst="8"/>
    <case src="9" dst="9"/>
    <case src="10" dst="10" default="yes"/>
  </format>
  <charset id="slammast_char">
    <char src="0x00" dst="BIFF"/>
    <char src="0x01" dst="GUNLOC"/>
    <char src="0x02" dst="ONI"/>
    <char src="0x03" dst="TIM"/>
    <char src="0x04" dst="EL STINGRAY"/>
    <char src="0x05" dst="HAGGAR"/>
    <char src="0x06" dst="ALEXANDER"/>
    <char src="0x07" dst="RASTA MON"/>
    <char src="0x08" dst="JUMBO"/>
    <char src="0x09" dst="SCORP"/>
    <char src="0xFF" dst="UNKNOWN" default="yes"/>
  </charset>
</hi2txt>