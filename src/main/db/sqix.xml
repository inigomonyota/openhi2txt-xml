<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 44 bytes -->
    <check><size>44</size></check>
    
    <!-- 5 records * 8 bytes each = 40 bytes -->
    <loop count="5">
      <!-- 4-byte Big-Endian BCD Score (missing the final 0) -->
      <elt size="4" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      
      <!-- 3-byte Name. Letters are mapped mathematically with a step of 2! -->
      <elt size="3" type="text" id="NAME" ascii-step="2" ascii-offset="17" charset="sqix_char"/>
      
      <!-- 1-byte integer for the Round (RD) -->
      <elt size="1" type="int"  id="ROUND" endianness="big_endian"/>
    </loop>

    <!-- The remaining 4 bytes track the standalone Top Score -->
    <elt size="4" type="raw" id="TRAIL"/>
  </structure>

  <output>
    <table id="TOP 5">
      <column id="NO"    src="index" format="+1"/>
      <column id="SCORE" src="SCORE" format="*10"/>
      <column id="NAME"  src="NAME"/>
      <column id="RD"    src="ROUND" format="PadL20"/>
    </table>
  </output>

  <!-- Translates the index from 0-4 to 1-5 -->
  <format id="+1">
    <add>1</add>
  </format>

  <!-- We use a tiny charset to catch special punctuation that breaks the math rule -->
  <charset id="sqix_char">
    <!-- The game uses 0xF4 for the hyphen (-) seen in Rank 4 "CE-" -->
    <char src="0xF4" dst="-"/>
  </charset>
</hi2txt>