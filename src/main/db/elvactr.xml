<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  elvactr - Elevator Action Returns (Taito, 1994)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,40ce3a,7c,00,01
    @:maincpu,program,40ce3c,1,c3,c3
  125 bytes = 10 entries x 12B + 4B tail + 1B range 2
  Record (12B): 2B pad + 2B score (BE int) + 1B pad + 1B comment_id +
                2B meta + 3B name (ASCII) + 1B pad
  Comment IDs: 1=NO COMMENTS. 2=SEE YOU AGAIN. (others TBD)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
    <size>125</size>
    </check>
    <loop count="10">
      <elt size="2" type="raw" id="PAD1"/>
      <elt size="2" type="int" id="SCORE"/>
      <elt size="1" type="raw" id="PAD2"/>
      <elt size="1" type="int" id="COMMENT"/>
      <elt size="2" type="raw" id="META"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw" id="PAD3"/>
    </loop>
    <elt size="4" type="raw" id="TAIL"/>
    <elt size="1" type="raw" id="RANGE2"/>
  </structure>

  <output>
    <table id="THE BEST PLAYERS" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE"/>
      <column id="COMMENTS" src="COMMENT" format="comment"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="comment">
    <case src="1" operator="=" dst="NO COMMENTS."/>
    <case src="2" operator="=" dst="SEE YOU AGAIN."/>
    <case src="3" operator="=" dst="GREAT PLAY!"/>
    <case src="4" operator="=" dst="PERFECT!"/>
  </format>

</hi2txt>