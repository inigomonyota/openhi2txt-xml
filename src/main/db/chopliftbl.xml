<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  chopliftbl - Choplifter (Sega/Irem bootleg, 1985)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,ef00,31,00,4b
    @:maincpu,program,ef71,4,00,00
  53 bytes = 7 entries x 7B + 4B checksum
  Record: 1B pad + 2B score (BCD LE, x100) + 1B pad + 3B name
  Score stored as 2-byte BCD little-endian, multiply by 100 for display.
  Name charset: 0x5D = '.' (period)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>53</size>
    </check>
    <loop count="7">
      <elt size="1" type="raw" id="SP1"/>
      <elt size="2" type="int" id="SCORE" base="16" endianness="little_endian"/>
      <elt size="1" type="raw" id="SP2"/>
      <elt size="3" type="text" id="NAME" charset="cs_chopliftbl" byte-trim="0x00"/>
    </loop>
    <elt size="4" type="raw" id="CHECKSUM"/>
  </structure>

  <output>
    <table id="CHOPLIFTER SPECIALISTS">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="score_x100"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="score_x100"><multiply>100</multiply></format>

  <charset id="cs_chopliftbl">
    <char src="0x5D" dst="."/>
  </charset>

</hi2txt>