<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  hi2txt description for Track & Field (trackfld)

  Reads MAME's 2048-byte nvram directly - no hiscore.dat entry needed.

  Based on the HiToText definition, with three changes:
    1. the six per-event tables no longer carry display="extra" on every
       column, so they actually appear in normal output
    2. event 4 is 110M HURDLES, not 100M HURDLES
    3. blank rows are dropped via line-ignore, and ranks print as ordinals

  Layout:
    0x000-0x3FF  1024 bytes of settings / bookkeeping (not decoded)
    0x400-0x4BF  six events x 4 entries of 8 bytes:
                     [0-3] record, one decimal digit per byte
                     [4-6] name, 3 chars, +48 to reach ascii
                     [7]   separator
                 entries 1-3 hold the world records, entry 4 is blank
    0x4C0-0x7DF  TOP SCORES: 160 entries of 5 bytes
                     [0-2] score, bcd, x10
                     [3-4] name, konami base-32, 3 chars in 2 bytes
                 100 entries are populated by default, all at 10000
    0x7E0-0x7FF  32 bytes of trailing bookkeeping (not decoded)

  Factory defaults for reference:
      100M DASH     9.95  10.00  10.12  sec
      LONG JUMP     8.90   8.77   8.43  m
      JAVELIN      96.72  90.21  84.96  m
      110M HURDLES 12.93  13.08  13.26  sec
      HAMMER       83.93  79.96  76.05  m
      HIGH JUMP     2.36   2.30   2.25  m
//-->
<hi2txt>

  <structure file="nvram">
    <check>
      <size>2048</size>
    </check>

    <elt size="1024" type="raw" id="SETTINGS"/>

    <!-- 100M DASH world records //-->
    <loop count="3">
      <elt size="4" type="int"  id="100M DASH SCORE" decoding-profile="bcd"/>
      <elt size="3" type="text" id="100M DASH NAME"  charset="trackfld2" ascii-offset="48"/>
      <elt size="1" type="raw"  id="100M DASH SEPARATOR"/>
    </loop>
    <elt size="8" type="raw" id="100M DASH BLANK SLOT"/>
    <!-- LONG JUMP world records //-->
    <loop count="3">
      <elt size="4" type="int"  id="LONG JUMP SCORE" decoding-profile="bcd"/>
      <elt size="3" type="text" id="LONG JUMP NAME"  charset="trackfld2" ascii-offset="48"/>
      <elt size="1" type="raw"  id="LONG JUMP SEPARATOR"/>
    </loop>
    <elt size="8" type="raw" id="LONG JUMP BLANK SLOT"/>
    <!-- JAVELIN world records //-->
    <loop count="3">
      <elt size="4" type="int"  id="JAVELIN SCORE" decoding-profile="bcd"/>
      <elt size="3" type="text" id="JAVELIN NAME"  charset="trackfld2" ascii-offset="48"/>
      <elt size="1" type="raw"  id="JAVELIN SEPARATOR"/>
    </loop>
    <elt size="8" type="raw" id="JAVELIN BLANK SLOT"/>
    <!-- 110M HURDLES world records //-->
    <loop count="3">
      <elt size="4" type="int"  id="110M HURDLES SCORE" decoding-profile="bcd"/>
      <elt size="3" type="text" id="110M HURDLES NAME"  charset="trackfld2" ascii-offset="48"/>
      <elt size="1" type="raw"  id="110M HURDLES SEPARATOR"/>
    </loop>
    <elt size="8" type="raw" id="110M HURDLES BLANK SLOT"/>
    <!-- HAMMER world records //-->
    <loop count="3">
      <elt size="4" type="int"  id="HAMMER SCORE" decoding-profile="bcd"/>
      <elt size="3" type="text" id="HAMMER NAME"  charset="trackfld2" ascii-offset="48"/>
      <elt size="1" type="raw"  id="HAMMER SEPARATOR"/>
    </loop>
    <elt size="8" type="raw" id="HAMMER BLANK SLOT"/>
    <!-- HIGH JUMP world records //-->
    <loop count="3">
      <elt size="4" type="int"  id="HIGH JUMP SCORE" decoding-profile="bcd"/>
      <elt size="3" type="text" id="HIGH JUMP NAME"  charset="trackfld2" ascii-offset="48"/>
      <elt size="1" type="raw"  id="HIGH JUMP SEPARATOR"/>
    </loop>
    <elt size="8" type="raw" id="HIGH JUMP BLANK SLOT"/>

    <!-- main high score table //-->
    <loop count="160">
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="2" type="text" id="NAME"  decoding-profile="base-32" charset="trackfld"/>
    </loop>

    <elt size="32" type="raw" id="BOOKKEEPING"/>
  </structure>

  <output>

    <table id="100M DASH WORLD RECORDS">
      <column id="RANK"   src="index"     format="rank"/>
      <column id="RECORD" src="100M DASH SCORE"  format="time"/>
      <column id="NAME"   src="100M DASH NAME"/>
    </table>

    <table id="LONG JUMP WORLD RECORDS">
      <column id="RANK"   src="index"     format="rank"/>
      <column id="RECORD" src="LONG JUMP SCORE"  format="distance"/>
      <column id="NAME"   src="LONG JUMP NAME"/>
    </table>

    <table id="JAVELIN WORLD RECORDS">
      <column id="RANK"   src="index"     format="rank"/>
      <column id="RECORD" src="JAVELIN SCORE"  format="distance"/>
      <column id="NAME"   src="JAVELIN NAME"/>
    </table>

    <table id="110M HURDLES WORLD RECORDS">
      <column id="RANK"   src="index"     format="rank"/>
      <column id="RECORD" src="110M HURDLES SCORE"  format="time"/>
      <column id="NAME"   src="110M HURDLES NAME"/>
    </table>

    <table id="HAMMER WORLD RECORDS">
      <column id="RANK"   src="index"     format="rank"/>
      <column id="RECORD" src="HAMMER SCORE"  format="distance"/>
      <column id="NAME"   src="HAMMER NAME"/>
    </table>

    <table id="HIGH JUMP WORLD RECORDS">
      <column id="RANK"   src="index"     format="rank"/>
      <column id="RECORD" src="HIGH JUMP SCORE"  format="distance"/>
      <column id="NAME"   src="HIGH JUMP NAME"/>
    </table>
	
	<table id="TOP SCORES" line-ignore="SCORE:0">
      <column id="RANK"  src="index" format="rank"/>
      <column id="SCORE" src="SCORE"  format="*10"/>
      <column id="NAME"  src="NAME"/>
    </table>

  </output>

