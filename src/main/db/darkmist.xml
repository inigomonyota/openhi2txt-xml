<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Dark Mist">
  <!--
    hiscore.dat: @:maincpu,program,e01d,8c,00,20
    10 entries x 14 bytes = 140 bytes
    Score: 4 bytes BCD (base=16)
    Name:  10 bytes ASCII/tile-indexed, space-padded
    Special tiles: 0x01=$  0x02=_SW(swastika)  0x03=_GATE  0x04=_CROSS
                   0x05=_STAR  0x06=_SKULL  0x07=_HEART  0x08=_GHOST
                   0x09=_FACE  0x0a=_X(unknown)
  //-->

  <structure file="hi">
    <check>
      <size>140</size>
    </check>
    <loop count="10">
      <elt size="4"  type="int"  id="SCORE" base="16"/>
      <elt size="10" type="text" id="NAME"  charset="darkmist"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="rank"/>
      <column id="SCORE"/>
      <column id="NAME"  format="TrimR "/>
    </table>
  </output>

  <format id="rank">
    <case src="0"  dst="1:"/>
    <case src="1"  dst="2:"/>
    <case src="2"  dst="3:"/>
    <case src="3"  dst="4:"/>
    <case src="4"  dst="5:"/>
    <case src="5"  dst="6:"/>
    <case src="6"  dst="7:"/>
    <case src="7"  dst="8:"/>
    <case src="8"  dst="9:"/>
    <case src="9"  dst="10:"/>
  </format>

  <charset id="darkmist">
    <char src="0x01" dst="$"/>
    <char src="0x02" dst="X"/>
    <char src="0x03" dst="_"/>
    <char src="0x04" dst="_"/>
    <char src="0x05" dst="_"/>
    <char src="0x06" dst="_"/>
    <char src="0x07" dst="_"/>
    <char src="0x08" dst="_"/>
    <char src="0x09" dst="_"/>
    <char src="0x0a" dst="_"/>
    <char src="0x20" dst=" "/>
    <char src="0x21" dst="!"/>
    <char src="0x26" dst="&amp;"/>
    <char src="0x2c" dst=","/>
    <char src="0x2e" dst="."/>
    <char src="0x3b" dst=";"/>
    <char src="0x3c" dst="&lt;"/>
    <char src="0x3d" dst="="/>
    <char src="0x3e" dst="&gt;"/>
    <char src="0x3f" dst="?"/>
  </charset>

</hi2txt>