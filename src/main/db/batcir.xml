<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>280</size></check>
    
    <loop count="20">
      <elt size="6" type="text" id="NAME" byte-skip="odd" charset="batcir_char"/>
      <elt size="4" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      <elt size="1" type="int"  id="CHAR"/>
      <elt size="1" type="int"  id="STAGE"/>
      <elt size="1" type="int"  id="TITLE"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING BEST 10" lines-max="10">
      <column id="RANK"      src="index" format="ordinal"/>
      <column id="NAME"      src="NAME"/>
      <column id="TITLE"     src="TITLE" format="title_map"/>
      <column id="SCORE"     src="SCORE"/>
      <column id="CHARACTER" src="CHAR"  format="char_map"/>
      <column id="STAGE"     src="STAGE" format="+1"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1st"/>
    <case src="1" dst="2nd"/>
    <case src="2" dst="3rd"/>
    <case src="3" dst="4th"/>
    <case src="4" dst="5th"/>
    <case src="5" dst="6th"/>
    <case src="6" dst="7th"/>
    <case src="7" dst="8th"/>
    <case src="8" dst="9th"/>
    <case src="9" dst="10th"/>
  </format>

  <!-- Translates the internal 0-based index to standard 1-based level numbers -->
  <format id="+1">
    <add>1</add>
  </format>

  <format id="char_map">
    <case src="0" dst="CYBER BLUE"/>
    <case src="1" dst="CAPTAIN SILVER"/>
    <case src="2" dst="YELLOW IRIS"/>
    <case src="3" dst="PINK OSTRICH"/>
    <case src="4" dst="ALIEN GREEN"/>
  </format>

  <format id="title_map">
    <case src="0" dst="MEGA SOLDIER"/>
    <case src="1" dst="GIGA SOLDIER"/>
    <case src="2" dst="MEGA SNIPER"/>
    <case src="3" dst="GIGA SNIPER"/>
    <case src="4" dst="MEGA BUSTER"/>
    <case src="0" operator="!=" format="*1" default="yes"/> 
  </format>

  <charset id="batcir_char">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
    <char src="0xFF" dst="?" default="yes"/>
  </charset>
</hi2txt>