<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  pbobble3 - Puzzle Bobble 3 (Taito, 1996)
  Taito F3 hardware, 68EC020 CPU.
  hiscore.dat: @:maincpu,program,41eff0,99,00,04
  153 bytes.

  Layout: 5 Puzzle entries + 5 VS CPU entries, stored in display order.
  Each record is 16B, but the final entry (VS CPU rank 5) is truncated
  to 9 bytes (7 trailing pad bytes not captured by hiscore.dat).
  5×16 + 5×16 - 7 = 80 + 73 = 153 ✓

  16-byte record:
    [0-3]  Score  (4B BCD big-endian; displayed value = BCD × 10)
    [4]    Round  (1B int)
    [5-7]  Name   (3B ASCII)
    [8]    Character ID (1B int, 0-8)
    [9-15] Padding (7B zeros)

  Character IDs:
    0=BUB / BOB  1=TWINKLE  2=PRICCIO  3=MARINA  4=MUSASHI
    5=LUNA LUNA  6=JACK  7=SUPER SONIC BLAST MAN  8=DEB

  "PTS" suffix seen on-screen is display chrome, not stored in file.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>153</size>
    </check>

    <!-- PUZZLE MODE: 5 × 16B records (bytes 0-79) -->
    <loop count="5">
      <elt size="4" type="int" id="PZ_SCORE" base="16" table-index="loop_index"/>
      <elt size="1" type="int" id="PZ_ROUND" table-index="loop_index"/>
      <elt size="3" type="text" id="PZ_NAME" table-index="loop_index"/>
      <elt size="1" type="int" id="PZ_CHAR" table-index="loop_index"/>
      <elt size="7" type="raw" id="PZ_PAD"/>
    </loop>

    <!-- VS CPU MODE: 5 × 16B records (bytes 80-152), last 7B truncated -->
    <loop count="5" skip-last-bytes="7">
      <elt size="4" type="int" id="VS_SCORE" base="16" table-index="loop_index"/>
      <elt size="1" type="int" id="VS_ROUND" table-index="loop_index"/>
      <elt size="3" type="text" id="VS_NAME" table-index="loop_index"/>
      <elt size="1" type="int" id="VS_CHAR" table-index="loop_index"/>
      <elt size="7" type="raw" id="VS_PAD"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING - PUZZLE MODE" sort="SCORE" sort-order="desc" sort-format="sort_num">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="ROUND" src="PZ_ROUND"/>
      <column id="CHARACTER" src="PZ_CHAR" format="char_name"/>
      <column id="SCORE" src="PZ_SCORE" format="score_x10;comma_score"/>
      <column id="NAME" src="PZ_NAME"/>
    </table>

    <table id="RANKING - VS CPU MODE" sort="SCORE" sort-order="desc" sort-format="sort_num">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="ROUND" src="VS_ROUND"/>
      <column id="CHARACTER" src="VS_CHAR" format="char_name"/>
      <column id="SCORE" src="VS_SCORE" format="score_x10;comma_score"/>
      <column id="NAME" src="VS_NAME"/>
    </table>
  </output>

  <!-- Ordinal rank (0-4 -> 1ST-5TH) -->
  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
    <case src="3" operator="=" dst="4TH"/>
    <case src="4" operator="=" dst="5TH"/>
  </format>

  <!-- Character ID (0-8) -> character name -->
  <format id="char_name">
    <case src="0" operator="=" dst="BUB / BOB"/>
    <case src="1" operator="=" dst="TWINKLE"/>
    <case src="2" operator="=" dst="PRICCIO"/>
    <case src="3" operator="=" dst="MARINA"/>
    <case src="4" operator="=" dst="MUSASHI"/>
    <case src="5" operator="=" dst="LUNA LUNA"/>
    <case src="6" operator="=" dst="JACK"/>
    <case src="7" operator="=" dst="SUPER SONIC BLAST MAN"/>
    <case src="8" operator="=" dst="DEB"/>
  </format>

  <!-- BCD score stored as score/10; multiply by 10 for display -->
  <format id="score_x10"><multiply>10</multiply></format>

  <!-- Pass-through for numeric sort (bypasses any string formatting) -->
  <format id="sort_num"><multiply>1</multiply></format>

<!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>
