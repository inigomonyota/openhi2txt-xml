<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  sfa - Street Fighter Alpha: Warriors' Dreams (Capcom, 1995)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat: @:maincpu,program,ffaea0,a0,01,00
  160 bytes = 2 tables of 5 entries x 16 bytes each
  Record: 4B header + 4B score (BCD) + 3B name (ASCII) + 5B tail = 16 bytes
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>160</size>
    </check>
    <!-- Score Ranking: 5 entries x 16 bytes -->
    <loop count="5">
      <elt size="4" type="raw" id="SPAD1"/>
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="SNAME"/>
      <elt size="5" type="raw" id="SPAD2"/>
    </loop>
    <!-- VS Ranking: 5 entries x 16 bytes -->
    <loop count="5">
      <elt size="4" type="raw" id="VPAD1"/>
      <elt size="4" type="int" id="VSCORE" base="16"/>
      <elt size="3" type="text" id="VNAME"/>
      <elt size="5" type="raw" id="VPAD2"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE"/>
      <column id="NAME" src="SNAME"/>
    </table>
    <table id="VS RANKING" sort="VSCORE" sort-order="desc">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE" src="VSCORE"/>
      <column id="NAME" src="VNAME"/>
    </table>
  </output>

  <format id="ordinal">
    <add>1</add>
    <replace src="1" dst="1ST"/>
    <replace src="2" dst="2ND"/>
    <replace src="3" dst="3RD"/>
    <replace src="4" dst="4TH"/>
    <replace src="5" dst="5TH"/>
  </format>

</hi2txt>