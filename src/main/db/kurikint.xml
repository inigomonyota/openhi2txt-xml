<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    Kuri Kinton (World)
    ROM: kurikint (also kurikinta, kurikintj, kurikintu, kurikintw)
    tested with mame and embedded hiscore.dat
      source: analysis of .hi file
    .hi file: 160 bytes
    10 entries x 16 bytes
    Each entry (16 bytes):
      +0   4 bytes  SCORE (BCD big-endian)
      +4   3 bytes  NAME  (ASCII)
      +7   9 bytes  padding
  //-->
  <structure file=".hi">
    <check>
      <definition>0:8aa3:a0:00:2e</definition>
      <size>160</size>
    </check>
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="9" type="raw"  id="PAD"/>
    </loop>
  </structure>
  <output>
    <table id="TOP 10">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="PAD" format="hexadecimal_string" display="debug"/>
    </table>
  </output>
  <format id="ordinal">
    <case src="0" dst="1st"/>
    <case src="1" dst="2nd"/>
    <case src="2" dst="3rd"/>
    <case src="3" dst="4th"/>
    <case src="4" dst="5th"/>
    <case src="5" dst="6th"/>
    <case src="6" dst="7th"/>
    <case src="7" dst="8th"/>
    <case src="8" dst="9th"/>
    <case src="9" dst="10th"/>
  </format>
</hi2txt>