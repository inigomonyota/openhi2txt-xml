<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  eprom - Escape from the Planet of the Robot Monsters / E.P.R.O.M. (Atari Games, 1989)
  hiscore.dat:
    @:maincpu,program,3f7de8,c8,00,98
  200 bytes = 40 entries x 5 bytes

  Per-entry layout (5 bytes):
    [0]   Padding (always 0x00)
    [1-2] Score (2-byte big-endian int)
    [3-4] Internal metadata (NOT a name encoding)

  KNOWN LIMITATION: Player names cannot be extracted from this file.

  Detailed investigation in MAME debugger established:
    - The 2 bytes after each score (e.g. 53AC, 221D, 4DE7) are NOT name
      letters in any encoding. Proof: rank 19 (REM) and rank 37 (LRW)
      have IDENTICAL 5-byte records (00 27 10 4D E7) but display as
      different names. Two records cannot encode different output if
      they contain identical bytes.
    - Plain-ASCII searches (find 3F0000,10000,...) for "MOT", "BJS",
      "ERM", and other live names returned no hits in RAM. Names are
      not stored as ASCII anywhere accessible.
    - The ROM at 0x03A45A holds an 8-byte-record default name table
      (ERM, ERM, ERM, ERM, BJS, ...) but this is only the boot defaults
      and is never modified.
    - The eeprom NVRAM dump contains scrambled/parity-encoded score
      data identical to the .hi file but no recoverable name letters.

  Conclusion: eprom uses a packed name encoding (likely 5- or 6-bit
  per character) that cannot be reverse-engineered from the data alone.
  Decoding would require disassembling the game's name display routine.

  This XML therefore outputs RANK and SCORE only.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>200</size>
    </check>

    <loop count="40">
      <elt size="1" type="raw" id="EPAD"/>
      <elt size="2" type="int" id="SCORE" endianness="big_endian" table-index="loop_index"/>
      <elt size="2" type="raw" id="META"/>
    </loop>
  </structure>

  <output>
    <table id="TOP 40">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="comma_score"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>