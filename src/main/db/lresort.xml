<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<hi2txt>

  <!--
    lresort - Last Resort (SNK, Neo Geo)
    Reads the MAME saveram file (nvram/lresort/saveram), 65536 bytes.

    Neo Geo 68000: saveram is word-swapped, so structure uses byte-swap 2.
    TOP 10 RANKING = two contiguous 10-entry arrays (post-swap):
      0x0320  SCORES : 10 x 4-byte BCD (00 21 82 00 gives 218200)
      0x0348  NAMES  : 10 x 4 bytes, ASCII, space-padded
               (short names like "T" are stored padded with spaces;
                the charset below strips the 0x20 padding)
    RANK is positional, shown as 1st..10th.
  -->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>

    <!-- skip to SCORES array at 0x0320 (800 bytes) -->
    <elt size="800" type="raw" id="PRE"/>
    <loop count="10">
      <elt size="4" type="int" base="16" id="SCORE"/>
    </loop>
    <!-- NAMES array at 0x0348 (immediately after) -->
    <loop count="10">
      <elt size="4" type="text" charset="nospace" id="NAME"/>
    </loop>
  </structure>

  <format id="rank">
    <case src="0" dst="1st"/>
    <case src="1" dst="2nd"/>
    <case src="2" dst="3rd"/>
    <case src="3" dst="4th"/>
    <case src="4" dst="5th"/>
    <case src="5" dst="6th"/>
    <case src="6" dst="7th"/>
    <case src="7" dst="8th"/>
    <case src="8" dst="9th"/>
    <case src="9" dst="10th"/>
  </format>

  <output>
    <table id="TOP 10 RANKING">
      <column id="RANK"  src="index" format="rank"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- strip 0x20 space padding from names -->
  <charset id="nospace">
    <char src="0x20" dst=""/>
  </charset>

</hi2txt>
