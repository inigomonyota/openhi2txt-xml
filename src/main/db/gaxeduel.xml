<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE openhi2txt>
<!--
  Golden Axe: The Duel (gaxeduel) - Sega ST-V
  Live ranking table in Low Work RAM (:maincpu program space, 0x002FA974..0x002FA9B3):
    +0x00 (4 bytes): "SEGA" header
    +0x04 (5 x 12 bytes): Top 5 ranking entries (big-endian):
      +0x00 u32 SCORE
      +0x04 3ch NAME
      +0x07 u8  CHARIDX (0=KAIN .. 9=PANCHOS)
      +0x08 4b  UNUSED/PADDING
-->
<openhi2txt requires="0.3.0" label="Golden Axe: The Duel">
  <structure file=".hi">
    <check>
      <size>64</size>
    </check>
    <elt id="HEADER" type="raw" size="4"/>
    <loop count="5">
      <elt id="SCORE" type="int" size="4" endianness="big_endian"/>
      <elt id="NAME" type="text" size="3"/>
      <elt id="CHARIDX" type="int" size="1"/>
      <elt id="PADDING" type="raw" size="4"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING TOP 5" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="NAME"/>
      <column id="SCORE" src="SCORE" format="PAD8"/>
      <column id="CHARACTER" src="CHARIDX" format="charname"/>
    </table>
  </output>

  <format id="PAD8"><pad direction="left" max="8">0</pad></format>
  <format id="charname">
    <case src="0" dst="KAIN"/>
    <case src="1" dst="MILAN"/>
    <case src="2" dst="GILLIUS"/>
    <case src="3" dst="ZOMA"/>
    <case src="4" dst="JAM"/>
    <case src="5" dst="DEATH ADDER"/>
    <case src="6" dst="KEEL"/>
    <case src="7" dst="DOC"/>
    <case src="8" dst="GREEN"/>
    <case src="9" dst="PANCHOS"/>
  </format>
</openhi2txt>
