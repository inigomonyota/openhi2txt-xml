<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  cninja - Caveman Ninja (Data East, 1991)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,1877fb,1,30,30
    @:maincpu,program,1877fa,ae,00,00
  175 bytes = 1B trigger + 14B header (top score + pad) + 160B (20 x 8B entries)
  Record (8B): 4B name (ASCII, space/null padded) + 4B score (BCD)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>175</size>
    </check>
    <!-- Trigger byte -->
    <elt size="1" type="raw" id="TRIGGER"/>
    <!-- Header: 4B top score + 10B pad -->
    <elt size="14" type="raw" id="HEADER"/>
    <!-- 20 entries x 8B -->
    <loop count="20">
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw" id="NPAD"/>
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>
  </structure>

  <output>
    <table id="BEST PLAYERS">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE" format="comma_score"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>
