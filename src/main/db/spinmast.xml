<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Spin Master">
  <!--
    Neo Geo saveram, byte-swap=2 ("BACKUP RAM OK !" signature confirmed).
    BEST SCORE @ post-swap offset 0x320. Parallel-array layout (like 1941.xml):
      SCORE array @0x320: 5 x 4B = [00 pad][3B BCD]  (3-byte BCD = 6 digits, keeps leading zero)
      NAME  array @0x334: 5 x 4B = [3B name A=0][00 pad]
    Name A=0 (ascii-offset=65): D=0x03, E=0x04; '.'=0x26 via charset.
    One table pairs SCORE[i] with NAME[i] by index.
  //-->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>
    <elt size="800" type="raw" id="HEADER"/>
    <loop count="5">
      <elt size="1" type="raw" id="SPAD"/>
      <elt size="3" type="int" id="SCORE" base="16"/>
    </loop>
    <loop count="5">
      <elt size="3" type="text" id="NAME" ascii-offset="65" charset="csSpin"/>
      <elt size="1" type="raw"  id="NPAD"/>
    </loop>
  </structure>

  <output>
    <table id="BEST SCORE">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE" format="PadL60"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <charset id="csSpin">
    <char src="0x26" dst="."/>
  </charset>
</hi2txt>
