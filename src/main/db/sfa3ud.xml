      <elt size="1" type="raw"  id="AS_P2"/>
      <elt size="3" type="int"  id="AS_SCORE" base="16"/>
      <elt size="3" type="text" id="AS_NAME"  charset="sfa3"/>
      <elt size="1" type="raw"  id="AS_CONST"/>
    </loop>
    <!-- V-ISM SCORE RANKING: 29 entries //-->
    <loop count="29">
      <elt size="1" type="int"  id="VS_CHAR"/>
      <elt size="2" type="raw"  id="VS_P0"/>
      <elt size="1" type="raw"  id="VS_GRADE"/>
      <elt size="3" type="raw"  id="VS_P1"/>
      <elt size="1" type="raw"  id="VS_TID"/>
      <elt size="1" type="raw"  id="VS_P2"/>
      <elt size="3" type="int"  id="VS_SCORE" base="16"/>
      <elt size="3" type="text" id="VS_NAME"  charset="sfa3"/>
      <elt size="1" type="raw"  id="VS_CONST"/>
    </loop>
    <!-- X-ISM VS RANKING: 29 entries //-->
    <loop count="29">
      <elt size="1" type="int"  id="XV_CHAR"/>
      <elt size="2" type="raw"  id="XV_P0"/>
      <elt size="1" type="raw"  id="XV_GRADE"/>
      <elt size="3" type="raw"  id="XV_P1"/>
      <elt size="1" type="raw"  id="XV_TID"/>
      <elt size="1" type="raw"  id="XV_P2"/>
      <elt size="3" type="int"  id="XV_WINS" base="16"/>
