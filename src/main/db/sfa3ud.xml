<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  sfa3ud - Street Fighter Alpha 3 (USA 980904 Phoenix Edition) (bootleg)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat: @:maincpu,program,ff23be,ae0,00,05
  2784 bytes = 6 tables x 29 entries x 16 bytes
  Record (16B), verified against factory-default .hi dump:
    +0  CHAR   1B character index (0x00-0x1f)
    +1  pad    2B 00
    +3  GRADE  1B (05/04/03/02 by score band)
    +4  pad    3B 00
    +7  TID    1B table id (0..5)
    +8  pad    1B 00
    +9  VALUE  3B BCD  (SCORE for X/A/V SCORE tables, WINS for VS tables)
    +12 NAME   3B charset A=0
    +15 CONST  1B 0x2d
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <definition>0:ff23be:ae0:00:05</definition>
      <size>2784</size>
    </check>
    <!-- X-ISM SCORE RANKING: 29 entries //-->
    <loop count="29">
      <elt size="1" type="int"  id="XS_CHAR"/>
      <elt size="2" type="raw"  id="XS_P0"/>
      <elt size="1" type="raw"  id="XS_GRADE"/>
      <elt size="3" type="raw"  id="XS_P1"/>
      <elt size="1" type="raw"  id="XS_TID"/>
      <elt size="1" type="raw"  id="XS_P2"/>
      <elt size="3" type="int"  id="XS_SCORE" base="16"/>
      <elt size="3" type="text" id="XS_NAME"  charset="sfa3"/>
      <elt size="1" type="raw"  id="XS_CONST"/>
    </loop>
    <!-- A-ISM SCORE RANKING: 29 entries //-->
    <loop count="29">
      <elt size="1" type="int"  id="AS_CHAR"/>
      <elt size="2" type="raw"  id="AS_P0"/>
      <elt size="1" type="raw"  id="AS_GRADE"/>
      <elt size="3" type="raw"  id="AS_P1"/>
