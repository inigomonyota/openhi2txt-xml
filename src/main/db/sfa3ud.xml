    </loop>
    <!-- A-ISM VS RANKING: 29 entries //-->
    <loop count="29">
      <elt size="1" type="int"  id="AV_CHAR"/>
      <elt size="2" type="raw"  id="AV_P0"/>
      <elt size="1" type="raw"  id="AV_GRADE"/>
      <elt size="3" type="raw"  id="AV_P1"/>
