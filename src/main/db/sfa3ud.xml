      <elt size="1" type="raw"  id="VV_TID"/>
      <elt size="1" type="raw"  id="VV_P2"/>
      <elt size="3" type="int"  id="VV_WINS" base="16"/>
      <elt size="3" type="text" id="VV_NAME"  charset="sfa3"/>
      <elt size="1" type="raw"  id="VV_CONST"/>
    </loop>
  </structure>

  <output>
    <table id="X-ISM SCORE RANKING" sort="XS_SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="XS_NAME"/>
      <column id="SCORE" src="XS_SCORE"/>
      <column id="CHARACTER" src="XS_CHAR" format="charname"/>
    </table>
    <table id="A-ISM SCORE RANKING" sort="AS_SCORE" sort-order="desc">
