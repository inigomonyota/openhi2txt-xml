<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- duckhunt by Nintendo, 1985 -->
<!-- hiscore.dat: @:maincpu,program,640,20,12,28 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>32</size>
    </check>

    <!-- 5 records, 5 bytes each: 2 (Score BCD) + 3 (Name) -->
    <loop count="5">
      <elt size="2" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="duckhunt"/>
    </loop>
  </structure>

  <output>
    <table id="DO YOUR BEST!">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="*100;comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-4 into 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Nintendo character set derived from the .hi hex dump -->
  <charset id="duckhunt">
    <char src="0x0A" dst="A"/>
    <char src="0x0E" dst="E"/>
    <char src="0x12" dst="I"/>
    <char src="0x16" dst="M"/>
    <char src="0x17" dst="N"/>
    <char src="0x27" dst="J"/>
    <char src="0x28" dst="K"/>
    <char src="0x2C" dst="Z"/>
    <char src="0x2E" dst="-"/>
    <char src="0x2F" dst="."/>
  </charset>
</hi2txt>