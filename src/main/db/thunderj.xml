<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>150</size></check>
    
    <loop count="30">
      <elt size="3" type="int"  id="SCORE" endianness="big_endian"/>
      <elt size="2" type="text" id="NAME"  decoding-profile="base-40"/>
    </loop>
  </structure>

  <output>
    <table id="MOST EXCELLENT DIVERS">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="NAME"  format="fix_space"/>
      <column id="SCORE" src="SCORE"/>
    </table>
  </output>

  <format id="+1">
    <add>1</add>
  </format>

  <!-- Replaces the @ symbol generated by the base-40 profile with a blank space -->
  <format id="fix_space">
    <replace src="@" dst=" "/>
  </format>
</hi2txt>