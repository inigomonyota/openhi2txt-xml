<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  mainevt - The Main Event (Konami, 1988)
  hiscore.dat: @:maincpu,program,415d,45,ae,77
  69 bytes total

  Layout: 10 entries of 6 bytes each separated by 0xFF bytes:
    10 × 6B records + 9 × 0xFF separators = 60 + 9 = 69 ✓

  6-byte entry record:
    [0-2] Name (3 bytes, custom Konami charset)
    [3]   Null separator (0x00)
    [4-5] Score (2 bytes packed BCD big-endian, stored as score/10)

  Custom Konami charset (derived from known entries):
    0x9F       = '?' (single)
    0xA0       = '!?' (ligature)
    0xA1       = '!!' (ligature)
    0xA8       = 'W/' (ligature)
    0xAC-0xB5  = '0'-'9'
    0xB6-0xCF  = 'A'-'Z'
	0xA6       = 'Mr' (ligature)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>69</size>
    </check>

    <!-- 10 entries × 7B each (3 name + 1 null + 2 score + 1 separator)
         The last entry is missing its trailing separator, hence skip-last-bytes="1" -->
    <loop count="10" skip-last-bytes="1">
      <elt size="3" type="text" id="NAME" charset="mainevt_chr" table-index="loop_index"/>
      <elt size="1" type="raw"  id="ESEP"/>
      <elt size="2" type="int"  id="SCORE" base="16" endianness="big_endian" table-index="loop_index"/>
      <elt size="1" type="raw"  id="ETRIG"/>
    </loop>
  </structure>

  <output>
    <table id="OFFICIAL RATINGS">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME"/>
      <column id="SCORE" format="score_x10"/>
    </table>
  </output>

  <!-- Ordinal rank -->
  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
    <case src="3" operator="=" dst="4TH"/>
    <case src="4" operator="=" dst="5TH"/>
    <case src="5" operator="=" dst="6TH"/>
    <case src="6" operator="=" dst="7TH"/>
    <case src="7" operator="=" dst="8TH"/>
    <case src="8" operator="=" dst="9TH"/>
    <case src="9" operator="=" dst="10TH"/>
  </format>

  <!-- Score stored as score/10 -->
  <format id="score_x10"><multiply>10</multiply></format>

  <charset id="mainevt_chr">
    <char src="0xAC" dst="0"/>
    <char src="0xAD" dst="1"/>
    <char src="0xAE" dst="2"/>
    <char src="0xAF" dst="3"/>
    <char src="0xB0" dst="4"/>
    <char src="0xB1" dst="5"/>
