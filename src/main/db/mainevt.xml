    <char src="0x9F" dst="?"/>
    <char src="0xA0" dst="!?"/>
    <char src="0xA1" dst="!!"/>
	<char src="0xA6" dst="Mr"/>
	<char src="0xA5" dst="Jr"/>
    <char src="0xA7" dst="&amp;"/>
    <char src="0xA8" dst="W/"/>
    <char src="0xA9" dst="&lt;HEART&gt;"/>
    <char src="0xAB" dst="#"/>
	<char src="0xA3" dst="Mc"/>
	<char src="0xA4" dst="Dr"/>
	<char src="0xAA" dst="&gt;"/>
  </charset>

</hi2txt>
