<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Sega Rally Championship">
  <!--
    Sega Model 2 (i960 little-endian), file=backup1, NO byte-swap, strings FORWARD.
    (The 128B eeprom is settings only.)
    CHAMPIONSHIP TOP 16 @ offset 0x3c4, 16 x 12B:
      [TIME:4 int LE frames@60fps][NAME:4 ASCII+null][FLAG:4 int LE]
    TIME = frame count @60fps -> M'SS"CC.
    FLAG: bit1 = CAR (0=CELICA,1=DELTA), bit0 = TRANSMISSION (0=AT,1=MT).
  //-->

  <structure file="backup1">
    <check>
      <size>16384</size>
    </check>
    <elt size="964" type="raw" id="HEADER"/>
    <loop count="16">
      <elt size="4" type="int"  id="TIME" endianness="little_endian"/>
      <elt size="4" type="text" id="NAME" byte-trunc="0x00"/>
      <elt size="4" type="int"  id="FLAG" endianness="little_endian"/>
    </loop>
  </structure>

  <output>
    <table id="CHAMPIONSHIP TOP 16">
      <column id="RANK"         src="index" format="+1"/>
      <column id="NAME"/>
      <column id="TIME"         format="time_fmt"/>
      <column id="CAR"          src="FLAG"  format="carmap"/>
      <column id="TRANSMISSION" src="FLAG"  format="transmap"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="time_fmt" input-as-subcolumns-input="yes">
    <concat>
      <column format="d3600"/>
      <txt>'</txt>
      <column format="%3600;d60;PadL20"/>
      <txt>&quot;</txt>
      <column format="%60;*100;d60;PadL20"/>
    </concat>
  </format>

  <format id="carmap">
    <case src="0" dst="CELICA"/>
    <case src="1" dst="CELICA"/>
    <case src="2" dst="DELTA"/>
    <case src="3" dst="DELTA"/>
  </format>

  <format id="transmap">
    <case src="0" dst="AT"/>
    <case src="1" dst="MT"/>
    <case src="2" dst="AT"/>
    <case src="3" dst="MT"/>
  </format>

</hi2txt>
