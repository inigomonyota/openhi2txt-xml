<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hi2txt>
<hi2txt label="Fire Trap">
  <structure file=".hi">
    <check><size>93</size></check>
    <elt id="TOP_SCORE" type="int" size="3" base="16"/>
    <loop count="10">
      <elt id="SCORE" type="int"  size="3" base="16"/>
      <elt id="STAGE" type="int"  size="1"/>
      <elt id="NAME"  type="text" size="5" ascii-offset="55" charset="CS_FIRETRAP"/>
    </loop>
  </structure>

  <charset id="CS_FIRETRAP">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
    <char src="0x24" dst="."/>
    <char src="0x25" dst=" "/>
  </charset>

  <format id="RANK_FMT">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <output>
    <field id="TOP SCORE" src="TOP_SCORE" display="extra"/>
    <table id="TODAY'S BEST FIREFIGHTERS" lines-max="10">
      <column id="RANK"  src="index" format="RANK_FMT"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"/>
      <column id="STAGE" src="STAGE"/>
    </table>
  </output>
</hi2txt>
