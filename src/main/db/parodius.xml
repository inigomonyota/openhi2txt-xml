<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- parodius by Konami, 1990 -->
<!-- hiscore.dat: @:maincpu,program,1f50,5e,00,00 | @:maincpu,program,1f51,1,05,05 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>95</size>
    </check>

    <!-- 10 records, 9 bytes each (Total 90 bytes) -->
    <loop count="10">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="konami_parodius"/>
      <elt size="1" type="int"  id="SEX_ID"/>
      <elt size="1" type="raw"  id="RECORD_PAD"/>
    </loop>

    <!-- Global High Score (4 bytes starting at Offset 90) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>

    <!-- Final byte (Sentinel 0x05 from hiscore.dat) -->
    <elt size="1" type="raw" id="SENTINEL"/>
  </structure>

  <output>
    <!-- Displays the Global Top Score with commas and no leading zeros -->
    <!--field id="HI-SCORE" format="comma_score" display="always"/-->

    <table id="RANKING">
      <column id="RANK"  src="index"  format="ordinal"/>
      <!-- Comma score automatically removes leading zeros from integer inputs -->
      <column id="SCORE" src="SCORE"  format="comma_score"/>
      <column id="NAME"  src="NAME"/>
      <column id="SEX"   src="SEX_ID" format="sex_map"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1"/><case src="1" dst="2"/><case src="2" dst="3"/>
    <case src="3" dst="4"/><case src="4" dst="5"/><case src="5" dst="6"/>
    <case src="6" dst="7"/><case src="7" dst="8"/><case src="8" dst="9"/>
    <case src="9" dst="10"/>
  </format>

  <format id="sex_map">
    <case src="1" dst="OTOKO"/>
    <case src="0" dst="ONNA"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Custom Konami Character Map -->
  <charset id="konami_parodius">
    <char src="0x0C" dst="A"/><char src="0x0D" dst="B"/><char src="0x0E" dst="C"/>
    <char src="0x0F" dst="D"/><char src="0x10" dst="E"/><char src="0x11" dst="F"/>
    <char src="0x12" dst="G"/><char src="0x13" dst="H"/><char src="0x14" dst="I"/>
    <char src="0x15" dst="J"/><char src="0x16" dst="K"/><char src="0x17" dst="L"/>
    <char src="0x18" dst="M"/><char src="0x19" dst="N"/><char src="0x1A" dst="O"/>
    <char src="0x1B" dst="P"/><char src="0x1C" dst="Q"/><char src="0x1D" dst="R"/>
    <char src="0x1E" dst="S"/><char src="0x1F" dst="T"/><char src="0x20" dst="U"/>
    <char src="0x21" dst="V"/><char src="0x22" dst="W"/><char src="0x23" dst="X"/>
    <char src="0x24" dst="Y"/><char src="0x25" dst="Z"/>
    <char src="0x29" dst="."/>
  </charset>
</hi2txt>