<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  Cotton 2 (cotton2) - Sega ST-V - high score ranking (single combined chart)

  Source: the LIVE ranking table in WORK RAM (:maincpu program space, 0x0604EC20),
  saved via the companion hiscore.dat. This is where the game keeps and DISPLAYS
  the ranking during a session (the battery-backup block at 0x180000 only holds
  boot defaults and never receives live scores under MAME). Work RAM is normal
  byte memory, so - unlike the backup image - there is NO odd-byte interleave and
  NO byte-skip is needed.

  Table = 20 records x 20 bytes at .hi offset 0 (big-endian):
      +0x00 u32 SCORE | +0x04 3ch NAME (+NUL) | +0x08 u16 STAGE
      +0x0A u8 CHARACTER (0=COTTON,1=APPLI) | +0x0C u16 MAX HIT | +0x10 u16 MAX CHAIN
-->
<hi2txt>
  <structure file=".hi">
    <loop count="20">
      <elt size="4" type="int"  endianness="big_endian" id="SCORE"/>
      <elt size="3" type="text"                          id="NAME"/>
      <elt size="1" type="raw"                           id="NAMEPAD"/>
      <elt size="2" type="int"  endianness="big_endian" id="STAGE"/>
      <elt size="1" type="int"                           id="CHARIDX"/>
      <elt size="1" type="raw"                           id="CHARPAD"/>
      <elt size="2" type="int"  endianness="big_endian" id="MAXHIT"/>
      <elt size="2" type="raw"                           id="MAXHITSTG"/>
      <elt size="2" type="int"  endianness="big_endian" id="MAXCHAIN"/>
      <elt size="2" type="raw"                           id="MAXCHAINSTG"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK"      src="index"   format="ranklabel"/>
      <column id="SCORE"     src="SCORE"/>
      <column id="NAME"      src="NAME"/>
      <column id="STAGE"     src="STAGE"/>
      <column id="CHARACTER" src="CHARIDX" format="charname"/>
      <column id="MAX HIT"   src="MAXHIT"/>
      <column id="MAX CHAIN" src="MAXCHAIN"/>
    </table>
  </output>

  <format id="ranklabel">
    <case src="0" dst="TOP"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
    <case src="10" dst="11TH"/>
    <case src="11" dst="12TH"/>
    <case src="12" dst="13TH"/>
    <case src="13" dst="14TH"/>
    <case src="14" dst="15TH"/>
    <case src="15" dst="16TH"/>
    <case src="16" dst="17TH"/>
    <case src="17" dst="18TH"/>
    <case src="18" dst="19TH"/>
    <case src="19" dst="20TH"/>
  </format>
  <format id="charname">
    <case src="0" dst="COTTON"/>
    <case src="1" dst="APPLI"/>
  </format>
</hi2txt>
