<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <structure file=".hi">
    <check>
      <size>306</size>
    </check>

    <!--
      0x000-0x05F : VS RECORD section
      0x060-0x0BF : MAXHITS section
      0x0C0-0x131 : HI-SCORE section

      There are 13 fighter slots.  Each value/name is written into
      the same table row using table-index="loop_index".
    -->

    <!-- VS RECORD values: 1 byte value + 1 byte unused, 13 fighters -->
    <loop count="13">
      <elt size="1" type="int" id="VS_WINS" table-index="loop_index"/>
      <elt size="1" type="int" id="VS_VALUE_PAD"/>
    </loop>

    <!-- padding before VS names -->
    <elt size="5" type="int" id="VS_PAD_A"/>

    <!-- VS names: 3-byte initials + 1 unused byte, 13 fighters -->
    <loop count="13">
      <elt size="3" type="text" id="VS_NAME"
           charset="asurabus" table-index="loop_index"/>
      <elt size="1" type="int" id="VS_NAME_PAD"/>
    </loop>

    <!-- padding to next 0x60-byte section -->
    <elt size="13" type="int" id="VS_PAD_B"/>

    <!-- MAXHITS values: 1 byte value + 1 byte unused, 13 fighters -->
    <loop count="13">
      <elt size="1" type="int" id="MAX_HITS" table-index="loop_index"/>
      <elt size="1" type="int" id="MAX_VALUE_PAD"/>
    </loop>

    <!-- padding before MAXHITS names -->
    <elt size="5" type="int" id="MAX_PAD_A"/>

    <!-- MAXHITS names: 3-byte initials + 1 unused byte, 13 fighters -->
    <loop count="13">
      <elt size="3" type="text" id="MAX_NAME"
           charset="asurabus" table-index="loop_index"/>
      <elt size="1" type="int" id="MAX_NAME_PAD"/>
    </loop>

    <!-- padding to HI-SCORE section -->
    <elt size="13" type="int" id="MAX_PAD_B"/>

    <!-- HI-SCORE values: 3-byte big-endian score + 1 unused byte -->
    <loop count="13">
      <elt size="3" type="int" id="HI_SCORE"
           endianness="big_endian" table-index="loop_index"/>
      <elt size="1" type="int" id="HI_SCORE_PAD"/>
    </loop>

    <!-- padding before HI-SCORE names -->
    <elt size="11" type="int" id="HI_PAD_A"/>

    <!-- HI-SCORE names: 3-byte initials + 1 unused byte, 13 fighters -->
    <loop count="13">
      <elt size="3" type="text" id="HI_NAME"
           charset="asurabus" table-index="loop_index"/>
      <elt size="1" type="int" id="HI_NAME_PAD"/>
    </loop>

  </structure>

  <output>
    <table id="RECORDS" lines-max="13">
      <column id="FIGHTER" src="index" format="fighter"/>
      <column id="HI-SCORE" src="HI_SCORE"/>
      <column id="HI NAME" src="HI_NAME"/>
      <column id="MAX HITS" src="MAX_HITS"/>
      <column id="MAX NAME" src="MAX_NAME"/>
      <column id="VS WINS" src="VS_WINS"/>
      <column id="VS NAME" src="VS_NAME"/>
    </table>
  </output>

  <format id="fighter">
    <case src="0" dst="Yashaou"/>
    <case src="1" dst="Goat"/>
    <case src="2" dst="Leon"/>
    <case src="3" dst="Chen-Mao"/>
    <case src="4" dst="Zam-B"/>
    <case src="5" dst="Rose Mary"/>
    <case src="6" dst="Alice"/>
    <case src="7" dst="Taros"/>
    <case src="8" dst="Sittara"/>
    <case src="9" dst="Rokurouta"/>
    <case src="10" dst="Zinsuke"/>
    <case src="11" dst="Alice!"/>
    <case src="12" dst="Nanami"/>
  </format>

  <charset id="asurabus">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
  </charset>

</hi2txt>
