<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  xmcota - X-Men: Children of the Atom (Capcom, 1994)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat: @:maincpu,program,ffec8e,3c,00,01
  60 bytes = 3 blocks:
    Block 1: 5 x 4B score (BCD) = 20 bytes
    Block 2: 20 bytes padding (zeros)
    Block 3: 5 x (3B name A=0 + 1B wins) = 20 bytes
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <definition>0:ffec8e:3c:00:01</definition>
      <size>60</size>
    </check>
    <loop count="5">
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>
    <elt size="20" type="raw" id="PAD"/>
    <loop count="5">
      <elt size="3" type="text" id="NAME" charset="xmcota"/>
      <elt size="1" type="int" id="WINS"/>
    </loop>
  </structure>

  <output>
    <table sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME"/>
      <column id="SCORE"/>
      <column id="WINS"/>
    </table>
  </output>
  
  <format id="ordinal">
    <add>1</add>
    <replace src="1" dst="1ST"/>
    <replace src="2" dst="2ND"/>
    <replace src="3" dst="3RD"/>
    <replace src="4" dst="4TH"/>
    <replace src="5" dst="5TH"/>
  </format>

  <charset id="xmcota">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
  </charset>

</hi2txt>