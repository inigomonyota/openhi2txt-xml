<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <structure file=".hi">
    <check>
      <size>19</size>
    </check>

    <!-- Existing verified hiscore.dat byte order -->

    <!-- bytes 0-5: MAX HIT -> display row 1 -->
    <loop count="1">
      <elt size="2" type="int" id="RECORD"
           endianness="big_endian"
           table-index="loop_index" table-index-format="+1"/>
      <elt size="3" type="text" id="NAME"
           charset="asurabld"
           table-index="loop_index" table-index-format="+1"/>
      <elt size="1" type="int" id="CHARACTER"
           table-index="loop_index" table-index-format="+1"/>
    </loop>

    <!-- bytes 6-13: SCORE -> display row 2 -->
    <loop count="1">
      <elt size="4" type="int" id="RECORD"
           endianness="big_endian"
           table-index="loop_index" table-index-format="+2"/>
      <elt size="3" type="text" id="NAME"
           charset="asurabld"
           table-index="loop_index" table-index-format="+2"/>
      <elt size="1" type="int" id="CHARACTER"
           table-index="loop_index" table-index-format="+2"/>
    </loop>

    <!-- bytes 14-18: VS SCORE -> display row 0 -->
    <loop count="1">
      <elt size="1" type="int" id="RECORD"
           format="packed_bcd"
           table-index="loop_index"/>
      <elt size="3" type="text" id="NAME"
           charset="asurabld"
           table-index="loop_index"/>
      <elt size="1" type="int" id="CHARACTER"
           table-index="loop_index"/>
    </loop>
  </structure>

  <output>
    <table id="RECORDS" lines-max="3">
      <column id="CHART" src="index" format="chart"/>
      <column id="RECORD"/>
      <column id="NAME"/>
      <column id="CHARACTER" format="fighter"/>
    </table>
  </output>

  <format id="chart">
    <case src="0" dst="VS SCORE"/>
    <case src="1" dst="MAX HIT"/>
    <case src="2" dst="SCORE"/>
  </format>

