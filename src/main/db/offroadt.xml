<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  offroadt: Ivan Stewart's Super Off-Road Track-Pak
  High scores stored in nvram/offroadt/battery (16384 bytes)
  Native nvram saving - no hiscore.dat entry required.
  Each 99-byte record: 2(counter) + 3(NAME) + 9(gamedata) + 2(SCORE) + 83(racedata)
  Score is little-endian, in units of 1000.
-->
<hi2txt>

  <structure file="battery">
    <check>
      <size>16384</size>
    </check>
    <elt size="44" type="raw" id="HEADER"/>
    <loop count="165">
      <elt size="2"  type="raw"  id="RAW1"/>
      <elt size="3"  type="text" id="NAME"/>
      <elt size="9"  type="raw"  id="RAW2"/>
      <elt size="2"  type="int"  id="SCORE" endianness="little_endian"/>
      <elt size="83" type="raw"  id="RAW3"/>
    </loop>
    <elt size="5" type="raw" id="TAIL"/>
  </structure>

  <output>
    <table id="THE IRONMAN CLUB" line-ignore="SORT_SCORE:0" sort="SORT_SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SORT_SCORE" src="SCORE" format="*1000" display="debug"/>
      <column id="SCORE" format="score_fmt"/>
    </table>
  </output>

  <format id="score_fmt">
    <prefix>$</prefix>
    <suffix>,000</suffix>
  </format>

</hi2txt>