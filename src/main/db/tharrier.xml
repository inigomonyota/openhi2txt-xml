<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    Task Force Harrier [tharrier, UPL/NMK 68000] - MAME hiscore-plugin .hi file (128 bytes).
    Score table = 8 records x 16 bytes, pre-sorted high->low:
      [SCORE:4 BE BCD][STAGE:2 BE][NAME:5 chars, each a 2-byte word, char code in LOW byte]
    SCORE is 4-byte big-endian BCD and the game drops the two trailing zeros, so the
      displayed value = BCD digits x 100  (00 00 08 24 -> 0824 -> 824 -> 82400).
    NAME chars: letters A-Z and '-' are ASCII in the low byte; DIGITS 0-9 are stored as
      tile indices 0x00-0x09 (e.g. '8' = 0x08, seen in "AV-8A"), remapped by the 'names' charset.
    STAGE is the "1" column shown between score and name.
  //-->
  <structure file=".hi">
    <check><size>128</size></check>
    <loop count="8">
      <elt size="4"  type="int"  id="SCORE" endianness="big_endian" base="16"/>
      <elt size="2"  type="int"  id="STAGE" endianness="big_endian"/>
      <elt size="10" type="text" id="NAME"  byte-skip="odd" charset="names"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="STAGE" src="STAGE"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- displayed score = stored BCD value x 100 -->
  <format id="score"><multiply>100</multiply></format>

  <!-- initials: digits are tile indices 0x00-0x09; letters/'-' pass through as ASCII -->
  <charset id="names">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
  </charset>
</hi2txt>
