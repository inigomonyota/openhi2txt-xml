  <format id="CR_hold"><concat><column id="CR_H0"/><column id="CR_H1"/><column id="CR_H2"/></concat></format>
  <format id="CR_val"><sum><column id="CR_VHI" format="*256"/><column id="CR_VLO"/></sum></format>
  <format id="SV_total" input-as-subcolumns-input="true"><concat><column format="+0"/><column>,</column><column format="-73;parscore"/></concat></format>
  <format id="SH_total" input-as-subcolumns-input="true"><concat><column format="+0"/><column>,</column><column format="-72;parscore"/></concat></format>
  <format id="CR_total" input-as-subcolumns-input="true"><concat><column format="+0"/><column>,</column><column format="-72;parscore"/></concat></format>
  <format id="SV_mark"><case src="6000" operator="&gt;=" format="yrds"/><case src="1000" operator="&gt;=" format="+0"/><case src="100" operator="&gt;=" format="feet"/><case src="60" operator="&gt;=" format="SV_total"/><case src="0" default="yes" format="+0"/></format>
  <format id="SH_mark"><case src="6000" operator="&gt;=" format="yrds"/><case src="1000" operator="&gt;=" format="+0"/><case src="100" operator="&gt;=" format="feet"/><case src="60" operator="&gt;=" format="SH_total"/><case src="0" default="yes" format="+0"/></format>
  <format id="CR_mark"><case src="6000" operator="&gt;=" format="yrds"/><case src="1000" operator="&gt;=" format="+0"/><case src="100" operator="&gt;=" format="feet"/><case src="60" operator="&gt;=" format="CR_total"/><case src="0" default="yes" format="+0"/></format>
  <format id="ever_hold"><concat><column id="ED_H0"/><column id="ED_H1"/><column id="ED_H2"/></concat></format>
  <format id="ever_dist"><sum><column id="ED_VHI" format="*256"/><column id="ED_VLO"/></sum></format>
  <format id="evermark"><case src="6000" operator="&gt;=" format="yrds"/><case src="100" operator="&gt;=" format="feet"/><case src="0" default="yes" format="+0"/></format>
  <format id="holefmt"><prefix>#</prefix></format>
  <format id="evermap"><case src="0" dst="Longest Drive Ever"/><case src="1" dst="Longest Putt Ever"/></format>
  <format id="coursemap"><case src="0" dst="Stone Valley"/><case src="1" dst="Sea Haven"/><case src="2" dst="Coyote Run"/></format>
  <format id="plus"><prefix>+</prefix></format>
  <format id="parscore"><case src="0" dst="E"/><case src="0" operator="&gt;" format="plus"/></format>
  <format id="yrds"><divide_trunc>36</divide_trunc><suffix> Yrds</suffix></format>
  <format id="feet"><divide_trunc>12</divide_trunc><suffix> Ft</suffix></format>
  <format id="statmap"><case src="0" dst="Total Score"/><case src="1" dst="Greens Hit"/><case src="2" dst="Number Of Putts"/><case src="3" dst="Fairways Hit"/><case src="4" dst="Eagles or Better"/><case src="5" dst="Birdies"/><case src="6" dst="Longest Drive"/><case src="7" dst="Longest Putt"/><case src="8" dst="Great Shot Points"/></format>
