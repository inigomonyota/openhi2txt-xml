<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- sf: Street Fighter, Capcom, 1987 -->
<!-- hiscore.dat: @:maincpu,program,ff8e72,9c,00,12 | @:maincpu,program,ffc012,8,00,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>164</size>
    </check>

    <!-- 10 records, 16 bytes each -->
    <!-- skip-last-bytes="4" aligns with the 156-byte (0x9C) table limit in hiscore.dat -->
    <loop count="10" skip-last-bytes="4">
      <!-- Table scores are stored as digits 0-9 in the low nibble, divided by 10 -->
      <elt size="8" type="int"  id="SCORE" nibble-skip="odd" base="16"/>
      <elt size="1" type="raw"  id="PAD_1"/>
      <elt size="3" type="text" id="NAME"  ascii-offset="55"/>
      <elt size="4" type="raw"  id="PAD_2"/>
    </loop>

    <!-- Global High Score (Last 8 bytes) -->
    <!-- Unlike the table, this is stored as the full value, so no multiplier is needed -->
    <elt size="8" type="int" id="HI-SCORE" nibble-skip="odd" base="16"/>
  </structure>

  <output>
    <table id="RANKING BEST 10">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="*10;comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>