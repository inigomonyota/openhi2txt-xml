<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Fighting Soccer">
  <!--
    tested with mame 0.159 and hiscore.dat 2015-07-01
    source: GreatStone
  //-->
  
  <structure file=".hi">
    <check>
      <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure versus the provided file //-->
      <definition>0:e349:14:48:01</definition>
      <!-- optional: if defined, it allows to select the good structure versus the provided file
                     useful if multiple structures are defined but hiscore.dat not provided //-->
      <size>20</size>
    </check>
    <loop count="5">
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="int"  id="SCORE" base="16"/>
    </loop>
  </structure>
  
  <output>
    <table id="TOP 5 PLAYERS">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME"/>
	  <column id="SCORE" format="score;ordinal"/>
    </table>
    <field id="TOP SCORE" display="extra"/>
  </output>
  
  <format id="score">
    <case src="3" operator="&gt;" dst="CHAMPION"/>
  </format>
  
  <!-- Translates 1-4 into 1ST MATCH WIN - 4TH MATCH WIN -->
  <format id="ordinal">
    <case src="1" dst="1ST MATCH WIN"/><case src="2" dst="2ND MATCH WIN"/><case src="3" dst="3RD MATCH WIN"/>
  </format>
</hi2txt>
