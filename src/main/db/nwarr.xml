<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 72 bytes -->
    <check><size>72</size></check>
    
    <!-- 6 Records * 12 Bytes = 72 Bytes -->
    <loop count="6">
      <!-- 6-byte Big Endian BCD Score -->
      <elt size="6" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      
      <!-- 3-character ASCII Name -->
      <elt size="3" type="text" id="NAME"/>
      
      <!-- 1 byte name padding (0x00 or 0x20) -->
      <elt size="1" type="raw"  id="NAME_PAD"/>
      
      <!-- 1-byte Win counter -->
      <elt size="1" type="int"  id="WINS"/>
      
      <!-- 1 byte record padding -->
      <elt size="1" type="raw"  id="REC_PAD"/>
    </loop>
  </structure>

  <output>
    <!-- lines-max="5" perfectly hides that 6th invisible record -->
    <table id="BEST 5 FIGHTERS" lines-max="5">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"/>
      <column id="WINS"  src="WINS"/>
    </table>
  </output>

  <!-- Translates the index from 0-4 to match the lowercase layout on screen -->
  <format id="ordinal">
    <case src="0" dst="1st"/>
    <case src="1" dst="2nd"/>
    <case src="2" dst="3rd"/>
    <case src="3" dst="4th"/>
    <case src="4" dst="5th"/>
  </format>
</hi2txt>