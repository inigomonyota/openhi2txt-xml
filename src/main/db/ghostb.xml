<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Ghostbusters">
  <!--
    Ghostbusters (ghostb) - Data East, 1987.
    No nvram: the BEST 10 BUSTERS ranking lives in maincpu work RAM and is
    restored by MAME's hiscore plugin, which dumps it to hiscore\ghostb.hi.
    hiscore.dat (shared with ghostb2a): @:maincpu,program,01c0,76,01,10
      -> 0x76 = 118 bytes starting at 0x01c0; first byte 0x01, last byte 0x10.

    The 118-byte table is 10 ranking records. The first 9 are 12 bytes; the
    10th is truncated to 10 bytes (its trailing 2-byte pad is outside the
    0x76 region, so the region ends on the row-color byte 0x10 = the dat's
    end-check). Each record:
      [0]    first initial   (A=0x01 .. Z=0x1a)
      [1]    separator        (0x1f, shown as '.')
      [2]    last  initial   (A=0x01 .. Z=0x1a)
      [3]    pad (00)
      [4..6] SCORE : 3-byte packed BCD, big-endian (50 00 00 = 500000).
             Read with base="16" (the deployed hi2txt/openhi2txt decode packed
             2-digit-per-byte BCD via base 16; decoding-profile="bcd" is the
             UNPACKED 1-digit-per-byte variant and would misread it).
      [7]    row color attribute (0x10/0x30, alternating) -> skipped
      [8..9] TOTAL GHOST : 2-byte packed BCD, big-endian (01 00 = 100)
      [10..11] pad (00 00) -> absent on the truncated 10th record

    Verified byte-for-byte against the BEST 10 BUSTERS screenshot (e.g. rank 1
    A.O / 100 / 500000, rank 9 T.O / 20 / 11280, rank 10 T.S / 10 / 10000).
    The pixel font makes Y look like V and N like H on screen; the RAM bytes
    are authoritative.

    Authored by Pipmick @ CoinOPS.
  //-->

  <structure file=".hi">
    <check>
      <size>118</size>
    </check>

    <loop count="9">
      <elt size="3" type="text" id="NAME"  charset="csGB"                            table-index="loop_index"/>
      <elt size="1" type="raw"  id="PAD1"                                            table-index="loop_index"/>
      <elt size="3" type="int"  id="SCORE" base="16" endianness="big_endian"         table-index="loop_index"/>
      <elt size="1" type="raw"  id="COLOR"                                           table-index="loop_index"/>
      <elt size="2" type="int"  id="GHOST" base="16" endianness="big_endian"         table-index="loop_index"/>
      <elt size="2" type="raw"  id="PAD2"                                            table-index="loop_index"/>
    </loop>

    <!-- rank 10: truncated record (no trailing 2-byte pad) -->
    <elt size="3" type="text" id="NAME"  charset="csGB"                            table-index="9"/>
    <elt size="1" type="raw"  id="PAD1"                                            table-index="9"/>
    <elt size="3" type="int"  id="SCORE" base="16" endianness="big_endian"         table-index="9"/>
    <elt size="1" type="raw"  id="COLOR"                                           table-index="9"/>
    <elt size="2" type="int"  id="GHOST" base="16" endianness="big_endian"         table-index="9"/>
  </structure>

  <output>
    <table id="BEST 10 BUSTERS">
      <column id="RANK"        src="index" format="+1"/>
      <column id="NAME"        src="NAME"/>
      <column id="TOTAL GHOST" src="GHOST"/>
      <column id="SCORE"       src="SCORE"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <charset id="csGB">
    <char src="0x01" dst="A"/>
    <char src="0x02" dst="B"/>
    <char src="0x03" dst="C"/>
    <char src="0x04" dst="D"/>
    <char src="0x05" dst="E"/>
    <char src="0x06" dst="F"/>
    <char src="0x07" dst="G"/>
    <char src="0x08" dst="H"/>
    <char src="0x09" dst="I"/>
    <char src="0x0a" dst="J"/>
    <char src="0x0b" dst="K"/>
    <char src="0x0c" dst="L"/>
    <char src="0x0d" dst="M"/>
    <char src="0x0e" dst="N"/>
    <char src="0x0f" dst="O"/>
    <char src="0x10" dst="P"/>
    <char src="0x11" dst="Q"/>
    <char src="0x12" dst="R"/>
    <char src="0x13" dst="S"/>
    <char src="0x14" dst="T"/>
    <char src="0x15" dst="U"/>
    <char src="0x16" dst="V"/>
    <char src="0x17" dst="W"/>
    <char src="0x18" dst="X"/>
    <char src="0x19" dst="Y"/>
    <char src="0x1a" dst="Z"/>
    <char src="0x1f" dst="."/>
  </charset>
</hi2txt>
