<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- mystwarr by Konami, 1993 -->
<!-- hiscore.dat: @:maincpu,program,200400,4e,48,01 | @:maincpu,program,200170,4,00,00 | @:maincpu,program,200171,1,10,10 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>83</size>
    </check>

    <!-- 10 records, 8 bytes each: 4 (Name) + 3 (Score) + 1 (Pad) -->
    <loop count="10">
      <elt size="4" type="text" id="NAME" charset="konami"/>
      <!-- Reading 3 bytes prevents grabbing the sentinel byte at the end of the 10th record -->
      <elt size="3" type="int"  id="SCORE_RAW" base="16"/>
      <elt size="1" type="raw"  id="SENTINEL"/>
    </loop>

    <!-- Global Top Score (Last 4 bytes of the 84-byte file) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>
  </structure>

  <output>
    <table id="TOP 10 NINJAS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <!-- Multiplier of 100 restores the two trailing zeros removed by the 3-byte read -->
      <column id="SCORE" src="SCORE_RAW" format="*100;comma_score"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="konami">
    <char src="0x3E" dst="."/>
    <char src="0x3F" dst=""/>
  </charset>
</hi2txt>