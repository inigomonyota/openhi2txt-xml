<?xml version="1.0" encoding="UTF-8"?>
<hi2txt>
<!-- Street Fighter EX 2 (Capcom ZN-2, at28c16 eeprom). Byte-oriented, no byte-swap.
     Record = 12 bytes: [CHARACTER:1][NAME:3 ASCII][VALUE:4 little-endian][pad:4]
       RANKING - SCORE @ raw 0x3c  (VALUE = SCORE, 18 records; 2nd copy at 0x114)
       RANKING - WINS  @ raw 0x1ec (VALUE = WINS, 1 record; 2nd copy at 0x1f8)
     CHARACTER = 1-byte fighter index, case-mapped (index map differs from sfex, e.g. 0x04=HAYATE).
     NOTE: ranks 15-18 (KAI/SDW/GRD/NNS) are the hidden characters (Kairi / Shadowgeist / Garuda /
     Nanase per the name initials); they all share CHARACTER index 0xff, so the specific fighter
     cannot be mapped from the index - 0xff is rendered as empty CHARACTER. -->
<structure file="at28c16">
  <check>
    <size>2080</size>
  </check>
  <elt size="60" type="raw" id="HEADER"/>
  <loop count="18">
    <elt size="1" type="int"  id="CHARACTER"/>
    <elt size="3" type="text" id="NAME"/>
    <elt size="4" type="int"  id="SCORE" endianness="little_endian"/>
    <elt size="4" type="raw"  id="PAD"/>
  </loop>
  <elt size="216" type="raw" id="GAP"/>
  <elt size="1" type="int"  id="WCHARACTER"/>
  <elt size="3" type="text" id="WNAME"/>
  <elt size="4" type="int"  id="WINS" endianness="little_endian"/>
  <elt size="4" type="raw"  id="WPAD"/>
</structure>

<format id="rank">
  <case src="0" dst="1ST"/>
  <case src="1" dst="2ND"/>
  <case src="2" dst="3RD"/>
  <case src="3" dst="4TH"/>
  <case src="4" dst="5TH"/>
  <case src="5" dst="6TH"/>
  <case src="6" dst="7TH"/>
  <case src="7" dst="8TH"/>
  <case src="8" dst="9TH"/>
  <case src="9" dst="10TH"/>
  <case src="10" dst="11TH"/>
  <case src="11" dst="12TH"/>
  <case src="12" dst="13TH"/>
  <case src="13" dst="14TH"/>
  <case src="14" dst="15TH"/>
  <case src="15" dst="16TH"/>
  <case src="16" dst="17TH"/>
  <case src="17" dst="18TH"/></format>

<format id="character">
  <case src="1"   dst="HOKUTO"/>
  <case src="3"   dst="D.DARK"/>
  <case src="4"   dst="HAYATE"/>
  <case src="5"   dst="SHARON"/>
  <case src="6"   dst="SKULLO"/>
  <case src="8"   dst="C.JACK"/>
  <case src="9"   dst="GUILE"/>
  <case src="10"  dst="DHALSIM"/>
  <case src="12"  dst="RYU"/>
  <case src="13"  dst="KEN"/>
  <case src="14"  dst="CHUN-LI"/>
  <case src="15"  dst="ZANGIEF"/>
  <case src="16"  dst="BLANKA"/>
  <case src="17"  dst="VEGA"/>
  <case src="255" dst=""/>
</format>

<output>
  <table id="RANKING - SCORE">
    <column id="RANK"      src="index" format="rank"/>
    <column id="SCORE"/>
    <column id="NAME"/>
    <column id="CHARACTER" format="character"/>
  </table>
  <table id="RANKING - WINS">
    <column id="RANK"      src="index" format="rank"/>
    <column id="WINS"      format="Suffix WINS"/>
    <column id="NAME"      src="WNAME"/>
    <column id="CHARACTER" src="WCHARACTER" format="character"/>
  </table>
</output>
</hi2txt>
