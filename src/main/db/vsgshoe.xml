<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- vsgshoe by Nintendo, 1985 -->
<!-- hiscore.dat: @:maincpu,program,560,1d,12,a0 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>29</size>
    </check>

    <!-- 5 records, 5 bytes each: 2 (Score BCD) + 3 (Name) -->
    <!-- The file is 29 bytes ($1D); the loop covers the first 25 bytes. -->
    <loop count="5">
      <elt size="2" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="vsgshoe"/>
    </loop>
  </structure>

  <output>
    <table id="DO YOUR BEST!">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="*100;comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Comprehensive Ordinal Formatter -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <!-- Handles higher ranks if the table ever expands -->
    <case src="10" dst="11TH"/><case src="11" dst="12TH"/><case src="12" dst="13TH"/>
    <case src="20" dst="21ST"/><case src="21" dst="22ND"/><case src="22" dst="23RD"/>
    <case src="0" operator="&gt;=" format="+1;SuffixTH" default="yes"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Full Nintendo Character Mapping -->
  <charset id="vsgshoe">
    <!-- Numbers 0-9 -->
    <char src="0x00" dst="0"/><char src="0x01" dst="1"/><char src="0x02" dst="2"/><char src="0x03" dst="3"/><char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/><char src="0x06" dst="6"/><char src="0x07" dst="7"/><char src="0x08" dst="8"/><char src="0x09" dst="9"/>
    <!-- Alphabet A-Z -->
    <char src="0x0A" dst="A"/><char src="0x0B" dst="B"/><char src="0x0C" dst="C"/><char src="0x0D" dst="D"/><char src="0x0E" dst="E"/>
    <char src="0x0F" dst="F"/><char src="0x10" dst="G"/><char src="0x11" dst="H"/><char src="0x12" dst="I"/><char src="0x13" dst="J"/>
    <char src="0x14" dst="K"/><char src="0x15" dst="L"/><char src="0x16" dst="M"/><char src="0x17" dst="N"/><char src="0x18" dst="O"/>
    <char src="0x19" dst="P"/><char src="0x1A" dst="Q"/><char src="0x1B" dst="R"/><char src="0x1C" dst="S"/><char src="0x1D" dst="T"/>
    <char src="0x1E" dst="U"/><char src="0x1F" dst="V"/><char src="0x20" dst="W"/><char src="0x21" dst="X"/><char src="0x22" dst="Y"/><char src="0x23" dst="Z"/>
    <!-- Special Characters -->
    <char src="0xA5" dst=" "/> <!-- Confirmed Space -->
    <char src="0x24" dst="."/> <!-- Common Nintendo period location -->
    <char src="0x25" dst="-"/> <!-- Common Nintendo dash location -->
  </charset>
</hi2txt>