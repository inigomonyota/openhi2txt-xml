<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Thunder Dragon">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,b9100,c0,00,20</definition>
      <size>192</size>
    </check>
    <loop count="12">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="2" type="int"  id="STAGE"/>
      <elt size="2" type="raw"  id="PAD"/>
      <elt size="8" type="text" id="NAME"  charset="tdragonb" ascii-offset="-41"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="STAGE"/>
    </table>
  </output>

  <charset id="tdragonb">
    <char src="0x20" dst=" "/>
    <char src="0x84" dst="Z"/>
  </charset>
</hi2txt>
