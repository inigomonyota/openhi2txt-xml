<?xml version="1.0" encoding="UTF-8"?>
<hi2txt>
<!-- Street Fighter EX (Capcom ZN-1, at28c16 eeprom). Byte-oriented, no byte-swap.
     RANKING table @ raw 0x88, 10 records x 12 bytes (a second copy sits at 0x13c):
       [0]    CHARACTER  1-byte fighter index (case-mapped to fighter name)
       [1:4]  NAME       3 ASCII chars
       [4:8]  SCORE      4-byte little-endian binary
       [8:12] padding -->
<structure file="at28c16">
  <check>
    <size>2080</size>
  </check>
  <elt size="136" type="raw" id="HEADER"/>
  <loop count="10">
    <elt size="1" type="int"  id="CHARACTER"/>
    <elt size="3" type="text" id="NAME"/>
    <elt size="4" type="int"  id="SCORE" endianness="little_endian"/>
    <elt size="4" type="raw"  id="PAD"/>
  </loop>
</structure>

<format id="rank">
  <case src="0" dst="1ST"/>
  <case src="1" dst="2ND"/>
  <case src="2" dst="3RD"/>
  <case src="3" dst="4TH"/>
  <case src="4" dst="5TH"/>
  <case src="5" dst="6TH"/>
  <case src="6" dst="7TH"/>
  <case src="7" dst="8TH"/>
  <case src="8" dst="9TH"/>
  <case src="9" dst="10TH"/>
</format>

<format id="character">
  <case src="1"  dst="HOKUTO"/>
  <case src="3"  dst="D.DARK"/>
  <case src="4"  dst="PULLUM"/>
  <case src="6"  dst="SKULLO"/>
  <case src="8"  dst="C.JACK"/>
  <case src="9"  dst="GUILE"/>
  <case src="12" dst="RYU"/>
  <case src="13" dst="KEN"/>
  <case src="14" dst="CHUN-LI"/>
  <case src="15" dst="ZANGIEF"/>
</format>

<output>
  <table id="RANKING">
    <column id="RANK"      src="index" format="rank"/>
    <column id="SCORE"/>
    <column id="NAME"/>
    <column id="CHARACTER" format="character"/>
  </table>
</output>
</hi2txt>
