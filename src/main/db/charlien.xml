<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Charlie Ninja">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,184a80,ae,00,00
                  @:maincpu,program,182200,01,e6,e6</definition>
      <size>175</size>
    </check>
    <elt size="32" type="raw" id="EMPTY"/>
    <loop count="5">
      <elt size="2" type="text" id="NAME1"/>
      <elt size="2" type="raw"  id="PAD1"/>
      <elt size="2" type="text" id="NAME2"/>
      <elt size="2" type="raw"  id="PAD2"/>
      <elt size="1" type="int"  id="D0"/>
      <elt size="1" type="int"  id="D1"/>
      <elt size="2" type="raw"  id="PAD3"/>
      <elt size="1" type="int"  id="D2"/>
      <elt size="1" type="int"  id="D3"/>
      <elt size="2" type="raw"  id="PAD4"/>
      <elt size="1" type="int"  id="D4"/>
      <elt size="1" type="int"  id="D5"/>
      <elt size="2" type="raw"  id="PAD5"/>
      <elt size="1" type="int"  id="D6"/>
      <elt size="1" type="int"  id="D7"/>
      <elt size="2" type="raw"  id="PAD6"/>
    </loop>
    <elt size="23" type="raw" id="EMPTY2"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="NAME"  format="name"/>
    </table>
  </output>

  <format id="score">
    <concat>
      <column id="D0"/>
      <column id="D1"/>
      <column id="D2"/>
      <column id="D3"/>
      <column id="D4"/>
      <column id="D5"/>
      <column id="D6"/>
      <column id="D7"/>
    </concat>
  </format>

  <format id="name">
    <concat>
      <column id="NAME1"/>
      <column id="NAME2"/>
    </concat>
  </format>
</hi2txt>
