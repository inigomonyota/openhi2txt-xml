<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hi2txt>
<hi2txt label="Major Title 2">
  <structure file=".hi">
    <check><size>320</size></check>
    <!-- TOP 10 PLAYERS - AMERICAN COURSE -->
    <loop count="10">
      <elt id="US_NAME"  type="text" size="3"/>
      <elt id="US_PAD0"  type="raw"  size="5"/>
      <elt id="US_SCORE" type="int"  size="2" endianness="little_endian"/>
      <elt id="US_PLACE" type="int"  size="1"/>
      <elt id="US_AS"    type="int"  size="1"/>
      <elt id="US_PAD1"  type="raw"  size="4"/>
    </loop>
    <!-- TOP 10 PLAYERS - EUROPEAN COURSE -->
    <loop count="10">
      <elt id="EU_NAME"  type="text" size="3"/>
      <elt id="EU_PAD0"  type="raw"  size="5"/>
      <elt id="EU_SCORE" type="int"  size="2" endianness="little_endian"/>
      <elt id="EU_PLACE" type="int"  size="1"/>
      <elt id="EU_AS"    type="int"  size="1"/>
      <elt id="EU_PAD1"  type="raw"  size="4"/>
    </loop>
  </structure>

  <format id="AS_FMT">
    <case src="0" dst="POWERPLY"/>
    <case src="1" dst="GOLF PRO"/>
    <case src="2" dst="TECHNIC."/>
    <case src="3" dst="MAGICIAN"/>
  </format>

  <format id="NEG_SCORE">
    <substract>65536</substract>
  </format>

  <format id="POS_SCORE">
    <prefix>+</prefix>
  </format>

  <format id="SCORE_FMT">
    <case src="0" dst="EVEN"/>
    <case src="32767" operator="&gt;" format="NEG_SCORE"/>
    <case default="true" format="POS_SCORE"/>
  </format>

  <format id="PLACE_FMT">
    <case src="0xff" dst="WIN"/>
    <case src="0x01" dst="1ST"/>
    <case src="0x02" dst="2ND"/>
    <case src="0x03" dst="3RD"/>
    <case src="0x04" dst="4TH"/>
    <case src="0x05" dst="5TH"/>
    <case src="0x06" dst="6TH"/>
    <case src="0x07" dst="7TH"/>
    <case src="0x08" dst="8TH"/>
    <case src="0x09" dst="9TH"/>
    <case src="0x10" dst="10TH"/>
    <case src="0x11" dst="11TH"/>
    <case src="0x12" dst="12TH"/>
    <case src="0x13" dst="13TH"/>
    <case src="0x14" dst="14TH"/>
    <case src="0x15" dst="15TH"/>
    <case src="0x16" dst="16TH"/>
    <case src="0x17" dst="17TH"/>
    <case src="0x18" dst="18TH"/>
    <case src="0x19" dst="19TH"/>
    <case src="0x20" dst="20TH"/>
    <case src="0x21" dst="21ST"/>
    <case src="0x22" dst="22ND"/>
    <case src="0x23" dst="23RD"/>
    <case src="0x24" dst="24TH"/>
  </format>

  <output>
    <table id="TOP 10 PLAYERS - AMERICAN COURSE" lines-max="10">
      <column id="RANK"  src="index"    format="+1"/>
      <column id="NAME"  src="US_NAME"  format="Trim "/>
      <column id="(AS)"  src="US_AS"    format="AS_FMT"/>
      <column id="SCORE" src="US_SCORE" format="SCORE_FMT"/>
      <column id="PLACE" src="US_PLACE" format="PLACE_FMT"/>
    </table>
    <table id="TOP 10 PLAYERS - EUROPEAN COURSE" lines-max="10">
      <column id="RANK"  src="index"    format="+1"/>
      <column id="NAME"  src="EU_NAME"  format="Trim "/>
      <column id="(AS)"  src="EU_AS"    format="AS_FMT"/>
      <column id="SCORE" src="EU_SCORE" format="SCORE_FMT"/>
      <column id="PLACE" src="EU_PLACE" format="PLACE_FMT"/>
    </table>
  </output>
</hi2txt>
