<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="XX Mission">
  <!--
    tested with mame 0.285 and hiscore.dat
    source: openhi2txt
  //-->

  <structure file=".hi">
    <check>
      <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure version the provided file is for -->
      <definition>0:e018:4:00:00
                  0:e084:61:20:20
                  0:c1a0:1:30:30
                  0:c1c0:1:30:30
                  0:c1e0:1:30:30
                  0:c200:1:30:30
                  0:c220:1:33:33
                  0:c240:1:01:01
                  0:c260:1:01:01</definition>
      <!-- optional: if defined, it allows to select the good structure version the provided file is for
                     useful if multiple structures are defined, but hiscore.dat is not provided -->
      <size>108</size>
    </check>
    <elt id="TOP SCORE" type="int" size="4" endianness="big_endian" base="16"/>
    <loop count="5" skip-first-bytes="3">
      <elt id="RANK_STR" type="text" size="3" ascii-offset="0"/>
      <elt id="EMPTY" type="raw" size="2"/>
      <elt id="SCORE" type="text" size="6" charset="xxmissio" ascii-offset="0"/>
      <elt id="EMPTY" type="raw" size="1"/>
      <elt id="NAME" type="text" size="8" charset="xxmissio" ascii-offset="0"/>
    </loop>
    <elt id="EMPTY" type="raw" size="7"/>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="Trim"/>
      <column id="NAME" format="Trim"/>
    </table>
    <field id="TOP SCORE" format="*10" display="extra"/>
  </output>

  <charset id="xxmissio">
    <char src="0x01" dst=" "/>
    <char src="0x5b" dst="."/>
  </charset>
</hi2txt>
