<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <structure file=".hi">
    <check>
      <size>280</size>
    </check>

    <loop count="20">
      <!-- base="16" = packed BCD for hi2txt -->
      <elt size="4" type="int" id="SCORE" base="16"/>

      <elt size="4" type="text" id="NAME" charset="outrun"/>

      <elt size="6" type="raw" id="_MID"/>
    </loop>
  </structure>
  <output>
    <table id="OUTRUNNERS">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME"  src="NAME" format="trimr"/>
    </table>
  </output>
  <charset id="outrun">
    <char src="0x5b" dst="."/>
  </charset>
</hi2txt>