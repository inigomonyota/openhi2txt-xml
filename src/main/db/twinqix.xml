<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Twin Qix">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,406b6f,9b,00,54</definition>
      <size>155</size>
    </check>
    <loop count="10" skip-last-bytes="5">
      <elt size="4" type="int"  id="SCORE" base="10"/>
      <elt size="4" type="int"  id="ROUND" base="10"/>
      <elt size="8" type="text" id="NAME"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="/16;*10"/>
      <column id="NAME"/>
      <column id="ROUND"/>
    </table>
  </output>
</hi2txt>
