<?xml version="1.0" encoding="utf-8"?>
<hi2txt>
  <!--
    ffight (.hi) definition for hi2txt
    Single unified chart: 3 entries.

    hiscore.dat ranges (reference):
      @:maincpu,program,ff850c,3c,ff,00
      @:maincpu,program,ff80a0,04,00,00
    Total .hi size: 64 bytes (matches ffight.hi)

    Verified ffight.hi layout:
      - 0x00..0x13 (20 bytes): pointers (ignored)
      - 3 high-score entries:
          SCORE (4 bytes packed BCD, big-endian)
          NAME  (3 bytes ASCII)
          FLAG  (1 byte, increments 0,1,2) (ignored)
      - Remaining bytes: other tables/checksum (ignored)
  -->

  <structure file=".hi">
    <elt size="20" type="raw" id="_SKIP_PTRS"/>

    <loop count="3">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="ffight"/>
      <elt size="1" type="raw"  id="_FLAG"/>
    </loop>

    <elt size="20" type="raw" id="_TAIL"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME"  src="NAME" format="trimr"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="trimr"><trim direction="right"> </trim></format>

  <charset id="ffight">
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>
