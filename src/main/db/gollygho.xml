<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- gollygho by Namco, 1990 -->
<!-- hiscore.dat: @:maincpu,program,10312e,143,02,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>323</size>
    </check>

    <!-- SINGLE PLAYER TABLE (10 records, 16 bytes each) -->
    <loop count="10">
      <elt size="2" type="int"  id="S1_SCORE" base="16"/>
      <elt size="1" type="raw"  id="S1_TYPE"/>
      <!-- Split the name field: read 3, skip 4 -->
      <elt size="3" type="text" id="S1_NAME"  charset="namco_gho"/>
      <elt size="4" type="raw"  id="S1_NAME_REST"/>
      <elt size="2" type="int"  id="S1_SCENE" endianness="big_endian"/>
      <elt size="4" type="raw"  id="S1_PAD"/>
    </loop>

    <!-- DOUBLE PLAYER TABLE (10 records, 16 bytes each) -->
    <loop count="10">
      <elt size="2" type="int"  id="S2_SCORE" base="16"/>
      <elt size="1" type="raw"  id="S2_TYPE"/>
      <!-- Read the full 7 characters for Double Player mode -->
      <elt size="7" type="text" id="S2_NAME"  charset="namco_gho"/>
      <elt size="2" type="int"  id="S2_SCENE" endianness="big_endian"/>
      <elt size="4" type="raw"  id="S2_PAD"/>
    </loop>
  </structure>

  <output>
    <table id="SINGLE PLAYER TOP 10">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="S1_SCORE" format="comma_score"/>
      <column id="NAME"  src="S1_NAME"/>
      <column id="SCENE" src="S1_SCENE" format="scene_map"/>
    </table>

    <table id="DOUBLE PLAYER TOP 10">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="S2_SCORE" format="comma_score"/>
      <column id="NAME"  src="S2_NAME"/>
      <column id="SCENE" src="S2_SCENE" format="scene_map"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- Scene Map -->
  <format id="scene_map">
    <case src="5" dst="END"/>
    <case src="0" operator="&gt;" format="*1" default="yes"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Namco System 2 Alphanumeric Charset -->
  <charset id="namco_gho">
    <char src="0x00" dst="A"/><char src="0x01" dst="B"/><char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/><char src="0x04" dst="E"/><char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/><char src="0x07" dst="H"/><char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/><char src="0x0A" dst="K"/><char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/><char src="0x0D" dst="N"/><char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/><char src="0x10" dst="Q"/><char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/><char src="0x13" dst="T"/><char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/><char src="0x16" dst="W"/><char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/><char src="0x19" dst="Z"/>
    <char src="0x1B" dst=" &amp; "/>
  </charset>
</hi2txt>