<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- lgtnfght by Konami, 1990 -->
<!-- hiscore.dat: @:maincpu,program,90400,50,41,50 | @:maincpu,program,90120,4,00,60 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>84</size>
    </check>

    <!-- Block 1: 10 Records, 8 bytes each (80 bytes total) -->
    <loop count="10">
      <!-- Byte 0-2: Name (3 bytes ASCII) -->
      <elt size="3" type="text" id="NAME"/>
      <!-- Byte 3: Stage Index (00=1, 01=2, 02=3, 03=4) -->
      <elt size="1" type="int"  id="STAGE_RAW"/>
      <!-- Byte 4-7: Score (4-byte BCD) -->
      <elt size="4" type="int"  id="SCORE" base="16"/>
    </loop>

    <!-- Block 2: Global Top Score (Last 4 bytes of file) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="comma_score" display="extra"/-->

    <table id="TOP 10 PLAYERS">
      <column id="RANK"  src="index"     format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <!-- +1 translates index 0-3 to Stages 1-4 -->
      <column id="STAGE" src="STAGE_RAW" format="+1"/>
      <column id="SCORE" src="SCORE"     format="comma_score"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>