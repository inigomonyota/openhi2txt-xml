<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  tekken - Tekken (Namco, 1994)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,1e0498,180,04,00
  384 bytes = 192B (2P GAME WINS) + 192B (RANKING)
  2P GAME WINS: 16 x 12B (1B wins + 3B pad + 1B char_id + 3B pad + 4B raw)
  RANKING: 16 x 12B
  RANKING record: 4B time (LE int, frames@60fps) + 1B char_id + 1B pad +
                  2B raw + 3B name (ASCII) + 1B null
  Time: stored as frame count at 60fps. Converted via:
    minutes = frames / 3600
    seconds = (frames % 3600) / 60
    centiseconds = (frames % 60) * 100 / 60
  Character IDs: 0=KAZUYA 1=PAUL 2=LAW 3=JACK 4=NINA 5=KING 6=YOSHIMITSU 7=MICHELLE
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>384</size>
    </check>
    <!-- 2P GAME WINS: 16 x 12B -->
    <loop count="16">
      <elt size="1" type="int" id="VWINS"/>
      <elt size="3" type="raw" id="VP1"/>
      <elt size="1" type="int" id="VCHAR"/>
      <elt size="3" type="raw" id="VP2"/>
      <elt size="4" type="raw" id="VP3"/>
    </loop>
    <!-- RANKING: 16 entries x 12B -->
    <loop count="16">
      <elt size="4" type="int" id="TIME" endianness="little_endian"/>
      <elt size="1" type="int" id="TCHAR"/>
      <elt size="1" type="raw" id="TP1"/>
      <elt size="2" type="raw" id="TP2"/>
      <elt size="3" type="text" id="TNAME"/>
      <elt size="1" type="raw" id="TP3"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK" src="index" format="+1"/>
      <column id="CHARACTER" src="TCHAR" format="charname"/>
      <column id="TIME" format="time_fmt"/>
      <column id="NAME" src="TNAME"/>
    </table>
    <table id="RANKING 2P GAME WINS">
      <column id="RANK" src="index" format="+1"/>
      <column id="CHARACTER" src="VCHAR" format="charname"/>
      <column id="WINS" src="VWINS"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="charname">
    <case src="0" operator="=" dst="KAZUYA"/>
    <case src="1" operator="=" dst="PAUL"/>
    <case src="2" operator="=" dst="LAW"/>
    <case src="3" operator="=" dst="JACK"/>
    <case src="4" operator="=" dst="NINA"/>
    <case src="5" operator="=" dst="KING"/>
    <case src="6" operator="=" dst="YOSHIMITSU"/>
    <case src="7" operator="=" dst="MICHELLE"/>
  </format>

  <!-- Time format: frames@60fps -> M'SS''CC -->
  <format id="time_fmt" input-as-subcolumns-input="yes">
    <concat>
      <column format="d3600"/>
      <txt>'</txt>
      <column format="%3600;d60;PadL20"/>
      <txt>''</txt>
      <column format="%60;*100;d60;PadL20"/>
    </concat>
  </format>

</hi2txt>