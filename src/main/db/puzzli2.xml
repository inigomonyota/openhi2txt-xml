<?xml version="1.0" encoding="UTF-8"?>
<hi2txt>
<!-- Puzzli 2 / Puzzli 2 Super (IGS PGM, sram).
     68000 => byte-swap="2".
     RANKING table @ raw 0x19b65 (score-aligned), 10 records x 30 bytes:
       [0:3]   SCORE  3-byte big-endian binary (this record's own score)
       [3:17]  gap    per-record play data + ffff marker (not displayed)
       [17:21] NAME   4 ASCII chars ("IGS.")
       [21:30] tail   constant signature 00 5b a7 75 5e ae 6c 00 00 (not displayed)
     NOTE: within the game's record the score field physically precedes the name it belongs to;
     reading score-aligned (name at score+0x11) pairs each score with its own name/rank. -->
<structure file="sram" byte-swap="2">
  <check>
    <size>131072</size>
  </check>
  <elt size="105317" type="raw" id="HEADER"/>
  <loop count="10">
    <elt size="3"  type="int"  id="SCORE"/>
    <elt size="14" type="raw"  id="GAP"/>
    <elt size="4"  type="text" id="NAME"/>
    <elt size="9"  type="raw"  id="TAIL"/>
  </loop>
</structure>

<format id="rank">
  <case src="0" dst="1ST"/>
  <case src="1" dst="2ND"/>
  <case src="2" dst="3RD"/>
  <case src="3" dst="4TH"/>
  <case src="4" dst="5TH"/>
  <case src="5" dst="6TH"/>
  <case src="6" dst="7TH"/>
  <case src="7" dst="8TH"/>
  <case src="8" dst="9TH"/>
  <case src="9" dst="10TH"/>
</format>

<output>
  <table id="RANKING">
    <column id="RANK" src="index" format="rank"/>
    <column id="NAME"/>
    <column id="SCORE"/>
  </table>
</output>
</hi2txt>
