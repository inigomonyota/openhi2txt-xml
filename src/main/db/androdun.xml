<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Andro Dunos">
  <!--
    Neo Geo backup RAM (saveram), byte-swapped (byte-swap="2").
    TOP 10 table starts at 0x8A0 (2208): 10 x 8-byte entries:
      [0]   rank (1..10)
      [1-3] name  (3 chars, ASCII + neogeo specials via charset)
      [4-7] score / 10  (big-endian binary; multiply by 10 to display)
    Output formatted to match the default chart: RANK / NAME / SCORE,
    ranks as 1ST..10TH, name given a trailing '-' separator.
  -->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>
    <elt size="2208" type="raw" id="DATA"/>
    <loop count="10">
      <elt size="1" type="int"  id="RANK"/>
      <elt size="3" type="text" id="NAME" charset="androdun"/>
      <elt size="4" type="int"  id="SCORE" base="10"/>
    </loop>
  </structure>

  <output>
    <table id="TOP 10">
      <column id="RANK" src="RANK"  format="ordinal"/>
      <column id="NAME" src="NAME"  format="Suffix-"/>
      <column id="SCORE" src="SCORE" format="*10"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="1" dst="1ST"/>
    <case src="2" dst="2ND"/>
    <case src="3" dst="3RD"/>
    <case src="4" dst="4TH"/>
    <case src="5" dst="5TH"/>
    <case src="6" dst="6TH"/>
    <case src="7" dst="7TH"/>
    <case src="8" dst="8TH"/>
    <case src="9" dst="9TH"/>
    <case src="10" dst="10TH"/>
  </format>

  <charset id="androdun">
    <char src="0x5B" dst="."/>
    <char src="0x5C" dst=" "/>
    <char src="0x5D" dst="!"/>
    <char src="0x5E" dst="?"/>
  </charset>
</hi2txt>
