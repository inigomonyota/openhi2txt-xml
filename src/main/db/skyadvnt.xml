<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Sky Adventure">
  <!--
    tested with mame 0.285 and hiscore.dat
    source: openhi2txt
  //-->

  <structure file=".hi">
    <check>
      <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure version the provided file is for -->
      <definition>0:40031:3:00:24
                  0:41102:bc:00:20</definition>
      <!-- optional: if defined, it allows to select the good structure version the provided file is for
                     useful if multiple structures are defined, but hiscore.dat is not provided -->
      <size>191</size>
    </check>
    <elt id="TOP SCORE" type="int" size="3" endianness="big_endian" base="16"/>
    <loop count="10">
      <elt id="SCORE_HI" type="int" size="2" endianness="big_endian" base="16"/>
      <elt id="EMPTY" type="raw" size="1"/>
      <elt id="SCORE_LO" type="int" size="1" base="16"/>
      <elt id="EMPTY" type="raw" size="4"/>
      <elt id="NAME1" type="text" size="2" ascii-offset="0"/>
      <elt id="EMPTY" type="raw" size="1"/>
      <elt id="NAME2" type="text" size="1" ascii-offset="0"/>
      <elt id="EMPTY" type="raw" size="4"/>
    </loop>
    <elt id="EMPTY" type="raw" size="28"/>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="score_combine"/>
      <column id="NAME" format="name_combine;Trim"/>
    </table>
    <field id="TOP SCORE" display="extra"/>
  </output>

  <format id="pad00">
    <pad direction="left" max="2">0</pad>
  </format>
  <format id="score_combine">
    <concat>
      <column id="SCORE_HI"/>
      <column id="SCORE_LO" format="pad00"/>
    </concat>
  </format>
  <format id="name_combine">
    <concat>
      <column id="NAME1"/>
      <column id="NAME2"/>
    </concat>
  </format>
</hi2txt>
