<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- kikikai by Taito, 1986 -->
<!-- hiscore.dat: @:maincpu,program,e2fc,23,00,55 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>35</size>
    </check>

    <!-- 5 records, 7 bytes each -->
    <!-- Record: 3(Score BCD) + 1(Scene) + 3(Name) -->
    <loop count="5">
      <!-- 49000 is stored as 00 49 00. base=16 handles BCD logic. -->
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="int"  id="SCENE"/>
      <elt size="3" type="text" id="NAME" charset="taito_kikikai"/>
    </loop>
  </structure>

  <output>
    <table id="BEST 5">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="*10;comma_score"/>
      <column id="SCENE" src="SCENE"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-4 into 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Character set for special Taito symbols used in your Rank 5 entry -->
  <charset id="taito_kikikai">
    <char src="0x21" dst="!"/><char src="0x3F" dst="?"/><char src="0x2E" dst="."/>
  </charset>
</hi2txt>