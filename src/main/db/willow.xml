<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  willow - Willow (Capcom, 1989)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,ffefc6,50,00,20
    @:maincpu,program,fff03e,04,00,00
  84 bytes = 10 entries x 8B + 4B top score
  Record (8B): 4B score (BCD) + 4B name (3B ASCII + 1B space pad)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>84</size>
    </check>
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw" id="PAD"/>
    </loop>
    <elt size="4" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>