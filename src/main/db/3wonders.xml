<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Three Wonders">
  <!--
    hiscore.dat: 7 memory blocks concatenated (352 bytes total)
    Three games, each with 5 entries. Record: 4-byte BCD score + 3-byte ASCII name
      + 1-byte flag (0x01 seen on some entries, meaning unknown) + 8-byte padding
    Pointer blocks (RAM addresses) are skipped as raw.
    Layout:
      0x000-0x013: game1 pointers (skip)
      0x014-0x063: game1 data - Midnight Wanderers (5 x 16 bytes)
      0x064-0x08b: game2 pointers (skip)
      0x08c-0x0db: game2 data - Chariot (5 x 16 bytes)
      0x0dc-0x103: game3 pointers (skip)
      0x104-0x153: game3 data - Don't Pull (5 x 16 bytes)
      0x154-0x15f: global scores (skip)
  //-->

  <structure file="hi">
    <check>
      <size>352</size>
    </check>
    <!-- game1 pointers -->
    <elt size="20" type="raw" id="PTR1"/>
    <!-- Midnight Wanderers -->
    <loop count="5">
      <elt size="4" type="int"  id="MW_SCORE" base="16" table-index="loop_index"/>
      <elt size="3" type="text" id="MW_NAME"  ascii-offset="0" table-index="loop_index"/>
      <elt size="1" type="raw"  id="MW_FLAG"  table-index="loop_index"/>
      <elt size="8" type="raw"  id="MW_PAD"   table-index="loop_index"/>
    </loop>
    <!-- game2 pointers -->
    <elt size="40" type="raw" id="PTR2"/>
    <!-- Chariot -->
    <loop count="5">
      <elt size="4" type="int"  id="CH_SCORE" base="16" table-index="loop_index"/>
      <elt size="3" type="text" id="CH_NAME"  ascii-offset="0" table-index="loop_index"/>
      <elt size="1" type="raw"  id="CH_FLAG"  table-index="loop_index"/>
      <elt size="8" type="raw"  id="CH_PAD"   table-index="loop_index"/>
    </loop>
    <!-- game3 pointers -->
    <elt size="40" type="raw" id="PTR3"/>
    <!-- Don't Pull -->
    <loop count="5">
      <elt size="4" type="int"  id="DP_SCORE" base="16" table-index="loop_index"/>
      <elt size="3" type="text" id="DP_NAME"  ascii-offset="0" table-index="loop_index"/>
      <elt size="1" type="raw"  id="DP_FLAG"  table-index="loop_index"/>
      <elt size="8" type="raw"  id="DP_PAD"   table-index="loop_index"/>
    </loop>
    <!-- global -->
    <elt size="12" type="raw" id="GLOBAL"/>
  </structure>

  <output>
    <table id="MIDNIGHT WANDERERS">
      <column id="RANK"     src="index" format="ordinal"/>
      <column id="SCORE" src="MW_SCORE"/>
      <column id="NAME"  src="MW_NAME"  format="TrimR "/>
    </table>
    <table id="CHARIOT">
      <column id="RANK"     src="index" format="ordinal"/>
      <column id="SCORE" src="CH_SCORE"/>
      <column id="NAME"  src="CH_NAME"  format="TrimR "/>
    </table>
    <table id="DON'T PULL">
      <column id="RANK"     src="index" format="ordinal"/>
      <column id="SCORE" src="DP_SCORE"/>
      <column id="NAME"  src="DP_NAME"  format="TrimR "/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

</hi2txt>