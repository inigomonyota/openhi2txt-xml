<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Desert War">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,fee1b028,eb,94,24</definition>
      <size>235</size>
    </check>
    <loop count="5">
      <elt size="4" type="int"  id="SCORE" endianness="little_endian" base="10"/>
      <elt size="2" type="int"  id="STAGE" endianness="little_endian"/>
      <elt size="1" type="text" id="CHAR1" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="1" type="text" id="CHAR2" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="1" type="text" id="CHAR3" ascii-offset="65"/>
      <elt size="5" type="raw"  id="PAD3"/>
    </loop>
    <loop count="5">
      <elt size="4" type="int"  id="SCORE2" endianness="little_endian" base="10"/>
      <elt size="2" type="int"  id="STAGE2" endianness="little_endian"/>
      <elt size="1" type="text" id="CHAR2_1" charset="desertwr" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD2_1"/>
      <elt size="1" type="text" id="CHAR2_2" charset="desertwr" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD2_2"/>
      <elt size="1" type="text" id="CHAR2_3" charset="desertwr" ascii-offset="65"/>
      <elt size="5" type="raw"  id="PAD2_3"/>
    </loop>
    <loop count="5" skip-last-bytes="5">
      <elt size="4" type="int"  id="SCORE3" endianness="little_endian" base="10"/>
      <elt size="2" type="int"  id="STAGE3" endianness="little_endian"/>
      <elt size="1" type="text" id="CHAR3_1" charset="desertwr" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD3_1"/>
      <elt size="1" type="text" id="CHAR3_2" charset="desertwr" ascii-offset="65"/>
      <elt size="1" type="raw"  id="PAD3_2"/>
      <elt size="1" type="text" id="CHAR3_3" charset="desertwr" ascii-offset="65"/>
      <elt size="5" type="raw"  id="PAD3_3"/>
    </loop>
  </structure>

  <output>
    <table id="TABLE 1">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME"  format="name1"/>
      <column id="STAGE" src="STAGE" format="+1"/>
    </table>
    <table id="TABLE 2">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE2"/>
      <column id="NAME"  format="name2"/>
      <column id="STAGE" src="STAGE2" format="+1"/>
    </table>
    <table id="TABLE 3">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE3"/>
      <column id="NAME"  format="name3"/>
      <column id="STAGE" src="STAGE3" format="+1"/>
    </table>
  </output>

  <format id="name1">
    <concat>
      <column id="CHAR1"/>
      <column id="CHAR2"/>
      <column id="CHAR3"/>
    </concat>
  </format>
  <format id="name2">
    <concat>
      <column id="CHAR2_1"/>
      <column id="CHAR2_2"/>
      <column id="CHAR2_3"/>
    </concat>
  </format>
  <format id="name3">
    <concat>
      <column id="CHAR3_1"/>
      <column id="CHAR3_2"/>
      <column id="CHAR3_3"/>
    </concat>
  </format>

  <charset id="desertwr">
    <char src="0x24" dst=" "/>
    <char src="0x25" dst="."/>
  </charset>
</hi2txt>
