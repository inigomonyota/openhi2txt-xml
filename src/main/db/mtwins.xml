<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  mtwins - Mega Twins / Chiki Chiki Boys (Capcom, 1990)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,ff12c8,190,00,00
    @:maincpu,program,ff9168,28,02,5b
    @:maincpu,program,ffe006,04,00,00
  444 bytes = 400B scores (100 x 4B BCD) + 40B names (10 x 4B) + 4B top score
  Scores: 100 x 4B BCD (only top 10 displayed). Names: 10 x (3B name + 1B pad).
  Charset: tile-based with gaps. A-J=0x00-0x09, K-O=0x10-0x14,
           P-T=0x18-0x1C, U-Y=0x20-0x24, Z=0x28. 0x5B=space/pad.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>444</size>
    </check>
    <!-- Top 10 scores: 10 x 4B BCD -->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>
    <!-- Remaining 90 scores (not displayed) -->
    <elt size="360" type="raw" id="EXTRASCORES"/>
    <!-- Names: 10 x (3B name + 1B pad) -->
    <loop count="10">
      <elt size="3" type="text" id="NAME" charset="tiles"/>
      <elt size="1" type="raw" id="PAD"/>
    </loop>
    <!-- Top score (4B BCD) -->
    <elt size="4" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="SCORE RANKING BEST 10">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="comma_score"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="tiles">
    <!-- A-J: 0x00-0x09 -->
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <!-- K-O: 0x10-0x14 -->
    <char src="0x10" dst="K"/>
    <char src="0x11" dst="L"/>
    <char src="0x12" dst="M"/>
    <char src="0x13" dst="N"/>
    <char src="0x14" dst="O"/>
    <!-- P-T: 0x18-0x1C -->
    <char src="0x18" dst="P"/>
    <char src="0x19" dst="Q"/>
    <char src="0x1A" dst="R"/>
    <char src="0x1B" dst="S"/>
    <char src="0x1C" dst="T"/>
    <!-- U-Y: 0x20-0x24 -->
    <char src="0x20" dst="U"/>
    <char src="0x21" dst="V"/>
    <char src="0x22" dst="W"/>
    <char src="0x23" dst="X"/>
    <char src="0x24" dst="Y"/>
    <!-- Z: 0x28 -->
    <char src="0x28" dst="Z"/>
    <!-- Space/pad -->
    <char src="0x5B" dst=" "/>
  </charset>

</hi2txt>
