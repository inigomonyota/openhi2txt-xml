<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 80 bytes -->
    <check><size>80</size></check>
    
    <!-- 10 Records * 8 Bytes = 80 Bytes -->
    <loop count="10">
      <!-- 4-byte Big Endian BCD Score -->
      <elt size="4" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      
      <!-- 1-byte Stage -->
      <elt size="1" type="int"  id="STAGE"/>
      
      <!-- 3-character ASCII Name -->
      <elt size="3" type="text" id="NAME"/>
    </loop>
  </structure>

  <output>
    <table id="BEST 10">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE"/>
      <column id="STAGE" src="STAGE"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates the index from 0-9 to 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>
</hi2txt>