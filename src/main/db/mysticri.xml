<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  mysticri - Mystic Riders / Gun Hohki (Irem Corporation, 1992)
  M92 board, V33 CPU (little-endian).
  hiscore.dat:
    @:maincpu,program,e8af8,38,00,4d
    @:maincpu,program,e8b30,94,2e,00
  204 bytes = 56B range1 + 148B range2 (contiguous)

  Layout (block-interleaved, 11 slots = 10 displayed + 1 buffer):
    [0-43]    11 × 4B  LE packed-BCD scores
    [44-54]   11 × 1B  ranks (stored as rank-1)
    [55-87]   11 × 3B  ASCII names
    [88-98]   11 × 1B  stages (stored as stage-1; 7=ALL)
    [99-134]  18 × 2B  LE int stage-best scores (6 stages × 3 entries)
    [135-188] 18 × 3B  ASCII stage-best names
    [189-203] 15B tail/metadata
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>204</size>
    </check>

    <!-- ====== MAIN TABLE (11 slots, display 10) ====== -->

    <!-- Scores: 10 × 4B LE packed-BCD + 1 buffer -->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16" endianness="little_endian" table-index="loop_index"/>
    </loop>
    <elt size="4" type="raw" id="SCORE_BUF"/>

    <!-- Ranks: 10 × 1B + 1 buffer (stored as rank-1) -->
    <loop count="10">
      <elt size="1" type="int" id="RANK_VAL" table-index="loop_index"/>
    </loop>
    <elt size="1" type="raw" id="RANK_BUF"/>

    <!-- Names: 10 × 3B + 1 buffer -->
    <loop count="10">
      <elt size="3" type="text" id="NAME" table-index="loop_index"/>
    </loop>
    <elt size="3" type="raw" id="NAME_BUF"/>

    <!-- Stages: 10 × 1B + 1 buffer (stored as stage-1; 7=ALL) -->
    <loop count="10">
      <elt size="1" type="int" id="STAGE_VAL" table-index="loop_index"/>
    </loop>
    <elt size="1" type="raw" id="STAGE_BUF"/>

    <!-- ====== STAGE BEST 3 (6 stages × 3 entries) ====== -->

    <!-- Stage best scores: 18 × 2B LE int -->
    <loop count="3">
      <elt size="2" type="int" id="S1_SCORE" endianness="little_endian" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="2" type="int" id="S2_SCORE" endianness="little_endian" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="2" type="int" id="S3_SCORE" endianness="little_endian" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="2" type="int" id="S4_SCORE" endianness="little_endian" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="2" type="int" id="S5_SCORE" endianness="little_endian" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="2" type="int" id="S6_SCORE" endianness="little_endian" table-index="loop_index"/>
    </loop>

    <!-- Stage best names: 18 × 3B ASCII -->
    <loop count="3">
      <elt size="3" type="text" id="S1_NAME" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="3" type="text" id="S2_NAME" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="3" type="text" id="S3_NAME" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="3" type="text" id="S4_NAME" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="3" type="text" id="S5_NAME" table-index="loop_index"/>
    </loop>
    <loop count="3">
      <elt size="3" type="text" id="S6_NAME" table-index="loop_index"/>
    </loop>

    <!-- Tail (15 bytes metadata) -->
    <elt size="15" type="raw" id="TAIL"/>
  </structure>

  <output>
    <table id="BEST PILOTS RANKING">
      <column id="POSITION" src="index" format="pos10"/>
      <column id="SCORE" format="comma_score"/>
      <column id="RANK" src="RANK_VAL" format="+1"/>
      <column id="NAME"/>
      <column id="STAGE" src="STAGE_VAL" format="+1;stage_check"/>
    </table>

    <table id="STAGE BEST 3 - STAGE 1" line-ignore="S1_SCORE:0">
      <column id="POSITION" src="index" format="pos3"/>
      <column id="SCORE" src="S1_SCORE" format="comma_score"/>
      <column id="NAME" src="S1_NAME"/>
    </table>

    <table id="STAGE BEST 3 - STAGE 2" line-ignore="S2_SCORE:0">
      <column id="POSITION" src="index" format="pos3"/>
      <column id="SCORE" src="S2_SCORE" format="comma_score"/>
      <column id="NAME" src="S2_NAME"/>
    </table>

    <table id="STAGE BEST 3 - STAGE 3" line-ignore="S3_SCORE:0">
      <column id="POSITION" src="index" format="pos3"/>
      <column id="SCORE" src="S3_SCORE" format="comma_score"/>
      <column id="NAME" src="S3_NAME"/>
    </table>

    <table id="STAGE BEST 3 - STAGE 4" line-ignore="S4_SCORE:0">
      <column id="POSITION" src="index" format="pos3"/>
      <column id="SCORE" src="S4_SCORE" format="comma_score"/>
      <column id="NAME" src="S4_NAME"/>
    </table>

    <table id="STAGE BEST 3 - STAGE 5" line-ignore="S5_SCORE:0">
      <column id="POSITION" src="index" format="pos3"/>
      <column id="SCORE" src="S5_SCORE" format="comma_score"/>
      <column id="NAME" src="S5_NAME"/>
    </table>

    <table id="STAGE BEST 3 - STAGE 6" line-ignore="S6_SCORE:0">
      <column id="POSITION" src="index" format="pos3"/>
      <column id="SCORE" src="S6_SCORE" format="comma_score"/>
      <column id="NAME" src="S6_NAME"/>
    </table>
  </output>

  <!-- Position formats -->
  <format id="pos10">
    <case src="0" operator="=" dst="NO. 1"/>
    <case src="1" operator="=" dst="NO. 2"/>
    <case src="2" operator="=" dst="NO. 3"/>
    <case src="3" operator="=" dst="NO. 4"/>
    <case src="4" operator="=" dst="NO. 5"/>
    <case src="5" operator="=" dst="NO. 6"/>
    <case src="6" operator="=" dst="NO. 7"/>
    <case src="7" operator="=" dst="NO. 8"/>
    <case src="8" operator="=" dst="NO. 9"/>
    <case src="9" operator="=" dst="NO. 10"/>
  </format>

  <format id="pos3">
    <case src="0" operator="=" dst="NO. 1"/>
    <case src="1" operator="=" dst="NO. 2"/>
    <case src="2" operator="=" dst="NO. 3"/>
  </format>

  <!-- Rank/Stage helpers -->
  <format id="+1"><add>1</add></format>

  <format id="stage_check">
    <case src="7" operator="=" dst="ALL"/>
    <case src="0" operator="&gt;" format="*1" default="yes"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

</hi2txt>
