<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    Marvel Super Heroes vs. Street Fighter (Capcom, 1997)
    mshvsf, mshvsfa, mshvsfa1, mshvsfb, mshvsfb1, mshvsfh,
    mshvsfj, mshvsfj1, mshvsfj2, mshvsfu, mshvsfu1, mshvsfu1d

    .hi file: 99 bytes (1 chunk from hiscore.dat)
      @:maincpu,program,ff2b0c,63,00,03

    2 ranking tables, 10-byte records:
      [VALUE:4 BCD] [CHAR:1] [PAD:1] [NAME:3] [00:1]
      Entries 1-5:  Score Ranking (BCD score)
      Entries 6-10: VS Ranking (BCD wins x10000), 10th short by 1

    Custom charset: 0x00=A..0x19=Z, 0x1A=0..0x23=9, 0x2B=space

    Defaults:
      Score: 50000 JON, 40000 X68, 30000 TAU, 20000 SUM, 10000 CHI
      VS:    2 WINS MOF, 2 WINS HRS, 2 WINS KAW, 2 WINS YOU, 2 WINS KAD
  //-->

  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,ff2b0c,63,00,03</definition>
      <size>99</size>
    </check>
    <!-- Score Ranking (5 entries) -->
    <loop count="5">
      <elt size="4" type="int" base="16" id="SCORE"/>
      <elt size="1" type="raw" id="SCHAR"/>
      <elt size="1" type="raw" id="SPAD"/>
      <elt size="3" type="text" id="SNAME"/>
      <elt size="1" type="raw" id="STERM"/>
    </loop>
    <!-- VS Ranking (5 entries, last entry short by 1) -->
    <loop count="5" skip-last-bytes="1">
      <elt size="4" type="int" base="16" id="WINS"/>
      <elt size="1" type="raw" id="VCHAR"/>
      <elt size="1" type="raw" id="VPAD"/>
      <elt size="3" type="text" id="VNAME"/>
      <elt size="1" type="raw" id="VTERM"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME" src="SNAME" format="cps2name"/>
    </table>
    <table id="VS RANKING">
      <column id="RANK" src="index" format="+1"/>
      <column id="WINS" format="/10000"/>
      <column id="NAME" src="VNAME" format="cps2name"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="/10000"><divide>10000</divide></format>

  <format id="cps2name" apply-to="char">
    <case src="0x00" dst="A"/>
    <case src="0x01" dst="B"/>
    <case src="0x02" dst="C"/>
    <case src="0x03" dst="D"/>
    <case src="0x04" dst="E"/>
    <case src="0x05" dst="F"/>
    <case src="0x06" dst="G"/>
    <case src="0x07" dst="H"/>
    <case src="0x08" dst="I"/>
    <case src="0x09" dst="J"/>
    <case src="0x0A" dst="K"/>
    <case src="0x0B" dst="L"/>
    <case src="0x0C" dst="M"/>
    <case src="0x0D" dst="N"/>
    <case src="0x0E" dst="O"/>
    <case src="0x0F" dst="P"/>
    <case src="0x10" dst="Q"/>
    <case src="0x11" dst="R"/>
    <case src="0x12" dst="S"/>
    <case src="0x13" dst="T"/>
    <case src="0x14" dst="U"/>
    <case src="0x15" dst="V"/>
    <case src="0x16" dst="W"/>
    <case src="0x17" dst="X"/>
    <case src="0x18" dst="Y"/>
    <case src="0x19" dst="Z"/>
    <case src="0x1A" dst="0"/>
    <case src="0x1B" dst="1"/>
    <case src="0x1C" dst="2"/>
    <case src="0x1D" dst="3"/>
    <case src="0x1E" dst="4"/>
    <case src="0x1F" dst="5"/>
    <case src="0x20" dst="6"/>
    <case src="0x21" dst="7"/>
    <case src="0x22" dst="8"/>
    <case src="0x23" dst="9"/>
    <case src="0x2B" dst=" "/>
  </format>
</hi2txt>
