<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Top Hunter">
  <!--
    Neo Geo saveram, byte-swap=2 ("BACKUP RAM OK !" confirmed).
    TOP 5 PLAYERS @ 0x33c, 5 x 8B: [FLAG:1][SCORE:3 BCD][NAME:3 ASCII][pad:1].
    Score physically precedes the name (the name-first alignment @0x340 is a false shift).
    NAME plain ASCII incl. '.' (0x2e), e.g. T.H, M.K. SCORE 3-byte BCD (leading zeros dropped).
    FLAG byte (e0/70/30/80/20) is unused by the reference -> raw.
  //-->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>
    <elt size="828" type="raw" id="HEADER"/>
    <loop count="5">
      <elt size="1" type="raw"  id="FLAG"/>
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="TOP 5 PLAYERS">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
</hi2txt>
