<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!-- Double Dragon (Neo Geo, doubledr) - saveram, byte-swap=2 -->
  <structure file="saveram">
    <check><size>65536</size></check>
    <elt size="800" type="text" id="PAD0"/>
    <!-- 5 x 16-byte entries -->
    <loop count="5">
      <elt size="4" type="int" id="PAD_A"/>
      <elt size="4" type="int" id="SCORE" byte-swap="2" endianness="big_endian" base="16"/>
      <elt size="2" type="int" id="CHARIDX" byte-swap="2" endianness="little_endian"/>
      <elt size="2" type="text" id="NAME_A" byte-swap="2" charset="ddname"/>
      <elt size="1" type="int" id="VSWIN"/>
      <elt size="1" type="text" id="NAME_C" charset="ddname"/>
      <elt size="2" type="int" id="PAD_B"/>
    </loop>
  </structure>

  <output>
    <table id="BEST DRAGONS">
      <column id="RANK"      src="index"   format="ordinal"/>
      <column id="POINT"     src="SCORE"/>
      <column id="CHARACTER" src="CHARIDX" format="character"/>
      <column id="NAME"      src="NAME_A"  format="namejoin"/>
      <column id="VS WIN"    src="VSWIN"   format="vswin"/>
    </table>
  </output>

  <!-- NAME = chars 1-2 (NAME_A, src) + char 3 (NAME_C, appended via concat), because
       byte-swap couples name char 3 with the VS WIN byte in one word -->
  <format id="namejoin"><concat><column src="NAME_C"/></concat></format>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>
  <format id="character">
    <case src="0" dst="BILLY"/>
    <case src="2" dst="JIMMY"/>
    <case src="4" dst="MARIAN"/>
    <case src="5" dst="ABOBO"/>
    <case src="6" dst="AMON"/>
    <case src="7" dst="EDDIE"/>
    <case src="8" dst="REBECCA"/>
    <case src="9" dst="DULTON"/>
    <case src="10" dst="CHENG-FU"/>
    <case src="11" dst="BURNOV"/>
    <!-- all 10 playable characters verified from saveram; indices 1 and 3 unused by the roster -->
    <case src="255" dst="?" default="yes"/>
  </format>
  <!-- VS WIN byte at +13. Assumed binary (0-99). Extend cases if wins exceed 30. -->
  <format id="vswin">
    <case src="0" dst="x 00"/>
    <case src="1" dst="x 01"/>
    <case src="2" dst="x 02"/>
    <case src="3" dst="x 03"/>
    <case src="4" dst="x 04"/>
    <case src="5" dst="x 05"/>
    <case src="6" dst="x 06"/>
    <case src="7" dst="x 07"/>
    <case src="8" dst="x 08"/>
    <case src="9" dst="x 09"/>
    <case src="10" dst="x 10"/>
    <case src="11" dst="x 11"/>
    <case src="12" dst="x 12"/>
    <case src="13" dst="x 13"/>
    <case src="14" dst="x 14"/>
    <case src="15" dst="x 15"/>
    <case src="16" dst="x 16"/>
    <case src="17" dst="x 17"/>
    <case src="18" dst="x 18"/>
    <case src="19" dst="x 19"/>
    <case src="20" dst="x 20"/>
    <case src="21" dst="x 21"/>
    <case src="22" dst="x 22"/>
    <case src="23" dst="x 23"/>
    <case src="24" dst="x 24"/>
    <case src="25" dst="x 25"/>
    <case src="26" dst="x 26"/>
    <case src="27" dst="x 27"/>
    <case src="28" dst="x 28"/>
    <case src="29" dst="x 29"/>
    <case src="30" dst="x 30"/>
    <case src="255" dst="x ??" default="yes"/>
  </format>
  <charset id="ddname"><char src="0x00" dst=""/></charset>
</hi2txt>
