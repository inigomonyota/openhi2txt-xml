<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- gforce2 by Sega, 1988 -->
<!-- hiscore.dat: @:suby,program,1fe400,38,00,01 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>56</size>
    </check>

    <!-- 7 records, 8 bytes each -->
    <loop count="7">
      <!-- Byte 0-3: Score (BCD). e.g., 00 12 88 50 = 128,850 -->
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <!-- Byte 4-6: Name (Standard ASCII-offset style for Sega Y-System) -->
      <elt size="3" type="text" id="NAME"  charset="gforce2_chars"/>
      <!-- Byte 7: Start Stage/Level (Integer) -->
      <elt size="1" type="int"  id="START"/>
    </loop>
  </structure>

  <output>
    <table id="ACE COMMANDERS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
      <column id="START" src="START"/>
    </table>
  </output>

  <!-- Translates 0-6 into 1ST-7TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Sega Y-System Alphanumeric Charset -->
  <charset id="gforce2_chars">
    <!-- Numbers 0-9 -->
    <char src="0x00" dst="0"/><char src="0x01" dst="1"/><char src="0x02" dst="2"/><char src="0x03" dst="3"/><char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/><char src="0x06" dst="6"/><char src="0x07" dst="7"/><char src="0x08" dst="8"/><char src="0x09" dst="9"/>
    <!-- Alphabet A-Z (Mapped based on TAK, KON, IPP defaults) -->
    <char src="0x0A" dst="A"/><char src="0x0B" dst="B"/><char src="0x0C" dst="C"/><char src="0x0D" dst="D"/><char src="0x0E" dst="E"/>
    <char src="0x0F" dst="F"/><char src="0x10" dst="G"/><char src="0x11" dst="H"/><char src="0x12" dst="I"/><char src="0x13" dst="J"/>
    <char src="0x14" dst="K"/><char src="0x15" dst="L"/><char src="0x16" dst="M"/><char src="0x17" dst="N"/><char src="0x18" dst="O"/>
    <char src="0x19" dst="P"/><char src="0x1A" dst="Q"/><char src="0x1B" dst="R"/><char src="0x1C" dst="S"/><char src="0x1D" dst="T"/>
    <char src="0x1E" dst="U"/><char src="0x1F" dst="V"/><char src="0x20" dst="W"/><char src="0x21" dst="X"/><char src="0x22" dst="Y"/><char src="0x23" dst="Z"/>
    <!-- Special Symbols -->
    <char src="0x42" dst="."/> <!-- Period used in .Z. and T.T -->
  </charset>
</hi2txt>