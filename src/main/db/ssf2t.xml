<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    ssf2t - Super Street Fighter II Turbo (Capcom, 1994)
    also: ssf2txj
    .hi file format (via hiscore.dat plugin)
    hiscore.dat: @:maincpu,program,ffd6a2,30,00,20
                 @:maincpu,program,ffd71a,4,00,00
    Block 1: 6 entries x 8 bytes = 48 bytes (4B score BCD + 3B name ASCII + 1B pad)
    Block 2: 4 bytes game state
    Total: 52 bytes. Game displays top 5 but stores 6.
  //-->

  <structure file=".hi">
    <check>
      <definition>0:ffd6a2:30:00:20
                  0:ffd71a:4:00:00</definition>
      <size>52</size>
    </check>
    <loop count="6">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw" id="PAD"/>
    </loop>
    <elt size="4" type="raw" id="TAIL"/>
  </structure>

  <output>
    <table id="RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>