<?xml version="1.0" encoding="UTF-8"?>
<hi2txt>
<!-- Q*bert's Qubes (Gottlieb, nvram). 6502 - no byte-swap.
     Two identical 20-entry tables:
       NOSER ELITE    @ raw 0x200
       SUPREME NOSERS @ raw 0x32f
     Entries are stored in REVERSE rank order (ascending score) -> loop_reverse_index.
     Record = 15 bytes:
       [0]     fd    marker
       [1:3]   two flag/pointer bytes (linked-list order; not displayed)
       [3:7]   00 00 00 00
       [7:11]  SCORE 4 bytes, one decimal digit per byte (BCD-style) => decoding-profile="bcd"
       [11]    ff    marker
       [12:15] NAME  3 chars, value+55 (A=0x0a); space = 0xff (charset)
     NOTE: file is authoritative - rank 11 name decodes to GHR (byte 0x11 = H) in BOTH table
     copies; the reference XML's "GMR" is a transcription typo. -->
<structure file="nvram">
  <check>
    <size>4096</size>
  </check>
  <elt size="512" type="raw" id="HEADER"/>
  <loop count="20">
    <elt size="7" type="raw"  id="HDR1"                                       table-index="loop_reverse_index"/>
    <elt size="4" type="int"  id="SCORE" decoding-profile="bcd"               table-index="loop_reverse_index"/>
    <elt size="1" type="raw"  id="MARK1"                                      table-index="loop_reverse_index"/>
    <elt size="3" type="text" id="NAME"  ascii-offset="55" charset="qbertqub" table-index="loop_reverse_index"/>
  </loop>
  <elt size="3" type="raw" id="GAP"/>
  <loop count="20">
    <elt size="7" type="raw"  id="HDR2"                                        table-index="loop_reverse_index"/>
    <elt size="4" type="int"  id="SCORE2" decoding-profile="bcd"              table-index="loop_reverse_index"/>
    <elt size="1" type="raw"  id="MARK2"                                      table-index="loop_reverse_index"/>
    <elt size="3" type="text" id="NAME2" ascii-offset="55" charset="qbertqub" table-index="loop_reverse_index"/>
  </loop>
</structure>

<output>
  <table id="NOSER ELITE">
    <column id="RANK" src="index" format="+1;Suffix)"/>
    <column id="SCORE"/>
    <column id="NAME"/>
  </table>
  <table id="SUPREME NOSERS">
    <column id="RANK" src="index" format="+1;Suffix)"/>
    <column id="SCORE2"/>
    <column id="NAME2"/>
  </table>
</output>

<charset id="qbertqub">
  <char src="0xff" dst=" "/>
</charset>
</hi2txt>
