<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  dynwar - Dynasty Wars (Capcom, 1989)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,ffe2d6,3c,e2,00
    @:maincpu,program,ff8158,04,00,00
  64 bytes = 12B header + 48B (6 x 8B entries) + 4B top score
  Record (8B): 4B score (BCD) + 3B name (CPS1 tile charset, step 2) + 1B pad
  Entries stored in slot order, game sorts by score for display.
  6 entries stored, 5 displayed (1 overflow from push-down).
  Charset: A-H=0x10-0x1E, I-P=0x30-0x3E, Q-X=0x50-0x5E, Y-Z=0x70-0x72 (step 2)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>64</size>
    </check>
    <!-- Header (12B) -->
    <elt size="12" type="raw" id="HEADER"/>
    <!-- 6 entries x 8B -->
    <loop count="6">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME" charset="tiles"/>
      <elt size="1" type="raw" id="PAD"/>
    </loop>
    <!-- Top score (4B BCD) -->
    <elt size="4" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="BEST 5" sort="SCORE" sort-order="desc" lines-max="5">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE" format="comma_score"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
    <case src="3" operator="=" dst="4TH"/>
    <case src="4" operator="=" dst="5TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="tiles">
    <!-- A-H: 0x10-0x1E step 2 -->
    <char src="0x10" dst="A"/>
    <char src="0x12" dst="B"/>
    <char src="0x14" dst="C"/>
    <char src="0x16" dst="D"/>
    <char src="0x18" dst="E"/>
    <char src="0x1A" dst="F"/>
    <char src="0x1C" dst="G"/>
    <char src="0x1E" dst="H"/>
    <!-- I-P: 0x30-0x3E step 2 -->
    <char src="0x30" dst="I"/>
    <char src="0x32" dst="J"/>
    <char src="0x34" dst="K"/>
    <char src="0x36" dst="L"/>
    <char src="0x38" dst="M"/>
    <char src="0x3A" dst="N"/>
    <char src="0x3C" dst="O"/>
    <char src="0x3E" dst="P"/>
    <!-- Q-X: 0x50-0x5E step 2 -->
    <char src="0x50" dst="Q"/>
    <char src="0x52" dst="R"/>
    <char src="0x54" dst="S"/>
    <char src="0x56" dst="T"/>
    <char src="0x58" dst="U"/>
    <char src="0x5A" dst="V"/>
    <char src="0x5C" dst="W"/>
    <char src="0x5E" dst="X"/>
    <!-- Y-Z: 0x70-0x72 step 2 -->
    <char src="0x70" dst="Y"/>
    <char src="0x72" dst="Z"/>
  </charset>

</hi2txt>
