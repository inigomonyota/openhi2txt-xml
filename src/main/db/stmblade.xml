<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- stmblade by Visco Corporation, 1996 -->
<!-- hiscore.dat: @:maincpu,program,28d3,80,15,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>128</size>
    </check>

    <!-- 10 records, exactly 10 bytes each -->
    <!-- Structure: 3(Name) + 4(Score LE) + 1(Marker) + 1(Pilot ID) + 1(Pad) -->
    <loop count="10">
      <elt size="3" type="text" id="NAME" charset="visco_chars"/>
      <elt size="4" type="int"  id="SCORE" endianness="little_endian"/>
      <elt size="1" type="raw"  id="MARKER"/>
      <elt size="1" type="int"  id="PILOT_ID"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <table id="TOP GUNNERS - HIGH SCORE RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK"  src="index"    format="ordinal"/>
      <column id="SCORE" src="SCORE"    format="comma_score"/>
      <column id="NAME"  src="NAME"/>
      <column id="PILOT" src="PILOT_ID" format="pilot_map"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- Pilot and Aircraft Mapping (Playable Ships Only) -->
  <format id="pilot_map">
    <case src="0" dst="LUCKY (F14-TOMCAT)"/>
    <case src="1" dst="ALEX (MIG-29A FULCRUM)"/>
    <case src="2" dst="CAMEL (AV-8B HARRIER II)"/>
    <case src="3" dst="KAMIKAZE (ZERO FIGHTER)"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Visco Character Set (Updated with Underscore) -->
  <charset id="visco_chars">
    <!-- Letters A-Z -->
    <char src="0x00" dst="A"/><char src="0x01" dst="B"/><char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/><char src="0x04" dst="E"/><char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/><char src="0x07" dst="H"/><char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/><char src="0x0A" dst="K"/><char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/><char src="0x0D" dst="N"/><char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/><char src="0x10" dst="Q"/><char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/><char src="0x13" dst="T"/><char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/><char src="0x16" dst="W"/><char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/><char src="0x19" dst="Z"/>
    <!-- Symbols -->
    <char src="0x1A" dst="."/>
    <char src="0x1C" dst="!"/>
    <char src="0x1D" dst="?"/>
    <char src="0x1E" dst="-"/>
    <char src="0x1F" dst="&amp;"/>
    <char src="0x2C" dst="_"/> <!-- Newly mapped underscore -->
  </charset>
</hi2txt>