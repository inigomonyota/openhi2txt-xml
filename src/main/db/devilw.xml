<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  devilw - Devil World (Konami, 1987)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,60131,ef,00,10
    @:maincpu,program,60049,3,00,30
  242 bytes = 239B main (29 x 8B + 7B partial) + 3B top score
  Record (8B): 3B score (BCD x10) + 3B name (charset A=0x11, .=0x2C) + 1B pad(0x10) + 1B pad(0x00)
  3 blocks of 10 entries: LABRYNA, CONDOR, third (backup/unknown).
  Last entry of third block truncated by 1B.
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>242</size>
    </check>
    <!-- LABRYNA: 10 x 8B -->
    <loop count="10">
      <elt size="3" type="int" id="LSCORE" base="16"/>
      <elt size="3" type="text" id="LNAME" charset="az"/>
      <elt size="2" type="raw" id="LPAD"/>
    </loop>
    <!-- CONDOR: 10 x 8B -->
    <loop count="10">
      <elt size="3" type="int" id="CSCORE" base="16"/>
      <elt size="3" type="text" id="CNAME" charset="az"/>
      <elt size="2" type="raw" id="CPAD"/>
    </loop>
    <!-- Third block: 9 full x 8B + 1 truncated x 7B -->
    <elt size="79" type="raw" id="BLOCK3"/>
    <!-- Top score (3B BCD) -->
    <elt size="3" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="BEST 10 PLAYERS - LABRYNA">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE" src="LSCORE" format="score_x10"/>
      <column id="NAME" src="LNAME"/>
    </table>
    <table id="BEST 10 PLAYERS - CONDOR">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="SCORE" src="CSCORE" format="score_x10"/>
      <column id="NAME" src="CNAME"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" operator="=" dst="1ST"/>
    <case src="1" operator="=" dst="2ND"/>
    <case src="2" operator="=" dst="3RD"/>
    <case src="3" operator="=" dst="4TH"/>
    <case src="4" operator="=" dst="5TH"/>
    <case src="5" operator="=" dst="6TH"/>
    <case src="6" operator="=" dst="7TH"/>
    <case src="7" operator="=" dst="8TH"/>
    <case src="8" operator="=" dst="9TH"/>
    <case src="9" operator="=" dst="10TH"/>
  </format>

  <format id="score_x10"><multiply>10</multiply><case src="0" operator="&gt;=" format="comma_score"/></format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="az">
    <char src="0x11" dst="A"/>
    <char src="0x12" dst="B"/>
    <char src="0x13" dst="C"/>
    <char src="0x14" dst="D"/>
    <char src="0x15" dst="E"/>
    <char src="0x16" dst="F"/>
    <char src="0x17" dst="G"/>
    <char src="0x18" dst="H"/>
    <char src="0x19" dst="I"/>
    <char src="0x1A" dst="J"/>
    <char src="0x1B" dst="K"/>
    <char src="0x1C" dst="L"/>
    <char src="0x1D" dst="M"/>
    <char src="0x1E" dst="N"/>
    <char src="0x1F" dst="O"/>
    <char src="0x20" dst="P"/>
    <char src="0x21" dst="Q"/>
    <char src="0x22" dst="R"/>
    <char src="0x23" dst="S"/>
    <char src="0x24" dst="T"/>
    <char src="0x25" dst="U"/>
    <char src="0x26" dst="V"/>
    <char src="0x27" dst="W"/>
    <char src="0x28" dst="X"/>
    <char src="0x29" dst="Y"/>
    <char src="0x2A" dst="Z"/>
    <char src="0x2C" dst="."/>
  </charset>

</hi2txt>
