<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- viprp1 by Seibu Kaihatsu Inc., 1995 -->
<!-- hiscore.dat: @:maincpu,program,1e610,c7,40,2e -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>199</size>
    </check>

    <!-- BLOCK 1: SOLO PLAYERS (10 records x 10 bytes = 100 bytes) -->
    <!-- Structure: 4(Score LE) + 1(Stage) + 1(Sub) + 4(Name) -->
    <loop count="10">
      <elt size="4" type="int"  id="S_SCORE" endianness="little_endian"/>
      <elt size="1" type="int"  id="S_STAGE"/>
      <elt size="1" type="int"  id="S_SUB"/>
      <elt size="4" type="text" id="S_NAME"  charset="seibu_nulls"/>
    </loop>

    <!-- BLOCK 2: DUAL PLAYERS (10 records x 10 bytes = 100 bytes) -->
    <!-- skip-last-bytes="1" handles the 199-byte file limit -->
    <loop count="10" skip-last-bytes="1">
      <elt size="4" type="int"  id="D_SCORE" endianness="little_endian"/>
      <elt size="1" type="int"  id="D_STAGE"/>
      <elt size="1" type="int"  id="D_SUB"/>
      <elt size="4" type="text" id="D_NAME"  charset="seibu_nulls"/>
    </loop>
  </structure>

  <output>
    <table id="ACE PILOTS - SOLO PLAYERS">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="SCORE" src="S_SCORE" format="comma_score"/>
      <column id="NAME"  src="S_NAME"  format="trim_right"/>
      <column id="STG"   format="solo_stg"/>
    </table>

    <table id="ACE PILOTS - DUAL PLAYERS">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="SCORE" src="D_SCORE" format="comma_score"/>
      <column id="NAME"  src="D_NAME"  format="trim_right"/>
      <column id="STG"   format="dual_stg"/>
    </table>
  </output>

  <!-- Stage Concatenators -->
  <format id="solo_stg" input-as-subcolumns-input="yes">
    <concat><column id="S_STAGE"/><txt>-</txt><column id="S_SUB"/></concat>
  </format>

  <format id="dual_stg" input-as-subcolumns-input="yes">
    <concat><column id="D_STAGE"/><txt>-</txt><column id="D_SUB"/></concat>
  </format>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <charset id="seibu_nulls">
    <char src="0x00" dst=""/> <!-- Removes null terminators safely -->
  </charset>
</hi2txt>