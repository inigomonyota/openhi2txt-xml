<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Power Drift">
  <!--
    structure: 20 entries x 20 bytes (file is 399 bytes - last byte missing)
    per entry:
      [0-3]  score, 4-byte BCD big-endian
      [4]    time minutes, BCD
      [5]    time seconds, BCD
      [6]    time centiseconds, BCD
      [7]    unknown (internal timer byte)
      [8-10] name, 3 ASCII chars
      [11]   null terminator
      [12]   course index (0=A, 1=B, 2=C, 3=D, 4=E)
      [13-19] prize/trophy data
  //-->

  <structure file=".hi">
    <check>
      <size>399</size>
    </check>
    <loop count="20">
      <elt size="4" type="int"  id="SCORE"    base="16"/>
      <elt size="1" type="int"  id="TIME MN"  base="16"/>
      <elt size="1" type="int"  id="TIME SEC" base="16"/>
      <elt size="1" type="int"  id="TIME CS"  base="16"/>
      <elt size="1" type="raw"  id="UNKNOWN"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="NULL"/>
      <elt size="1" type="int"  id="COURSE"/>
      <elt size="7" type="raw"  id="PRIZE"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"    src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="COURSE"  format="course"/>
      <column id="TIME"    format="time"/>
      <column id="UNKNOWN" format="hexadecimal_string" display="debug"/>
      <column id="PRIZE"   format="hexadecimal_string" display="debug"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="course">
    <case src="0" dst="A"/>
    <case src="1" dst="B"/>
    <case src="2" dst="C"/>
    <case src="3" dst="D"/>
    <case src="4" dst="E"/>
  </format>

  <format id="mn"><suffix>'</suffix></format>
  <format id="sec"><pad direction="left" max="2">0</pad></format>
  <format id="cs"><pad direction="left" max="2">0</pad></format>

  <format id="time">
    <concat>
      <column id="TIME MN"  format="mn"/>
      <column id="TIME SEC" format="sec"/>
      <txt>"</txt>
      <column id="TIME CS"  format="cs"/>
    </concat>
  </format>

</hi2txt>