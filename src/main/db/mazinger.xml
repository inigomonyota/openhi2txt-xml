<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- mazinger by Banpresto, 1994 -->
<!-- hiscore.dat: @:maincpu,program,100022,43,00,4e -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>67</size>
    </check>

    <!-- 1. Global High Score (4 bytes) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>

    <!-- 2. 8 Ranking Records (8 bytes each) -->
    <!-- Structure: 4(Score BCD) + 3(Name) + 1(Pad) -->
    <!-- skip-last-bytes="1" handles the missing padding byte in the 8th record (67 total bytes) -->
    <loop count="8" skip-last-bytes="1">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  charset="mazinger_chars"/>
      <elt size="1" type="raw"  id="PAD"/>
    </loop>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="comma_score" display="extra"/-->

    <table id="TODAY'S TOP 8">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-7 into TOP-8TH -->
  <format id="ordinal">
    <case src="0" dst="TOP"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Custom charset for special symbols like the underscore -->
  <charset id="mazinger_chars">
    <char src="0x5F" dst="_"/>
    <char src="0x00" dst=""/>
  </charset>
</hi2txt>