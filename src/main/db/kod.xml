<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    kod: The King of Dragons (World 910805)
    Hiscores stored in hiscore/kod.hi (40 bytes)

    5 entries, 8 bytes each:
      - 4 bytes SCORE (packed BCD, base=16 decoding)
      - 3 bytes NAME  (0=A .. 25=Z) => ascii-offset=65
      - 1 byte CLASS  (00=ELF, 01=WIZ, 02=FIG, 03=CLR, 04=DWF assumed)
  //-->

  <structure file=".hi">
    <check>
      <size>40</size>
    </check>

    <loop count="5">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"  ascii-offset="65"/>
      <elt size="1" type="text" id="CLASS" charset="kodclass"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"/>
      <column id="CLASS"/>
      <column id="SCORE"/>
    </table>
  </output>

  <charset id="kodclass">
    <char src="0x00" dst="ELF"/>
    <char src="0x01" dst="WIZ"/>
    <char src="0x02" dst="FIG"/>
    <char src="0x03" dst="CLR"/>
    <char src="0x04" dst="DWF"/>
  </charset>
</hi2txt>
