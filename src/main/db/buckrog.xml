<?xml version="1.0" encoding="utf-8"?>
<hi2txt>
  <!--
    buckrog (.hi) definition for hi2txt

    hiscore.dat ranges (reference):
      @:maincpu,program,c400,3e,00,00   -> 0x3E (62 bytes) names + scores
      @:maincpu,program,c549,10,ff,ff   -> 0x10 (16 bytes) aux/check
      @:maincpu,program,c54b,1,0f,0f    -> 0x01 (1 byte)  aux/check
      Total .hi size = 79 bytes

    Layout inside first 0x3E bytes:
      - Names: 10 entries x 3 bytes = 30 bytes (ASCII; 0x00 padding)
      - Pad : 2 bytes
      - Scores: 10 entries x 3 bytes = 30 bytes
          [0x00 pad][2 bytes packed BCD]  e.g. 00 58 76 -> 5876
  -->

  <structure file=".hi">
    <check><size>79</size></check>

    <!-- 10 names -->
    <loop count="10">
      <elt size="3" type="text" id="NAME" charset="buckrog" />
    </loop>

    <elt size="2" type="raw" id="_PAD0"/>

    <!-- 10 scores -->
    <loop count="10">
      <elt size="1" type="raw" id="_SPAD"/>
      <elt size="2" type="int" id="SCORE" base="16"/>
    </loop>

    <!-- ignore remaining aux/check bytes -->
    <elt size="17" type="raw" id="_TAIL"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE" format="blank_zero"/>
      <column id="NAME"  src="NAME"  format="trimr"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="trimr">
    <trim direction="right"> </trim>
  </format>

  <format id="blank_zero">
    <case src="0" dst=""/>
  </format>

  <charset id="buckrog">
    <char src="0x00" dst=" "/>
  </charset>
</hi2txt>
