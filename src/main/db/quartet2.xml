<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <structure file=".hi">
    <check>
      <size>792</size>
    </check>

    <loop count="99">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="_Z"/>
    </loop>
  </structure>

  <output>
    <table id="SUPER PLAYERS">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="NAME"  src="NAME" format="trimr"/>
    </table>
  </output>

</hi2txt>
