<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  devstors - Devastators (Konami, 1988)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,41c4,2e,01,01
  46 bytes = 24B names + 6B padding + 16B scores
  Block layout:
    Names: 8 x 3B (charset A=0x01, Z=0x1A)
    Padding: 6B
    Scores: 8 x 2B BCD
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>46</size>
    </check>
    <!-- Names: 8 x 3B -->
    <loop count="8">
      <elt size="3" type="text" id="NAME" charset="az"/>
    </loop>
    <!-- Padding: 6B -->
    <elt size="6" type="raw" id="PAD"/>
    <!-- Scores: 8 x 2B BCD -->
    <loop count="8">
      <elt size="2" type="int" id="SCORE" base="16"/>
    </loop>
  </structure>

  <output>
    <table id="SCORE RANKING">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE" format="comma_score"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <!-- If score is >= 1,000,000,000 (Billions) -->
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    
    <!-- If score is >= 1,000,000 (Millions) -->
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    
    <!-- If score is >= 1,000 (Thousands) -->
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    
    <!-- Fallback for scores under 1,000 (Passes the number through as-is) -->
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <!-- Formats like: 1,234,567,890 -->
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234,567 -->
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <!-- Formats like: 1,234 -->
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="az">
    <char src="0x01" dst="A"/>
    <char src="0x02" dst="B"/>
    <char src="0x03" dst="C"/>
    <char src="0x04" dst="D"/>
    <char src="0x05" dst="E"/>
    <char src="0x06" dst="F"/>
    <char src="0x07" dst="G"/>
    <char src="0x08" dst="H"/>
    <char src="0x09" dst="I"/>
    <char src="0x0A" dst="J"/>
    <char src="0x0B" dst="K"/>
    <char src="0x0C" dst="L"/>
    <char src="0x0D" dst="M"/>
    <char src="0x0E" dst="N"/>
    <char src="0x0F" dst="O"/>
    <char src="0x10" dst="P"/>
    <char src="0x11" dst="Q"/>
    <char src="0x12" dst="R"/>
    <char src="0x13" dst="S"/>
    <char src="0x14" dst="T"/>
    <char src="0x15" dst="U"/>
    <char src="0x16" dst="V"/>
    <char src="0x17" dst="W"/>
    <char src="0x18" dst="X"/>
    <char src="0x19" dst="Y"/>
    <char src="0x1A" dst="Z"/>
  </charset>

</hi2txt>