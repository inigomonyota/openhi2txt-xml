<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Samurai Shodown II">

  <!--
    Neo Geo 64KB saveram, interpreted after byte-swap="2".

    Persistent records:
      0x0322-0x0325 : highest score (4 bytes, decimal digits stored as hex nibbles)
      0x0326-0x0328 : highest-score initials (00=A ... 19=Z)
      0x0330-0x0331 : most wins
      0x0332-0x0334 : most-wins initials (00=A ... 19=Z)
      0x033A-0x033F : CLEAR TIME RANKING - VS COM, 3 x 2-byte times
      0x0340-0x0345 : CLEAR TIME RANKING - 1P VS 2P, 3 x 2-byte times

    Time bytes are decimal digits held in hexadecimal form:
      99 94 -> 99.94
      70 00 -> 70.00
  -->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>

    <!-- 0x0000-0x0321 -->
    <elt size="802" type="raw" id="_PREFIX"/>

    <!-- 0x0322 -->
    <elt size="4" type="int" id="HIGH_SCORE"
         endianness="big_endian" base="16"/>

    <!-- 0x0326 -->
    <elt size="3" type="text" id="HIGH_SCORE_NAME"
         charset="samsho2_name"/>

    <!-- 0x0329-0x032F -->
    <elt size="7" type="raw" id="_GAP1"/>

    <!-- 0x0330 -->
    <elt size="2" type="int" id="MOST_WINS"
         endianness="big_endian"/>

    <!-- 0x0332 -->
    <elt size="3" type="text" id="MOST_WINS_NAME"
         charset="samsho2_name"/>

    <!-- 0x0335-0x0339 -->
    <elt size="5" type="raw" id="_GAP2"/>

    <!-- 0x033A-0x033F -->
    <loop count="3">
      <elt size="2" type="int" id="VS_COM_TIME"
           endianness="big_endian" base="16"/>
    </loop>

    <!-- 0x0340-0x0345 -->
    <loop count="3">
      <elt size="2" type="int" id="P1_VS_P2_TIME"
           endianness="big_endian" base="16"/>
    </loop>

    <!-- 0x0346-0xFFFF -->
    <elt size="64698" type="raw" id="_SUFFIX"/>
  </structure>

  <output>
    <table id="PLAYER WITH THE HIGHEST SCORE" lines-max="1">
      <column id="NAME" src="HIGH_SCORE_NAME"/>
      <column id="SCORE" src="HIGH_SCORE"/>
    </table>

    <table id="PLAYER WITH THE MOST NUMEROUS WIN" lines-max="1">
      <column id="NAME" src="MOST_WINS_NAME"/>
      <column id="WINS" src="MOST_WINS"/>
    </table>

    <table id="CLEAR TIME RANKING - VS COM" lines-max="3">
      <column id="RANK" src="index" format="+1"/>
      <column id="TIME" src="VS_COM_TIME" format="time"/>
    </table>

    <table id="CLEAR TIME RANKING - 1P VS 2P" lines-max="3">
      <column id="RANK" src="index" format="+1"/>
      <column id="TIME" src="P1_VS_P2_TIME" format="time"/>
    </table>
  </output>

  <format id="time" input-as-subcolumns-input="yes">
    <concat>
      <column format="d100"/>
      <txt>.</txt>
      <column format="%100;PadL20"/>
    </concat>
  </format>

  <charset id="samsho2_name">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0A" dst="K"/>
    <char src="0x0B" dst="L"/>
    <char src="0x0C" dst="M"/>
    <char src="0x0D" dst="N"/>
    <char src="0x0E" dst="O"/>
    <char src="0x0F" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
  </charset>

</hi2txt>
