<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!-- The Last Blade 2 (lastbld2) - Neo Geo saveram, byte-swap=2 -->
  <structure file="saveram">
    <check><size>65536</size></check>
    <!-- skip to 0x360 where the score table begins -->
    <elt size="864" type="text" id="PAD0"/>
    <!-- SCORE RANKING: 5 x 12 bytes = score(4 BCD) + name(3+NUL) + charindex(2) + pad(2) -->
    <loop count="5">
      <elt size="4" type="int" id="SCORE" byte-swap="2" endianness="big_endian" base="16"/>
      <elt size="4" type="text" id="SNAME" byte-swap="2" charset="tb2name"/>
      <elt size="2" type="int" id="CHARIDX" byte-swap="2" endianness="big_endian"/>
      <elt size="2" type="int" id="SPAD" byte-swap="2"/>
    </loop>
    <!-- TIME ATTACK: 16 fighters x 3 entries = name(3+NUL) + beatby(1) + NUL(1) -->
    <!-- KAEDE -->
    <elt size="4" type="text" id="KAEDE_NAME" table-index="0" byte-swap="2" charset="tb2name"/>
    <elt size="2" type="int" id="KAEDE_BEAT" table-index="0" byte-swap="2" endianness="little_endian"/>
    <elt size="4" type="text" id="KAEDE_NAME" table-index="1" byte-swap="2" charset="tb2name"/>
    <elt size="2" type="int" id="KAEDE_BEAT" table-index="1" byte-swap="2" endianness="little_endian"/>
