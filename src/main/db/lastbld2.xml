    <elt size="2" type="int" id="SETSUNA_BEAT" table-index="1" byte-swap="2" endianness="little_endian"/>
    <elt size="4" type="text" id="SETSUNA_NAME" table-index="2" byte-swap="2" charset="tb2name"/>
