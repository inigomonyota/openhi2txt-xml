    <elt size="2" type="int" id="SHIGEN_BEAT" table-index="0" byte-swap="2" endianness="little_endian"/>
    <elt size="4" type="text" id="SHIGEN_NAME" table-index="1" byte-swap="2" charset="tb2name"/>
