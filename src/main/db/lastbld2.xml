      <column id="NAME"    src="SETSUNA_NAME"/>
      <column id="BEAT BY" src="SETSUNA_BEAT" format="beatby"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>
  <format id="beatby">
    <case src="5"  dst="BEAT BY- 5"/>
    <case src="10" dst="BEAT BY-10"/>
    <case src="15" dst="BEAT BY-15"/>
    <case src="0"  dst="BEAT BY- 0" default="yes"/>
  </format>
  <format id="character">
    <case src="0" dst="KAEDE"/>
    <case src="1" dst="MORIYA"/>
    <case src="2" dst="YUKI"/>
    <case src="3" dst="OKINA"/>
    <case src="4" dst="AKARI"/>
    <case src="5" dst="JUZOH"/>
    <case src="6" dst="WASHIZUKA"/>
    <case src="7" dst="MUKURO"/>
    <case src="8" dst="AMANO"/>
    <case src="9" dst="LEE"/>
    <case src="10" dst="ZANTETSU"/>
    <case src="11" dst="SHIGEN"/>
    <case src="12" dst="KAGAMI"/>
    <case src="13" dst="KOJIROH"/>
    <case src="14" dst="HIBIKI"/>
    <case src="15" dst="SETSUNA"/>
    <!-- Hidden / code characters - all four indices verified from saveram
         (16 Kouryu, 17 Original Kaede, 18 Hagure Hitogata, 19 Naoe Kotetsu) -->
    <case src="16" dst="KOURYU"/>
    <case src="17" dst="ORIGINAL KAEDE"/>
    <case src="18" dst="HAGURE HITOGATA"/>
    <case src="19" dst="NAOE KOTETSU"/>   <!-- verified: BBB / 471100 -->
    <case src="255" dst="?" default="yes"/>
  </format>
  <charset id="tb2name">
    <char src="0x00" dst=""/>
  </charset>
</hi2txt>
