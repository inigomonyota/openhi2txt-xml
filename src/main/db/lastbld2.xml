  <output>
    <table id="SCORE RANKING">
      <column id="RANK"      src="index"   format="ordinal"/>
      <column id="NAME"      src="SNAME"/>
      <column id="SCORE"     src="SCORE"/>
      <column id="CHARACTER" src="CHARIDX" format="character"/>
    </table>
    <table id="TIME ATTACK RANKING - KAEDE">
      <column id="RANK"    src="index" format="ordinal"/>
      <column id="NAME"    src="KAEDE_NAME"/>
      <column id="BEAT BY" src="KAEDE_BEAT" format="beatby"/>
    </table>
    <table id="TIME ATTACK RANKING - MORIYA">
      <column id="RANK"    src="index" format="ordinal"/>
      <column id="NAME"    src="MORIYA_NAME"/>
      <column id="BEAT BY" src="MORIYA_BEAT" format="beatby"/>
    </table>
    <table id="TIME ATTACK RANKING - YUKI">
      <column id="RANK"    src="index" format="ordinal"/>
      <column id="NAME"    src="YUKI_NAME"/>
