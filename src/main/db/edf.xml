<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- edf by Jaleco, 1991 -->
<!-- hiscore.dat: @:maincpu,program,64c17,107,01,00 | @:maincpu,program,61d3e,4,00,00 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>268</size>
    </check>

    <!-- Block 1: Rank Markers (Offsets 0-19) -->
    <loop count="10">
      <elt size="2" type="raw" id="RANK_MARKER"/>
    </loop>

    <!-- Block 2: Scores (Offsets 20-58, 39 bytes) -->
    <!-- Stored as 2-byte BCD (×100 for display). 48 05 -> BCD 4805 * 100 = 480,500 -->
    <!-- Each entry: 2B score + 2B pad. Last entry has only 1B pad (skip-last-bytes). -->
    <loop count="10" skip-last-bytes="1">
      <elt size="2" type="int" id="SCORE" base="16" table-index="loop_index"/>
      <elt size="2" type="raw" id="SPAD"/>
    </loop>

    <!-- Block 3: Names (Offsets 59-158) -->
    <!-- Record size: exactly 10 bytes. 8-char name + 2 null bytes. -->
    <loop count="10">
      <elt size="10" type="text" id="NAME" charset="edf_clean" table-index="loop_index"/>
    </loop>

    <!-- Block 4: Stages (Offsets 159-178) -->
    <!-- Big Endian 00 07 -> 7 -->
    <loop count="10">
      <elt size="2" type="int" id="STAGE_RAW" endianness="big_endian" table-index="loop_index"/>
    </loop>

    <!-- Block 5: Junk/Metadata Padding (85 bytes) -->
    <elt size="85" type="raw" id="GAP"/>

    <!-- Block 6: Global High Score (4 bytes) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="d100;PadL80" display="extra"/-->

    <table id="BEST PILOTS RANKING">
      <column id="RANK"  src="index"     format="ordinal"/>
      <!-- *100 converts 2-byte BCD to full score, PadL80 zero-pads to 8 digits -->
      <column id="SCORE" src="SCORE"     format="*100;comma_score"/>
      <column id="NAME"  src="NAME"      format="trim_right"/>
      <column id="STAGE" src="STAGE_RAW" format="stage_map"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/><case src="4" dst="5TH"/><case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/><case src="7" dst="8TH"/><case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- Maps internal stage values to game display -->
  <format id="stage_map">
    <case src="7" dst="ALL"/>
    <case src="0" operator="&gt;" format="*1" default="yes"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Charset for null handling -->
  <charset id="edf_clean">
    <char src="0x00" dst=""/>
    <char src="0x26" dst="&amp;"/>
  </charset>
</hi2txt>