<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Frenzy">
  <!--
    hiscore.dat entry already exists (frenzy)
    10 entries x 6 bytes = 60 bytes + 0xFF sentinel
    Score: 3 bytes BCD
    Name:  3 bytes ASCII
  //-->

  <structure file="hi">
    <check>
      <size>61</size>
    </check>
    <loop count="10">
      <elt size="3" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME" ascii-offset="0"/>
    </loop>
    <elt size="1" type="raw" id="SENTINEL"/>
  </structure>

  <output>
    <table id="HIGH SCORES">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>