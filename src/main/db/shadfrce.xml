<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Shadow Force">
  <!--
    shadfrce / shadfrcej  (Shadow Force, Technos 1993, M68000, shadfrce.cpp).
    Scores live in volatile work RAM; there is no nvram file, so the MAME
    hiscore plugin restores them on boot from three blocks that concatenate,
    in hiscore.dat order, into the 44-byte .hi:
      @:maincpu,program,1f002a,2 ,00,05   -> .hi bytes 0x00-0x01 (rec1 score hi)
      @:maincpu,program,1f002c,26,00,00   -> .hi bytes 0x02-0x27 (rest of recs)
      @:maincpu,program,1f0022,4 ,00,00   -> .hi bytes 0x28-0x2b (HI-score copy)
    Because 0x1f002a is immediately followed by 0x1f002c in RAM, the first two
    blocks are contiguous: .hi 0x00-0x27 = five 8-byte RANKING records. The
    trailing 4 bytes (0x28-0x2b) are the top "HI" score mirror (same as rank 1)
    and are skipped here.

    RANKING record (8 bytes):
      +0 SCORE  : 4 bytes packed BCD, big-endian (00 05 00 00 = 50000). Decoded
                  with base="16" (packed 2-digit-per-byte BCD; same technique as
                  jojoban). On-screen 8-digit field, leading zeros dropped.
      +4 NAME   : 3 bytes plain ASCII (e.g. 0x54 0x41 0x4b = "TAK").
      +7 AVATAR : 1 byte character id of the fighter used:
                  0=KAI, 1=TENGU, 2=COYOTE, 3=BLUNET.
    Factory default table (snap 0001):
      1st KAI    50000 TAK / 2nd TENGU 40000 EBI / 3rd COYOTE 30000 MAT
      4th BLUNET 20000 TJC / 5th KAI   10000 ATI
    Proven byte-for-byte against the live plugin .hi (hiscore/shadfrce.hi).
    Authored by Pipmick @ CoinOPS.
  //-->

  <structure file=".hi">
    <check>
      <size>44</size>
    </check>

    <loop count="5">
      <elt size="4" type="int"  id="SCORE"  base="16" table-index="loop_index"/>
      <elt size="3" type="text" id="NAME"   table-index="loop_index"/>
      <elt size="1" type="int"  id="AVATAR" table-index="loop_index"/>
    </loop>

    <!-- trailing 4-byte "HI" score mirror (= rank 1), skipped -->
    <elt size="4" type="raw" id="_HI"/>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"      src="index"  format="ordinal"/>
      <column id="CHARACTER" src="AVATAR" format="avatar"/>
      <column id="SCORE"     src="SCORE"/>
      <column id="NAME"      src="NAME"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <format id="avatar">
    <case src="0" dst="KAI"/>
    <case src="1" dst="TENGU"/>
    <case src="2" dst="COYOTE"/>
    <case src="3" dst="BLUNET"/>
  </format>
</hi2txt>
