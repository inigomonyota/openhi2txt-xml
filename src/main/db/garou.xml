<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Garou: Mark of the Wolves">

  <!--
    Neo Geo 64KB saveram.
    BEST BOUT table starts at swapped offset 0x05A8.

    5 records x 8 bytes:
      +0      CHARACTER / portrait selector
      +1..3   NAME (ASCII)
      +4..7   SCORE, stored as hexadecimal-looking decimal digits.
               Example: 00 12 38 00 -> base="16" -> 123800

    Character mapping was verified directly from leaderboard entries:
      00 TERRY
      01 ROCK
      02 DONG HWAN
      03 JAE HOON
      04 HOTARU
      05 GATO
      06 B. JENET
      07 BUTT
      08 HOKUTOMARU
      09 FREEMAN
      0A TIZOC
      0B KEVIN
      0C GRANT
      0D KAIN
  -->

  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>

    <elt size="1448" type="raw" id="_PREFIX"/>

    <loop count="5">
      <elt size="1" type="int"  id="CHARACTER"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="4" type="int"  id="SCORE" endianness="big_endian" base="16"/>
    </loop>

    <elt size="64048" type="raw" id="_SUFFIX"/>
  </structure>

  <output>
    <table id="BEST BOUT" lines-max="5">
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" src="NAME"/>
      <column id="CHARACTER" src="CHARACTER" format="character"/>
      <column id="SCORE" src="SCORE"/>
    </table>
  </output>

  <format id="character">
    <case src="0"  dst="TERRY"/>
    <case src="1"  dst="ROCK"/>
    <case src="2"  dst="DONG HWAN"/>
    <case src="3"  dst="JAE HOON"/>
    <case src="4"  dst="HOTARU"/>
    <case src="5"  dst="GATO"/>
    <case src="6"  dst="B. JENET"/>
    <case src="7"  dst="BUTT"/>
    <case src="8"  dst="HOKUTOMARU"/>
    <case src="9"  dst="FREEMAN"/>
    <case src="10" dst="TIZOC"/>
    <case src="11" dst="KEVIN"/>
    <case src="12" dst="GRANT"/>
    <case src="13" dst="KAIN"/>
  </format>

</hi2txt>
