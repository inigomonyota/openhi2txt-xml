<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Renegade">
  <!--
    hiscore.dat:
      @:maincpu,program,101b,28 -> 40 bytes (5 entries x 8 bytes)
      @:maincpu,program,2e,3    -> 3 bytes trailing (skip)
    Entry: 3-byte BCD score (little-endian) + 2-byte pad + 3-byte ASCII name
  //-->

  <structure file="hi">
    <check>
      <size>43</size>
    </check>
    <loop count="5">
      <elt size="3" type="int"  id="SCORE" base="16" endianness="little_endian" table-index="loop_index"/>
      <elt size="2" type="raw"  id="PAD"   table-index="loop_index"/>
      <elt size="3" type="text" id="NAME"  ascii-offset="0" table-index="loop_index"/>
    </loop>
    <elt size="3" type="raw" id="TAIL"/>
  </structure>

  <output>
    <table id="BEST SCORE">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"/>
      <column id="SCORE"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>