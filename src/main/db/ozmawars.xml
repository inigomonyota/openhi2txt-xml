<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Ozma Wars">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,2043,02,00,00</definition>
      <size>2</size>
    </check>
    <loop count="1">
      <elt size="2" type="int" id="SCORE" endianness="little_endian" base="16"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="*10"/>
    </table>
  </output>

</hi2txt>
