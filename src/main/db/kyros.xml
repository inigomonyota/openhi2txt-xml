<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Kyros">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,20e00,ae,01,02
                  @:maincpu,program,20020,4,00,00</definition>
      <size>178</size>
    </check>
    <loop count="10">
      <elt size="1" type="raw"  id="FLAG"/>
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="raw"  id="PAD"/>
      <elt size="1" type="int"  id="RANK_IDX"/>
      <elt size="8" type="text" id="NAME"/>
    </loop>
    <elt size="38" type="raw" id="EMPTY"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="RANK_IDX" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
    </table>
  </output>
</hi2txt>
