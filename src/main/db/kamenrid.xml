<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Masked Riders Club Battle Race">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,202e93,9f,0a,10</definition>
      <size>159</size>
    </check>
    <loop count="10" skip-last-bytes="1">
      <elt size="1" type="raw"  id="RANK_RAW"/>
      <elt size="1" type="raw"  id="PAD0"/>
      <elt size="1" type="text" id="CHAR1" charset="kamenrid" ascii-offset="65" table-index="loop_reverse_index"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="1" type="text" id="CHAR2" charset="kamenrid" ascii-offset="65" table-index="loop_reverse_index"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="1" type="text" id="CHAR3" charset="kamenrid" ascii-offset="65" table-index="loop_reverse_index"/>
      <elt size="1" type="raw"  id="PAD3"/>
      <elt size="1" type="int"  id="STAGE" table-index="loop_reverse_index"/>
      <elt size="1" type="raw"  id="PAD4"/>
      <elt size="1" type="int"  id="RIDER" table-index="loop_reverse_index"/>
      <elt size="1" type="raw"  id="PAD5"/>
      <elt size="3" type="int"  id="SCORE" base="10" table-index="loop_reverse_index"/>
      <elt size="1" type="raw"  id="PAD6"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="*10"/>
      <column id="NAME"  format="name"/>
      <column id="STAGE" format="+1;stage"/>
    </table>
  </output>

  <format id="name">
    <concat>
      <column id="CHAR1"/>
      <column id="CHAR2"/>
      <column id="CHAR3"/>
    </concat>
  </format>

  <format id="stage">
    <case src="10" dst="ALL"/>
  </format>

  <charset id="kamenrid">
    <char src="0x1a" dst="0"/>
    <char src="0x1b" dst="1"/>
    <char src="0x1c" dst="2"/>
    <char src="0x1d" dst="3"/>
    <char src="0x1e" dst="4"/>
    <char src="0x1f" dst="5"/>
    <char src="0x20" dst="6"/>
    <char src="0x21" dst="7"/>
    <char src="0x22" dst="8"/>
    <char src="0x23" dst="9"/>
  </charset>
</hi2txt>
