<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check><size>52</size></check>

    <!-- 1. Skip the pushed-out 6th rank score -->
    <elt size="4" type="raw" id="SKIP_S6"/>

    <!-- 2. Read the 5 scores (Stored Lowest-to-Highest) -->
    <!-- loop_reverse_index automatically flips them to Highest-to-Lowest! -->
    <!-- skip-last-bytes="2" handles the missing padding on the 1st place score. -->
    <loop count="5" skip-last-bytes="2">
      <elt size="2" type="int" id="SCORE" base="16" table-index="loop_reverse_index"/>
      <elt size="2" type="raw" id="S_PAD"/>
    </loop>

    <!-- 3. Read the 5 Characters and Names (Stored Highest-to-Lowest) -->
    <loop count="5">
      <elt size="1" type="int"  id="CHARACTER"/>
      <elt size="3" type="text" id="NAME"/>
    </loop>

    <!-- 4. Read the 5 Ratings (Stored Highest-to-Lowest) -->
    <loop count="5">
      <elt size="1" type="raw"  id="R_PAD"/>
      <elt size="1" type="text" id="RATING"/>
    </loop>
  </structure>

  <output>
    <!-- Because loop_reverse_index aligned everything perfectly, we just output a single table! -->
    <table id="TOP 5">
      <column id="RANK"      src="index"     format="ordinal"/>
      <column id="SCORE"     src="SCORE"     format="*10;comma_score"/>
      <column id="NAME"      src="NAME"/>
      <column id="CHARACTER" src="CHARACTER" format="charname"/>
      <column id="RATING"    src="RATING"/>
    </table>
  </output>

  <!-- Translates the visual row index to 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <!-- Translates the character ID -->
  <format id="charname">
    <case src="1" dst="MIKE"/>
    <case src="2" dst="JACKIE"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>