<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <!--
    Ghoul Patrol (USA) - SNES

    SAFER INITIALISATION / RESTORE VERSION

    hiscore.dat:
      snes,ghoulptru:
      @delay=1
      @:maincpu,program,7e2004,bc,41,10
      @:maincpu,program,7e20c0,2,00,00

    Why this trigger is stronger:

      $7E2004 = $41 = "A" from the default first-place name ANDREW.

      The first range ends at $7E20BF = $10.  This byte is part of the
      default 10th-place numeric score 1000, stored as:

        $7E20BE-$7E20C1 = 00 10 00 00

      Therefore the plugin must see BOTH:
        beginning of the default table = ANDREW
        end of the default table       = default score 1000

      before it can restore the saved .hi data.

    The two hiscore.dat ranges are physically contiguous in WRAM and are
    concatenated by MAME into a 190-byte .hi:

      range 1 = $BC = 188 bytes ($7E2004-$7E20BF)
      range 2 = 2 bytes          ($7E20C0-$7E20C1)
      total   = 190 bytes

    WRAM layout:

      $7E2004-$7E2099
        10 x 15-byte formatted ranking records

      $7E209A-$7E20C1
        10 x 4-byte packed-BCD numeric scores

    Each 15-byte formatted record:
      bytes 0-7  = name / "/" padding
      bytes 8-13 = remaining padding + displayed score
      byte 14    = $00 terminator

    Custom character codes confirmed from the supplied state:
      $5D = ☺
      $5C = ☮
      $3E = 👍
      $3D = ✌
      $5B = ☠
      $3F = !
  -->

  <structure file=".hi">
    <check>
      <size>190</size>
    </check>

    <loop count="10">
      <elt size="8" type="text" id="NAME" charset="ghoulptru"/>
      <elt size="7" type="raw" id="DISPLAY_TAIL"/>
    </loop>

    <loop count="10">
      <elt size="1" type="int" id="B0"/>
      <elt size="1" type="int" id="B1"/>
      <elt size="1" type="int" id="B2"/>
      <elt size="1" type="int" id="B3"/>
    </loop>
  </structure>

  <output>
    <table id="TOP PLAYERS">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="score"/>
      <column id="NAME" src="NAME" format="clean_name"/>
    </table>
  </output>

  <format id="+1">
    <add>1</add>
  </format>

  <format id="b0_lo"><remainder>16</remainder></format>
  <format id="b0_hi"><divide_trunc>16</divide_trunc><multiply>10</multiply></format>

  <format id="b1_lo"><remainder>16</remainder><multiply>100</multiply></format>
  <format id="b1_hi"><divide_trunc>16</divide_trunc><multiply>1000</multiply></format>

  <format id="b2_lo"><remainder>16</remainder><multiply>10000</multiply></format>
  <format id="b2_hi"><divide_trunc>16</divide_trunc><multiply>100000</multiply></format>

  <format id="b3_lo"><remainder>16</remainder><multiply>1000000</multiply></format>
  <format id="b3_hi"><divide_trunc>16</divide_trunc><multiply>10000000</multiply></format>

  <format id="score">
    <sum>
      <column id="B0" format="b0_lo"/>
      <column id="B0" format="b0_hi"/>
      <column id="B1" format="b1_lo"/>
      <column id="B1" format="b1_hi"/>
      <column id="B2" format="b2_lo"/>
      <column id="B2" format="b2_hi"/>
      <column id="B3" format="b3_lo"/>
      <column id="B3" format="b3_hi"/>
    </sum>
  </format>

  <format id="clean_name" apply-to="char">
    <replace src="/" dst=""/>
  </format>

  <!--
    Ghoul Patrol name-entry character translations.

    Standard letters A-Z and digits 0-9 are already ASCII and therefore
    pass through normally.  These are the non-standard glyph codes that
    were positively identified from the supplied character-entry state
    and the custom 1680 name.
  -->
  <charset id="ghoulptru">

  <!-- A-Z -->
  <char src="0x41" dst="A"/>
  <char src="0x42" dst="B"/>
  <char src="0x43" dst="C"/>
  <char src="0x44" dst="D"/>
  <char src="0x45" dst="E"/>
  <char src="0x46" dst="F"/>
  <char src="0x47" dst="G"/>
  <char src="0x48" dst="H"/>
  <char src="0x49" dst="I"/>
  <char src="0x4A" dst="J"/>
  <char src="0x4B" dst="K"/>
  <char src="0x4C" dst="L"/>
  <char src="0x4D" dst="M"/>
  <char src="0x4E" dst="N"/>
  <char src="0x4F" dst="O"/>
  <char src="0x50" dst="P"/>
  <char src="0x51" dst="Q"/>
  <char src="0x52" dst="R"/>
  <char src="0x53" dst="S"/>
  <char src="0x54" dst="T"/>
  <char src="0x55" dst="U"/>
  <char src="0x56" dst="V"/>
  <char src="0x57" dst="W"/>
  <char src="0x58" dst="X"/>
  <char src="0x59" dst="Y"/>
  <char src="0x5A" dst="Z"/>

  <!-- padding -->
  <char src="0x2F" dst=""/>

  <!-- Ghoul Patrol symbols -->
  <char src="0x5D" dst="&#9787;"/> <!-- ☻ -->
  <char src="0x5C" dst="&#9774;"/> <!-- ☮ -->
  <char src="0x3E" dst="&#9756;"/> <!-- ☜ substitute for thumbs up -->
  <char src="0x3D" dst="&#9757;"/> <!-- ☝ substitute for victory sign -->
  <char src="0x5B" dst="&#9760;"/> <!-- ☠ -->
  <char src="0x3F" dst="!"/>

</charset>

</hi2txt>
