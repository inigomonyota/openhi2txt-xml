<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  wof - Warriors of Fate (Capcom, 1992)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,ff6368,0a,00,00
    @:maincpu,program,ff77d8,78,ff,10
    @:maincpu,program,ff63d4,04,00,00
  134 bytes = 10B counters + 40B pointers + 80B scores (10x8B) + 4B top score
  Name charset: letter = position * 2 (A=0x02..Z=0x34), space=0x00
  Score: 4B BCD. Character ID: 0=PORTOR, 4=KASSAK, 8=SUBUTAI, 12=KADAN, 16=ABAKA
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>134</size>
    </check>
    <!-- Range 1: character play counts (5 x 2 bytes BE) //-->
    <loop count="5">
      <elt size="2" type="int" id="PLAYS"/>
    </loop>
    <!-- Range 2: pointer block (40 bytes) //-->
    <elt size="40" type="raw" id="PTRS"/>
    <!-- Range 2: score records (10 x 8 bytes) //-->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="3" type="text" id="NAME" charset="wof"/>
      <elt size="1" type="int" id="CHARID"/>
    </loop>
    <!-- Range 3: top score (4 bytes) //-->
    <elt size="4" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="SCORE RANKING" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME"/>
      <column id="CHARACTER" src="CHARID" format="charname"/>
    </table>
    <table id="CHARACTER RANKING" sort="PLAYS" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="CHARACTER" src="index" format="charbyindex"/>
      <column id="PLAYS"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="charname">
    <case src="1" operator="&lt;" dst="PORTOR"/>
    <case src="5" operator="&lt;" dst="KASSAK"/>
    <case src="9" operator="&lt;" dst="SUBUTAI"/>
    <case src="13" operator="&lt;" dst="KADAN"/>
    <case src="17" operator="&lt;" dst="ABAKA"/>
  </format>

  <format id="charbyindex">
    <case src="1" operator="&lt;" dst="PORTOR"/>
    <case src="2" operator="&lt;" dst="KASSAK"/>
    <case src="3" operator="&lt;" dst="SUBUTAI"/>
    <case src="4" operator="&lt;" dst="KADAN"/>
    <case src="5" operator="&lt;" dst="ABAKA"/>
  </format>

  <charset id="wof">
    <char src="0x00" dst=" "/>
    <char src="0x02" dst="A"/>
    <char src="0x04" dst="B"/>
    <char src="0x06" dst="C"/>
    <char src="0x08" dst="D"/>
    <char src="0x0A" dst="E"/>
    <char src="0x0C" dst="F"/>
    <char src="0x0E" dst="G"/>
    <char src="0x10" dst="H"/>
    <char src="0x12" dst="I"/>
    <char src="0x14" dst="J"/>
    <char src="0x16" dst="K"/>
    <char src="0x18" dst="L"/>
    <char src="0x1A" dst="M"/>
    <char src="0x1C" dst="N"/>
    <char src="0x1E" dst="O"/>
    <char src="0x20" dst="P"/>
    <char src="0x22" dst="Q"/>
    <char src="0x24" dst="R"/>
    <char src="0x26" dst="S"/>
    <char src="0x28" dst="T"/>
    <char src="0x2A" dst="U"/>
    <char src="0x2C" dst="V"/>
    <char src="0x2E" dst="W"/>
    <char src="0x30" dst="X"/>
    <char src="0x32" dst="Y"/>
    <char src="0x34" dst="Z"/>
  </charset>

</hi2txt>