<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- battlera by Data East Corporation, 1988 -->
<!-- hiscore.dat: @:maincpu,program,1f0220,8a,41,00 | @:maincpu,program,1f000e,4,00,00 | @:maincpu,program,1f000f,1,10,10 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>143</size>
    </check>

    <!-- Block 1: Names (Offsets 0-39) -->
    <loop count="10">
      <elt size="4" type="text" id="NAME" charset="battlera"/>
    </loop>

    <!-- Pad 1: 25 bytes -->
    <elt size="25" type="raw" id="PAD_NAMES_TO_SCORES"/>

    <!-- Block 2: Scores (Offsets 65-104) -->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>

    <!-- Pad 2: Exactly 23 bytes to align with Stages at offset 128 -->
    <elt size="23" type="raw" id="PAD_SCORES_TO_STAGES"/>

    <!-- Block 3: Stages (Offsets 128-137) -->
    <loop count="10">
      <elt size="1" type="int" id="STAGE"/>
    </loop>

    <!-- Separator/Padding before Hi-Score -->
    <elt size="1" type="raw" id="SEP"/>

    <!-- Block 4: Global High Score (Offsets 139-142) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>
  </structure>

  <output>
    <field id="HI-SCORE" format="d100;comma_score" display="extra"/>

    <table id="BEST 10 PLAYERS">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"  format="trim_right"/>
      <column id="SCORE" src="SCORE" format="d100;comma_score"/>
      <column id="STAGE" src="STAGE" format="stage_mapping"/>
    </table>
  </output>

  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <format id="trim_right">
    <trim direction="right"> </trim>
  </format>

  <!-- Translates hex codes 07-00 to the display values -->
  <format id="stage_mapping">
    <case src="7" dst="STAGE 🎖"/>
    <case src="6" dst="STAGE 7"/>
    <case src="5" dst="STAGE 6"/>
    <case src="4" dst="STAGE 5"/>
    <case src="3" dst="STAGE 4"/>
    <case src="2" dst="STAGE 3"/>
    <case src="1" dst="STAGE 2"/>
    <case src="0" dst="STAGE 1"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="battlera">
    <char src="0xB2" dst="🎖"/>
  </charset>
</hi2txt>