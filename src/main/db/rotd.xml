<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Rage of the Dragons">
  <!--
    Neo Geo saveram, 65536B, 16-bit byte-swap=2 ("BACKUP RAM OK !" @0x10).

    RANKING table: 10 records x 12B, HEADER=809, record stride starts at 0x329.
    After the tool applies byte-swap=2, each 12B record decodes as:
      [SCORE:3 BCD][pad:1][CHAR1:1][pad:1][CHAR2:1][NAME:3 ASCII][pad:2]
    SCORE is a 3-byte big-endian BCD value read directly (NO multiply/offset):
      50 00 00 -> 500000, 10 00 00 -> 100000, 05 17 00 -> 51700, 05 00 00 -> 50000.
    (An earlier revision wrongly used a single "coarse" byte with (x)*10000+50000,
    which gave 100000 for a real 51700 entry; the true field is 3 BCD bytes and the
    fine thousands/hundreds live in bytes 2-3 of the record.)

    AVATAR PAIR: SOLVED. CHAR1/CHAR2 are 1-byte fighter indices at record offsets
    4 and 6 (the two index bytes just before the 3-char name). Index -> fighter map
    (see <format id="fighter">):
      0 BILLY 1 LYNN 2 RADEL 3 ANNIE 4 CASSANDRA 5 ONI 6 PEPE 7 PUPA
      8 ALICE 9 ELIAS 10 JONES 11 ABUBO 12 SONIA 13 JIMMY
    VERIFIED against the default board (all 10 rows + scores match the attract
    screenshots) AND four real-play saves whose 10th-place entry the player reported:
      BILLY+LYNN 51500 (ZZS/ZZZ), RADEL+ANNIE 51000 (!?A), CASSANDRA+ONI 51700 (&/?)
    all decode exactly (name, both fighters, and score).

    NOTE: rotd has NO hiscore.dat entry, so this build of hi2txt cannot auto-match
    a structure for it (it errors "unable to find a structure ... matches ...
    hiscore.dat definition"). This definition therefore documents the fully
    verified layout; the shipped default table in output\rotd\ was produced from
    that verified decode. Add a rotd hiscore.dat block to make it tool-runnable.
  //-->
  <structure file="saveram" byte-swap="2">
    <check>
      <size>65536</size>
    </check>
    <elt size="809" type="raw"  id="HEADER"/>
    <loop count="10">
      <elt size="3" type="int"  id="SCORE" base="16" endianness="big_endian"/>
      <elt size="1" type="raw"  id="PAD1"/>
      <elt size="1" type="int"  id="CHAR1"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="1" type="int"  id="CHAR2"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="2" type="raw"  id="PAD3"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"      src="index" format="rank"/>
      <column id="SCORE"     src="SCORE" format="score"/>
      <column id="NAME"      src="NAME"/>
      <column id="FIGHTER 1" src="CHAR1" format="fighter"/>
      <column id="FIGHTER 2" src="CHAR2" format="fighter"/>
    </table>
  </output>

  <format id="score"><pad direction="left" max="7">0</pad></format>
  <format id="rank">
    <add>1</add>
    <case src="1" dst="1ST"/><case src="2" dst="2ND"/><case src="3" dst="3RD"/>
    <case src="4" dst="4TH"/><case src="5" dst="5TH"/><case src="6" dst="6TH"/>
    <case src="7" dst="7TH"/><case src="8" dst="8TH"/><case src="9" dst="9TH"/>
    <case src="10" dst="10TH"/>
  </format>
  <format id="fighter">
    <case src="0"  dst="BILLY"/><case src="1"  dst="LYNN"/>
    <case src="2"  dst="RADEL"/><case src="3"  dst="ANNIE"/>
    <case src="4"  dst="CASSANDRA"/><case src="5"  dst="ONI"/>
    <case src="6"  dst="PEPE"/><case src="7"  dst="PUPA"/>
    <case src="8"  dst="ALICE"/><case src="9"  dst="ELIAS"/>
    <case src="10" dst="JONES"/><case src="11" dst="ABUBO"/>
    <case src="12" dst="SONIA"/><case src="13" dst="JIMMY"/>
  </format>
</hi2txt>
