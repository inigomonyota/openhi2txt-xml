<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>

  <!-- A.B. Cop (abcop, Sega X-Board).  hiscore .hi = 84 bytes.
       Live "BEST PILOTS" table in work RAM (maincpu 0x08010C).
       7 records of 12 bytes:
         [ score : 4 bytes BCD ] [ name : 3 ASCII + 1 space ]
         [ 00 00 ] [ stage : 1 ] [ sub-stage : 1 ]
       Score is BCD -> type int, base 16.  AREA = "stage-substage". -->

  <structure file=".hi">
    <check>
      <definition>0:8010c:54:10:01</definition>
      <size>84</size>
    </check>

    <loop count="7">
      <elt size="4" type="int"  id="SCORE"    base="16"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="PAD_SPACE"/>
      <elt size="2" type="raw"  id="PAD_AREA"/>
      <elt size="1" type="int"  id="STAGE"/>
      <elt size="1" type="int"  id="SUBSTAGE"/>
    </loop>
  </structure>

  <output>
    <table id="BEST PILOTS">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE"/>
      <column id="AREA"  format="area"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- combine stage and sub-stage into "stage-substage" -->
  <format id="area">
    <concat>
      <column id="STAGE"/>
      <txt>-</txt>
      <column id="SUBSTAGE"/>
    </concat>
  </format>

</hi2txt>
