<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Mad Shark">
  <!--
    tested with mame 0.285 and hiscore.dat
    source: openhi2txt
  //-->

  <structure file=".hi">
    <check>
      <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure version the provided file is for -->
      <definition>0:201d20:4:00:00
                  0:205dd2:c4:00:00
                  0:201d21:1:0a:0a</definition>
      <!-- optional: if defined, it allows to select the good structure version the provided file is for
                     useful if multiple structures are defined, but hiscore.dat is not provided -->
      <size>201</size>
    </check>
    <elt id="TOP SCORE" type="int" size="4" endianness="big_endian" base="10"/>
    <loop count="9" skip-last-bytes="2">
      <elt id="SCORE" type="int" size="4" endianness="big_endian" base="10"/>
      <elt id="EMPTY" type="raw" size="1"/>
      <elt id="NAME1" type="text" size="1" charset="madshark" ascii-offset="-128"/>
      <elt id="EMPTY" type="raw" size="1"/>
      <elt id="NAME2" type="text" size="1" charset="madshark" ascii-offset="-128"/>
      <elt id="EMPTY" type="raw" size="1"/>
      <elt id="NAME3" type="text" size="1" charset="madshark" ascii-offset="-128"/>
      <elt id="EMPTY" type="raw" size="12"/>
    </loop>
    <elt id="EMPTY" type="raw" size="1"/>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME" format="name_combine;Trim"/>
    </table>
    <field id="TOP SCORE" display="extra"/>
  </output>

  <format id="name_combine">
    <concat>
      <column id="NAME1"/>
      <column id="NAME2"/>
      <column id="NAME3"/>
    </concat>
  </format>

  <charset id="madshark">
    <char src="0x20" dst=" "/>
  </charset>
</hi2txt>
