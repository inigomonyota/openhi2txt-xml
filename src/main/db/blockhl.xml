<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- blockhl by Konami, 1989 -->
<!-- hiscore.dat: @:maincpu,program,4163,44,00,05 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>68</size>
    </check>

    <!-- BLOCK 1: SCORE TOP 3 (24 bytes) -->
    <!-- Record: 4(Score) + 1(Pad) + 3(Name) = 8 bytes -->
    <loop count="3">
      <elt size="4" type="int"  id="S_SCORE" base="16"/>
      <elt size="1" type="raw"  id="S_SEP"/>
      <elt size="3" type="text" id="S_NAME"  charset="konami_block" ascii-offset="64"/>
    </loop>

    <!-- BLOCK 2: BLOCK TOP 3 (24 bytes) -->
    <loop count="3">
      <elt size="4" type="int"  id="B_SCORE" base="16"/>
      <elt size="1" type="raw"  id="B_SEP"/>
      <elt size="3" type="text" id="B_NAME"  charset="konami_block" ascii-offset="64"/>
    </loop>

    <!-- Trailing metadata and global high scores (20 bytes) -->
    <elt size="20" type="raw" id="TRAILER"/>
  </structure>

  <output>
    <table id="SCORE TOP 3">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="NAME"  src="S_NAME"/>
      <column id="SCORE" src="S_SCORE" format="comma_score"/>
    </table>

    <table id="BLOCK TOP 3">
      <column id="RANK"  src="index"   format="ordinal"/>
      <column id="NAME"  src="B_NAME"/>
      <column id="SCORE" src="B_SCORE" format="comma_score"/>
    </table>
  </output>

  <!-- Translates 0-2 into 1ST-3RD -->
  <format id="ordinal">
    <case src="0" dst="1ST"/><case src="1" dst="2ND"/><case src="2" dst="3RD"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000000"/><txt>,</txt><column format="%1000000000;d1000000;PadL30"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat><column format="d1000000"/><txt>,</txt><column format="%1000000;d1000;PadL30"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat><column format="d1000"/><txt>,</txt><column format="%1000;PadL30"/></concat>
  </format>

  <!-- Konami Block Hole Charset -->
  <charset id="konami_block">
    <char src="0x1B" dst="F"/> <!-- Mapped to F for the Rank 3 Block High Score -->
    <char src="0x00" dst=""/>
  </charset>
</hi2txt>