<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Lode Runner - The Dig Fight">
  <!--
    Lode Runner - The Dig Fight (loderndf) - Psikyo, 2000 (psikyo4.cpp, Hitachi
    SH-2). The RANKING is NOT saved to the 256-byte 93C56 eeprom (it stays all
    zeros); it lives in volatile SH-2 work RAM and is lost on reboot. MAME's
    hiscore plugin restores it via a new hiscore.dat entry:
      loderndf: @:maincpu,program,6038bcc,50,00,00
      -> 0x50 = 80 bytes at 0x6038bcc = 5 ranking records x 16 bytes.
    (psikyo SH-2 work RAM is the 0x060xxxxx window, as for s1945ii/dragnblz.)

    Each 16-byte record (SH-2 is big-endian; each initial is a 16-bit word whose
    high byte is 0x00, so read the low byte as the character code):
      [0..1]  initial 1  (BE16: A=0x00 .. Z=0x19, 0x1a = "." separator)
      [2..3]  initial 2
      [4..5]  initial 3
      [6..7]  pad (0000)
      [8..10] TIME : 24-bit big-endian frame count @60Hz (300 = 5.00s)
      [11]    pad (00)
      [12..13] STAGE : 16-bit big-endian (06,04,03,02,01)
      [14..15] pad (0000)

    Verified byte-for-byte against the RANKING screenshot:
      1 F.K ST06 00'05"00   2 DEO ST04 00'03"00   3 YMY ST03 00'02"00
      4 N.S ST02 00'01"00   5 T.K ST01 00'00"00
    The stylized font makes letters ambiguous on screen; the RAM bytes are
    authoritative. Time shown MM'SS"CC where centiseconds = trunc(frames*5/3).

    Authored by Pipmick @ CoinOPS.
  //-->

  <structure file=".hi">
    <check>
      <size>80</size>
    </check>

    <loop count="5">
      <elt size="1" type="raw"  id="Z1"/>
      <elt size="1" type="text" id="C1"    charset="csLR"/>
      <elt size="1" type="raw"  id="Z2"/>
      <elt size="1" type="text" id="C2"    charset="csLR"/>
      <elt size="1" type="raw"  id="Z3"/>
      <elt size="1" type="text" id="C3"    charset="csLR"/>
      <elt size="2" type="raw"  id="PAD1"/>
      <elt size="3" type="int"  id="TIME"  endianness="big_endian"/>
      <elt size="1" type="raw"  id="PAD2"/>
      <elt size="2" type="int"  id="STAGE" endianness="big_endian"/>
      <elt size="2" type="raw"  id="PAD3"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="NAME"  src="C1"    format="namecat"/>
      <column id="STAGE" src="STAGE" format="stagefmt"/>
      <column id="TIME"  src="TIME"  format="besttime"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

  <format id="namecat" input-as-subcolumns-input="yes">
    <concat><column src="C1"/><column src="C2"/><column src="C3"/></concat>
  </format>

  <!-- "ST" + 2-digit stage -->
  <format id="stagefmt" input-as-subcolumns-input="yes">
    <concat><txt>ST</txt><column format="d10"/><column format="%10"/></concat>
  </format>

  <!-- frames -> centiseconds (trunc frames*5/3), shown MM'SS"CC, each 2 digits -->
  <format id="besttime" input-as-subcolumns-input="yes">
    <concat>
      <column format="*5;d3;d60000"/>
      <column format="*5;d3;d6000;%10"/>
      <txt>'</txt>
      <column format="*5;d3;%6000;d100;d10"/>
      <column format="*5;d3;%6000;d100;%10"/>
      <txt>"</txt>
      <column format="*5;d3;%100;d10"/>
      <column format="*5;d3;%100;%10"/>
    </concat>
  </format>

  <charset id="csLR">
    <char src="0x00" dst="A"/>
    <char src="0x01" dst="B"/>
    <char src="0x02" dst="C"/>
    <char src="0x03" dst="D"/>
    <char src="0x04" dst="E"/>
    <char src="0x05" dst="F"/>
    <char src="0x06" dst="G"/>
    <char src="0x07" dst="H"/>
    <char src="0x08" dst="I"/>
    <char src="0x09" dst="J"/>
    <char src="0x0a" dst="K"/>
    <char src="0x0b" dst="L"/>
    <char src="0x0c" dst="M"/>
    <char src="0x0d" dst="N"/>
    <char src="0x0e" dst="O"/>
    <char src="0x0f" dst="P"/>
    <char src="0x10" dst="Q"/>
    <char src="0x11" dst="R"/>
    <char src="0x12" dst="S"/>
    <char src="0x13" dst="T"/>
    <char src="0x14" dst="U"/>
    <char src="0x15" dst="V"/>
    <char src="0x16" dst="W"/>
    <char src="0x17" dst="X"/>
    <char src="0x18" dst="Y"/>
    <char src="0x19" dst="Z"/>
    <char src="0x1a" dst="."/>
  </charset>
</hi2txt>
