<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- gundhara by Banpresto, 1995 -->
<!-- hiscore.dat: @:maincpu,program,20f908,33,00,6e -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>51</size>
    </check>

    <!-- Block 1: Scores (5 records, 4 bytes each) -->
    <!-- Stored as Big Endian Integers. 00 01 BB 02 = 113,410 -->
    <loop count="5">
      <elt size="4" type="int" id="SCORE"/>
    </loop>

    <!-- Block 2: Middle Padding/Attributes (12 bytes) -->
    <elt size="12" type="raw" id="PAD"/>

    <!-- Block 3: Names (5 records, 4 bytes each) -->
    <!-- 10th record is truncated by the 51-byte file limit. -->
    <loop count="5" skip-last-bytes="1">
      <elt size="4" type="text" id="NAME" charset="gundhara"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="SCORE" src="SCORE" format="comma_score"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <!-- Translates 0-4 into 1ST-5TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <!-- Custom charset for Banpresto/Banpresto hardware -->
  <charset id="gundhara">
    <char src="0x7A" dst="Z"/>
    <char src="0x7B" dst="="/> <!-- Middle Dot symbol used in your Z=Z example -->
    <char src="0x00" dst=""/>
  </charset>
</hi2txt>