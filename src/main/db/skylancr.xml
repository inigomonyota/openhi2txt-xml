<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Sky Lancer">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,82e3,2,00,01
                  @:maincpu,program,82e5,22,00,00</definition>
      <size>36</size>
    </check>
    <loop count="5">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="2" type="raw" id="EMPTY"/>
    </loop>
    <elt size="6" type="raw" id="EMPTY2"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE"/>
    </table>
  </output>
</hi2txt>
