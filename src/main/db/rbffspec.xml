    <check><size>65536</size></check>
    <elt size="874" type="raw" id="_PREFIX"/>

    <!-- Slot 0: TERRY BOGARD -->
    <loop count="3">
      <elt size="1" type="raw"  id="_C00_PAD"/>
      <elt size="3" type="int"  id="C00_SCORE" base="16"/>
      <elt size="3" type="text" id="C00_NAME"/>
      <elt size="1" type="int"  id="C00_FRANK"/>
    </loop>
    <elt size="8" type="raw" id="_C00_TAIL"/>

