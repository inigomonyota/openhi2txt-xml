<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Thundercade">
  <!--
    tested with mame 0.??? and related hiscore.dat
    structure: 10 entries x 15 bytes = 150 bytes total
    diagonal layout: entry i (0-indexed) within its 15-byte block has
      [0..i]     leading zeros  (i+1 bytes)
      [i+1..i+2] score, 2-byte BCD (base16 *10)
      [i+3..i+5] name, 3 ASCII chars
      [i+6..14]  trailing zeros (9-i bytes, omitted for last entry)
    table-index used to collect non-contiguous same-id elts into a virtual array
  //-->

  <structure file=".hi">
    <check>
      <size>150</size>
    </check>

    <elt size="1"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="0"/>
    <elt size="3"  type="text" id="NAME"             table-index="0"/>
    <elt size="9"  type="raw"  id="_PAD"/>

    <elt size="2"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="1"/>
    <elt size="3"  type="text" id="NAME"             table-index="1"/>
    <elt size="8"  type="raw"  id="_PAD"/>

    <elt size="3"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="2"/>
    <elt size="3"  type="text" id="NAME"             table-index="2"/>
    <elt size="7"  type="raw"  id="_PAD"/>

    <elt size="4"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="3"/>
    <elt size="3"  type="text" id="NAME"             table-index="3"/>
    <elt size="6"  type="raw"  id="_PAD"/>

    <elt size="5"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="4"/>
    <elt size="3"  type="text" id="NAME"             table-index="4"/>
    <elt size="5"  type="raw"  id="_PAD"/>

    <elt size="6"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="5"/>
    <elt size="3"  type="text" id="NAME"             table-index="5"/>
    <elt size="4"  type="raw"  id="_PAD"/>

    <elt size="7"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="6"/>
    <elt size="3"  type="text" id="NAME"             table-index="6"/>
    <elt size="3"  type="raw"  id="_PAD"/>

    <elt size="8"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="7"/>
    <elt size="3"  type="text" id="NAME"             table-index="7"/>
    <elt size="2"  type="raw"  id="_PAD"/>

    <elt size="9"  type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="8"/>
    <elt size="3"  type="text" id="NAME"             table-index="8"/>
    <elt size="1"  type="raw"  id="_PAD"/>

    <elt size="10" type="raw"  id="_PAD"/>
    <elt size="2"  type="int"  id="SCORE" base="16" table-index="9"/>
    <elt size="3"  type="text" id="NAME"             table-index="9"/>
  </structure>

  <output>
    <table id="RANKING">
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" src="SCORE" format="*10"/>
      <column id="NAME"  src="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>
  <format id="*10"><multiply>10</multiply></format>

</hi2txt>