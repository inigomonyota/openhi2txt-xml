<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    tested with mame 0.148 and related hiscore.dat
      source: HiToText
  //-->
  
  <structure file="nvram">
    <check>
      <!-- optional: if defined, it allows to select the good structure version the provided file
                     useful if multiple structures are defined, but hiscore.dat not provided //-->
      <size>2048</size>
    </check>
    <elt size="7" type="raw" id="UNUSED"/>
    <elt size="6" type="int" id="TOP SCORE" base="16" nibble-skip="odd"/>
    <elt size="7" type="raw" id="UNUSED2"/>
    <loop count="10">
      <elt size="3" type="text" id="NAME"/>
      <elt size="3" type="int"  id="SCORE" base="16"/>
    </loop>
    <elt size="3"    type="int" id="TOP SCORE DUPLICATE" base="16"/>
    <elt size="1965" type="raw" id="UNUSED3"/>
  </structure>
  
  <output>
    <table line-ignore="SCORE:0">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="comma_score"/>
      <column id="NAME"/>
    </table>
    <field id="TOP SCORE"           display="debug"/>
    <field id="TOP SCORE DUPLICATE" display="debug"/>
  </output>
    
  <format id="+1"><add>1</add></format>
  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       Just apply format="comma_score" to any column!
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>
  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>
