<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check>
      <size>64</size>
    </check>
    <loop count="5">
      <elt size="1" type="raw" id="FLAG"/>
      <elt size="3" type="int" base="16" id="SCORE"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw" id="PAD"/>
      <elt size="4" type="int" endianness="little_endian" id="WINS"/>
    </loop>
    <elt size="4" type="raw" id="TAIL"/>
  </structure>
  <output>
    <table id="BEST 5 FIGHTERS">
      <column src="index" format="+1" id="RANK"/>
      <column src="NAME" id="NAME"/>
      <column src="SCORE" id="SCORE"/>
      <column src="WINS" id="WINS"/>
    </table>
  </output>
</hi2txt>
