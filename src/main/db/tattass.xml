<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  hi2txt description for Tattoo Assassins (tattass)  [Data East prototype]

  Reads the MAME nvram "eeprom" file (1024 bytes) directly.

  "MARKS OF DISTINCTION" table, 11 entries from offset 0x0C.
  Per entry (4 bytes):
      [0-2]  NAME   3 ascii chars
      [3]    SCORE  1 byte, plain binary integer

  RANK: the top entry (index 0, highest score) is shown as "TOP" (the champion
  tattooed on the assassin's back); the remaining entries are numbered 1..10.
-->
<hi2txt>

  <structure file="eeprom">
    <check>
      <size>1024</size>
    </check>

    <!-- 12 bytes header before the table -->
    <elt size="12" type="raw" id="PAD00"/>

    <loop count="11">
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="int"  id="SCORE"/>
    </loop>
  </structure>

  <output>
    <table id="MARKS OF DISTINCTION">
      <column id="RANK"  src="index" format="rank"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE" format="pad2"/>
    </table>
  </output>

  <format id="rank">
    <case src="0" dst="TOP"/>
    <case src="1" dst="1:"/><case src="2" dst="2:"/><case src="3" dst="3:"/>
    <case src="4" dst="4:"/><case src="5" dst="5:"/><case src="6" dst="6:"/>
    <case src="7" dst="7:"/><case src="8" dst="8:"/><case src="9" dst="9:"/>
    <case src="10" dst="10:"/>
  </format>

  <format id="pad2">
    <pad direction="left" max="2">0</pad>
  </format>

</hi2txt>
