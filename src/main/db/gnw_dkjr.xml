<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Game &amp; Watch: Donkey Kong Jr.">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,data,11,6,0,0
                  @:maincpu,data,51,6,0,0</definition>
      <size>12</size>
    </check>
    <loop count="2">
      <elt size="6" type="int" id="SCORE" endianness="little_endian" nibble-skip="odd" base="16"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="MODE" src="index" format="mode"/>
      <column id="SCORE" format="/100"/>
    </table>
  </output>

  <format id="mode">
    <case src="0" dst="GAME A"/>
    <case src="1" dst="GAME B"/>
  </format>
</hi2txt>
