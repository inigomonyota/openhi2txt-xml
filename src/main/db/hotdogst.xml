<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">

<!-- hotdogst by Marble Inc, 1996 -->
<!-- hiscore.dat: @:maincpu,program,301100,54,00,14 -->

<hi2txt>
  <structure file=".hi">
    <check>
      <size>84</size>
    </check>

    <!-- 1. The 'Top Score' field at the start of the file (4 bytes) -->
    <elt size="4" type="int" id="HI-SCORE" base="16"/>

    <!-- 2. The 10 Table Scores (40 bytes) -->
    <loop count="10">
      <elt size="4" type="int" id="SCORE" base="16"/>
    </loop>

    <!-- 3. The 10 Rounds/Names (40 bytes) -->
    <!-- Structure: 1 byte Round + 3 bytes Name -->
    <loop count="10">
      <elt size="1" type="int"  id="ROUND_RAW"/>
      <!-- Offset 65 maps 0x00 to 'A', 0x01 to 'B', etc. -->
      <elt size="3" type="text" id="NAME" charset="hotdogst_chars" ascii-offset="65"/>
    </loop>
  </structure>

  <output>
    <!--field id="HI-SCORE" format="comma_score" display="extra"/-->

    <table>
      <column id="RANK"  src="index"     format="ordinal"/>
      <column id="SCORE" src="SCORE"     format="comma_score"/>
      <column id="NAME"  src="NAME"/>
      <column id="ROUND" src="ROUND_RAW" format="+1"/>
    </table>
  </output>

  <!-- Translates indices into ordinal ranks -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/><txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/><txt>,</txt>
      <column format="%1000000;d1000;PadL30"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/><txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <charset id="hotdogst_chars">
    <char src="0x1A" dst="."/>
    <char src="0x1B" dst=" "/>
  </charset>
</hi2txt>