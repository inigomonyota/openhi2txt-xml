<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Street Fighter III 2nd Impact: Giant Attack">

  <!--
    MAME hiscore.dat block:
      @:maincpu,program,2015924,90,1c,02

    0x90 = 144 bytes = 12 records x 12 bytes
      records 1-6  : RANKING SCORE
      records 7-12 : RANKING WINS

    Record layout:
      +0..2   NAME       custom 3-byte charset
      +3      padding
      +4..5   CHARACTER  16-bit big-endian
      +6..7   padding
      +8..11  VALUE      32-bit big-endian
  -->

  <structure file=".hi">
    <check>
      <size>144</size>
    </check>

    <loop count="6">
      <elt size="3" type="text" id="S_NAME" charset="sfiii_name"/>
      <elt size="1" type="raw" id="_S_PAD1"/>
      <elt size="2" type="int" id="S_CHARACTER" endianness="big_endian"/>
      <elt size="2" type="raw" id="_S_PAD2"/>
      <elt size="4" type="int" id="S_SCORE" endianness="big_endian"/>
    </loop>

    <loop count="6">
      <elt size="3" type="text" id="W_NAME" charset="sfiii_name"/>
      <elt size="1" type="raw" id="_W_PAD1"/>
      <elt size="2" type="int" id="W_CHARACTER" endianness="big_endian"/>
      <elt size="2" type="raw" id="_W_PAD2"/>
      <elt size="4" type="int" id="W_WINS" endianness="big_endian"/>
    </loop>
  </structure>

  <output>
    <table id="RANKING SCORE" lines-max="6">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="S_NAME"/>
      <column id="CHARACTER" src="S_CHARACTER" format="character"/>
      <column id="SCORE" src="S_SCORE"/>
    </table>

    <table id="RANKING WINS" lines-max="6">
      <column id="RANK" src="index" format="ordinal"/>
      <column id="NAME" src="W_NAME"/>
      <column id="CHARACTER" src="W_CHARACTER" format="character"/>
      <column id="WINS" src="W_WINS"/>
    </table>
  </output>

  <!-- CPS-3 character IDs used by SFIII 2nd Impact -->
  <format id="character">
    <case src="0" dst="GILL"/>
    <case src="1" dst="ALEX"/>
    <case src="2" dst="RYU"/>
    <case src="3" dst="YUN"/>
    <case src="4" dst="DUDLEY"/>
    <case src="5" dst="NECRO"/>
    <case src="6" dst="HUGO"/>
    <case src="7" dst="IBUKI"/>
    <case src="8" dst="ELENA"/>
    <case src="9" dst="ORO"/>
    <case src="10" dst="YANG"/>
    <case src="11" dst="KEN"/>
    <case src="12" dst="SEAN"/>
    <case src="13" dst="URIEN"/>
    <case src="14" dst="AKUMA"/>
    <case src="15" dst="SHIN AKUMA"/>
  </format>

  <format id="ordinal">
    <case src="0" dst="1st"/>
    <case src="1" dst="2nd"/>
    <case src="2" dst="3rd"/>
    <case src="3" dst="4th"/>
    <case src="4" dst="5th"/>
    <case src="5" dst="6th"/>
  </format>

  <!-- Initial-entry charset: 0-9 then A-Z -->
  <charset id="sfiii_name">
    <char src="0x00" dst="0"/>
    <char src="0x01" dst="1"/>
    <char src="0x02" dst="2"/>
    <char src="0x03" dst="3"/>
    <char src="0x04" dst="4"/>
    <char src="0x05" dst="5"/>
    <char src="0x06" dst="6"/>
    <char src="0x07" dst="7"/>
    <char src="0x08" dst="8"/>
    <char src="0x09" dst="9"/>
    <char src="0x0A" dst="A"/>
    <char src="0x0B" dst="B"/>
    <char src="0x0C" dst="C"/>
    <char src="0x0D" dst="D"/>
    <char src="0x0E" dst="E"/>
    <char src="0x0F" dst="F"/>
    <char src="0x10" dst="G"/>
    <char src="0x11" dst="H"/>
    <char src="0x12" dst="I"/>
    <char src="0x13" dst="J"/>
    <char src="0x14" dst="K"/>
    <char src="0x15" dst="L"/>
    <char src="0x16" dst="M"/>
    <char src="0x17" dst="N"/>
    <char src="0x18" dst="O"/>
    <char src="0x19" dst="P"/>
    <char src="0x1A" dst="Q"/>
    <char src="0x1B" dst="R"/>
    <char src="0x1C" dst="S"/>
    <char src="0x1D" dst="T"/>
    <char src="0x1E" dst="U"/>
    <char src="0x1F" dst="V"/>
    <char src="0x20" dst="W"/>
    <char src="0x21" dst="X"/>
    <char src="0x22" dst="Y"/>
    <char src="0x23" dst="Z"/>
  </charset>

</hi2txt>
