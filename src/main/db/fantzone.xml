<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<!--
  fantzone - Fantasy Zone (Sega, 1986)
  .hi file format (via hiscore.dat plugin)
  hiscore.dat:
    @:maincpu,program,fffc00,38,00,52
    @:maincpu,program,ffc22c,4,00,00
  60 bytes = 7 entries x 8B + 4B top score
  Record (8B): 4B score (BCD) + 1B round + 3B name (ASCII)
//-->
<hi2txt>

  <structure file=".hi">
    <check>
      <size>60</size>
    </check>
    <loop count="7">
      <elt size="4" type="int" id="SCORE" base="16"/>
      <elt size="1" type="int" id="ROUND"/>
      <elt size="3" type="text" id="NAME"/>
    </loop>
    <elt size="4" type="raw" id="TOPSCORE"/>
  </structure>

  <output>
    <table id="FANTASY ZONE HIGH SCORES" sort="SCORE" sort-order="desc">
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="ROUND"/>
      <column id="NAME"/>
    </table>
  </output>

  <format id="+1"><add>1</add></format>

</hi2txt>