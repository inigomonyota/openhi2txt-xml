<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Coco Loco">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,53,02,00,00
                  @:maincpu,program,2170,25,3e,3e</definition>
      <size>39</size>
    </check>
    <loop count="1">
      <elt size="2" type="int" id="SCORE" endianness="little_endian" base="16"/>
    </loop>
    <elt size="37" type="raw" id="EMPTY"/>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE" format="*10"/>
    </table>
  </output>
</hi2txt>
