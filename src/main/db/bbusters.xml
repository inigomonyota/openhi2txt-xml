<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <check>
      <!-- Matches hiscore.dat range 0x9B (155 bytes) -->
      <size>155</size>
    </check>

    <!-- Record: 3(Score) + 1(Pad) + 6(Name) + 2(Section) + 4(Pad) = 16 bytes -->
    <!-- skip-last-bytes="5" allows reading 10 entries from a 155-byte file -->
    <loop count="10" skip-last-bytes="5">
      <elt size="3" type="int"  id="SCORE" base="16"/>
      <elt size="1" type="raw"  id="S_PAD"/>
      <!-- byte-skip="even" keeps indices 1, 3, 5 (the letters) and skips 2, 4, 6 (the nulls) -->
      <elt size="6" type="text" id="NAME" byte-skip="even" ascii-offset="65"/>
      <elt size="2" type="int"  id="SECTION" endianness="little_endian" base="16"/>
      <elt size="4" type="raw"  id="RECORD_PAD"/>
    </loop>
  </structure>

  <output>
    <table id="BEST PLAYERS">
      <column id="RANK"    src="index" format="ordinal"/>
      <column id="SCORE"   src="SCORE" format="*10;comma_score"/>
      <column id="NAME"    src="NAME"/>
      <column id="SECTION" src="SECTION"/>
    </table>
  </output>

  <!-- Translates 0-9 into 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- ==========================================
       UNIVERSAL COMMA FORMATTER
       ========================================== -->
  <format id="comma_score">
    <case src="1000000000" operator="&gt;=" format="three_commas"/>
    <case src="1000000"    operator="&gt;=" format="two_commas"/>
    <case src="1000"       operator="&gt;=" format="one_comma"/>
    <case src="1000"       operator="&lt;"  format="*1" default="yes"/>
  </format>

  <format id="three_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000000"/>
      <txt>,</txt>
      <column format="%1000000000;d1000000;PadL30"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="two_commas" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000000"/>
      <txt>,</txt>
      <column format="%1000000;d1000;PadL30"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>

  <format id="one_comma" input-as-subcolumns-input="yes">
    <concat>
      <column format="d1000"/>
      <txt>,</txt>
      <column format="%1000;PadL30"/>
    </concat>
  </format>
</hi2txt>