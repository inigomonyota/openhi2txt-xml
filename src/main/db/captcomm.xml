<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <structure file=".hi">
    <!-- File is exactly 405 bytes -->
    <check><size>405</size></check>
    
    <!-- 50 Records * 8 Bytes = 400 Bytes -->
    <loop count="50">
      <!-- 3-character string utilizing the Capcom mathematical font -->
      <elt size="3" type="text" id="NAME" charset="captcomm_char"/>
      
      <!-- 1-byte Character Icon ID -->
      <elt size="1" type="int"  id="CHAR_ID"/>
      
      <!-- 4-byte Big-Endian BCD Score -->
      <elt size="4" type="int"  id="SCORE" base="16" endianness="big_endian"/>
    </loop>
    
    <!-- The remaining 5 bytes of the Top Score tracker -->
    <elt size="5" type="raw" id="TRAIL"/>
  </structure>

  <output>
    <!-- lines-max="10" perfectly hides the 40 invisible records -->
    <table id="RANKING" lines-max="10">
      <column id="RANK"  src="index" format="ordinal"/>
      <column id="NAME"  src="NAME"/>
      <column id="SCORE" src="SCORE"/>
      <column id="CHARACTER" src="CHAR_ID" format="char_map"/>
    </table>
  </output>

  <!-- Translates the visual row index to 1ST-10TH -->
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
    <case src="5" dst="6TH"/>
    <case src="6" dst="7TH"/>
    <case src="7" dst="8TH"/>
    <case src="8" dst="9TH"/>
    <case src="9" dst="10TH"/>
  </format>

  <!-- Translates the hex byte into the character's name -->
  <format id="char_map">
    <case src="0"  dst="MACK"/>
    <case src="4"  dst="CAPTAIN"/>
    <case src="8"  dst="GINZU"/>
    <case src="12" dst="BABY"/>
  </format>

  <!-- Decodes Capcom's custom A-Z step font -->
  <charset id="captcomm_char">
    <char src="0x00" dst="A"/>
    <char src="0x02" dst="B"/>
    <char src="0x04" dst="C"/>
    <char src="0x06" dst="D"/>
    <char src="0x08" dst="E"/>
    <char src="0x0A" dst="F"/>
    <char src="0x0C" dst="G"/>
    <char src="0x0E" dst="H"/>
    <char src="0x10" dst="I"/>
    <char src="0x12" dst="J"/>
    <char src="0x14" dst="K"/>
    <char src="0x16" dst="L"/>
    <char src="0x18" dst="M"/>
    <char src="0x1A" dst="N"/>
    <char src="0x1C" dst="O"/>
    <char src="0x1E" dst="P"/>
    <char src="0x20" dst="Q"/>
    <char src="0x22" dst="R"/>
    <char src="0x24" dst="S"/>
    <char src="0x26" dst="T"/>
    <char src="0x28" dst="U"/>
    <char src="0x2A" dst="V"/>
    <char src="0x2C" dst="W"/>
    <char src="0x2E" dst="X"/>
    <char src="0x30" dst="Y"/>
    <char src="0x32" dst="Z"/>
    <char src="0xFF" dst="?" default="yes"/>
  </charset>
</hi2txt>