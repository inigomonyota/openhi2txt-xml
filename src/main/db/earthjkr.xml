<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="U.N. Defense Force: Earth Joker">
  <!--
    tested with mame 0.285 and hiscore.dat
    source: openhi2txt
  //-->

  <structure file=".hi">
    <check>
      <!-- optional: if defined and hiscore.dat provided, it allows to select the good structure version the provided file is for -->
      <definition>0:103204:2f:00:42</definition>
      <!-- optional: if defined, it allows to select the good structure version the provided file is for
                     useful if multiple structures are defined, but hiscore.dat is not provided -->
      <size>47</size>
    </check>
    <loop count="6" skip-last-bytes="1">
      <elt id="SCORE" type="int" size="4" endianness="big_endian" base="10"/>
      <elt id="NAME" type="text" size="3" ascii-offset="0"/>
      <elt id="EMPTY" type="raw" size="1"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="SCORE"/>
      <column id="NAME" format="Trim"/>
    </table>
  </output>
</hi2txt>
