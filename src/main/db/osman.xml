<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt>
  <!--
    osman: Osman / Cannon Dancer
    Hiscores stored in hiscore/osman.hi

    10 entries.

    Name is split across two 16-bit words with 0xFFFF fillers between words.
    Charset maps 0x81..0x9A => A..Z, 0xE5 => '.', 0x20 => ' '.

    Score digits are stored in three bytes:
      - D1: ten-thousands digit
      - D2: thousands digit
      - D3: hundreds digit
    score = D1*10000 + D2*1000 + D3*100
    (This fixes the 10th place case like 3500 vs 3000.)
  //-->

  <structure file=".hi">
    <loop count="10">
      <!-- NAME (4 chars total, last is often space) -->
      <elt size="2" type="text" id="NAMEA" charset="osman_name"/>
      <elt size="2" type="raw"  id="FILL1"/>
      <elt size="2" type="text" id="NAMEB" charset="osman_name"/>
      <elt size="2" type="raw"  id="FILL2"/>

      <!-- unused / padding in this block -->
      <elt size="2" type="raw"  id="RAW0"/>
      <elt size="2" type="raw"  id="FILL3"/>

      <!-- D1 lives in the low byte of the next real word (00 D1) -->
      <elt size="1" type="raw"  id="D1HI"/>
      <elt size="1" type="int"  id="D1"/>
      <elt size="2" type="raw"  id="FILL4"/>

      <!-- D2,D3 live in the next real word (D2 D3) -->
      <elt size="1" type="int"  id="D2"/>
      <elt size="1" type="int"  id="D3"/>
      <elt size="2" type="raw"  id="FILL5"/>

      <!-- tail -->
      <elt size="2" type="raw"  id="RAW1"/>
      <elt size="2" type="raw"  id="FILL6"/>
    </loop>
  </structure>

  <output>
    <table>
      <column id="RANK" src="index" format="+1"/>
      <column id="NAME" format="namecat;TrimR"/>
      <column id="SCORE" format="score"/>
    </table>
  </output>

  <format id="namecat">
    <concat>
      <column id="NAMEA"/>
      <column id="NAMEB"/>
    </concat>
  </format>

  <format id="score">
    <sum>
      <column id="D1" format="*10000"/>
      <column id="D2" format="*1000"/>
      <column id="D3" format="*100"/>
    </sum>
  </format>

  <charset id="osman_name">
    <char src="0x20" dst=" "/>
    <char src="0xE5" dst="."/>

    <char src="0x81" dst="A"/><char src="0x82" dst="B"/><char src="0x83" dst="C"/><char src="0x84" dst="D"/>
    <char src="0x85" dst="E"/><char src="0x86" dst="F"/><char src="0x87" dst="G"/><char src="0x88" dst="H"/>
    <char src="0x89" dst="I"/><char src="0x8A" dst="J"/><char src="0x8B" dst="K"/><char src="0x8C" dst="L"/>
    <char src="0x8D" dst="M"/><char src="0x8E" dst="N"/><char src="0x8F" dst="O"/><char src="0x90" dst="P"/>
    <char src="0x91" dst="Q"/><char src="0x92" dst="R"/><char src="0x93" dst="S"/><char src="0x94" dst="T"/>
    <char src="0x95" dst="U"/><char src="0x96" dst="V"/><char src="0x97" dst="W"/><char src="0x98" dst="X"/>
    <char src="0x99" dst="Y"/><char src="0x9A" dst="Z"/>
  </charset>
</hi2txt>
