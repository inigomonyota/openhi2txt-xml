<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Puzzle Bobble">
  <!--
    structure: 4-byte header + 5 entries x 10 bytes = 54 bytes total
    header [0:4]:
      [0]    initialized flag (0xFF)
      [1:4]  padding
    per entry (10 bytes):
      [0:4]  score, 4-byte big-endian integer
      [4]    unknown (always 0x00)
      [5]    round reached
      [6:9]  name, 3 ASCII chars
      [9]    null terminator
  //-->
  <structure file=".hi">
    <check>
      <size>54</size>
    </check>
    <elt size="1" type="raw" id="INIT FLAG"/>
    <elt size="3" type="raw" id="PADDING"/>
    <loop count="5">
      <elt size="4" type="int"  id="SCORE"/>
      <elt size="1" type="raw"  id="UNKNOWN"/>
      <elt size="1" type="int"  id="ROUND"/>
      <elt size="3" type="text" id="NAME"/>
      <elt size="1" type="raw"  id="NULL"/>
    </loop>
  </structure>
  <output>
    <table id="BEST 5">
      <column id="RANK"    src="index" format="ordinal"/>
      <column id="SCORE"/>
      <column id="ROUND"/>
      <column id="NAME"/>
      <column id="UNKNOWN" format="hexadecimal_string" display="debug"/>
    </table>
    <field id="INIT FLAG" format="hexadecimal_string" display="debug"/>
    <field id="PADDING"   format="hexadecimal_string" display="debug"/>
  </output>
  <format id="ordinal">
    <case src="0" dst="1ST"/>
    <case src="1" dst="2ND"/>
    <case src="2" dst="3RD"/>
    <case src="3" dst="4TH"/>
    <case src="4" dst="5TH"/>
  </format>
</hi2txt>