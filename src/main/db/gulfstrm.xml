<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE hi2txt SYSTEM "hi2txt.dtd">
<hi2txt label="Gulf Storm">
  <!--
    tested with mame 0.251 and embedded hiscore.dat
    source: Antigravity
  //-->
  <structure file=".hi">
    <check>
      <definition>@:maincpu,program,c580,80,00,2e
                  @:maincpu,program,c618,4,00,00</definition>
      <size>132</size>
    </check>
    <loop count="16">
      <elt size="4" type="int"  id="SCORE" base="16"/>
      <elt size="4" type="text" id="NAME"/>
    </loop>
    <elt size="4" type="raw" id="UNKNOWN"/>
  </structure>

  <output>
    <table>
      <column id="RANK"  src="index" format="+1"/>
      <column id="SCORE" format="*100"/>
      <column id="NAME"/>
    </table>
  </output>
</hi2txt>
